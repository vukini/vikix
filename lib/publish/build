#!/usr/bin/env python3
"""build — a book's EPUB and PDF from its Markdown, checked (vikix publish).

Run in a project folder, by `vikix publish` or by a Makefile that includes
publish.mk:

  build epub     out/NAME.epub: pandoc, the e-ink table fix, epubcheck
  build pdf      out/NAME.pdf: pandoc, then Typst
  build check    both, into a scratch folder, then the spelling and the
                 links: nothing is written to out/
  build spell [--keep]
                 the words hunspell doesn't know, by chapter; --keep adds
                 them to words.txt (then read it: what's a real typo goes)
  build links    every link and image in the text: a #heading must be in
                 the book, a file beside the text must be there, and an
                 address on the web must answer (asked once a week; no
                 network, and the web's are left for next time)

The project has publish.yml, pandoc's metadata (title, author, lang, and
anything else pandoc reads) plus Vikix's own keys:

  name: living-in-sql      the files' name (default: the folder's)
  chapters: [a.md, b.md]   the text, in order (default: chapters/*.md by
                           name, else book.md)
  mainfont: ...            the PDF's face (default: IBM Plex Serif; Amiri
                           when lang is Arabic); Arabic in any book is set
                           in Amiri

The spelling is checked in the book's lang against LibreOffice's
dictionary (en_GB for any English, eo, ar: vikix publish setup fetches
them), and a passage marked ::: {lang=eo} (or [vorto]{lang=eo}) against
its own. Code, raw HTML and maths aren't prose. words.txt, one word a
line, beside publish.yml, holds the book's own words.

An EPUB epubcheck rejects is not kept as NAME.epub: it is left as
NAME.epub.rejected beside the report. A PDF Typst warned about is the same.
"""
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import zipfile
from concurrent.futures import ThreadPoolExecutor

import yaml

HERE = os.path.dirname(os.path.realpath(__file__))
DATA = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
# The pinned epubcheck (vikix publish setup); tests name a stand-in.
EPUBCHECK = os.environ.get("VIKIX_EPUBCHECK") or os.path.join(DATA, "vikix", "epubcheck", "epubcheck.jar")
# LibreOffice's dictionaries, pinned (vikix publish setup).
DICTS = os.environ.get("VIKIX_DICTS") or os.path.join(DATA, "vikix", "hunspell")
WORDS = "words.txt"
CACHE = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
# What the web answered to each link, kept a week (a check a day shouldn't
# knock on every site again); a dead one is asked again every time.
LINKS_CACHE = os.path.join(CACHE, "vikix", "publish-links.json")
LINKS_KEEP = 7 * 24 * 3600
# The kernel's routes: no default route is no network, and the web's links
# are left for next time rather than called dead. The tests name a file.
ROUTES = os.environ.get("VIKIX_NET_ROUTES") or "/proc/net/route"


def die(msg):
    sys.exit(f"publish: {msg}")


def meta():
    if not os.path.exists("publish.yml"):
        die(f"no publish.yml in {os.getcwd()} (vikix publish new makes one)")
    with open("publish.yml", encoding="utf-8") as f:
        m = yaml.safe_load(f) or {}
    if not m.get("title"):
        die("publish.yml has no title")
    return m


def sources(m):
    if m.get("chapters"):
        files = list(m["chapters"])
    else:
        files = sorted(glob.glob("chapters/*.md")) or (["book.md"] if os.path.exists("book.md") else [])
    missing = [f for f in files if not os.path.exists(f)]
    if missing:
        die(f"not there: {', '.join(missing)}")
    if not files:
        die("no text: chapters/*.md, book.md, or chapters: in publish.yml")
    return files


def name(m):
    return m.get("name") or os.path.basename(os.getcwd())


def run(argv, **kw):
    r = subprocess.run(argv, capture_output=True, text=True, **kw)
    return r.returncode, (r.stdout + r.stderr).strip()


def rezip(src_dir, dest):
    """An EPUB's zip: mimetype first and stored, the rest compressed."""
    with zipfile.ZipFile(dest, "w") as z:
        z.write(os.path.join(src_dir, "mimetype"), "mimetype", compress_type=zipfile.ZIP_STORED)
        for root, _, files in os.walk(src_dir):
            for f in sorted(files):
                full = os.path.join(root, f)
                rel = os.path.relpath(full, src_dir)
                if rel != "mimetype":
                    z.write(full, rel, compress_type=zipfile.ZIP_DEFLATED)


def epubcheck(path):
    if not os.path.exists(EPUBCHECK):
        die(f"no epubcheck at {EPUBCHECK} (vikix publish setup)")
    argv = [EPUBCHECK, path] if os.access(EPUBCHECK, os.X_OK) and not EPUBCHECK.endswith(".jar") \
        else ["java", "-jar", EPUBCHECK, path]
    return run(argv)


def code_intact(unpacked):
    """The pages whose code blocks have markup inside (a span per token),
    which e-ink readers lay out without the spaces between."""
    pre_code = re.compile(r"<pre[^>]*>\s*<code[^>]*>(.*?)</code>\s*</pre>", re.S)
    bad = []
    for page in sorted(glob.glob(os.path.join(unpacked, "EPUB", "text", "*.xhtml"))):
        with open(page, encoding="utf-8") as f:
            if any("<span" in block for block in pre_code.findall(f.read())):
                bad.append(os.path.basename(page))
    return ", ".join(bad)


def epub(m, files, outdir):
    os.makedirs(outdir, exist_ok=True)
    dest = os.path.join(outdir, name(m) + ".epub")
    with tempfile.TemporaryDirectory() as tmp:
        raw = os.path.join(tmp, "raw.epub")
        rc, said = run(["pandoc", *files, "--metadata-file=publish.yml", "-o", raw,
                        f"--css={os.path.join(HERE, 'epub.css')}", "--toc", "--toc-depth=2",
                        # No highlighting: it wraps each token of code in a
                        # <span>, and e-ink readers collapse the spaces
                        # between them, so every listing loses its layout
                        # (Living in Python found it first). epubcheck can't
                        # see it: code_intact() below can.
                        "--no-highlight"])
        if rc != 0:
            die(f"pandoc: {said}")
        unpacked = os.path.join(tmp, "book")
        with zipfile.ZipFile(raw) as z:
            z.extractall(unpacked)
        # The e-ink fix: tables into row cards, one-cell boxes into asides.
        rc, said = run([sys.executable, os.path.join(HERE, "fix-tables.py"), unpacked])
        if rc != 0:
            die(f"the table fix: {said}")
        broken = code_intact(unpacked)
        if broken:
            die(f"code would lose its spaces on e-ink readers: {broken}")
        built = os.path.join(tmp, "built.epub")
        rezip(unpacked, built)
        rc, report = epubcheck(built)
        if rc != 0:
            shutil.copy(built, dest + ".rejected")
            print(report)
            die(f"epubcheck rejected it: kept as {dest}.rejected")
        shutil.move(built, dest)
    print(f"{dest}  ({os.path.getsize(dest) // 1024} KB, epubcheck: no errors)")
    return dest


def pdf(m, files, outdir):
    os.makedirs(outdir, exist_ok=True)
    dest = os.path.join(outdir, name(m) + ".pdf")
    # The book's face, then Amiri for any Arabic in it (Typst takes the
    # first face that has a letter). Arabic books are set in Amiri itself.
    # pandoc's Typst template writes font: ("$mainfont$",), so the second
    # face goes in through the quotes: the only way it takes a list.
    arabic = str(m.get("lang", "")).startswith("ar")
    face = m.get("mainfont") or ("Amiri" if arabic else "IBM Plex Serif")
    font = ["-V", f'mainfont={face}' if face == "Amiri" else f'mainfont={face}", "Amiri']
    with tempfile.TemporaryDirectory() as tmp:
        built = os.path.join(tmp, "built.pdf")
        rc, said = run(["pandoc", *files, "--metadata-file=publish.yml", "-o", built,
                        "--pdf-engine=typst", "--toc", *font])
        if rc != 0:
            die(f"pandoc and Typst: {said}")
        warned = [line for line in said.splitlines() if "warning" in line.lower()]
        if warned:
            shutil.copy(built, dest + ".rejected")
            print("\n".join(warned))
            die(f"Typst warned: kept as {dest}.rejected")
        shutil.move(built, dest)
    print(f"{dest}  ({os.path.getsize(dest) // 1024} KB, Typst: no warnings)")
    return dest


def dict_name(lang):
    lang = str(lang or "en").lower().replace("_", "-")
    for prefix, d in (("en", "en_GB"), ("eo", "eo"), ("ar", "ar")):
        if lang.startswith(prefix):
            return d
    return None


def languages(m, files):
    """The book's dictionary first, then any other a passage is marked in."""
    own = dict_name(m.get("lang"))
    marked = set()
    for f in files:
        if f.lower().endswith((".docx", ".odt", ".epub")):
            continue   # a passage's language there is Word's, not marked: the book's lang
        with open(f, encoding="utf-8", errors="replace") as fh:
            marked.update(re.findall(r"lang=[\"']?([A-Za-z_-]+)", fh.read()))
    others = sorted({dict_name(x) or x for x in marked} - {own})
    return own or m.get("lang", "?"), others


def unknown_words(m, files):
    """{dictionary: {word: [chapter, ...]}} of the words hunspell doesn't know."""
    if not shutil.which("hunspell"):
        die("no hunspell (vikix add publish)")
    own, others = languages(m, files)
    found = {}
    for d in [own, *others]:
        if not os.path.exists(os.path.join(DICTS, d + ".dic")):
            print(f"spelling: no {d} dictionary, not checked (vikix publish setup fetches en_GB, eo and ar)")
            continue
        argv = ["hunspell", "-l", "-i", "utf-8", "-d", os.path.join(DICTS, d)]
        if os.path.exists(WORDS):
            argv += ["-p", os.path.abspath(WORDS)]
        for f in files:
            rc, prose = run(["pandoc", f, "--metadata-file=publish.yml", "-M", f"spell_lang={d}",
                             f"--lua-filter={os.path.join(HERE, 'spell.lua')}", "-t", "plain", "--wrap=none"])
            if rc != 0:
                die(f"pandoc, reading {f}: {prose}")
            # A curly apostrophe is the same word to the reader (CTE’s, CTE's).
            r = subprocess.run(argv, input=prose.replace("\u2019", "'"), capture_output=True, text=True)
            for word in r.stdout.split():
                # Anything with a digit is a name or a number (0x1000, FTS5,
                # chapter 10's), and one letter a letter (Part V, C, ĉ):
                # never a misspelt word.
                if any(c.isdigit() for c in word) or len(word) == 1:
                    continue
                if word.endswith("'s"):
                    word = word[:-2]
                found.setdefault(d, {}).setdefault(word, [])
                chapter = os.path.splitext(os.path.basename(f))[0]
                if chapter not in found[d][word]:
                    found[d][word].append(chapter)
    return found


def spell(m, files, keep=False):
    found = unknown_words(m, files)
    total = sum(len(w) for w in found.values())
    if not total:
        own, others = languages(m, files)
        print(f"spelling: every word is known ({', '.join([own, *others])}, and {WORDS})")
        return True
    for d, words in found.items():
        print(f"spelling, {d}: {len(words)} words not in the dictionary or {WORDS}")
        for word in sorted(words, key=str.lower):
            where = words[word]
            print(f"  {word:<24} {where[0]}" + (f" and {len(where) - 1} more" if len(where) > 1 else ""))
    if keep:
        have = set()
        if os.path.exists(WORDS):
            with open(WORDS, encoding="utf-8") as f:
                have = {line.strip() for line in f if line.strip()}
        new = sorted({w for words in found.values() for w in words} - have, key=str.lower)
        with open(WORDS, "a", encoding="utf-8") as f:
            f.writelines(w + "\n" for w in new)
        print(f"kept: {len(new)} words added to {WORDS}; read it, and take out what's a typo")
        return True
    return False


# --- The links -------------------------------------------------------------------

def ast_walk(node):
    """Every dict of pandoc's JSON tree, depth first."""
    if isinstance(node, dict):
        yield node
        for v in node.values():
            yield from ast_walk(v)
    elif isinstance(node, list):
        for v in node:
            yield from ast_walk(v)


def book_links(m, files):
    """(ids, links): every id in the book (a heading's, a div's, a span's),
    and every link and image as (target, chapter, kind), kind "link" or
    "image", in the text's order."""
    ids, links = set(), []
    for f in files:
        r = subprocess.run(["pandoc", f, "--metadata-file=publish.yml", "-t", "json"],
                           capture_output=True, text=True)
        if r.returncode != 0:
            die(f"pandoc, reading {f}: {r.stderr.strip()}")
        chapter = os.path.splitext(os.path.basename(f))[0]
        for node in ast_walk(json.loads(r.stdout)):
            t, c = node.get("t"), node.get("c")
            if t in ("Header", "Div", "Span", "CodeBlock", "Code", "Table", "Figure") and isinstance(c, list):
                attr = c[1] if t == "Header" else c[0]
                if isinstance(attr, list) and attr and isinstance(attr[0], str) and attr[0]:
                    ids.add(attr[0])
            if t in ("Link", "Image") and isinstance(c, list) and len(c) == 3:
                target = c[2][0]
                if target:
                    links.append((target, chapter, f, t.lower()))
    return ids, links


def net_up():
    """Is there a default route? Without one nothing on the web answers."""
    try:
        with open(ROUTES) as f:
            for line in f.readlines()[1:]:
                parts = line.split()
                if len(parts) > 3 and parts[1] == "00000000" and int(parts[3], 16) & 2:
                    return True
    except (OSError, ValueError):
        return True   # can't tell: ask the web, and let the answers say
    return False


def cache_read():
    try:
        with open(LINKS_CACHE, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def cache_write(cache):
    try:
        os.makedirs(os.path.dirname(LINKS_CACHE), exist_ok=True)
        tmp = LINKS_CACHE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(cache, f)
        os.replace(tmp, LINKS_CACHE)
    except OSError:
        pass   # a cache that can't be written only costs the next check its calls


def ask_web(url):
    """None when the address answers (any status but 404 and 410: a site
    that says 403 to a script still has the page), else a few words why not."""
    def call(method):
        req = urllib.request.Request(url, method=method,
                                     headers={"User-Agent": "vikix-publish link check (+https://vikix.dev)"})
        with urllib.request.urlopen(req, timeout=15) as r:
            return r.status
    try:
        try:
            status = call("HEAD")
        except urllib.error.HTTPError as e:
            # A server that doesn't take HEAD (405, 501), or refuses it: GET
            # says what it has.
            status = e.code if e.code in (404, 410) else call("GET")
    except urllib.error.HTTPError as e:
        status = e.code
    except urllib.error.URLError as e:
        reason = e.reason
        return f"no answer ({getattr(reason, 'strerror', None) or reason})"
    except (OSError, ValueError) as e:
        return f"no answer ({e})"
    if status in (404, 410):
        return f"gone ({status})"
    return None


def links(m, files):
    """Every link in the book checked: True when all are found."""
    ids, found = book_links(m, files)
    if not found:
        print("links: none in the text")
        return True
    bad, web, nweb, nanchors, nfiles = [], {}, 0, 0, 0
    for target, chapter, f, kind in found:
        if target.startswith("#"):
            nanchors += 1
            if target[1:] not in ids:
                bad.append((target, chapter, f"no heading or id {target} in the book"))
        elif re.match(r"https?://", target):
            nweb += 1
            web.setdefault(target, (chapter, kind))
        elif re.match(r"[a-z][a-z0-9+.-]*:", target):
            continue   # mailto:, tel:, data: and the like: nothing to look up
        else:
            nfiles += 1
            path = os.path.join(os.path.dirname(f), target.split("#", 1)[0])
            if not os.path.exists(path):
                bad.append((target, chapter, f"no such {'file' if kind == 'link' else 'image'} beside the text"))
    skipped = 0
    if web:
        cache = cache_read()
        now = time.time()
        ask = [u for u in web if not (u in cache and cache[u].get("ok") and now - cache[u].get("at", 0) < LINKS_KEEP)]
        if ask and not net_up():
            skipped = len(ask)
            ask = []
        if ask:
            with ThreadPoolExecutor(max_workers=8) as pool:
                for url, why in zip(ask, pool.map(ask_web, ask)):
                    cache[url] = {"at": now, "ok": why is None, "why": why}
            cache_write(cache)
        for url, (chapter, kind) in web.items():
            if url in cache and not cache[url].get("ok") and url in ask:
                bad.append((url, chapter, cache[url].get("why") or "no answer"))
    kinds = []
    if nweb:
        kinds.append(f"{nweb - skipped} on the web" if skipped else f"{nweb} on the web")
    if nanchors:
        kinds.append(f"{nanchors} to headings")
    if nfiles:
        kinds.append(f"{nfiles} to files")
    if bad:
        print(f"links: {len(bad)} of {len(found)} not found")
        for target, chapter, why in bad:
            print(f"  {target}  {chapter}: {why}")
    else:
        print(f"links: {len(found)} in the text, all found ({', '.join(kinds)})")
    if skipped:
        print(f"links: no network, so {skipped} on the web {'is' if skipped == 1 else 'are'} left for next time")
    return not bad


def main(argv):
    what = argv[0] if argv else ""
    if what == "name":
        # The files' name, for vikix publish --send.
        print(name(meta()))
        return 0
    if what not in ("epub", "pdf", "check", "spell", "links"):
        print(__doc__.strip())
        return 0 if what in ("-h", "--help", "help") else 2
    m = meta()
    files = sources(m)
    if what == "epub":
        epub(m, files, "out")
    elif what == "spell":
        if not spell(m, files, keep="--keep" in argv):
            return 1
    elif what == "pdf":
        pdf(m, files, "out")
    elif what == "links":
        if not links(m, files):
            return 1
    else:
        # The text first: a heading that isn't there stops Typst with a
        # message of its own, and the chapter is named here.
        spelt = spell(m, files)
        linked = links(m, files)
        if not spelt and not linked:
            die(f"check: the spelling and the links above want a look "
                f"(fix them, or vikix publish spell --keep for the words that are right)")
        if not spelt:
            die(f"check: the spelling above wants a look "
                f"(fix it, or vikix publish spell --keep for the words that are right)")
        if not linked:
            die("check: the links above want a look (fix them, or take them out)")
        with tempfile.TemporaryDirectory() as tmp:
            epub(m, files, tmp)
            pdf(m, files, tmp)
        print(f"check: {name(m)} builds, passes epubcheck and Typst, its spelling and its links ({len(files)} files of text)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
