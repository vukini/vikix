;;; Phase 0: data-only patterns and a clock independent of StumpWM.
(defpackage :vikix-music (:use :cl) (:export :tone :play :stop :check-file))
(in-package :vikix-music)
(defvar *emit* nil)
(defvar *bar* (lambda (start bpm steps) (declare (ignore start bpm steps))))
(defvar *silence* (lambda () nil))
(defvar *clock* (lambda () (/ (get-internal-real-time) internal-time-units-per-second)))
(defvar *worker* nil)
(defvar *stopping* nil)
(defvar *gain* 0.08)
(defun bounded (value low high label)
  (unless (and (realp value) (<= low value high))
    (error "~a must be between ~a and ~a" label low high))
  value)
(defun frequency (note)
  (let* ((name (string-upcase (string note))) (n (length name)))
    (cond ((string= name "-") nil)
          ((string= name "X") 220.0)
          (t
           (unless (and (<= 2 n 3) (find (char name 0) "CDEFGAB")
                        (digit-char-p (char name (1- n)))
                        (or (= n 2) (find (char name 1) "SB")))
             (error "Bad note ~a: use c4, cs4, eb4, x or -" note))
           (let* ((octave (digit-char-p (char name (1- n))))
                  (pitch (nth (position (char name 0) "CDEFGAB") '(0 2 4 5 7 9 11)))
                  (accidental (if (= n 2) 0 (if (char= (char name 1) #\S) 1 -1)))
                  (midi (+ (* 12 (1+ octave)) pitch accidental)))
             (bounded midi 12 119 "note (C0 through B8)")
             (float (* 440 (expt 2 (/ (- midi 69) 12))) 1.0))))))
(defun read-patterns (path)
  ;; No file form is evaluated. Bound depth and size before using READ.
  (with-open-file (in path)
    (when (> (file-length in) 65536) (error "Pattern file exceeds 64 KiB"))
    (let ((text (make-string (file-length in))) (depth 0) (comment nil))
      (setf text (subseq text 0 (read-sequence text in)))
      (loop for c across text do
        (cond ((char= c #\Newline) (setf comment nil))
              (comment nil)
              ((char= c #\;) (setf comment t))
              ((char= c #\() (when (> (incf depth) 8) (error "Pattern nesting too deep")))
              ((char= c #\)) (when (< (decf depth) 0) (error "Unbalanced parentheses")))
              ((or (alphanumericp c) (find c "-.:+ '") (find c '(#\Tab #\Return))) nil)
              (t (error "Character ~s is not pattern data" c))))
      (unless (zerop depth) (error "Unbalanced parentheses"))
      (let ((*read-eval* nil) (*package* (find-package :vikix-music))
            (*readtable* (copy-readtable nil)) (eof (gensym)) (bpm 120) (patterns nil)
            (bank nil) (bank-seen nil))
        (with-input-from-string (stream text)
          (loop for form = (read stream nil eof) until (eq form eof) do
            (unless (and (listp form) (ignore-errors (list-length form)))
              (error "Expected a proper pattern form"))
            (cond
              ((eq (first form) 'bank)
               (when bank-seen (error "Only one bank form is allowed"))
               (setf bank-seen t)
               (unless (evenp (length (rest form)))
                 (error "Bank needs pairs of pad number and pattern name"))
               (loop for (slot name) on (rest form) by #'cddr do
                 (unless (and (integerp slot) (<= 1 slot 32))
                   (error "Bank pad must be an integer from 1 to 32"))
                 (unless (and (symbolp name) (not (keywordp name)))
                   (error "Bank reference must be a pattern name"))
                 (when (assoc slot bank) (error "Duplicate bank pad ~a" slot))
                 (push (cons slot name) bank)))
              ((and (= (length form) 2) (eq (first form) 'tempo))
               (setf bpm (bounded (second form) 60 200 "tempo")))
              ((and (= (length form) 3) (eq (first form) 'defpattern)
                    (symbolp (second form)) (not (keywordp (second form)))
                    (listp (third form)) (ignore-errors (= (length (third form)) 2))
                    (eq (first (third form)) 'quote))
               (let ((steps (second (third form))))
                 (unless (and (listp steps) (ignore-errors (list-length steps))
                              (<= 1 (length steps) 128) (every #'symbolp steps))
                   (error "A pattern needs 1 to 128 note or rest symbols"))
                 (when (assoc (second form) patterns) (error "Duplicate pattern name"))
                 (push (cons (second form) (mapcar #'frequency steps)) patterns)
                 (when (> (length patterns) 32) (error "At most 32 patterns"))))
              (t (error "Use (tempo 120) and (defpattern name '(c4 - e4 -))")))))
        (unless patterns (error "No patterns in file"))
        ;; Resolve after all forms, so a bank may precede its patterns.
        (dolist (pad bank)
          (unless (assoc (cdr pad) patterns)
            (error "Unknown bank pattern ~a for pad ~a" (cdr pad) (car pad))))
        (values (nreverse patterns) bpm (nreverse bank) bank-seen)))))
(defun check-file (path)
  (multiple-value-bind (patterns bpm) (read-patterns path)
    (format t "~d pattern(s), ~a bpm~%" (length patterns) bpm)))
(defun bar-events (notes bpm start)
  (let ((step (/ 240d0 bpm (length notes))))
    (loop for freq in notes for i from 0 when freq
          collect (list (+ start (* i step)) freq (min 0.3 (* step 0.8)) *gain*))))
(defun tone (&optional (hz 440) (seconds 0.3))
  "A quiet, finite note; the synth frees itself."
  (bounded hz 20 20000 "frequency")
  (bounded seconds 0.02 5 "duration")
  (unless *emit* (error "Start with vikix music repl or vikix music tone"))
  (funcall *emit* (list (list (+ (funcall *clock*) 0.1) (float hz) seconds *gain*))))
(defun stop ()
  (setf *stopping* t)
  (when *worker*
    (sb-thread:join-thread *worker* :timeout 12 :default nil)
    (when (sb-thread:thread-alive-p *worker*) (error "Music worker did not stop"))
    (setf *worker* nil))
  (funcall *silence*)
  t)
(defun play-loop (path name bars)
  (let ((last-good nil) (bpm 120) (last-error nil) (start (+ (funcall *clock*) 0.2)))
    (loop for bar from 0 while (and (not *stopping*) (or (null bars) (< bar bars))) do
      (handler-case
          (multiple-value-bind (patterns tempo) (read-patterns path)
            (let ((selected (if name (find name patterns :key (lambda (p) (symbol-name (car p)))
                                          :test #'string-equal) (first patterns))))
              (unless selected (error "No pattern named ~a" name))
              (setf last-good (cdr selected) bpm tempo last-error nil)))
        (error (e)
          (unless last-good (error e))
          (let ((message (princ-to-string e)))
            (unless (equal message last-error)
              (format *error-output* "Keeping last good pattern: ~a~%" message))
            (setf last-error message))))
      ;; Do not catch up missed bars in a burst after suspend or overload.
      (when (< start (funcall *clock*)) (setf start (+ (funcall *clock*) 0.1)))
      (funcall *bar* start bpm (length last-good))
      (funcall *emit* (bar-events last-good bpm start))
      (incf start (/ 240d0 bpm))
      (let ((until (if (and bars (= (1+ bar) bars)) (+ start 0.05) (- start 0.1))))
        (loop while (and (not *stopping*) (< (funcall *clock*) until)) do (sleep 0.02))))))
(defun play (path &optional name)
  "Play a file, re-reading it at each bar. STOP ends this worker."
  (read-patterns path)
  (stop)
  (setf *stopping* nil
        *worker* (sb-thread:make-thread
                  (lambda () (handler-case (play-loop path name nil)
                               (error (e) (format *error-output* "Music stopped: ~a~%" e))))
                  :name "vikix-music")))
