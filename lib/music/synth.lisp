;;; Original Vikix synthesis, MIT (repository LICENSE); no samples or borrowed patches.
;;; Compiled only by setup, never by a score. Each voice frees its own node.
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(ql:quickload :cl-collider :silent t)
(in-package :sc-user)
(let* ((sc::*s* nil)
       (definitions
         (list
          ;; Keep the released sine, envelope and amplitude exactly as they were.
          (defsynth vikix-tone ((freq 440) (dur 0.3) (amp 0.08))
            (let* ((envelope (env-gen.kr (env '(0 1 0) (list 0.005 dur)) :act :free))
                   (signal (* (sin-osc.ar freq) envelope amp)))
              (out.ar 0 (list signal signal))))
          (defsynth vikix-kick ((freq 220) (dur 0.3) (amp 0.08))
            (let* ((pitch (env-gen.kr (env '(130 48 42) '(0.035 0.2))))
                   (envelope (env-gen.kr (env '(0 1 0) (list 0.003 dur)) :act :free))
                   (signal (* (sin-osc.ar pitch) envelope amp)))
              (out.ar 0 (list signal signal))))
          (defsynth vikix-snare ((freq 220) (dur 0.3) (amp 0.08))
            (let* ((envelope (env-gen.kr (env '(0 1 0) (list 0.002 dur)) :act :free))
                   (signal (* (+ (* 0.7 (white-noise.ar)) (* 0.3 (sin-osc.ar 180)))
                              envelope amp)))
              (out.ar 0 (list signal signal))))
          (defsynth vikix-closed-hat ((freq 220) (dur 0.3) (amp 0.08))
            (let* ((envelope (env-gen.kr (env '(0 1 0) '(0.001 0.06)) :act :free))
                   ;; A bounded bright metallic cluster, without filter overshoot.
                   (signal (* (+ (* 0.4 (sin-osc.ar 6131))
                                 (* 0.35 (sin-osc.ar 8273))
                                 (* 0.25 (white-noise.ar))) envelope amp)))
              (out.ar 0 (list signal signal))))
          (defsynth vikix-bass ((freq 440) (dur 0.3) (amp 0.08))
            (let* ((envelope (env-gen.kr (env '(0 1 0) (list 0.005 dur)) :act :free))
                   (signal (* (+ (* 0.75 (sin-osc.ar freq))
                                 (* 0.25 (sin-osc.ar (* 2 freq)))) envelope amp)))
              (out.ar 0 (list signal signal))))
          (defsynth vikix-bell ((freq 440) (dur 0.3) (amp 0.08))
            (let* ((envelope (env-gen.kr (env '(0 1 0) (list 0.003 dur)) :act :free))
                   (signal (* (+ (* 0.65 (sin-osc.ar freq))
                                 (* 0.25 (sin-osc.ar (* 2.76 freq)))
                                 (* 0.1 (sin-osc.ar (* 4.07 freq)))) envelope amp)))
              (out.ar 0 (list signal signal)))))))
  ;; One versioned bundle is replaced atomically by setup: no partial palette.
  (with-open-file (out (sb-ext:posix-getenv "VIKIX_MUSIC_SYNTH")
                       :direction :output :if-exists :supersede
                       :element-type '(unsigned-byte 8))
    (write-sequence (subseq (sc::encode-synthdef (first definitions)) 0 8) out)
    (write-byte 0 out)
    (write-byte (length definitions) out)
    (dolist (definition definitions)
      (write-sequence (subseq (sc::encode-synthdef definition) 10) out))))
