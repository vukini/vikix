(load (merge-pathnames "core.lisp" *load-truename*))
(in-package :vikix-music)
(defun unix-time ()
  (multiple-value-bind (seconds micros) (sb-ext:get-time-of-day)
    (+ seconds (/ micros 1000000d0))))
(defun main ()
  (let* ((args (cdr sb-ext:*posix-argv*)) (command (first args))
         (path (second args)))
    (when (equal command "check") (check-file path) (return-from main))
    (setf *clock* #'unix-time)
    (let ((events (sb-sys:make-fd-stream
                   (parse-integer (sb-ext:posix-getenv "VIKIX_MUSIC_FD"))
                   :output t :element-type 'character :buffering :line))
          (lock (sb-thread:make-mutex :name "music events")))
      (setf *silence* (lambda ()
                        (sb-thread:with-mutex (lock)
                          (write-line "stop" events) (finish-output events))))
      (setf *bar* (lambda (start bpm steps swing)
                    (sb-thread:with-mutex (lock)
                      (format events "bar ~f ~f ~d ~f~%" start bpm steps swing)
                      (finish-output events))))
      (setf *emit*
            (lambda (notes)
              (sb-thread:with-mutex (lock)
                (dolist (note notes)
                  (destructuring-bind (at freq dur gain &optional (sound 'sine) (relative 1)) note
                    (format events "~f ~f ~f ~f ~(~a~) ~f~%" at freq dur gain sound relative)))
                (finish-output events))))
      (unwind-protect
           (cond ((equal command "tone")
                  (tone (read-from-string path)) (sleep 0.6))
                 ((equal command "play")
                  (play-loop path (and (third args) (plusp (length (third args))) (third args))
                             (and (fourth args) (plusp (length (fourth args))) (parse-integer (fourth args)))))
                 ((equal command "repl")
                  (format t "Music REPL: (tone 440), (play ~s), (stop), (quit).~%" path)
                  ;; This is the user's local Lisp REPL, not the data-only file reader.
                  (loop for form = (progn (format t "~&music> ") (force-output)
                                          (read *standard-input* nil :eof))
                        until (eq form :eof) do
                    (when (equal form '(quit)) (return))
                    (handler-case (format t "~s~%" (eval form))
                      (error (e) (format *error-output* "~a~%" e)))))
                 (t (error "Unknown music command")))
        (stop) (close events)))))
(handler-case (main)
  (error (e) (format *error-output* "vikix music: ~a~%" e) (sb-ext:exit :code 1)))
