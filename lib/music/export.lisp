;;; Finite score expansion, sharing the live player's validated note semantics.
(load (merge-pathnames "core.lisp" *load-truename*))
(in-package :vikix-music)
(defun export-score (path name repeats)
  (unless (and (integerp repeats) (<= 1 repeats 16)) (error "Repeat must be 1 to 16"))
  (multiple-value-bind (patterns bpm bank bank-seen settings) (read-patterns path)
    (declare (ignore bank bank-seen))
    (when (plusp (length name))
      (setf patterns (remove-if-not (lambda (p) (string-equal name (symbol-name (car p)))) patterns)))
    (unless patterns (error "No matching pattern"))
    (let ((total 0d0))
      (dolist (pattern patterns)
        (incf total (* repeats (/ 240d0 bpm)
                       (if (getf (cdr (assoc (car pattern) settings)) :progression)
                           (length (cdr pattern)) 1))))
      (when (> total 3600) (error "Export exceeds one hour total; select a pattern or fewer repeats")))
    (format t "[")
    (loop for (name . notes) in patterns for first = t then nil
          for options = (cdr (assoc name settings))
          for bars = (* repeats (if (getf options :progression) (length notes) 1)) do
      (unless first (format t ","))
      (format t "{~s:~s,~s:~f,~s:~f,~s:[" "name" (symbol-name name)
              "bpm" bpm "duration" (* bars (/ 240d0 bpm)) "events")
      (let ((first-event t))
        (dotimes (bar bars)
          (dolist (event (if (getf options :progression)
                            (progression-events notes bar bpm (* bar (/ 240d0 bpm)) options)
                            (bar-events notes bpm (* bar (/ 240d0 bpm)) options)))
            (unless first-event (format t ","))
            (setf first-event nil)
            (destructuring-bind (at freq dur gain sound relative) event
              (format t "[~f,~f,~f,~f,~s]" at freq dur (* gain relative)
                      (string-downcase (symbol-name sound)))))))
      (format t "]}"))
    (format t "]~%")))
(handler-case
    (let ((args (cdr sb-ext:*posix-argv*)))
      (export-score (first args) (second args) (parse-integer (third args))))
  (error (e) (format *error-output* "vikix music send: ~a~%" e) (sb-ext:exit :code 1)))
