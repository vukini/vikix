#!/usr/bin/env python3
"""vikix-project — your projects, each a folder with a log.md (`vikix project`).

  vikix project [list] [--all]   one line each, most recently logged first:
                      name, % done, the last entry's date, the next step
                      (--all: projects with no entries yet, too)
  vikix project show NAME        title, folder, log, its Status, the last 3 entries
  vikix project path NAME        the folder: cd "$(vikix project path lambda)"
  vikix project log NAME "what was done" [--next "..."] [--status "few words"] [--agent]
                      a new entry for today at the top of the log, marked
                      (Vid) unless --agent (or run from Claude Code); never
                      committed: it says how
  vikix project open NAME        the project on a workspace of its own: a terminal
                      in the folder, the editor on its log, placed as you
                      left them (its saved layout); the workspace it has
                      still, if it's open
  vikix project save [NAME]      save the layout of its workspace now (leaving
                      the workspace saves it too): vikix layout project-NAME
  vikix project build NAME [-n]  run its build in its folder (-n: only say which)
  vikix project check NAME [-n]  run its checks in its folder: the log's Check
                      line, check.sh, check, tests/run.sh, test.sh, make
                      check or test, npm test (-n: only say which)
  vikix project new NAME [--in COLLECTION | --log-apart] [--title "..."] [--next "..."]
                      a new project: ~/src/NAME (the first root) with a log.md
                      (a Status and a first entry); --in: inside a collection;
                      --log-apart (--private, its old name): the repo
                      ~/src/NAME's log in the logs folder, out of a public
                      repo; a FOLDER (with a /, or .) gives that folder a log.md
  vikix project new NAME --git | --github public|private [--description "..."] [--log-apart]
                      the same, as a git repository: a README.md (the title,
                      the description), the log unless apart, one commit;
                      --github makes the repository on GitHub too (gh,
                      signed in: gh auth login), public or private, with the
                      description as its About, origin set, and pushes once
                      through gh's login over HTTPS, so your SSH key is not
                      asked for (origin keeps gh's protocol for your pushes)
  vikix project today [yesterday|DATE] [--no-git]   (also: vikix today)
                      what was done that day, project by project: the log
                      entries and the commits (any branch), then what's next
  vikix project pick             choose one with rofi and open it (Super+Alt+p)

What a project is: a folder under a root (~/src unless ~/.config/vikix/projects
says otherwise), at most `depth` levels down (2), with a log.md in it. A
folder inside a project folder is a project of that collection
(living-series/living-in-lambda). Hidden folders, node_modules and git
worktrees (their .git is a file: they'd count a project twice) are skipped.
A public repo keeps its log apart: a repo with no log.md whose name has
<logs>/NAME/log.md (logs=~/src/project-logs) is a project with that log.

A log, newest first:

  # Log: Title
  **Status** (...), as of 2026-09-12: 93% complete.
  - Standing: where it is
  - Next: what comes next
  - Build: make site          (optional: overrides the build found)
  - Check: make test          (optional: overrides the checks found)

  ## 2026-09-18 · status words (Vid)
  What was done.
  Next: what comes next.

Names match exactly, then by a prefix or a part of the name that only one
project has; a collection's project also answers to collection/name.
"""
import datetime
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "vikix" / "projects"
LOG_NAMES = ("log.md", "LOG.md")   # LOG.md: a collection's own log (living-series/LOG.md)
SKIP = {"node_modules"}
DATED = re.compile(r"^## (\d{4}-\d{2}-\d{2})\b(.*)$")
STATUS_DATE = re.compile(r"as of (\d{4}-\d{2}-\d{2})")
PERCENT = re.compile(r"(\d{1,3})% complete")


def die(msg, code=1):
    print(f"vikix project: {msg}", file=sys.stderr)
    sys.exit(code)


def today():
    # VIKIX_TODAY: for the tests, so "3 days ago" stays true.
    t = os.environ.get("VIKIX_TODAY")
    return datetime.date.fromisoformat(t) if t else datetime.date.today()


def expand(p):
    return Path(os.path.expandvars(os.path.expanduser(p.strip())))


def read_config():
    roots, logs, depth = [], HOME / "src" / "project-logs", 2
    try:
        lines = CONFIG.read_text().splitlines()
    except OSError:
        lines = []
    for line in lines:
        line = line.split("#", 1)[0].strip()
        if "=" not in line:
            continue
        key, val = (s.strip() for s in line.split("=", 1))
        if key == "root" and val:
            roots.append(expand(val))
        elif key == "logs" and val:
            logs = expand(val)
        elif key == "depth" and val.isdigit():
            depth = max(1, int(val))
    return roots or [HOME / "src"], logs, depth


class Project:
    def __init__(self, path, log, collection=None, external=False):
        self.path, self.log, self.collection, self.external = path, log, collection, external
        self.name = path.name
        self._parsed = None

    @property
    def full(self):
        return f"{self.collection}/{self.name}" if self.collection else self.name

    @property
    def parsed(self):
        if self._parsed is None:
            self._parsed = parse_log(self.log.read_text(errors="replace"))
        return self._parsed


def find_log(folder):
    for n in LOG_NAMES:
        if (folder / n).is_file():
            return folder / n
    return None


def discover():
    roots, logs, depth = read_config()
    logs_real = logs.resolve() if logs.exists() else None
    found, seen = [], set()

    def walk(folder, level, rel):
        try:
            subs = sorted(p for p in folder.iterdir() if p.is_dir())
        except OSError:
            return
        for sub in subs:
            if sub.name.startswith(".") or sub.name in SKIP:
                continue
            if (sub / ".git").is_file():          # a git worktree: the same project again
                continue
            real = sub.resolve()
            if logs_real and real == logs_real:   # the logs repo is not a project
                continue
            log = find_log(sub)
            external = False
            if log is None and level == 1 and (sub / ".git").is_dir() and logs_real:
                other = logs_real / sub.name / "log.md"
                if other.is_file():
                    log, external = other, True
            if log is not None and real not in seen:
                seen.add(real)
                found.append(Project(sub, log, "/".join(rel) or None, external))
            if level < depth:
                walk(sub, level + 1, rel + [sub.name])

    for root in roots:
        if root.is_dir():
            walk(root, 1, [])
    return found


def parse_log(text):
    lines = text.splitlines()
    title = None
    first_entry = len(lines)
    for i, line in enumerate(lines):
        if title is None and line.startswith("# "):
            title = line[2:].strip()
            if title.lower().startswith("log:"):
                title = title[4:].strip()
        if DATED.match(line):
            first_entry = i
            break
    intro = lines[:first_entry]

    # Status blocks: a **Status** line and the lines after it up to the
    # first one that is neither blank nor a "- " point.
    statuses, cur = [], None
    for line in intro:
        if line.startswith("**Status**"):
            cur = [line]
            statuses.append(cur)
        elif cur is not None:
            if line.strip() == "" or line.startswith(("- ", "  ")):
                cur.append(line)
            else:
                cur = None
    for s in statuses:
        while s and not s[-1].strip():
            s.pop()

    def point(block, key):
        for line in block:
            m = re.match(rf"^- {key}:\s*(.*)$", line)
            if m:
                return m.group(1).strip()
        return None

    first = statuses[0] if statuses else []
    pct = None
    sdate = None
    if first:
        m = PERCENT.search(first[0])
        pct = int(m.group(1)) if m else None
        m = STATUS_DATE.search(first[0])
        sdate = m.group(1) if m else None
    build = check = None
    for s in statuses:
        build = build or point(s, "Build")
        check = check or point(s, "Check")

    entries = []
    cur = None
    for line in lines[first_entry:]:
        m = DATED.match(line)
        if m:
            rest = m.group(2).strip()
            vid = rest.endswith("(Vid)")
            if vid:
                rest = rest[:-5].strip()
            rest = rest.lstrip("·").strip()
            cur = {"date": m.group(1), "words": rest, "vid": vid, "lines": [line], "next": None}
            entries.append(cur)
        elif cur is not None:
            cur["lines"].append(line)
            n = re.match(r"^Next:\s*(.*)$", line)
            if n and cur["next"] is None:
                cur["next"] = n.group(1).strip()
    for e in entries:
        while e["lines"] and not e["lines"][-1].strip():
            e["lines"].pop()

    return {
        "title": title, "intro": intro, "first_entry": first_entry,
        "statuses": statuses, "percent": pct, "status_date": sdate,
        "status_next": point(first, "Next") if first else None,
        "build": build, "check": check, "entries": entries,
    }


def last_date(p):
    dates = [e["date"] for e in p.parsed["entries"]]
    return max(dates) if dates else None


def next_step(p):
    """The newer of the Status' Next and the newest entry that has one."""
    d = p.parsed
    entry = next((e for e in d["entries"] if e["next"]), None)
    if d["status_next"] and (not entry or not d["status_date"] or d["status_date"] >= entry["date"]):
        return d["status_next"]
    return entry["next"] if entry else (d["status_next"] or "")


def ago(date):
    days = (today() - datetime.date.fromisoformat(date)).days
    if days <= 0:
        return "today"
    if days == 1:
        return "yesterday"
    if days < 14:
        return f"{days} days ago"
    if days < 60:
        return f"{days // 7} weeks ago"
    if days < 730:
        return f"{days // 30} months ago"
    return f"{days // 365} years ago"


def width():
    if os.environ.get("COLUMNS", "").isdigit():
        return int(os.environ["COLUMNS"])
    if sys.stdout.isatty():
        return shutil.get_terminal_size().columns
    return 0   # piped: whole lines


def rows(projects, everything):
    keep = [p for p in projects if everything or p.parsed["entries"]]
    keep.sort(key=lambda p: p.full)
    # Newest first; sort is stable, so names stay A to Z within a day.
    keep.sort(key=lambda p: last_date(p) or "", reverse=True)
    out = []
    for p in keep:
        pct = p.parsed["percent"]
        date = last_date(p)
        out.append((p, p.full, f"{pct}%" if pct is not None else "",
                    f"{date} ({ago(date)})" if date else "no entries yet", next_step(p)))
    return out


def cmd_list(args):
    everything = "--all" in args
    bad = [a for a in args if a != "--all"]
    if bad:
        die(f"list takes only --all, not {bad[0]}", 2)
    projects = discover()
    if not projects:
        roots, _, _ = read_config()
        die(f"no projects (folders with a log.md) under {', '.join(map(str, roots))}; "
            f"the folders searched are in {CONFIG}")
    table = rows(projects, everything)
    if not table:
        print("no project has a log entry yet (vikix project list --all shows them)")
        return
    nw = max(len(r[1]) for r in table)
    dw = max(len(r[3]) for r in table)
    w = width()
    for _, name, pct, date, nxt in table:
        line = f"{name:<{nw}}  {pct:>4}  {date:<{dw}}  {nxt}".rstrip()
        if w and len(line) > w:
            line = line[:max(w - 1, 0)] + "…"
        print(line)


def match(name, projects=None):
    projects = discover() if projects is None else projects
    if not projects:
        die("no projects found (vikix project list says where it looks)")
    low = name.lower()
    for test in (lambda p: low in (p.name.lower(), p.full.lower()),
                 lambda p: p.name.lower().startswith(low) or p.full.lower().startswith(low),
                 lambda p: low in p.full.lower()):
        hits = [p for p in projects if test(p)]
        if len(hits) == 1:
            return hits[0]
        if len(hits) > 1:
            names = "\n".join(f"  {p.full}" for p in sorted(hits, key=lambda p: p.full))
            die(f"'{name}' could be any of these; say which:\n{names}", 2)
    die(f"no project called '{name}' (vikix project list --all)")


def one_name(args, what):
    if len(args) != 1:
        die(f"usage: vikix project {what} NAME", 2)
    return match(args[0])


def where_log(p):
    if p.external:
        return f"{p.log} (kept apart from the repo)"
    return str(p.log)


def cmd_show(args):
    p = one_name(args, "show")
    d = p.parsed
    print(d["title"] or p.name)
    print(f"  project: {p.full}")
    print(f"  folder:  {p.path}")
    print(f"  log:     {where_log(p)}")
    if d["build"]:
        print(f"  build:   {d['build']}")
    if d["check"]:
        print(f"  check:   {d['check']}")
    for s in d["statuses"]:
        print()
        print("\n".join(s))
    entries = d["entries"][:3]
    if entries:
        print()
        print(f"The last {len(entries)} of {len(d['entries'])} entries:" if len(d["entries"]) > 3
              else "Entries:")
        for e in entries:
            print()
            print("\n".join(e["lines"]))
    else:
        print("\nNo entries yet: vikix project log " + p.name + ' "what was done"')


def cmd_path(args):
    print(one_name(args, "path").path)


def git_top(path):
    """The repository PATH is in, or None. A .git that is a repository (HEAD in
    it) or a worktree's file; a bare empty folder called .git isn't one (one in
    /tmp once made every temporary folder look like a repository)."""
    for d in [path, *path.parents]:
        g = d / ".git"
        if g.is_file() or (g / "HEAD").exists():
            return d
    return None


def add_entry(p, body, nxt=None, status=None, agent=False, date=None):
    """A new entry in p's log, dated DATE (today): above the entries of that
    day and before, so the log stays newest first (vikix day log writes
    yesterday's too)."""
    date = (date or today()).isoformat()
    text = p.log.read_text(errors="replace")
    lines = text.splitlines()
    at = len(lines)
    for i, line in enumerate(lines):
        m = DATED.match(line)
        if m and m.group(1) <= date:
            at = i
            break
    else:
        if not any(DATED.match(line) for line in lines):
            at = parse_log(text)["first_entry"]

    head = f"## {date}"
    if status:
        head += f" · {status}"
    if not agent:
        head += " (Vid)"
    entry = [head, "", body.strip()]
    if nxt:
        entry += ["", f"Next: {nxt}"]

    before, after = lines[:at], lines[at:]
    while before and not before[-1].strip():
        before.pop()
    new = before + ([""] if before else []) + entry + ([""] + after if after else [])
    p.log.write_text("\n".join(new) + "\n")
    p._parsed = None


def set_percent(p, percent, date=None):
    """The Status' "N% complete" becomes PERCENT, and its "as of" date DATE
    (today). False when the log's Status has no percentage to change."""
    date = (date or today()).isoformat()
    lines = p.log.read_text(errors="replace").splitlines()
    for i, line in enumerate(lines):
        if DATED.match(line):
            break
        if line.startswith("**Status**") and PERCENT.search(line):
            line = PERCENT.sub(f"{int(percent)}% complete", line, count=1)
            lines[i] = STATUS_DATE.sub(f"as of {date}", line, count=1)
            p.log.write_text("\n".join(lines) + "\n")
            p._parsed = None
            return True
    return False


def cmd_log(args):
    usage = 'usage: vikix project log NAME "what was done" [--next "..."] [--status "few words"] [--agent]'
    pos, nxt, status = [], None, None
    agent = bool(os.environ.get("CLAUDECODE"))
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--next", "--status"):
            if i + 1 >= len(args):
                die(usage, 2)
            if a == "--next":
                nxt = args[i + 1].strip()
            else:
                status = args[i + 1].strip()
            i += 2
            continue
        if a == "--agent":
            agent = True
        elif a == "--vid":
            agent = False
        elif a.startswith("--"):
            die(usage, 2)
        else:
            pos.append(a)
        i += 1
    if len(pos) != 2 or not pos[1].strip():
        die(usage, 2)
    p = match(pos[0])
    add_entry(p, pos[1], nxt, status, agent)

    print(f"wrote today's entry at the top of {p.log}")
    top = git_top(p.log.parent)
    if top:
        rel = os.path.relpath(p.log, top)
        print(f"not committed; when you want to: git -C {top} commit -m 'log: {p.name}' -- {rel}")
    else:
        print("(the log isn't in a git repo, so there's nothing to commit)")


def spawn(cmd, cwd):
    subprocess.Popen(cmd, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


EVAL = Path(__file__).resolve().parent / "vikix-eval"
LAYOUTS = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "vikix" / "layouts"


def lisp(form, timeout=20):
    """Lisp in the running StumpWM (vikix eval): what it printed, or None
    when there's no desktop to ask (then open works as it did)."""
    try:
        r = subprocess.run(["python3", str(EVAL), form], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0 or "error:" in r.stdout:
        return None
    return "\n".join(l for l in r.stdout.splitlines() if not l.startswith("=> ")).strip()


def lisp_str(text):
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def layout_name(full):
    """The layout a project's workspace is saved as (layouts.lisp's own rule)."""
    return "project-" + "".join("--" if c == "/" else c if (c.isalnum() or c in "-_.") else "_" for c in full)


def arrange(p, before):
    """Once the terminal and the editor have come (the workspace has two
    more windows), put the project's saved layout back. Its windows that
    aren't open are named."""
    if not (LAYOUTS / (layout_name(p.full) + ".lisp")).is_file():
        return
    count = "(princ (length (group-windows (current-group))))"
    for _ in range(60):
        n = lisp(count)
        if n is None or (n.isdigit() and int(n) >= before + 2):
            break
        time.sleep(0.25)
    time.sleep(0.3)   # their titles settle
    said = lisp(f"(multiple-value-bind (m s) (vikix-layout-restore {lisp_str(layout_name(p.full))}) "
                f"(princ (vikix-layout-said {lisp_str(p.full)} m s)))")
    if said:
        print("   placed as you left it: " + said)


def cmd_save(args):
    if args:
        p = one_name(args, "save")
        full = p.full
    else:
        full = lisp("(let ((p (gethash (current-group) *vikix-project-groups*))) (when p (princ p)))")
        if not full:
            die("this workspace isn't a project's (vikix project open NAME gives it one); or name it")
    out = lisp(f"(progn (vikix-project-save {lisp_str(full)}) (princ 1))")
    if out != "1":
        die("StumpWM didn't save it (vikix doctor)")
    print(f"saved {full}'s layout: vikix layout {layout_name(full)} puts it back")


def cmd_open(args):
    p = one_name(args, "open")
    if not os.environ.get("DISPLAY"):
        die(f'open needs the desktop; here: cd "$(vikix project path {p.name})"')
    # A workspace of its own: the one it has still, or the first empty one.
    claim = lisp(f"(princ (vikix-project-claim {lisp_str(p.full)}))")
    if claim == "EXISTING":
        print(f"{p.full} is open: its workspace")
        return
    before = lisp("(princ (length (group-windows (current-group))))")
    term = os.environ.get("VIKIX_TERMINAL") or "alacritty"
    if not shutil.which(term):
        die(f"no terminal: {term} isn't installed (VIKIX_TERMINAL names another)")
    # The terminal starts in the folder (cwd), so any terminal does.
    spawn([term], p.path)
    if shutil.which("emacsclient"):
        # -a '': starts the Emacs server if it isn't running; -n: don't wait.
        spawn(["emacsclient", "-n", "-c", "-a", "", str(p.log)], p.path)
    else:
        spawn([term, "-e", os.environ.get("EDITOR") or "nvim", str(p.log)], p.path)
    print(f"opened {p.full}: a terminal in {p.path}, the editor on {p.log}")
    if claim == "NEW" and before and before.isdigit():
        arrange(p, int(before))


def build_command(p):
    """(the command as words, how to show it), or (None, None)."""
    d = p.path
    if p.parsed["build"]:
        return ["bash", "-c", p.parsed["build"]], f"{p.parsed['build']}  (the log's Build line)"
    for script in (d / "build.sh", None, d / "src" / "build.sh"):
        if script is None:
            if any((d / m).is_file() for m in ("Makefile", "makefile", "GNUmakefile")):
                return ["make"], "make"
            continue
        if script.is_file():
            rel = os.path.relpath(script, d)
            try:
                shebang = script.open(errors="replace").readline()
            except OSError:
                shebang = ""
            shell = "bash" if "bash" in shebang else "sh"
            return [shell, rel], f"{shell} {rel}"
    if (d / "package.json").is_file():
        return ["npm", "run", "build"], "npm run build"
    return None, None


def cmd_build(args):
    dry = any(a in ("-n", "--dry-run") for a in args)
    p = one_name([a for a in args if a not in ("-n", "--dry-run")], "build")
    cmd, shown = build_command(p)
    if not cmd:
        die(f"{p.full}: no build.sh, Makefile, src/build.sh or package.json in {p.path}; "
            f"a '- Build: COMMAND' line in the log's Status says how")
    print(f"{p.full}: {shown}  (in {p.path})", flush=True)
    if dry:
        return
    try:
        rc = subprocess.run(cmd, cwd=p.path).returncode
    except FileNotFoundError:
        die(f"{cmd[0]} isn't installed")
    print(f"{p.full}: {'built' if rc == 0 else 'the build failed'} (exit status {rc})")
    sys.exit(rc)


def make_target(d, names):
    """The first of these targets the folder's Makefile has, or None."""
    for m in ("Makefile", "makefile", "GNUmakefile"):
        try:
            text = (d / m).read_text(errors="replace")
        except OSError:
            continue
        for t in names:
            if re.search(rf"^{t}\s*:", text, re.M):
                return t
    return None


def check_command(p):
    """(the command as words, how to show it), or (None, None)."""
    d = p.path
    if p.parsed["check"]:
        return ["bash", "-c", p.parsed["check"]], f"{p.parsed['check']}  (the log's Check line)"
    for script in ("check.sh", "check", "tests/run.sh", "test.sh"):
        f = d / script
        if f.is_file():
            if os.access(f, os.X_OK):
                return [f"./{script}"], f"./{script}"
            return ["bash", script], f"bash {script}"
    t = make_target(d, ("check", "test"))
    if t:
        return ["make", t], f"make {t}"
    try:
        import json
        if "test" in json.loads((d / "package.json").read_text()).get("scripts", {}):
            return ["npm", "test"], "npm test"
    except (OSError, ValueError, AttributeError):
        pass
    return None, None


def cmd_check(args):
    dry = any(a in ("-n", "--dry-run") for a in args)
    p = one_name([a for a in args if a not in ("-n", "--dry-run")], "check")
    cmd, shown = check_command(p)
    if not cmd:
        die(f"{p.full}: no check.sh, check, tests/run.sh, test.sh, make check/test or npm test "
            f"in {p.path}; a '- Check: COMMAND' line in the log's Status says how")
    print(f"{p.full}: {shown}  (in {p.path})", flush=True)
    if dry:
        return
    try:
        rc = subprocess.run(cmd, cwd=p.path).returncode
    except (FileNotFoundError, PermissionError):
        die(f"{cmd[0]} can't be run")
    print(f"{p.full}: {'the checks passed' if rc == 0 else 'the checks failed'} (exit status {rc})")
    sys.exit(rc)


def git_at(folder, *args, **kw):
    """git in FOLDER; its stdout, or a die with its stderr."""
    r = subprocess.run(["git", "-C", str(folder), *args], capture_output=True, text=True, **kw)
    if r.returncode != 0:
        die(f"git {args[0]} failed in {folder}: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout


def gh_create(folder, name, kind, description):
    """The repository FOLDER on GitHub as NAME, public or private, origin
    set; gh's URL for it. gh signed in is checked by the call itself: it
    says gh auth login when not."""
    cmd = ["gh", "repo", "create", name, f"--{kind}", "--source", str(folder), "--remote", "origin"]
    if description:
        cmd += ["--description", description]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        die("gh repo create took over a minute: GitHub can't be reached? The repository is here, "
            f"nothing is on GitHub; later: gh repo create {name} --{kind} --source {folder} --remote origin --push")
    if r.returncode != 0:
        die(f"gh repo create refused: {(r.stderr or r.stdout).strip()}\nthe repository is here, {folder}; "
            f"later: gh repo create {name} --{kind} --source {folder} --remote origin --push")
    url = next((w for w in (r.stdout + r.stderr).split() if w.startswith("https://")), "")
    return url or f"https://github.com/?/{name}"


def gh_push(folder):
    """The first push, -u origin HEAD. An SSH origin (gh's usual) would ask
    for the key's passphrase, which no shell of the Office's can give, so
    that one push goes to the same repository over HTTPS through gh's
    login (as the repos plugin pulls); origin stays as gh set it, for the
    user's own pushes."""
    url = git_at(folder, "remote", "get-url", "origin").strip()
    cmd = ["push", "-u", "origin", "HEAD"]
    m = re.match(r"^(?:git@github\.com:|ssh://git@github\.com/)(.+?)(?:\.git)?$", url)
    if m:
        cmd = ["-c", f"remote.origin.pushurl=https://github.com/{m.group(1)}.git",
               "-c", "credential.helper=", "-c", "credential.helper=!gh auth git-credential", *cmd]
    try:
        git_at(folder, *cmd, timeout=120)
    except subprocess.TimeoutExpired:
        die(f"the push took over two minutes and was stopped; later, from {folder}: git push -u origin HEAD")


def cmd_new(args):
    usage = ('usage: vikix project new NAME|FOLDER [--in COLLECTION | --log-apart] '
             '[--title "..."] [--next "..."] [--git | --github public|private [--description "..."]]')
    pos, opts = [], {}
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--in", "--title", "--next", "--github", "--description"):
            if i + 1 >= len(args) or not args[i + 1].strip():
                die(usage, 2)
            opts[a] = args[i + 1].strip()
            i += 2
            continue
        if a in ("--private", "--log-apart"):
            opts["--private"] = True
        elif a == "--git":
            opts[a] = True
        elif a.startswith("--"):
            die(usage, 2)
        else:
            pos.append(a)
        i += 1
    if len(pos) != 1 or ("--in" in opts and "--private" in opts):
        die(usage, 2)
    if opts.get("--github") not in (None, "public", "private"):
        die("--github takes public or private", 2)
    if "--description" in opts and "--git" not in opts and "--github" not in opts:
        die("--description goes with --git or --github: it is the README's line and GitHub's About", 2)
    repo = "--git" in opts or "--github" in opts
    if "--github" in opts and not shutil.which("gh"):
        die("gh (GitHub's command, package github-cli) isn't installed: nothing is made; "
            "--git makes the repository here alone, for a push later")
    arg = pos[0]
    roots, logs, depth = read_config()
    projects = discover()

    if "--private" in opts:
        name = Path(arg).name if ("/" in arg or arg == ".") else arg
        repo_dir = (Path(arg).resolve() if ("/" in arg or arg == ".") else roots[0] / name)
        folder, log = repo_dir, logs / name / "log.md"
    elif "--in" in opts:
        if "/" in arg:
            die("with --in, NAME is a name, not a folder", 2)
        coll = match(opts["--in"], projects)
        folder = coll.path / arg
        log = folder / "log.md"
    elif "/" in arg or arg == ".":
        folder = Path(arg).expanduser().resolve()
        log = folder / "log.md"
    else:
        folder = roots[0] / arg
        log = folder / "log.md"
    name = folder.name
    if repo and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", name):
        die(f"{name}: a repository's name is letters, digits, dots, dashes and underscores", 2)

    if log.exists() or (find_log(folder) and "--private" not in opts):
        die(f"{folder} already has a log: {log if log.exists() else find_log(folder)}")
    if "--private" not in opts and (folder / ".git").is_file():
        die(f"{folder} is a git worktree, which vikix project skips; make it in the repo itself")
    if repo and git_top(folder):
        die(f"{folder} is in a git repository already ({git_top(folder)}): --git and --github make a new one; "
            f"vikix project new {arg} alone gives it a log")

    title = opts.get("--title") or name.replace("-", " ").replace("_", " ")
    title = title[:1].upper() + title[1:]
    d = today().isoformat()
    text = (f"# Log: {title}\n\n"
            f"**Status**, as of {d}: 0% complete.\n\n"
            f"- Standing: just begun\n"
            f"- Next: {opts.get('--next') or 'the first step'}\n\n"
            f"## {d} · started (Vid)\n\nThe project begun.\n")
    made = not folder.exists()
    if "--private" not in opts or repo:
        folder.mkdir(parents=True, exist_ok=True)
    log.parent.mkdir(parents=True, exist_ok=True)
    log.write_text(text)

    print(f"made {log}" + (f" (and the folder {folder})" if made and ("--private" not in opts or repo) else ""))
    if "--private" in opts:
        print(f"the log is kept apart from the repo {folder}")
        if not repo and not (folder / ".git").is_dir():
            print(f"it is listed once {folder} is a git repo (git init {folder})")
    if repo:
        # The repository: the default branch the user's git makes (main when
        # it says nothing, not git's master), the README, the log unless it
        # is kept apart, one commit; then GitHub, then the push.
        branch = subprocess.run(["git", "config", "--get", "init.defaultBranch"],
                                capture_output=True, text=True).stdout.strip() or "main"
        git_at(folder, "init", "-q", "-b", branch)
        readme = folder / "README.md"
        if not readme.exists():
            readme.write_text(f"# {title}\n" + (f"\n{opts['--description']}\n" if opts.get("--description") else ""))
        git_at(folder, "add", "--", "README.md", *(["log.md"] if "--private" not in opts else []))
        git_at(folder, "commit", "-q", "-m", f"Begin {name}")
        print(f"a git repository on {branch}: README.md"
              + (" and log.md" if "--private" not in opts else "") + " committed")
        if "--github" in opts:
            url = gh_create(folder, name, opts["--github"], opts.get("--description"))
            gh_push(folder)
            print(f"on GitHub, {opts['--github']}: {url} (pushed; origin is set)")
    else:
        top = git_top(log.parent)
        if top:
            print(f"not committed; when you want to: git -C {top} add -- {os.path.relpath(log, top)}")
    # Looked for once the repository is there: a log kept apart is listed only for a repo.
    if not any(p.log.resolve() == log.resolve() for p in discover()):
        print(f"note: vikix project doesn't see it: {folder} isn't within {depth} levels of a root "
              f"in {CONFIG} ({', '.join(map(str, roots))})")
    print(f"edit the Status by hand; add entries with: vikix project log {name} \"what was done\"")


def git_today(top, day):
    """This day's commits in the repo at top, on any branch: [(hash, subject)]."""
    nxt = day + datetime.timedelta(days=1)
    try:
        r = subprocess.run(["git", "-C", str(top), "log", "--all", "--no-merges",
                            f"--since={day.isoformat()} 00:00", f"--until={nxt.isoformat()} 00:00",
                            "--format=%h %s"],
                           capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return []
    return [(line.split(" ", 1) + [""])[:2] for line in r.stdout.splitlines() if line.strip()]


def cmd_today(args):
    """What was done on a day (today unless DATE or yesterday) and what is next."""
    use_git = "--no-git" not in args
    rest = [a for a in args if a != "--no-git"]
    if len(rest) > 1 or (rest and rest[0].startswith("-")):
        die("usage: vikix today [yesterday|YYYY-MM-DD] [--no-git]", 2)
    day = today()
    if rest:
        if rest[0] == "yesterday":
            day -= datetime.timedelta(days=1)
        else:
            try:
                day = datetime.date.fromisoformat(rest[0])
            except ValueError:
                die(f"not a date: {rest[0]} (YYYY-MM-DD, or yesterday)", 2)
    iso = day.isoformat()
    projects = sorted(discover(), key=lambda p: p.full)
    w = width()

    def cut(s, indent):
        s = " " * indent + s
        return s if not w or len(s) <= w else s[:max(w - 1, 0)] + "…"

    # Commits, by repo; a repo that is a project's folder goes with that project.
    by_top = {}
    if use_git:
        for p in projects:
            top = git_top(p.path)
            if top and top not in by_top:
                by_top[top] = git_today(top, day)
    own = {p.path: p for p in projects}

    shown = 0
    print(f"{'Today' if day == today() else 'On'} {iso}" + ("" if day == today() else f" ({ago(iso)})"))
    for p in projects:
        entries = [e for e in p.parsed["entries"] if e["date"] == iso]
        commits = by_top.get(p.path, []) if p.path in by_top else []
        if not entries and not commits:
            continue
        shown += 1
        print()
        print(cut(p.full + (f"  ({p.parsed['percent']}%)" if p.parsed["percent"] is not None else ""), 0))
        for e in entries:
            body = " ".join(line.strip() for line in e["lines"][1:]
                            if line.strip() and not line.startswith("Next:"))
            words = e["words"] + (" (Vid)" if e["vid"] else "")
            print(cut(f"- {words}: {body}" if words else f"- {body}", 2))
        if commits:
            print(cut(f"{len(commits)} commit{'s' if len(commits) > 1 else ''}:", 2))
            for h, s in commits[:8]:
                print(cut(f"{h} {s}", 4))
            if len(commits) > 8:
                print(cut(f"… and {len(commits) - 8} more (git -C {p.path} log --since={iso})", 4))
        nxt = next_step(p)
        if nxt:
            print(cut(f"next: {nxt}", 2))
    # Repos with commits that no project's folder is (a collection's repo without its own log).
    for top, commits in sorted(by_top.items()):
        if commits and top not in own:
            shown += 1
            print()
            print(cut(f"{top}: {len(commits)} commit{'s' if len(commits) > 1 else ''}", 0))
            for h, s in commits[:8]:
                print(cut(f"{h} {s}", 4))
    if not shown:
        print()
        print("nothing logged" + (" or committed" if use_git else "") + " that day")


def cmd_pick(args):
    table = rows(discover(), True)
    if not table:
        subprocess.run(["notify-send", "-a", "Vikix", "No projects",
                        f"No folder with a log.md under the roots in {CONFIG}"])
        return
    nw = max(len(r[1]) for r in table)
    menu = "\n".join(f"{name:<{nw}}  {pct:>4}  {nxt}"[:160] for _, name, pct, _, nxt in table)
    r = subprocess.run(["rofi", "-dmenu", "-i", "-p", "Project", "-format", "i", "-no-custom"],
                       input=menu, capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip().isdigit():
        return
    p = table[int(r.stdout.strip())][0]
    cmd_open([p.full])


def main(argv):
    cmd, args = (argv[0], argv[1:]) if argv else ("list", [])
    if cmd.startswith("--") and cmd != "--help":
        cmd, args = "list", argv
    table = {"list": cmd_list, "show": cmd_show, "path": cmd_path, "log": cmd_log,
             "open": cmd_open, "save": cmd_save, "build": cmd_build, "check": cmd_check, "new": cmd_new,
             "today": cmd_today, "pick": cmd_pick}
    if cmd in ("help", "-h", "--help"):
        print(__doc__.strip())
        return
    if cmd not in table:
        die(f"unknown command: {cmd} (vikix project help)", 2)
    table[cmd](args)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except BrokenPipeError:
        pass
