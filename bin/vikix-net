#!/bin/sh
# vikix-net — the network link as one short line, for the mode line.
#
#   vikix-net   print the line; it takes no arguments
#
#   wifi VID       Wi-Fi: the network's name
#   wifi VID 42%   and its signal, when it is weak (under 60%)
#   wired      a cable, and no Wi-Fi
#   offline    neither
#
# Asks NetworkManager. Prints nothing when it isn't running, so the bar
# leaves the field out instead of showing something wrong.
devices=$(nmcli -t -f TYPE,STATE device 2>/dev/null) || exit 0

# SIGNAL before SSID, so a name with a colon in it (nmcli writes "\:")
# stays in one piece at the end of the line.
wifi=$(nmcli -t -f ACTIVE,SIGNAL,SSID device wifi list --rescan no 2>/dev/null |
       sed -n 's/^yes:\([0-9]*\):\(.*\)$/\1 \2/p' | sed 's/\\\(.\)/\1/g' | head -n 1)

if [ -n "$wifi" ]; then
  signal=${wifi%% *} name=${wifi#* }
  # A strong signal isn't news; a weak one explains a slow connection.
  if [ "$signal" -ge 60 ]; then
    printf 'wifi %s\n' "$name"
  else
    printf 'wifi %s %s%%\n' "$name" "$signal"
  fi
elif printf '%s\n' "$devices" | grep -q '^ethernet:connected'; then
  echo wired
else
  echo offline
fi
