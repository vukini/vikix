#!/usr/bin/env python3
"""vikix-docs — every document on the machine in one catalogue, found from one key.

  vikix docs find WORDS... [--source S] [--limit N] [--json|--tsv]
                                  the documents that match, best first: words
                                  as in a search box (the start of a word is
                                  enough), "exact words", a OR b
  vikix docs page [WORDS...]      the catalogue as a page in Nyxt (when you
                                  have it): the hits by where they're from,
                                  each with buttons to open it either way
  vikix docs pick                 a search box, then the hits to open
                                  (Super+F2): Enter opens it, Ctrl+Enter in
                                  the other place (a terminal for a man page,
                                  Emacs for a page of Markdown)
  vikix docs open ID [--other]    open one, by the id find shows
  vikix docs read ID              one as plain text (what the agents read)
  vikix docs index [--full] [--quiet]
                                  read again what changed (--full: all of
                                  it); vikix update does it
  vikix docs status               how many from where, and when last read
  vikix docs list [--source S]    how many from each source, a line each
                                  (source, count, tab between); with
                                  --source, its documents by title, as
                                  find --tsv prints them
  vikix docs get                  download the offline programming docs
                                  into ~/dev (a few GB, slow; what plain
                                  vikix docs did before)

What it covers, each with whose words they are: Vikix's guides (vikix);
the README, DESIGN, TODO, CLAUDE and log files, plans/ and docs/ of your
projects in ~/src (repo); the language guides in ~/dev (dev); your Org notes in
~/Dropbox/notes (note); your own documents, the folders you name (own,
below); every man page (man) and Info manual (info) on the
machine; the tldr pages (tldr: a command's worked examples, where a man
page has its options) and the ArchWiki (arch), the English pages of each
as wikiman keeps them in /usr/share/doc, when they're there; the READMEs
and notes packages keep in /usr/share/doc (doc); and every package there
is, installed or not (pkg). Vikix's guides rank first, then yours, then
tldr with the man pages, then the rest of the system's.

It reads again by itself what changed, when a search finds the catalogue
more than a day old (a few seconds); vikix update reads the man pages and
manuals again. A man page, a tldr page or a Markdown file opens as a page
in the docs browser, styled as the guide is (made by mandoc and pandoc,
cached in ~/.cache/vikix/docs/); an ArchWiki page as the copy is; a package
as a short page (installed or not, how to add it, its website); an Info
manual and your notes in Emacs. Ctrl+Enter (or --other) opens the other
way: Emacs, or a terminal; an ArchWiki page as it is today, on the web.

Your own documents (own) are the folders named in ~/.config/vikix/docs,
yours to make, a line each: own=~/books (every Markdown file under it), or
own=~/books one/*.md two/out/*.html (those files, as patterns from that
folder; HTML pages only when asked for). Unlike the other sources they are
read a section at a time (a Markdown heading, an HTML heading with an id
or a data-at tag),
so a search lands on the section, and so does a chapter a page of vikix
what names. They open in the docs browser at that section, styled as the
guide is, or in Emacs. They are closed to agents: docs_search and
docs_read leave them out, unless a line agents=~/books opens that folder
to them. The same file names the folders of your own pages for vikix what
(what=FOLDER; vikix what help says what a page is).

The catalogue is one SQLite file, ~/.local/share/vikix/docs/index.db: table
docs (id, source, kind, title, path, excerpt, mtime) and docs_fts, its
full-text index. Nothing in it leaves the machine.
"""
import glob
import hashlib
import html
import json
import os
import re
import shlex
import shutil
import signal
import socket
import sqlite3
import subprocess
import sys
import time
import urllib.parse

HOME = os.path.expanduser("~")
# The checkout this runs from (vikix mcp loads it without a __file__).
HERE = os.path.dirname(os.path.dirname(os.path.realpath(
    globals().get("__file__") or os.path.join(os.environ.get("VIKIX_DIR", os.path.expanduser("~/vikix")), "bin", "vikix-docs"))))
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share"), "vikix")
DB = os.environ.get("VIKIX_DOCS_DB") or os.path.join(DATA, "docs", "index.db")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "vikix", "docs")
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
SRC = os.environ.get("VIKIX_DOCS_SRC") or os.path.join(HOME, "src")
DEV = os.environ.get("VIKIX_DOCS_DEV") or os.path.join(HOME, "dev")
STALE = 24 * 3600                       # a search reads again what changed, after a day
BODY = 200_000                          # characters of a document indexed
BOOST = {"vikix": 3.0, "own": 2.5, "repo": 2.0, "dev": 2.0, "note": 2.0, "tldr": 1.1, "man": 1.0, "info": 1.0, "arch": 0.95,
         "pkgdoc": 0.9, "pkg": 0.8}
BADGE = {"vikix": "vikix", "own": "yours", "repo": "repo", "dev": "dev", "note": "note", "man": "man", "info": "info",
         "tldr": "tldr", "arch": "arch", "pkgdoc": "doc", "pkg": "pkg"}
PKGDOC = "/usr/share/doc"
# wikiman's offline copies (its own download step puts them here; nothing
# refreshes them by itself): the English pages of each.
TLDR = os.environ.get("VIKIX_DOCS_TLDR") or "/usr/share/doc/tldr-pages/en"
ARCH = os.environ.get("VIKIX_DOCS_ARCH") or "/usr/share/doc/arch-wiki/html/en"
PKGDOC_FILES = re.compile(r"^(README|NEWS|CHANGES|ChangeLog|FAQ|INSTALL|USAGE|TODO)|\.(md|txt|html?|rst)$", re.I)
REPO_FILES = ("README.md", "DESIGN.md", "TODO.md", "CLAUDE.md", "IDEAS.md", "bugs.md", "log.md")


def die(msg):
    sys.exit(f"vikix docs: {msg}")


# --- The catalogue -------------------------------------------------------------------------

def connect():
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    db = sqlite3.connect(DB, timeout=30)
    db.executescript("""
      PRAGMA journal_mode=WAL;
      CREATE TABLE IF NOT EXISTS docs (rid INTEGER PRIMARY KEY, id TEXT UNIQUE, source TEXT, kind TEXT,
                                       title TEXT, path TEXT, excerpt TEXT, mtime REAL);
      -- Its rows are docs' by rowid: found and dropped by it, at once.
      CREATE VIRTUAL TABLE IF NOT EXISTS docs_fts USING fts5(title, body,
                                                             tokenize='unicode61 remove_diacritics 2');
      CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v TEXT);
    """)
    return db


def meta(db, k, v=None):
    if v is None:
        row = db.execute("SELECT v FROM meta WHERE k = ?", (k,)).fetchone()
        return row[0] if row else None
    db.execute("INSERT OR REPLACE INTO meta VALUES (?, ?)", (k, str(v)))


def put(db, doc, body):
    drop(db, doc["id"])
    cur = db.execute("INSERT INTO docs (id, source, kind, title, path, excerpt, mtime) VALUES (?, ?, ?, ?, ?, ?, ?)",
                     (doc["id"], doc["source"], doc["kind"], doc["title"], doc["path"], doc.get("excerpt", ""),
                      doc["mtime"]))
    db.execute("INSERT INTO docs_fts (rowid, title, body) VALUES (?, ?, ?)", (cur.lastrowid, doc["title"], body[:BODY]))


def drop(db, doc_id):
    row = db.execute("SELECT rid FROM docs WHERE id = ?", (doc_id,)).fetchone()
    if row:
        db.execute("DELETE FROM docs_fts WHERE rowid = ?", (row[0],))
        db.execute("DELETE FROM docs WHERE rid = ?", (row[0],))


def drop_source(db, source):
    db.execute("DELETE FROM docs_fts WHERE rowid IN (SELECT rid FROM docs WHERE source = ?)", (source,))
    db.execute("DELETE FROM docs WHERE source = ?", (source,))


def excerpt(text):
    text = re.sub(r"\s+", " ", text).strip()
    return text[:300]


# --- Where documents come from ------------------------------------------------------------

def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read(BODY)
    except OSError:
        return ""


def md_title(text, path):
    m = re.search(r"^# +(.+)$", text, re.M)
    return m.group(1).strip() if m else os.path.basename(path)


def md_plain(text):
    """Markdown, its marks taken off, for the excerpt."""
    text = re.sub(r"```.*?```", " ", text, flags=re.S)
    text = re.sub(r"^#+ +.*$", " ", text, count=1, flags=re.M)
    text = re.sub(r"[`*_>#|]", " ", text)
    return re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", text)


def vikix_dir():
    return os.environ.get("VIKIX_DIR") or HERE


def files_vikix():
    for path in sorted(glob.glob(os.path.join(vikix_dir(), "docs", "*.md"))):
        if os.path.basename(path) == "README.md":
            continue
        yield path, "guide"
    yield os.path.join(vikix_dir(), "README.md"), "readme"


def files_repo():
    if not os.path.isdir(SRC):
        return
    for name in sorted(os.listdir(SRC)):
        project = os.path.join(SRC, name)
        # A project, not a worktree of one (its .git is a file there).
        if not os.path.isdir(os.path.join(project, ".git")):
            continue
        for f in REPO_FILES:
            p = os.path.join(project, f)
            if os.path.isfile(p):
                kind = {"README.md": "readme", "TODO.md": "todo", "log.md": "log"}.get(f, "design")
                yield p, kind
        for p in sorted(glob.glob(os.path.join(project, "DESIGN-*.md"))):
            yield p, "design"
        # The longer plans of a project, in its plans/ folder (Vikix's own are there).
        for p in sorted(glob.glob(os.path.join(project, "plans", "*.md"))):
            yield p, "design"
        # A checkout of Vikix: its guides are the vikix source's already.
        if os.path.exists(os.path.join(project, "docs", "guide.css")):
            continue
        for root, dirs, files in os.walk(os.path.join(project, "docs")):
            dirs[:] = [d for d in dirs if not d.startswith(".") and d != "node_modules"]
            if root.count(os.sep) - project.count(os.sep) > 3:
                continue
            for f in sorted(files):
                if f.endswith(".md"):
                    yield os.path.join(root, f), "doc"


def files_dev():
    for p in sorted(glob.glob(os.path.join(DEV, "*", "README.md"))):
        yield p, "guide"


OWN_FILE = os.path.join(CONFIG, "vikix", "docs")
OWN_SKIP = {"node_modules", "out", "build", "dist", ".cache", "__pycache__"}
OWN_LARGEST = 3_000_000   # bytes: a built single-file site is bigger, and isn't a document to read
OWN_HEADINGS = 2          # a section is a second-level heading (## in Markdown, h2); the first is the whole


def own_config(path=None):
    """~/.config/vikix/docs, yours: {"own": [(folder, [patterns])], "agents": [folders], "what": [folders]}."""
    found = {"own": [], "agents": [], "what": []}
    for line in (read_text(path or OWN_FILE) or "").splitlines():
        line = line.split("#", 1)[0].strip()
        key, sep, rest = line.partition("=")
        key = key.strip()
        if not sep or key not in found or not rest.strip():
            continue
        words = rest.split()
        folder = os.path.realpath(os.path.expanduser(words[0]))
        found[key].append((folder, words[1:]) if key == "own" else folder)
    return found


def own_open_to_agents(path, config=None):
    """Whether agents may read the document at PATH: it is under a folder an
    agents= line opens to them. Everything of yours is closed until then."""
    path = os.path.realpath(path)
    return any(path == folder or path.startswith(folder + os.sep)
               for folder in (config or own_config())["agents"])


def files_own(config=None):
    """Your documents: (path, top folder) each, by the own= lines."""
    seen = set()
    for folder, patterns in (config or own_config())["own"]:
        if not os.path.isdir(folder):
            continue
        if patterns:
            paths = [p for pat in patterns for p in sorted(glob.glob(os.path.join(folder, pat), recursive=True))]
        else:
            paths = []
            for root, dirs, files in os.walk(folder):
                dirs[:] = sorted(d for d in dirs if not d.startswith(".") and d not in OWN_SKIP)
                paths += [os.path.join(root, f) for f in sorted(files) if f.endswith(".md")]
        for path in paths:
            if path in seen or not os.path.isfile(path):
                continue
            seen.add(path)
            yield path, folder


def md_sections(text):
    """A Markdown text as (heading, depth, body) parts: what is before the
    first heading first, with no heading."""
    parts, heading, depth, body = [], "", 0, []
    for line in text.splitlines():
        m = re.match(r"^(#{1,%d}) +(.+?)\s*#*\s*$" % OWN_HEADINGS, line)
        if m:
            parts.append((heading, depth, "\n".join(body)))
            heading, depth, body = m.group(2).strip(), len(m.group(1)), []
        else:
            body.append(line)
    parts.append((heading, depth, "\n".join(body)))
    return [p for p in parts if p[0] or p[2].strip()]


def html_sections(text):
    """An HTML page as (heading, anchor, body) parts, by the second-level
    headings that have an id, or a data-at tag (what a link can land on: a
    page's own script routes #TAG to the block tagged so); what comes
    before the first is the page's."""
    parts, heading, hid, start = [], "", "", 0
    for m in re.finditer(r"(?is)<h2\b([^>]*)>(.*?)</h2>", text):
        idm = re.search(r'\bid="([^"]+)"', m.group(1)) or re.search(r'\bdata-at="([^"]+)"', m.group(1))
        if not idm:
            continue
        parts.append((heading, hid, text[start:m.start()]))
        heading, hid, start = html_plain(m.group(2)), idm.group(1), m.end()
    parts.append((heading, hid, text[start:]))
    return [p for p in parts if p[0] or html_plain(p[2])]


def own_title(text, path):
    if path.endswith(".html"):
        m = re.search(r"(?is)<title>(.*?)</title>", text) or re.search(r"(?is)<h1\b[^>]*>(.*?)</h1>", text)
        return html_plain(m.group(1)) if m else os.path.basename(path)
    return md_title(text, path)


def own_rows(path, folder):
    """The rows a document of yours makes: the whole, then a row a section
    (id own:PATH#HEADING, path PATH#HEADING for Markdown, PATH#ID for HTML)."""
    text = read_text(path)
    book = os.path.relpath(path, folder).split(os.sep)[0]
    book = "" if book == os.path.basename(path) else book
    title = own_title(text, path)
    said = f"{title} ({book})" if book else title
    whole = html_plain(text) if path.endswith(".html") else md_plain(text)
    rows = [({"id": f"own:{path}", "source": "own", "kind": "own", "title": said, "path": path,
              "excerpt": excerpt(whole)}, whole)]
    if path.endswith(".html"):
        parts = [(h, i, html_plain(b)) for h, i, b in html_sections(text) if h]
    else:
        parts = [(h, h, md_plain(b)) for h, d, b in md_sections(text) if h and d > 1]
    for heading, anchor, body in parts:
        rows.append(({"id": f"own:{path}#{heading}", "source": "own", "kind": "section",
                      "title": f"{title} › {heading}" + (f" ({book})" if book else ""),
                      "path": f"{path}#{anchor}", "excerpt": excerpt(body)}, body))
    return rows


def index_own(db, full):
    """Your documents, a file read again when it changed, its rows made anew."""
    known = {}
    for doc_id, mtime in db.execute("SELECT id, mtime FROM docs WHERE source = 'own'").fetchall():
        known.setdefault(doc_id.split("#", 1)[0], mtime)
    seen, changed = set(), 0
    for path, folder in files_own():
        try:
            mtime = os.path.getmtime(path)
            if os.path.getsize(path) > OWN_LARGEST:
                continue
        except OSError:
            continue
        doc_id = f"own:{path}"
        seen.add(doc_id)
        if not full and known.get(doc_id) == mtime:
            continue
        for old in db.execute("SELECT id FROM docs WHERE source = 'own' AND (id = ? OR id LIKE ?)",
                              (doc_id, doc_id.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "#%")).fetchall():
            drop(db, old[0])
        for doc, body in own_rows(path, folder):
            doc["mtime"] = mtime
            put(db, doc, body)
        changed += 1
    for doc_id in set(known) - seen:
        for old in db.execute("SELECT id FROM docs WHERE source = 'own' AND (id = ? OR id LIKE ?)",
                              (doc_id, doc_id.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "#%")).fetchall():
            drop(db, old[0])
    return changed


def html_plain(text):
    """An HTML page's words, scripts and styles left out."""
    text = re.sub(r"(?is)<(script|style)[^>]*>.*?</\1>", " ", text)
    text = re.sub(r"<[^>]+>", " ", text)
    return re.sub(r"\s+", " ", html.unescape(text)).strip()


def files_tldr():
    """The tldr pages for every system (common) and for Linux: one a command."""
    for sub in ("common", "linux"):
        for p in sorted(glob.glob(os.path.join(TLDR, sub, "*.html"))):
            yield p, "tldr"


def tldr_title(text, path):
    """The command, and what it is in a line: "tar — Archiving utility." """
    name = html.unescape(re.sub(r"<[^>]+>", "", (re.search(r"(?s)<h1>(.*?)</h1>", text) or [None, ""])[1])).strip()
    name = name or os.path.basename(path)[:-5]
    quote = re.search(r"(?s)<blockquote>(.*?)</blockquote>", text)
    what = ""
    if quote:
        lines = [l.strip() for l in html_plain(quote.group(1)).split(". ") if l.strip()]
        lines = [l for l in lines if not l.startswith("More information")]
        what = lines[0].rstrip(".") + "." if lines else ""
    return f"{name} — {what}" if what else name


def files_arch():
    """The ArchWiki's pages, each named for its title; the ones named by a
    hash are other languages' main pages."""
    for p in sorted(glob.glob(os.path.join(ARCH, "*.html"))):
        if not re.fullmatch(r"[0-9a-f]{32}\.html", os.path.basename(p)):
            yield p, "wiki"


def arch_title(text, path):
    m = re.search(r"(?s)<title>(.*?)</title>", text)
    title = html.unescape(m.group(1)).strip() if m else ""
    title = re.sub(r"\s+-\s+ArchWiki$", "", title)
    return title or os.path.basename(path)[:-5].replace("_", " ")


def arch_plain(text):
    """The page's own words: from its body, before the categories and the
    footer every page has."""
    start = text.find('id="bodyContent"')
    end = text.find('id="catlinks"')
    if end < 0:
        end = text.find('id="footer"')
    if start >= 0:
        # From the body's own tag to the tag that ends it.
        text = text[text.rfind("<", 0, start):text.rfind("<", 0, end) if end > start else None]
    return html_plain(text)


def notes_dir():
    """The notes: the inbox plugin's folder, or ~/Dropbox/notes."""
    settings = os.path.join(CONFIG, "vikix", "plugins", "inbox", "settings")
    try:
        with open(settings) as f:
            for line in f:
                k, _, v = line.partition("=")
                if k.strip() == "file" and v.strip():
                    return os.path.dirname(os.path.expanduser(v.strip()))
    except FileNotFoundError:
        pass
    return os.path.join(HOME, "Dropbox", "notes")


def files_note():
    root = notes_dir()
    for dirpath, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d != "attachments"]
        for f in sorted(files):
            if f.endswith(".org"):
                yield os.path.join(dirpath, f), "note"


def org_title(text, path):
    m = re.search(r"^#\+title:\s*(.+)$", text, re.M | re.I)
    if m:
        return m.group(1).strip()
    m = re.search(r"^\*+ +(.+)$", text, re.M)
    return m.group(1).strip() if m and os.path.basename(path) == "inbox.org" else os.path.basename(path)[:-4]


def org_plain(text):
    text = re.sub(r"^:PROPERTIES:.*?^:END:\s*$", " ", text, flags=re.M | re.S)
    text = re.sub(r"^#\+\w+:.*$", " ", text, flags=re.M)
    text = re.sub(r"\[\[[^\]]*\]\[([^\]]*)\]\]", r"\1", text)
    return re.sub(r"\[\[([^\]]*)\]\]", r"\1", text)


def index_files(db, source, files, title_of, plain, full):
    """Each file read again when it changed; the gone ones dropped."""
    seen = set()
    known = dict(db.execute("SELECT id, mtime FROM docs WHERE source = ?", (source,)).fetchall())
    changed = 0
    for path, kind in files:
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            continue
        doc_id = f"{source}:{path}"
        seen.add(doc_id)
        if not full and known.get(doc_id) == mtime:
            continue
        text = read_text(path)
        body = plain(text)
        title = title_of(text, path)
        if source == "repo":
            title = f"{title} ({os.path.relpath(path, SRC)})"
        put(db, {"id": doc_id, "source": source, "kind": kind, "title": title, "path": path,
                 "excerpt": excerpt(body), "mtime": mtime}, body)
        changed += 1
    for doc_id in set(known) - seen:
        drop(db, doc_id)
    return changed


def man_db_mtime():
    stamps = []
    for d in ("/usr/share/man", "/usr/local/share/man", os.path.join(HOME, ".local/share/man")):
        p = os.path.join(d, "mandoc.db")
        if os.path.exists(p):
            stamps.append(os.path.getmtime(p))
    return max(stamps) if stamps else 0


def index_man(db, full):
    """Every man page's names and one line, from apropos (makewhatis's index)."""
    stamp = str(man_db_mtime())
    if not full and meta(db, "man-stamp") == stamp:
        return 0
    r = subprocess.run(["apropos", "."], capture_output=True, text=True,
                       env=dict(os.environ, MANPATH=os.environ.get("MANPATH") or
                                f"{HOME}/.local/share/man:/usr/local/share/man:/usr/share/man"))
    drop_source(db, "man")
    n = 0
    for line in r.stdout.splitlines():
        m = re.match(r"^(.+?)\(([^)]+)\)\s+-\s+(.*)$", line)
        if not m:
            continue
        names = [x.strip() for x in m.group(1).split(",") if x.strip()]
        section = m.group(2).split(",")[0].strip()
        desc = m.group(3).strip()
        name = names[0]
        doc_id = f"man:{name}({section})"
        put(db, {"id": doc_id, "source": "man", "kind": "man", "title": f"{name}({section}) — {desc}",
                 "path": f"{section} {name}", "excerpt": desc, "mtime": 0}, " ".join(names) + " " + desc)
        n += 1
    meta(db, "man-stamp", stamp)
    return n


def index_info(db, full):
    """Each Info manual, from the directories' dir files."""
    dirs = [d for d in (os.path.join(HOME, ".local/share/info"), "/usr/local/share/info", "/usr/share/info")
            if os.path.exists(os.path.join(d, "dir"))]
    stamp = str(max((os.path.getmtime(os.path.join(d, "dir")) for d in dirs), default=0))
    if not full and meta(db, "info-stamp") == stamp:
        return 0
    drop_source(db, "info")
    n = 0
    for d in dirs:
        text = read_text(os.path.join(d, "dir"))
        for m in re.finditer(r"^\* ([^:]+): \(([^)]+)\)([^.]*)\.\s*(.*(?:\n {10,}.*)*)", text, re.M):
            name, manual, node, desc = m.group(1).strip(), m.group(2), m.group(3).strip() or "Top", " ".join(m.group(4).split())
            doc_id = f"info:({manual}){node}"
            if db.execute("SELECT 1 FROM docs WHERE id = ?", (doc_id,)).fetchone():
                continue
            put(db, {"id": doc_id, "source": "info", "kind": "info", "title": f"{name} — {desc}" if desc else name,
                     "path": f"({manual}){node}", "excerpt": desc, "mtime": 0}, f"{name} {manual} {desc}")
            n += 1
    meta(db, "info-stamp", stamp)
    return n


def xbps_stamp():
    """When the packages (installed, or in the repositories) last changed."""
    stamps = [os.path.getmtime(p) for p in glob.glob("/var/db/xbps/pkgdb-*.plist") +
              glob.glob("/var/db/xbps/*/*-repodata")]
    return str(max(stamps, default=0))


def index_pkg(db, full):
    """Every package there is, installed or not, with its one line."""
    stamp = xbps_stamp()
    if not full and meta(db, "pkg-stamp") == stamp:
        return 0
    if not shutil.which("xbps-query"):
        return 0
    r = subprocess.run(["xbps-query", "-Rs", ""], capture_output=True, text=True)
    drop_source(db, "pkg")
    n = 0
    for line in r.stdout.splitlines():
        m = re.match(r"^\[(.)\] (\S+?)-([^-\s]+_\d+)\s+(.*)$", line)
        if not m:
            continue
        installed, name, version, desc = m.group(1) == "*", m.group(2), m.group(3), m.group(4).strip()
        put(db, {"id": f"pkg:{name}", "source": "pkg", "kind": "installed" if installed else "package",
                 "title": f"{name} — {desc}" + ("  (installed)" if installed else ""),
                 "path": name, "excerpt": f"{version}", "mtime": 0}, f"{name} {desc}")
        n += 1
    meta(db, "pkg-stamp", stamp)
    return n


def index_pkgdoc(db, full):
    """The READMEs and notes packages put in /usr/share/doc: their names and
    first lines (bodies, mostly changelogs, would bury everything else)."""
    stamp = xbps_stamp()
    if not full and meta(db, "pkgdoc-stamp") == stamp:
        return 0
    drop_source(db, "pkgdoc")
    n = 0
    for pkg in sorted(os.listdir(PKGDOC)) if os.path.isdir(PKGDOC) else []:
        # The package's own folder only: below it are whole HTML manuals
        # (ImageMagick's alone has thousands of pages), which bury the rest.
        top = os.path.join(PKGDOC, pkg)
        if not os.path.isdir(top):
            continue
        for f in sorted(os.listdir(top)):
            path = os.path.join(top, f)
            if not os.path.isfile(path) or not PKGDOC_FILES.search(f):
                continue
            if f.lower().endswith((".html", ".htm")) and f.lower() not in ("index.html", "index.htm"):
                continue
            head = read_text(path)[:2000]
            plain = md_plain(re.sub(r"<[^>]+>", " ", head))
            body = read_text(path) if f.lower().startswith("readme") else plain
            put(db, {"id": f"pkgdoc:{path}", "source": "pkgdoc", "kind": "doc", "title": f"{pkg}: {f}",
                     "path": path, "excerpt": excerpt(plain), "mtime": 0}, f"{pkg} {body}")
            n += 1
    meta(db, "pkgdoc-stamp", stamp)
    return n


def index(full=False, quiet=False):
    t0 = time.time()
    db = connect()
    counts = {}
    with db:
        counts["vikix"] = index_files(db, "vikix", files_vikix(), md_title, md_plain, full)
        counts["repo"] = index_files(db, "repo", files_repo(), md_title, md_plain, full)
        counts["dev"] = index_files(db, "dev", files_dev(), md_title, md_plain, full)
        counts["note"] = index_files(db, "note", files_note(), org_title, org_plain, full)
        counts["own"] = index_own(db, full)
        # VIKIX_DOCS_SOURCES limits what's read (the tests leave the system's out).
        only = os.environ.get("VIKIX_DOCS_SOURCES", "man info tldr arch pkg pkgdoc").split()
        if "man" in only:
            counts["man"] = index_man(db, full)
        if "info" in only:
            counts["info"] = index_info(db, full)
        if "tldr" in only:
            counts["tldr"] = index_files(db, "tldr", files_tldr(), tldr_title, html_plain, full)
        if "arch" in only:
            counts["arch"] = index_files(db, "arch", files_arch(), arch_title, arch_plain, full)
        if "pkg" in only:
            counts["pkg"] = index_pkg(db, full)
        if "pkgdoc" in only:
            counts["pkgdoc"] = index_pkgdoc(db, full)
        meta(db, "indexed", int(time.time()))
    if not quiet:
        read = ", ".join(f"{n} {s}" for s, n in counts.items() if n)
        print(f"Read {read or 'nothing new'} in {time.time() - t0:.1f} s.")
    return counts


def fresh_enough():
    """Read again what changed, when the catalogue is more than a day old."""
    try:
        db = connect()
        last = int(meta(db, "indexed") or 0)
        db.close()
    except sqlite3.Error:
        last = 0
    if time.time() - last > STALE:
        index(quiet=True)


# --- Searching ------------------------------------------------------------------------------

def fts_query(words):
    """Words as in a search box: each the start of a word, "exact words", OR."""
    out = []
    for tok in re.findall(r'"[^"]+"|\S+', " ".join(words)):
        if tok.startswith('"'):
            inner = re.sub(r"[^\w\s]", " ", tok[1:-1]).strip()
            if inner:
                out.append(f'"{inner}"')
        elif tok == "OR":
            out.append("OR")
        else:
            parts = [p for p in re.split(r"[^\w]+", tok) if p]
            out += [f'"{p}"*' for p in parts]
    while out and out[0] == "OR":
        out.pop(0)
    while out and out[-1] == "OR":
        out.pop()
    return " ".join(out)


def find(words, source=None, limit=20):
    q = fts_query(words)
    if not q:
        return []
    db = connect()
    cases = " ".join(f"WHEN '{s}' THEN {b}" for s, b in BOOST.items())
    # The document named by the words themselves comes first: "tar" is
    # tar's own pages (tldr's, man's, the package) before everything that
    # mentions tar, or starts with it (target, tarball), however often.
    name = re.sub(r"\s+", " ", " ".join(words).replace('"', "")).strip().lower()
    like = name.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
    named = ("(lower(d.title) = ? OR lower(d.title) LIKE ? ESCAPE '\\' OR lower(d.title) LIKE ? ESCAPE '\\'"
             " OR lower(d.title) LIKE ? ESCAPE '\\')")
    sql = (f"SELECT d.id, d.source, d.kind, d.title, d.path, d.excerpt, "
           f"bm25(docs_fts, 10.0, 1.0) * (CASE d.source {cases} ELSE 1 END) "
           f"* (CASE WHEN {named} THEN 2 ELSE 1 END) AS score "
           f"FROM docs_fts JOIN docs d ON d.rid = docs_fts.rowid WHERE docs_fts MATCH ?")
    args = [name, like + " — %", like + "(%", like + ": %", q]
    if source:
        sql += " AND d.source = ?"
        args.append(source)
    sql += " ORDER BY score LIMIT ?"
    args.append(limit)
    try:
        rows = db.execute(sql, args).fetchall()
    except sqlite3.OperationalError:
        return []
    keys = ("id", "source", "kind", "title", "path", "excerpt")
    return [dict(zip(keys, r[:6])) for r in rows]


def get(doc_id):
    db = connect()
    r = db.execute("SELECT id, source, kind, title, path, excerpt FROM docs WHERE id = ?", (doc_id,)).fetchone()
    return dict(zip(("id", "source", "kind", "title", "path", "excerpt"), r)) if r else None


# --- Reading and opening --------------------------------------------------------------------

def man_args(doc):
    section, name = doc["path"].split(" ", 1)
    return section, name


def read(doc):
    """A document as plain text."""
    if doc["source"] == "man":
        section, name = man_args(doc)
        r = subprocess.run(["man", section, name], capture_output=True, text=True,
                           env=dict(os.environ, MANPAGER="cat", PAGER="cat", MANWIDTH="80"))
        return re.sub(r".\x08", "", r.stdout)
    if doc["source"] == "info":
        r = subprocess.run(["info", "-o", "-", doc["path"]], capture_output=True, text=True)
        return r.stdout
    if doc["source"] == "pkg":
        r = subprocess.run(["xbps-query", "-R", "-S", doc["path"]], capture_output=True, text=True)
        return r.stdout or doc["title"]
    if doc["source"] == "tldr":
        return tldr_text(doc["path"])
    if doc["source"] == "arch":
        return arch_plain(read_text(doc["path"]))
    if doc["source"] == "own":
        return own_text(doc)
    return read_text(doc["path"])


def own_split(doc):
    """(file, heading or id) of a document of yours: the whole file when it has no section."""
    path, _, anchor = doc["path"].partition("#")
    return path, anchor


def own_text(doc):
    """A document of yours as text: the section alone when it is one."""
    path, anchor = own_split(doc)
    text = read_text(path)
    if not anchor:
        return html_plain(text) if path.endswith(".html") else text
    if path.endswith(".html"):
        for heading, hid, body in html_sections(text):
            if hid == anchor:
                return heading + "\n\n" + html_plain(body)
    else:
        for heading, depth, body in md_sections(text):
            if heading == anchor:
                return "#" * depth + " " + heading + "\n" + body
    return html_plain(text) if path.endswith(".html") else text


def html_id_of(page, heading):
    """The id of the heading HEADING in the page PAGE (a file), as the
    renderer wrote it, or None: matched by the heading's words, so no rule
    of pandoc's has to be known."""
    want = re.sub(r"\s+", " ", re.sub(r"[`*_]", "", heading)).strip().lower()
    for m in re.finditer(r'(?is)<h[1-6]\b[^>]*\bid="([^"]+)"[^>]*>(.*?)</h[1-6]>', read_text(page)):
        if re.sub(r"\s+", " ", html_plain(m.group(2))).strip().lower() == want:
            return m.group(1)
    return None


def own_page(doc):
    """A document of yours as a page to open: its file (HTML), or the
    rendered Markdown, at its section when it has one."""
    path, anchor = own_split(doc)
    if path.endswith(".html"):
        page = path
    else:
        page = md_html(path, doc["title"])
        if page and anchor:
            anchor = html_id_of(page, anchor) or ""
    if not page:
        return None
    return "file://" + page + (f"#{anchor}" if anchor else "")


def guide_page(path):
    """The built HTML page of a guide (~/.local/share/vikix/guide), by its title."""
    guide = os.path.join(DATA, "guide")
    title = md_title(read_text(path), path)
    want = re.sub(r"[^\w]+", "-", title).strip("-").lower()
    for f in glob.glob(os.path.join(guide, "*.html")):
        if re.sub(r"[^\w]+", "-", os.path.basename(f)[:-5]).strip("-").lower() == want:
            return f
    return None


def man_html(doc):
    """A man page as a page styled as the guide is, cached."""
    section, name = man_args(doc)
    out = os.path.join(CACHE, "man", f"{name}.{section}.html")
    if os.path.exists(out):
        return out
    src = subprocess.run(["man", "-w", section, name], capture_output=True, text=True).stdout.strip().splitlines()
    if not src or not shutil.which("mandoc"):
        return None
    css = os.path.join(vikix_dir(), "docs", "guide.css")
    r = subprocess.run(["mandoc", "-Thtml", f"-Ostyle=file://{css}", src[0]], capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout:
        return None
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w") as f:
        f.write(r.stdout)
    return out


def md_html(path, title):
    """A Markdown file as a page styled as the guide is (pandoc, else Python's
    markdown), cached; None when neither is here."""
    key = hashlib.sha1(f"{path}:{os.path.getmtime(path)}".encode()).hexdigest()[:16]
    out = os.path.join(CACHE, "md", f"{key}.html")
    if os.path.exists(out):
        return out
    css = "file://" + os.path.join(vikix_dir(), "docs", "guide.css")
    base = "file://" + os.path.dirname(os.path.abspath(path)) + "/"
    text = read_text(path)
    body = None
    if shutil.which("pandoc"):
        r = subprocess.run(["pandoc", "-f", "gfm", "-t", "html5"], input=text, capture_output=True, text=True)
        body = r.stdout if r.returncode == 0 else None
    if body is None:
        try:
            import markdown
            body = markdown.markdown(text, extensions=["tables", "fenced_code"])
        except ImportError:
            return None
    page = (f'<!doctype html><html><head><meta charset="utf-8"><base href="{html.escape(base)}">'
            f'<title>{html.escape(title)}</title><link rel="stylesheet" href="{css}"></head>'
            f'<body><p class="vikix-docs-from">{html.escape(path)}</p>{body}</body></html>')
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w") as f:
        f.write(page)
    return out


def tldr_html(doc):
    """A tldr page (bare HTML as wikiman keeps it) as a page styled as the
    guide is, saying when the copy is from; cached."""
    path = doc["path"]
    key = hashlib.sha1(f"{path}:{os.path.getmtime(path)}".encode()).hexdigest()[:16]
    out = os.path.join(CACHE, "tldr", f"{key}.html")
    if os.path.exists(out):
        return out
    css = "file://" + os.path.join(vikix_dir(), "docs", "guide.css")
    body = re.sub(r"(?is)^.*?<body[^>]*>|</body>.*$", "", read_text(path))
    when = time.strftime("%Y-%m-%d", time.localtime(os.path.getmtime(path)))
    page = (f'<!doctype html><html><head><meta charset="utf-8"><title>{html.escape(doc["title"])}</title>'
            f'<link rel="stylesheet" href="{css}"></head>'
            f'<body><p class="vikix-docs-from">{html.escape(path)}, the copy of {when}</p>{body}</body></html>')
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w") as f:
        f.write(page)
    return out


def tldr_text(path):
    """A tldr page as text: what the command is, then each example's words
    and, set in, its command."""
    text = read_text(path)
    text = re.sub(r"(?is)<(script|style)[^>]*>.*?</\1>", " ", text)
    text = re.sub(r"(?i)<p>\s*<code>(.*?)</code>\s*</p>", lambda m: "    " + m.group(1), text)
    text = re.sub(r"(?i)</(h1|p|li|blockquote)>", "\n", text)
    text = re.sub(r"(?i)<li>", "- ", text)
    text = re.sub(r"(?i)</?code>", "`", text)
    text = re.sub(r"<[^>]+>", "", text)
    text = "\n".join(line.rstrip() for line in html.unescape(text).splitlines())
    return re.sub(r"\n{3,}", "\n\n", text).strip() + "\n"


def arch_url(doc):
    """The page as it is today, on wiki.archlinux.org (the copy's name is its title)."""
    name = os.path.basename(doc["path"])[:-5]
    return "https://wiki.archlinux.org/title/" + urllib.parse.quote(name, safe="()_,.-:")


def pkg_card(doc):
    """A package as a short page: what it is, installed or not, its website."""
    name = doc["path"]
    info = subprocess.run(["xbps-query", "-R", "-S", name], capture_output=True, text=True).stdout
    fields = dict(re.findall(r"^(\w[\w-]*): (.*)$", info, re.M))
    installed = doc["kind"] == "installed"
    home = fields.get("homepage", "")
    css = "file://" + os.path.join(vikix_dir(), "docs", "guide.css")
    labels = (("pkgver", "Version"), ("license", "Licence"), ("installed_size", "Size, installed"),
              ("maintainer", "Looked after by"))
    rows = "".join(f"<tr><th>{label}</th><td>{html.escape(fields[k])}</td></tr>" for k, label in labels if k in fields)
    page = (f'<!doctype html><html><head><meta charset="utf-8"><title>{html.escape(name)}</title>'
            f'<link rel="stylesheet" href="{css}"></head><body><h1>{html.escape(name)}</h1>'
            f'<p>{html.escape(fields.get("short_desc", doc["title"]))}</p>'
            f'<p><b>{"Installed." if installed else "Not installed."}</b> '
            f'{"" if installed else f"To install it: <code>vikix pkg add {html.escape(name)}</code>"}</p>'
            f'<table>{rows}</table>'
            + (f'<p>Its website (on the web, not this machine): <a href="{html.escape(home)}">{html.escape(home)}</a></p>'
               if home else "") + "</body></html>")
    out = os.path.join(CACHE, "pkg", f"{name}.html")
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w") as f:
        f.write(page)
    return out


def terminal(argv):
    term = (os.environ.get("VIKIX_TERMINAL") or "alacritty").split()
    subprocess.Popen(["setsid", "-f", *term, "-e", *argv], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def emacs(args):
    if shutil.which("emacsclient"):
        subprocess.Popen(["emacsclient", "-c", "-n", *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    return False


def docs_open(paths):
    # VIKIX_DOCS_OPEN: another opener (the tests' stand-in).
    opener = os.environ.get("VIKIX_DOCS_OPEN") or os.path.join(vikix_dir(), "bin", "vikix-docs-open")
    subprocess.Popen([opener, *paths],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def note_opened(doc):
    """A line for `vikix day`, which lists the documents opened each day:
    when, which, its title. Yours alone (600); never a reason to fail."""
    try:
        state = os.environ.get("VIKIX_STATE") or os.path.join(os.path.expanduser("~"), ".local", "state", "vikix")
        os.makedirs(os.path.join(state, "day"), exist_ok=True)
        fd = os.open(os.path.join(state, "day", "docs.log"), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as out:
            title = " ".join(str(doc.get("title") or doc.get("id") or "").split())
            out.write(f"{int(time.time())}\t{doc.get('id', '')}\t{title}\n")
    except OSError:
        pass


def open_doc(doc, other=False):
    note_opened(doc)
    src = doc["source"]
    if src == "man":
        section, name = man_args(doc)
        page = None if other else man_html(doc)
        if page:
            docs_open([page])
        else:
            terminal(["man", section, name])
    elif src == "info":
        if other or not emacs(["-e", f'(info "{doc["path"]}")']):
            terminal(["info", doc["path"]])
    elif src == "pkg":
        if other:
            terminal(["sh", "-c", f"xbps-query -R -S {doc['path']} | less"])
        else:
            docs_open([pkg_card(doc)])
    elif src == "tldr":
        if other:
            # tealdeer's own showing when it has its cache (tldr --update);
            # else the page's words, from the copy.
            name = os.path.basename(doc["path"])[:-5]
            txt = os.path.join(CACHE, "tldr", f"{name}.txt")
            os.makedirs(os.path.dirname(txt), exist_ok=True)
            with open(txt, "w") as f:
                f.write(tldr_text(doc["path"]))
            terminal(["sh", "-c", f"tldr {shlex.quote(name)} 2>/dev/null || less {shlex.quote(txt)}"])
        else:
            docs_open([tldr_html(doc)])
    elif src == "arch":
        if other:
            subprocess.Popen(["xdg-open", arch_url(doc)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            docs_open([doc["path"]])
    elif src == "own" and not other:
        page = own_page(doc)
        if page:
            docs_open([page])
        else:
            emacs([own_split(doc)[0]])
    elif src == "note" or other:
        path = own_split(doc)[0] if src == "own" else doc["path"]
        if not emacs([path]):
            docs_open([path])
    else:
        # A guide as its own built page; any Markdown as a page styled as
        # the guide; an HTML or text file as it is.
        page = guide_page(doc["path"]) if src == "vikix" else None
        if not page and doc["path"].endswith(".md"):
            page = md_html(doc["path"], doc["title"])
        docs_open([page or doc["path"]])


def hit_line(h):
    ex = h["excerpt"] if h["source"] in ("man", "info") else ""
    title = h["title"] if not ex or ex in h["title"] else f"{h['title']} — {ex}"
    return f"{BADGE.get(h['source'], h['source']):<5}  {title[:160]}"


def nyxt_listens(sock):
    """Whether a Nyxt answers on its socket. Asked of the socket itself: with
    none running `nyxt --remote` exits 0 all the same, and says so on the
    terminal it finds (/dev/tty: from the desktop's menu the login's, never
    our pipe), so its words can't be gone by."""
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(2)
    try:
        s.connect(sock)
        return True
    except OSError:
        return False
    finally:
        s.close()


def window_pids():
    """The processes owning the windows the window manager has, on every
    workspace (_NET_CLIENT_LIST, then each one's _NET_WM_PID)."""
    r = subprocess.run(["xprop", "-root", "_NET_CLIENT_LIST"], capture_output=True, text=True)
    pids = set()
    for wid in re.findall(r"0x[0-9a-fA-F]+", r.stdout):
        w = subprocess.run(["xprop", "-id", wid, "_NET_WM_PID"], capture_output=True, text=True)
        m = re.search(r"= (\d+)", w.stdout)
        if m:
            pids.add(int(m.group(1)))
    return pids


def stuck_nyxts():
    """Your Nyxts on this screen whose socket would be ours, now gone: the
    ones without a window (stuck: closing the last window can leave Nyxt
    running with nothing open, and no other Nyxt can reach it), and the ones
    still with windows (in use, only unreachable)."""
    r = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "nyxt"], capture_output=True, text=True)
    mine = []
    for pid in map(int, r.stdout.split()):
        try:
            with open(f"/proc/{pid}/environ", "rb") as f:
                env = dict(kv.split(b"=", 1) for kv in f.read().split(b"\0") if b"=" in kv)
        except OSError:
            continue
        same = all(env.get(k.encode(), b"").decode(errors="replace") == os.environ.get(k, "")
                   for k in ("DISPLAY", "XDG_RUNTIME_DIR"))
        if same:
            mine.append(pid)
    if not mine:
        return [], []
    shown = window_pids()
    return [p for p in mine if p not in shown], [p for p in mine if p in shown]


def stop_stuck_nyxt():
    """Close a Nyxt that can't answer and has nothing open, and say so; one
    that still has windows is the user's to close."""
    stuck, open_ = stuck_nyxts()
    for pid in stuck:
        for sig, wait in ((signal.SIGTERM, 3), (signal.SIGKILL, 1)):
            try:
                os.kill(pid, sig)
            except ProcessLookupError:
                break
            for _ in range(wait * 10):
                if not os.path.exists(f"/proc/{pid}"):
                    break
                time.sleep(0.1)
            if not os.path.exists(f"/proc/{pid}"):
                break
    if stuck:
        subprocess.run(["notify-send", "-a", "Docs", "A stuck Nyxt was closed",
                        "It had no window open and wasn't answering; a new one opens."])
    elif open_:
        subprocess.run(["notify-send", "-a", "Docs", "Nyxt isn't answering",
                        "The one open can't be reached (its socket is gone), so a second one opens. "
                        "Close the old one to have one again."])


def page(query):
    """The catalogue as a page in Nyxt (started first when it isn't running)."""
    if not shutil.which("nyxt"):
        die("the page is Nyxt's (vikix add lisp-apps); without it, Super+F2 or vikix docs find")
    form = f"(nyxt-user::vikix-docs-show {json.dumps(query)})"
    sock = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "nyxt", "nyxt.socket")
    def ask():
        try:
            r = subprocess.run(["nyxt", "--remote", "--quit", "--eval", form],
                               capture_output=True, text=True, timeout=20)
        except subprocess.TimeoutExpired:
            return False
        return r.returncode == 0
    if not (nyxt_listens(sock) and ask()):
        # Started with the page's address: Nyxt opens it after putting your
        # last session back, so it ends up in front. (Asked by --eval
        # instead, the page came first and the restored buffers covered it.)
        # A running Nyxt that didn't take the form takes the address.
        url = "nyxt:nyxt-user::vikix-docs-page?query=" + urllib.parse.quote(query, safe="")
        if not nyxt_listens(sock):
            stop_stuck_nyxt()
        nyxt = subprocess.Popen(["nyxt", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                start_new_session=True)
        for _ in range(60):
            if nyxt_listens(sock) or nyxt.poll() is not None:
                break
            time.sleep(0.5)
        if not nyxt_listens(sock):
            die("Nyxt didn't start (run nyxt in a terminal to see why)")
    # StumpWM brings Nyxt's window forward (vikix-docs-open does the same).
    subprocess.run(["vikix", "eval", '(vikix-raise-class "Nyxt")'], capture_output=True)
    return 0


def pick():
    fresh_enough()
    r = subprocess.run(["rofi", "-dmenu", "-p", "docs", "-l", "0", "-mesg",
                        "Words to find: Vikix's guides, your projects and notes, man and tldr pages, manuals, the ArchWiki"],
                       input="", capture_output=True, text=True)
    words = r.stdout.strip()
    if r.returncode != 0 or not words:
        return 0
    hits = find(words.split(), limit=40)
    if not hits:
        subprocess.run(["notify-send", "-a", "Docs", "Nothing found", f"for: {words}"])
        return 0
    # Ctrl+Enter is rofi's own (kb-accept-custom): freed first, or rofi
    # refuses to start ("already bound").
    r = subprocess.run(["rofi", "-dmenu", "-i", "-p", words, "-format", "i",
                        "-kb-accept-custom", "", "-kb-custom-1", "Control+Return",
                        "-mesg", "Enter opens it · Ctrl+Enter opens it the other way (a terminal, Emacs)"],
                       input="\n".join(hit_line(h) for h in hits), capture_output=True, text=True)
    if r.stdout.strip().isdigit() and r.returncode in (0, 10):
        open_doc(hits[int(r.stdout.strip())], other=r.returncode == 10)
    return 0


# --- Commands -------------------------------------------------------------------------------

def status():
    db = connect()
    rows = db.execute("SELECT source, count(*) FROM docs GROUP BY source ORDER BY count(*) DESC").fetchall()
    last = meta(db, "indexed")
    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(int(last))) if last else "never"
    print(f"{DB}  ({os.path.getsize(DB) / 1e6:.1f} MB), last read {when}")
    for s, n in rows:
        print(f"  {s:<6} {n:>6}")
    if not rows:
        print("  empty: vikix docs index")


def listing(source=None):
    db = connect()
    if not source:
        for s_, n in db.execute("SELECT source, count(*) FROM docs GROUP BY source ORDER BY count(*) DESC"):
            print(f"{s_}\t{n}")
        return
    for id_, title in db.execute("SELECT id, title FROM docs WHERE source = ? ORDER BY title COLLATE NOCASE",
                                 (source,)):
        print("\t".join([id_, source, " ".join(title.split()), ""]))


def main(argv):
    cmd = argv[0] if argv else ""
    args = argv[1:]
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
    elif cmd == "get":
        # The download of the offline docs, which plain `vikix docs` was.
        return subprocess.call(["bash", os.path.join(vikix_dir(), "install", "67-dev.sh")],
                               env=dict(os.environ, VIKIX_DOCS="1"))
    elif cmd == "":
        status()
        print("\nvikix docs find WORDS to search; vikix docs get for the offline programming docs "
              "(what plain vikix docs did before).")
    elif cmd == "find":
        as_json, as_tsv = "--json" in args, "--tsv" in args
        source, limit, words = None, 20, []
        it = iter(args)
        for a in it:
            if a in ("--json", "--tsv"):
                continue
            elif a == "--source":
                source = next(it, None)
            elif a == "--limit":
                limit = int(next(it, "20"))
            else:
                words.append(a)
        if not words:
            die("find what? vikix docs find WORDS")
        fresh_enough()
        hits = find(words, source, limit)
        if as_json:
            print(json.dumps(hits, ensure_ascii=False, indent=1))
        elif as_tsv:
            for h in hits:
                print("\t".join(" ".join(str(h[k]).split()) for k in ("id", "source", "title", "excerpt")))
        elif not hits:
            print("nothing found")
        else:
            for h in hits:
                print(hit_line(h))
                print(f"       {h['id']}")
    elif cmd == "list":
        listing(args[args.index("--source") + 1] if "--source" in args[:-1] else None)
    elif cmd == "pick":
        return pick()
    elif cmd == "page":
        return page(" ".join(args))
    elif cmd in ("open", "read"):
        if not args:
            die(f"{cmd} which? the id vikix docs find shows")
        doc = get(args[0])
        if not doc:
            die(f"no document {args[0]} (vikix docs find WORDS shows the ids)")
        if doc["source"] not in ("man", "info", "pkg") and not os.path.exists(own_split(doc)[0]):
            die(f"{doc['path']} is gone since the last index (vikix docs index catches up)")
        if cmd == "read":
            print(read(doc))
        else:
            open_doc(doc, other="--other" in args)
    elif cmd == "index":
        index(full="--full" in args, quiet="--quiet" in args)
    elif cmd == "status":
        status()
    else:
        die(f"no command {cmd} (vikix docs help)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
