#!/usr/bin/env python3
"""vikix-docs — every document on the machine in one catalogue, found from one key.

  vikix docs find WORDS... [--source S] [--limit N] [--json|--tsv]
                                  the documents that match, best first: words
                                  as in a search box (the start of a word is
                                  enough), "exact words", a OR b
  vikix docs page [WORDS...]      the catalogue as a page in Nyxt (when you
                                  have it): the hits by where they're from,
                                  each with buttons to open it either way
  vikix docs pick                 a search box, then the hits to open
                                  (Super+F2): Enter opens it, Ctrl+Enter in
                                  the other place (a terminal for a man page,
                                  Emacs for a page of Markdown)
  vikix docs open ID [--other]    open one, by the id find shows
  vikix docs random [--other]    one of Vikix's guides at random, as open
                                  opens it; every page once before any twice
  vikix docs read ID              one as plain text (what the agents read)
  vikix docs ask QUESTION... [--source S]... [--claude|--local] [--model M] [--limit N] [--show]
                                  a question answered from the documents
                                  found for it, which the answer names:
                                  Vikix's guides, your projects, ~/dev and
                                  your notes unless --source says which
                                  (own, man, all...; once each, or commas);
                                  a local model (Ollama) unless --claude,
                                  which sends the passages found to
                                  Anthropic and says so; --show prints what
                                  would be sent instead
  vikix docs index [--full] [--quiet]
                                  read again what changed (--full: all of
                                  it); vikix update does it
  vikix docs watch on|off|status  one inotifywait on ~/src, so a document
                                  that changes there is read within a
                                  second (until off, or the session ends)
  vikix docs status               how many from where, and when last read
  vikix docs list [--source S]    how many from each source, a line each
                                  (source, count, tab between); with
                                  --source, its documents by title, as
                                  find --tsv prints them
  vikix docs get                  download the offline programming docs
                                  into ~/dev (a few GB, slow; what plain
                                  vikix docs did before)

What it covers, each with whose words they are: Vikix's guides (vikix);
the README, DESIGN, TODO, CLAUDE and log files, plans/ and docs/ of your
projects in ~/src (repo); the language guides in ~/dev (dev); your Org notes in
~/Dropbox/notes (note); your own documents, the folders you name (own,
below); the classes of the Cuis Smalltalk image (cuis: a row a package and
a row a class, its comment and its method categories, read from the
package files, Vikix's in the checkout, yours in ~/cuis/NewPackages and
Cuis's own in ~/cuis/Packages, when Cuis is installed); every man page
(man) and Info manual (info) on the machine; the tldr pages (tldr: a
command's worked examples, where a man page has its options) and the
ArchWiki (arch), the English pages of each as wikiman keeps them in
/usr/share/doc, when they're there; the READMEs, notes and PDFs packages
keep in /usr/share/doc (doc); every package there is, installed or not
(pkg); the entries of Zeal's docsets (zeal: a function, a class, a method
by name, read in place from each docset's own index, nothing copied); and
links to the web (web: the websites of the packages installed, the links
the language guides in ~/dev list, and your own in ~/.config/vikix/docs-links,
a URL and its title a line). A web hit wears a globe: it is the one kind
that opens on the web, and nothing of it is ever fetched, not when the
catalogue is read, not when it is searched. Vikix's guides rank first,
then yours, then tldr with the man pages, then the rest of the system's;
a docset's entry named by words written as code (str.split, read_dir) stands
with the documents named by them, and a plain word (keyboard, split) keeps
the catalogue's own hits first, the docsets' entries after.

A PDF (in a project's docs/ or at its top, in /usr/share/doc, or in a
folder of yours by a *.pdf pattern) is read by the text it carries, its
first twenty pages (pdftotext, from poppler-utils; without it a PDF is
listed by its name, saying so), a row for the whole and a row a page, so a
hit opens at its page (zathura, evince or mupdf take a page; another viewer
opens the file). A scanned PDF with no text is listed by its name alone.

It reads again by itself what changed, when a search finds the catalogue
more than a day old (a few seconds); vikix update reads the man pages and
manuals again; vikix docs watch on reads a document of ~/src the moment it
changes. A man page, a tldr page or a Markdown file opens as a page
in the docs browser, styled as the guide is (made by mandoc and pandoc,
cached in ~/.cache/vikix/docs/); an ArchWiki page as the copy is; a package
as a short page (installed or not, how to add it, its website); an Info
manual and your notes in Emacs; a Cuis class in a Browser in the running
image, through its door (vikix eval --cuis), or its package file in Emacs
at the class when Cuis isn't running; a docset's entry as its page in the
docs browser, at the entry, or in Zeal when the docset keeps its pages
compressed; a web link in your default browser. Ctrl+Enter (or --other)
opens the other way: Emacs, or a terminal; an ArchWiki page as it is today,
on the web; a docset's entry in Zeal; a PDF's text in a terminal.
vikix docs random opens a guide page at random, every one before any twice.

vikix docs ask answers a question from the documents it finds for it (the
words they share), a local model by default, so nothing leaves the laptop
unless --claude is said; the answer ends with the documents it drew on, by
id. Under an agent, your own documents (own) stay closed to it as they are
to docs_search, unless a folder is opened with agents=. The web's links
are never read for an answer, and a docset's entries are found by name,
not asked.

Your own documents (own) are the folders named in ~/.config/vikix/docs,
yours to make, a line each: own=~/books (every Markdown file under it), or
own=~/books one/*.md two/out/*.html (those files, as patterns from that
folder; HTML pages only when asked for). Unlike the other sources they are
read a section at a time (a Markdown heading, an HTML heading with an id
or a data-at tag),
so a search lands on the section, and so does a chapter a page of vikix
what names. They open in the docs browser at that section, styled as the
guide is, or in Emacs. They are closed to agents: docs_search and
docs_read leave them out, unless a line agents=~/books opens that folder
to them. The same file names the folders of your own pages for vikix what
(what=FOLDER; vikix what help says what a page is).

The catalogue is one SQLite file, ~/.local/share/vikix/docs/index.db: table
docs (id, source, kind, title, path, excerpt, mtime) and docs_fts, its
full-text index. Nothing in it leaves the machine.
"""
import fcntl
import glob
import hashlib
import html
import json
import os
import random
import re
import shlex
import shutil
import signal
import socket
import sqlite3
import subprocess
import sys
import time
import urllib.parse

HOME = os.path.expanduser("~")
# The checkout this runs from (vikix mcp loads it without a __file__).
HERE = os.path.dirname(os.path.dirname(os.path.realpath(
    globals().get("__file__") or os.path.join(os.environ.get("VIKIX_DIR", os.path.expanduser("~/vikix")), "bin", "vikix-docs"))))
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share"), "vikix")
DB = os.environ.get("VIKIX_DOCS_DB") or os.path.join(DATA, "docs", "index.db")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "vikix", "docs")
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
SRC = os.environ.get("VIKIX_DOCS_SRC") or os.path.join(HOME, "src")
DEV = os.environ.get("VIKIX_DOCS_DEV") or os.path.join(HOME, "dev")
STALE = 24 * 3600                       # a search reads again what changed, after a day
BODY = 200_000                          # characters of a document indexed
BOOST = {"vikix": 3.0, "own": 2.5, "repo": 2.0, "dev": 2.0, "note": 2.0, "cuis": 1.2, "tldr": 1.1, "man": 1.0, "info": 1.0,
         "arch": 0.95, "pkgdoc": 0.9, "web": 0.85, "pkg": 0.8}
BADGE = {"vikix": "vikix", "own": "yours", "repo": "repo", "dev": "dev", "note": "note", "cuis": "cuis", "man": "man",
         "info": "info", "tldr": "tldr", "arch": "arch", "pkgdoc": "doc", "pkg": "pkg", "zeal": "zeal", "web": "web"}
# Zeal's docsets (vikix docs get puts them here; ~/dev/docsets links to it):
# read in place through each one's docSet.dsidx at every search, never copied.
ZEAL = os.environ.get("VIKIX_DOCS_ZEAL") or os.path.join(os.path.dirname(DATA), "Zeal", "Zeal", "docsets")
ZEAL_SHARE = 4            # a search keeps a quarter of its list for the docsets' entries, when they have any
LINKS_FILE = os.path.join(CONFIG, "vikix", "docs-links")   # your own links: a URL and its title a line
PDF_PAGES = 20            # pages of a PDF read: a 400-page manual costs seconds, not minutes
PDFTOTEXT = os.environ.get("VIKIX_DOCS_PDFTOTEXT") or "pdftotext"   # poppler's; the tests name one that isn't there
PDF_VIEWERS = (("zathura", lambda path, page: ["zathura", f"--page={page}", path]),
               ("evince", lambda path, page: ["evince", "-i", str(page), path]),
               ("mupdf", lambda path, page: ["mupdf", path, str(page)]))
ASK_SOURCES = ("vikix", "repo", "dev", "note")   # what vikix docs ask reads unless told otherwise
ASK_LIMIT = 6             # documents given to the model for a question
ASK_PASSAGE = 3000        # characters of each
CLAUDE_DEFAULT = "claude-sonnet-5"       # as Super+i's (bin/vikix-ask) and note ask's
LOCAL_DEFAULT = "llama3.2:3b"
STOP_WORDS = {"a", "an", "the", "to", "in", "on", "of", "i", "do", "does", "how", "is", "it", "and", "for", "at",
              "by", "what", "my", "can", "with", "are", "be", "this", "that", "from", "or", "when", "where", "why"}
CUIS = os.environ.get("VIKIX_DOCS_CUIS") or os.path.join(HOME, "cuis")   # the user's Cuis folder (vikix cuis setup lays it out)
PKGDOC = "/usr/share/doc"
# wikiman's offline copies (its own download step puts them here; nothing
# refreshes them by itself): the English pages of each.
TLDR = os.environ.get("VIKIX_DOCS_TLDR") or "/usr/share/doc/tldr-pages/en"
ARCH = os.environ.get("VIKIX_DOCS_ARCH") or "/usr/share/doc/arch-wiki/html/en"
PKGDOC_FILES = re.compile(r"^(README|NEWS|CHANGES|ChangeLog|FAQ|INSTALL|USAGE|TODO)|\.(md|txt|html?|rst|pdf)$", re.I)
REPO_FILES = ("README.md", "DESIGN.md", "TODO.md", "CLAUDE.md", "IDEAS.md", "bugs.md", "log.md")


def die(msg):
    sys.exit(f"vikix docs: {msg}")


# --- The catalogue -------------------------------------------------------------------------

def connect():
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    db = sqlite3.connect(DB, timeout=30)
    db.executescript("""
      PRAGMA journal_mode=WAL;
      CREATE TABLE IF NOT EXISTS docs (rid INTEGER PRIMARY KEY, id TEXT UNIQUE, source TEXT, kind TEXT,
                                       title TEXT, path TEXT, excerpt TEXT, mtime REAL);
      -- Its rows are docs' by rowid: found and dropped by it, at once.
      CREATE VIRTUAL TABLE IF NOT EXISTS docs_fts USING fts5(title, body,
                                                             tokenize='unicode61 remove_diacritics 2');
      CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v TEXT);
    """)
    return db


def meta(db, k, v=None):
    if v is None:
        row = db.execute("SELECT v FROM meta WHERE k = ?", (k,)).fetchone()
        return row[0] if row else None
    db.execute("INSERT OR REPLACE INTO meta VALUES (?, ?)", (k, str(v)))


def put(db, doc, body):
    drop(db, doc["id"])
    cur = db.execute("INSERT INTO docs (id, source, kind, title, path, excerpt, mtime) VALUES (?, ?, ?, ?, ?, ?, ?)",
                     (doc["id"], doc["source"], doc["kind"], doc["title"], doc["path"], doc.get("excerpt", ""),
                      doc["mtime"]))
    db.execute("INSERT INTO docs_fts (rowid, title, body) VALUES (?, ?, ?)", (cur.lastrowid, doc["title"], body[:BODY]))


def drop(db, doc_id):
    row = db.execute("SELECT rid FROM docs WHERE id = ?", (doc_id,)).fetchone()
    if row:
        db.execute("DELETE FROM docs_fts WHERE rowid = ?", (row[0],))
        db.execute("DELETE FROM docs WHERE rid = ?", (row[0],))


def drop_source(db, source):
    db.execute("DELETE FROM docs_fts WHERE rowid IN (SELECT rid FROM docs WHERE source = ?)", (source,))
    db.execute("DELETE FROM docs WHERE source = ?", (source,))


def excerpt(text):
    text = re.sub(r"\s+", " ", text).strip()
    return text[:300]


# --- Where documents come from ------------------------------------------------------------

def read_text(path, whole=False):
    """A file's text, as much as is indexed (WHOLE: all of it, for a page
    whose entry may be anywhere in it)."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read() if whole else f.read(BODY)
    except OSError:
        return ""


def md_title(text, path):
    m = re.search(r"^# +(.+)$", text, re.M)
    return m.group(1).strip() if m else os.path.basename(path)


def md_plain(text):
    """Markdown, its marks taken off, for the excerpt."""
    text = re.sub(r"```.*?```", " ", text, flags=re.S)
    text = re.sub(r"^#+ +.*$", " ", text, count=1, flags=re.M)
    text = re.sub(r"[`*_>#|]", " ", text)
    return re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", text)


def vikix_dir():
    return os.environ.get("VIKIX_DIR") or HERE


def files_vikix():
    for path in sorted(glob.glob(os.path.join(vikix_dir(), "docs", "*.md"))):
        if os.path.basename(path) == "README.md":
            continue
        yield path, "guide"
    yield os.path.join(vikix_dir(), "README.md"), "readme"


def files_repo():
    if not os.path.isdir(SRC):
        return
    for name in sorted(os.listdir(SRC)):
        project = os.path.join(SRC, name)
        # A project, not a worktree of one (its .git is a file there).
        if not os.path.isdir(os.path.join(project, ".git")):
            continue
        for f in REPO_FILES:
            p = os.path.join(project, f)
            if os.path.isfile(p):
                kind = {"README.md": "readme", "TODO.md": "todo", "log.md": "log"}.get(f, "design")
                yield p, kind
        for p in sorted(glob.glob(os.path.join(project, "DESIGN-*.md"))):
            yield p, "design"
        # A PDF at the top (a paper, a manual the project keeps).
        for p in sorted(glob.glob(os.path.join(project, "*.pdf"))):
            yield p, "pdf"
        # The longer plans of a project, in its plans/ folder (Vikix's own are there).
        for p in sorted(glob.glob(os.path.join(project, "plans", "*.md"))):
            yield p, "design"
        # A checkout of Vikix: its guides are the vikix source's already.
        if os.path.exists(os.path.join(project, "docs", "guide.css")):
            continue
        for root, dirs, files in os.walk(os.path.join(project, "docs")):
            dirs[:] = [d for d in dirs if not d.startswith(".") and d != "node_modules"]
            if root.count(os.sep) - project.count(os.sep) > 3:
                continue
            for f in sorted(files):
                if f.endswith(".md"):
                    yield os.path.join(root, f), "doc"
                elif f.lower().endswith(".pdf"):
                    yield os.path.join(root, f), "pdf"


def files_dev():
    for p in sorted(glob.glob(os.path.join(DEV, "*", "README.md"))):
        yield p, "guide"


OWN_FILE = os.path.join(CONFIG, "vikix", "docs")
OWN_SKIP = {"node_modules", "out", "build", "dist", ".cache", "__pycache__"}
OWN_LARGEST = 3_000_000   # bytes: a built single-file site is bigger, and isn't a document to read
OWN_HEADINGS = 2          # a section is a second-level heading (## in Markdown, h2); the first is the whole


def own_config(path=None):
    """~/.config/vikix/docs, yours: {"own": [(folder, [patterns])], "agents": [folders], "what": [folders]}."""
    found = {"own": [], "agents": [], "what": []}
    for line in (read_text(path or OWN_FILE) or "").splitlines():
        line = line.split("#", 1)[0].strip()
        key, sep, rest = line.partition("=")
        key = key.strip()
        if not sep or key not in found or not rest.strip():
            continue
        words = rest.split()
        folder = os.path.realpath(os.path.expanduser(words[0]))
        found[key].append((folder, words[1:]) if key == "own" else folder)
    return found


def own_open_to_agents(path, config=None):
    """Whether agents may read the document at PATH: it is under a folder an
    agents= line opens to them. Everything of yours is closed until then."""
    path = os.path.realpath(path)
    return any(path == folder or path.startswith(folder + os.sep)
               for folder in (config or own_config())["agents"])


def files_own(config=None):
    """Your documents: (path, top folder) each, by the own= lines."""
    seen = set()
    for folder, patterns in (config or own_config())["own"]:
        if not os.path.isdir(folder):
            continue
        if patterns:
            paths = [p for pat in patterns for p in sorted(glob.glob(os.path.join(folder, pat), recursive=True))]
        else:
            paths = []
            for root, dirs, files in os.walk(folder):
                dirs[:] = sorted(d for d in dirs if not d.startswith(".") and d not in OWN_SKIP)
                paths += [os.path.join(root, f) for f in sorted(files) if f.endswith(".md")]
        for path in paths:
            if path in seen or not os.path.isfile(path):
                continue
            seen.add(path)
            yield path, folder


def md_sections(text):
    """A Markdown text as (heading, depth, body) parts: what is before the
    first heading first, with no heading."""
    parts, heading, depth, body = [], "", 0, []
    for line in text.splitlines():
        m = re.match(r"^(#{1,%d}) +(.+?)\s*#*\s*$" % OWN_HEADINGS, line)
        if m:
            parts.append((heading, depth, "\n".join(body)))
            heading, depth, body = m.group(2).strip(), len(m.group(1)), []
        else:
            body.append(line)
    parts.append((heading, depth, "\n".join(body)))
    return [p for p in parts if p[0] or p[2].strip()]


def html_sections(text):
    """An HTML page as (heading, anchor, body) parts, by the second-level
    headings that have an id, or a data-at tag (what a link can land on: a
    page's own script routes #TAG to the block tagged so); what comes
    before the first is the page's."""
    parts, heading, hid, start = [], "", "", 0
    for m in re.finditer(r"(?is)<h2\b([^>]*)>(.*?)</h2>", text):
        idm = re.search(r'\bid="([^"]+)"', m.group(1)) or re.search(r'\bdata-at="([^"]+)"', m.group(1))
        if not idm:
            continue
        parts.append((heading, hid, text[start:m.start()]))
        heading, hid, start = html_plain(m.group(2)), idm.group(1), m.end()
    parts.append((heading, hid, text[start:]))
    return [p for p in parts if p[0] or html_plain(p[2])]


def own_title(text, path):
    if path.endswith(".html"):
        m = re.search(r"(?is)<title>(.*?)</title>", text) or re.search(r"(?is)<h1\b[^>]*>(.*?)</h1>", text)
        return html_plain(m.group(1)) if m else os.path.basename(path)
    return md_title(text, path)


def own_rows(path, folder):
    """The rows a document of yours makes: the whole, then a row a section
    (id own:PATH#HEADING, path PATH#HEADING for Markdown, PATH#ID for HTML)."""
    book = os.path.relpath(path, folder).split(os.sep)[0]
    book = "" if book == os.path.basename(path) else book
    if path.lower().endswith(".pdf"):
        title = pdf_title(path)
        return pdf_rows(path, "own", f"{title} ({book})" if book else title)
    text = read_text(path)
    title = own_title(text, path)
    said = f"{title} ({book})" if book else title
    whole = html_plain(text) if path.endswith(".html") else md_plain(text)
    rows = [({"id": f"own:{path}", "source": "own", "kind": "own", "title": said, "path": path,
              "excerpt": excerpt(whole)}, whole)]
    if path.endswith(".html"):
        parts = [(h, i, html_plain(b)) for h, i, b in html_sections(text) if h]
    else:
        parts = [(h, h, md_plain(b)) for h, d, b in md_sections(text) if h and d > 1]
    for heading, anchor, body in parts:
        rows.append(({"id": f"own:{path}#{heading}", "source": "own", "kind": "section",
                      "title": f"{title} › {heading}" + (f" ({book})" if book else ""),
                      "path": f"{path}#{anchor}", "excerpt": excerpt(body)}, body))
    return rows


def index_own(db, full):
    """Your documents, a file read again when it changed, its rows made anew."""
    known = {}
    for doc_id, mtime in db.execute("SELECT id, mtime FROM docs WHERE source = 'own'").fetchall():
        known.setdefault(doc_id.split("#", 1)[0], mtime)
    seen, changed = set(), 0
    for path, folder in files_own():
        try:
            mtime = os.path.getmtime(path)
            if os.path.getsize(path) > OWN_LARGEST:
                continue
        except OSError:
            continue
        doc_id = f"own:{path}"
        seen.add(doc_id)
        if not full and known.get(doc_id) == mtime:
            continue
        drop_rows(db, "own", doc_id)
        for doc, body in own_rows(path, folder):
            doc["mtime"] = mtime
            put(db, doc, body)
        changed += 1
    for doc_id in set(known) - seen:
        drop_rows(db, "own", doc_id)
    return changed


# --- The Cuis image's classes, from the package files ------------------------------------------

def files_cuis():
    """The Cuis packages (.pck.st) to read: Vikix's in the checkout, the
    user's in ~/cuis/NewPackages, Cuis's own in ~/cuis/Packages (a link into
    the release); each with whose it is."""
    seen = set()
    for folder, whose, deep in ((os.path.join(vikix_dir(), "cuis"), "Vikix", False),
                                (os.path.join(CUIS, "NewPackages"), "yours", False),
                                (os.path.join(CUIS, "Packages"), "Cuis", True)):
        pattern = os.path.join(folder, "**", "*.pck.st") if deep else os.path.join(folder, "*.pck.st")
        for path in sorted(glob.glob(pattern, recursive=deep)):
            real = os.path.realpath(path)
            if real in seen or not os.path.isfile(path):
                continue
            seen.add(real)
            yield path, whose


def pck_selector(pattern):
    """The selector of a method's first line: unary, binary or keyword."""
    pattern = pattern.strip()
    if re.match(r"^[A-Za-z_]\w*$", pattern):
        return pattern
    m = re.match(r"^([-+*/\\<>=~@%|&?,]+)\s", pattern)
    if m:
        return m.group(1)
    return "".join(re.findall(r"[A-Za-z_]\w*:", pattern))


def pck_parse(text):
    """A package file as (description, classes): classes in the file's order,
    each a dict with name, line, comment and categories (a category to its
    selectors, class-side ones marked); what the file says of other classes
    (extension methods) under the name 'extensions'. The chunk format: a !
    inside a chunk is doubled, as a quote inside a string is."""
    def unchunk(chunk):
        return chunk.replace("!!", "!").strip()
    m = re.search(r"^'Description ((?:[^']|'')*)'!", text, re.M)
    description = m.group(1).replace("''", "'").strip() if m else ""
    classes, by_name = [], {}
    for m in re.finditer(r"^!classDefinition: #(\w+) ", text, re.M):
        cls = {"name": m.group(1), "line": text.count("\n", 0, m.start()) + 1, "comment": "", "categories": {}}
        classes.append(cls)
        by_name[cls["name"]] = cls
    for m in re.finditer(r"^!(\w+) commentStamp: [^!]*!\s*((?:[^!]|!!)*)!", text, re.M):
        if m.group(1) in by_name:
            by_name[m.group(1)]["comment"] = unchunk(m.group(2))
    extensions = {}
    for m in re.finditer(r"^!(\w+)( class)? methodsFor: '((?:[^']|'')*)'[^!\n]*!\s*([^\n]*)", text, re.M):
        name, side, category, first = m.group(1), m.group(2), m.group(3).replace("''", "'"), m.group(4)
        selector = pck_selector(first) + (" (class side)" if side else "")
        if name in by_name:
            by_name[name]["categories"].setdefault(category, []).append(selector)
        else:
            extensions.setdefault(name, []).append(selector)
    return description, classes, extensions


def cuis_rows(path, whose):
    """The rows a package file makes: the package (id cuis:PATH), then a row
    a class (id cuis:PATH#Class, path PATH#Class)."""
    text = read_text(path)
    pkg = os.path.basename(path)[:-len(".pck.st")]
    description, classes, extensions = pck_parse(text)
    said = f"{pkg} (Cuis package, {whose})" if whose != "Cuis" else f"{pkg} (Cuis package)"
    body = description + "\n\nclasses: " + ", ".join(c["name"] for c in classes)
    if extensions:
        body += "\n\nextends: " + "; ".join(f"{name} ({', '.join(sels)})" for name, sels in extensions.items())
    rows = [({"id": f"cuis:{path}", "source": "cuis", "kind": "package", "title": said, "path": path,
              "excerpt": excerpt(description or body)}, body)]
    for cls in classes:
        cats = "\n".join(f"{cat}: {', '.join(sels)}" for cat, sels in cls["categories"].items())
        body = (cls["comment"] or f"a class of {pkg}, with no comment") + "\n\n" + cats
        rows.append(({"id": f"cuis:{path}#{cls['name']}", "source": "cuis", "kind": "class",
                      "title": f"{cls['name']} ({pkg})", "path": f"{path}#{cls['name']}",
                      "excerpt": excerpt(cls["comment"] or cats)}, body))
    return rows


def index_cuis(db, full):
    """The Cuis packages, a file read again when it changed, its rows made anew."""
    known = {}
    for doc_id, mtime in db.execute("SELECT id, mtime FROM docs WHERE source = 'cuis'").fetchall():
        known.setdefault(doc_id.split("#", 1)[0], mtime)
    seen, changed = set(), 0
    for path, whose in files_cuis():
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            continue
        doc_id = f"cuis:{path}"
        seen.add(doc_id)
        if not full and known.get(doc_id) == mtime:
            continue
        drop_rows(db, "cuis", doc_id)
        for doc, body in cuis_rows(path, whose):
            doc["mtime"] = mtime
            put(db, doc, body)
        changed += 1
    for doc_id in set(known) - seen:
        drop_rows(db, "cuis", doc_id)
    return changed


def drop_rows(db, source, doc_id):
    """A document's row and its sections' (ID#...) gone. The sections are a
    range of the ids' index ('#' then '$' in ASCII), never a LIKE, which
    scans the table: once a file, that made a sweep of the notes take a minute."""
    for old in db.execute("SELECT id FROM docs WHERE source = ? AND (id = ? OR (id >= ? AND id < ?))",
                          (source, doc_id, doc_id + "#", doc_id + "$")).fetchall():
        drop(db, old[0])


def cuis_text(doc):
    """A Cuis class or package as text: the comment, then a line a category with its selectors."""
    path, name = own_split(doc)
    description, classes, extensions = pck_parse(read_text(path))
    pkg = os.path.basename(path)[:-len(".pck.st")]
    if not name:
        lines = [f"{pkg}: a Cuis package", "", description, "", "classes: " + ", ".join(c["name"] for c in classes)]
        if extensions:
            lines += ["", "extends: " + "; ".join(f"{n} ({', '.join(s)})" for n, s in extensions.items())]
        return "\n".join(lines)
    cls = next((c for c in classes if c["name"] == name), None)
    if not cls:
        return f"{name} is no longer in {path}"
    lines = [f"{name} ({pkg})", "", cls["comment"] or "(no comment)", ""]
    lines += [f"{cat}: {', '.join(sels)}" for cat, sels in cls["categories"].items()]
    return "\n".join(lines)


def cuis_line(doc):
    """The line of the class's definition in its package file, for Emacs."""
    path, name = own_split(doc)
    if name:
        for cls in pck_parse(read_text(path))[1]:
            if cls["name"] == name:
                return cls["line"]
    return 1


def cuis_browse(name):
    """A Browser on the class in the running image, through the door; False
    when nothing answered (Cuis not running, no door)."""
    r = subprocess.run(["python3", os.path.join(HERE, "bin", "vikix-eval"), "--cuis",
                        f"BrowserWindow fullOnClass: (Smalltalk at: #{name}) selector: nil"],
                       capture_output=True, text=True, timeout=40)
    return r.returncode == 0


def html_plain(text):
    """An HTML page's words, scripts and styles left out."""
    text = re.sub(r"(?is)<(script|style)[^>]*>.*?</\1>", " ", text)
    text = re.sub(r"<[^>]+>", " ", text)
    return re.sub(r"\s+", " ", html.unescape(text)).strip()


def files_tldr():
    """The tldr pages for every system (common) and for Linux: one a command."""
    for sub in ("common", "linux"):
        for p in sorted(glob.glob(os.path.join(TLDR, sub, "*.html"))):
            yield p, "tldr"


def tldr_title(text, path):
    """The command, and what it is in a line: "tar — Archiving utility." """
    name = html.unescape(re.sub(r"<[^>]+>", "", (re.search(r"(?s)<h1>(.*?)</h1>", text) or [None, ""])[1])).strip()
    name = name or os.path.basename(path)[:-5]
    quote = re.search(r"(?s)<blockquote>(.*?)</blockquote>", text)
    what = ""
    if quote:
        lines = [l.strip() for l in html_plain(quote.group(1)).split(". ") if l.strip()]
        lines = [l for l in lines if not l.startswith("More information")]
        what = lines[0].rstrip(".") + "." if lines else ""
    return f"{name} — {what}" if what else name


def files_arch():
    """The ArchWiki's pages, each named for its title; the ones named by a
    hash are other languages' main pages."""
    for p in sorted(glob.glob(os.path.join(ARCH, "*.html"))):
        if not re.fullmatch(r"[0-9a-f]{32}\.html", os.path.basename(p)):
            yield p, "wiki"


def arch_title(text, path):
    m = re.search(r"(?s)<title>(.*?)</title>", text)
    title = html.unescape(m.group(1)).strip() if m else ""
    title = re.sub(r"\s+-\s+ArchWiki$", "", title)
    return title or os.path.basename(path)[:-5].replace("_", " ")


def arch_plain(text):
    """The page's own words: from its body, before the categories and the
    footer every page has."""
    start = text.find('id="bodyContent"')
    end = text.find('id="catlinks"')
    if end < 0:
        end = text.find('id="footer"')
    if start >= 0:
        # From the body's own tag to the tag that ends it.
        text = text[text.rfind("<", 0, start):text.rfind("<", 0, end) if end > start else None]
    return html_plain(text)


def notes_dir():
    """The notes: the inbox plugin's folder, or ~/Dropbox/notes."""
    settings = os.path.join(CONFIG, "vikix", "plugins", "inbox", "settings")
    try:
        with open(settings) as f:
            for line in f:
                k, _, v = line.partition("=")
                if k.strip() == "file" and v.strip():
                    return os.path.dirname(os.path.expanduser(v.strip()))
    except FileNotFoundError:
        pass
    return os.path.join(HOME, "Dropbox", "notes")


def files_note():
    root = notes_dir()
    for dirpath, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d != "attachments"]
        for f in sorted(files):
            if f.endswith(".org"):
                yield os.path.join(dirpath, f), "note"


def org_title(text, path):
    m = re.search(r"^#\+title:\s*(.+)$", text, re.M | re.I)
    if m:
        return m.group(1).strip()
    m = re.search(r"^\*+ +(.+)$", text, re.M)
    return m.group(1).strip() if m and os.path.basename(path) == "inbox.org" else os.path.basename(path)[:-4]


def org_plain(text):
    text = re.sub(r"^:PROPERTIES:.*?^:END:\s*$", " ", text, flags=re.M | re.S)
    text = re.sub(r"^#\+\w+:.*$", " ", text, flags=re.M)
    text = re.sub(r"\[\[[^\]]*\]\[([^\]]*)\]\]", r"\1", text)
    return re.sub(r"\[\[([^\]]*)\]\]", r"\1", text)


def index_files(db, source, files, title_of, plain, full):
    """Each file read again when it changed; the gone ones dropped."""
    seen = set()
    known = {}
    for doc_id, mtime in db.execute("SELECT id, mtime FROM docs WHERE source = ?", (source,)).fetchall():
        known.setdefault(doc_id.split("#", 1)[0], mtime)
    changed = 0
    for path, kind in files:
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            continue
        doc_id = f"{source}:{path}"
        seen.add(doc_id)
        if not full and known.get(doc_id) == mtime:
            continue
        index_file(db, source, path, kind, mtime, title_of, plain)
        changed += 1
    for doc_id in set(known) - seen:
        drop_rows(db, source, doc_id)
    return changed


def index_file(db, source, path, kind, mtime, title_of, plain):
    """One file's rows made anew: a page of text is one; a PDF is one and a
    row a page."""
    doc_id = f"{source}:{path}"
    if kind == "pdf":
        drop_rows(db, source, doc_id)
        said = pdf_title(path)
        if source == "repo":
            said = f"{said} ({os.path.relpath(path, SRC)})"
        for doc, body in pdf_rows(path, source, said):
            doc["mtime"] = mtime
            put(db, doc, body)
        return
    text = read_text(path)
    body = plain(text)
    title = title_of(text, path)
    if source == "repo":
        title = f"{title} ({os.path.relpath(path, SRC)})"
    put(db, {"id": doc_id, "source": source, "kind": kind, "title": title, "path": path,
             "excerpt": excerpt(body), "mtime": mtime}, body)


FILE_SOURCES = {"vikix": (files_vikix, md_title, md_plain), "repo": (files_repo, md_title, md_plain),
                "dev": (files_dev, md_title, md_plain), "note": (files_note, org_title, org_plain)}


def index_paths(db, paths):
    """The files named read again, or dropped when gone: the watch's way,
    each one placed by the listing it is in (a project's documents, a
    language guide, a note, one of yours); a file in no listing is nothing."""
    # As the listings name them (never resolved: the ids are the paths as
    # given), and resolved too for your folders, which are.
    paths = set(paths) | {os.path.realpath(p) for p in paths}
    changed = 0
    for source, (files, title_of, plain) in FILE_SOURCES.items():
        listed = dict(files())
        for path in paths:
            doc_id = f"{source}:{path}"
            if path in listed:
                try:
                    index_file(db, source, path, listed[path], os.path.getmtime(path), title_of, plain)
                    changed += 1
                except OSError:
                    continue
            elif db.execute("SELECT 1 FROM docs WHERE id = ?", (doc_id,)).fetchone():
                drop_rows(db, source, doc_id)
                changed += 1
    own = dict(files_own(own_config()))
    for path in paths:
        doc_id = f"own:{path}"
        if path in own:
            try:
                mtime = os.path.getmtime(path)
            except OSError:
                continue
            drop_rows(db, "own", doc_id)
            for doc, body in own_rows(path, own[path]):
                doc["mtime"] = mtime
                put(db, doc, body)
            changed += 1
        elif db.execute("SELECT 1 FROM docs WHERE id = ?", (doc_id,)).fetchone():
            drop_rows(db, "own", doc_id)
            changed += 1
    return changed


def man_db_mtime():
    stamps = []
    for d in ("/usr/share/man", "/usr/local/share/man", os.path.join(HOME, ".local/share/man")):
        p = os.path.join(d, "mandoc.db")
        if os.path.exists(p):
            stamps.append(os.path.getmtime(p))
    return max(stamps) if stamps else 0


def index_man(db, full):
    """Every man page's names and one line, from apropos (makewhatis's index)."""
    stamp = str(man_db_mtime())
    if not full and meta(db, "man-stamp") == stamp:
        return 0
    r = subprocess.run(["apropos", "."], capture_output=True, text=True,
                       env=dict(os.environ, MANPATH=os.environ.get("MANPATH") or
                                f"{HOME}/.local/share/man:/usr/local/share/man:/usr/share/man"))
    drop_source(db, "man")
    n = 0
    for line in r.stdout.splitlines():
        m = re.match(r"^(.+?)\(([^)]+)\)\s+-\s+(.*)$", line)
        if not m:
            continue
        names = [x.strip() for x in m.group(1).split(",") if x.strip()]
        section = m.group(2).split(",")[0].strip()
        desc = m.group(3).strip()
        name = names[0]
        doc_id = f"man:{name}({section})"
        put(db, {"id": doc_id, "source": "man", "kind": "man", "title": f"{name}({section}) — {desc}",
                 "path": f"{section} {name}", "excerpt": desc, "mtime": 0}, " ".join(names) + " " + desc)
        n += 1
    meta(db, "man-stamp", stamp)
    return n


def index_info(db, full):
    """Each Info manual, from the directories' dir files."""
    dirs = [d for d in (os.path.join(HOME, ".local/share/info"), "/usr/local/share/info", "/usr/share/info")
            if os.path.exists(os.path.join(d, "dir"))]
    stamp = str(max((os.path.getmtime(os.path.join(d, "dir")) for d in dirs), default=0))
    if not full and meta(db, "info-stamp") == stamp:
        return 0
    drop_source(db, "info")
    n = 0
    for d in dirs:
        text = read_text(os.path.join(d, "dir"))
        for m in re.finditer(r"^\* ([^:]+): \(([^)]+)\)([^.]*)\.\s*(.*(?:\n {10,}.*)*)", text, re.M):
            name, manual, node, desc = m.group(1).strip(), m.group(2), m.group(3).strip() or "Top", " ".join(m.group(4).split())
            doc_id = f"info:({manual}){node}"
            if db.execute("SELECT 1 FROM docs WHERE id = ?", (doc_id,)).fetchone():
                continue
            put(db, {"id": doc_id, "source": "info", "kind": "info", "title": f"{name} — {desc}" if desc else name,
                     "path": f"({manual}){node}", "excerpt": desc, "mtime": 0}, f"{name} {manual} {desc}")
            n += 1
    meta(db, "info-stamp", stamp)
    return n


def xbps_stamp():
    """When the packages (installed, or in the repositories) last changed."""
    stamps = [os.path.getmtime(p) for p in glob.glob("/var/db/xbps/pkgdb-*.plist") +
              glob.glob("/var/db/xbps/*/*-repodata")]
    return str(max(stamps, default=0))


def index_pkg(db, full):
    """Every package there is, installed or not, with its one line."""
    stamp = xbps_stamp()
    if not full and meta(db, "pkg-stamp") == stamp:
        return 0
    if not shutil.which("xbps-query"):
        return 0
    r = subprocess.run(["xbps-query", "-Rs", ""], capture_output=True, text=True)
    drop_source(db, "pkg")
    n = 0
    for line in r.stdout.splitlines():
        m = re.match(r"^\[(.)\] (\S+?)-([^-\s]+_\d+)\s+(.*)$", line)
        if not m:
            continue
        installed, name, version, desc = m.group(1) == "*", m.group(2), m.group(3), m.group(4).strip()
        put(db, {"id": f"pkg:{name}", "source": "pkg", "kind": "installed" if installed else "package",
                 "title": f"{name} — {desc}" + ("  (installed)" if installed else ""),
                 "path": name, "excerpt": f"{version}", "mtime": 0}, f"{name} {desc}")
        n += 1
    meta(db, "pkg-stamp", stamp)
    return n


def index_pkgdoc(db, full):
    """The READMEs and notes packages put in /usr/share/doc: their names and
    first lines (bodies, mostly changelogs, would bury everything else)."""
    stamp = xbps_stamp()
    if not full and meta(db, "pkgdoc-stamp") == stamp:
        return 0
    drop_source(db, "pkgdoc")
    n = 0
    for pkg in sorted(os.listdir(PKGDOC)) if os.path.isdir(PKGDOC) else []:
        # The package's own folder only: below it are whole HTML manuals
        # (ImageMagick's alone has thousands of pages), which bury the rest.
        top = os.path.join(PKGDOC, pkg)
        if not os.path.isdir(top):
            continue
        for f in sorted(os.listdir(top)):
            path = os.path.join(top, f)
            if not os.path.isfile(path) or not PKGDOC_FILES.search(f):
                continue
            if f.lower().endswith((".html", ".htm")) and f.lower() not in ("index.html", "index.htm"):
                continue
            if f.lower().endswith(".pdf"):
                for doc, body in pdf_rows(path, "pkgdoc", f"{pkg}: {f}"):
                    doc["mtime"] = 0
                    put(db, doc, f"{pkg} {body}")
                    n += 1
                continue
            head = read_text(path)[:2000]
            plain = md_plain(re.sub(r"<[^>]+>", " ", head))
            body = read_text(path) if f.lower().startswith("readme") else plain
            put(db, {"id": f"pkgdoc:{path}", "source": "pkgdoc", "kind": "doc", "title": f"{pkg}: {f}",
                     "path": path, "excerpt": excerpt(plain), "mtime": 0}, f"{pkg} {body}")
            n += 1
    meta(db, "pkgdoc-stamp", stamp)
    return n


# --- Zeal's docsets, read in place -----------------------------------------------------------

def plist_value(text, key):
    m = re.search(r"<key>" + re.escape(key) + r"</key>\s*<string>([^<]*)</string>", text)
    return html.unescape(m.group(1)).strip() if m else ""


def docsets():
    """Each docset Zeal has: key (what Zeal's own address names it by), name,
    folder, index (its docSet.dsidx) and whether its pages are files here
    (else they're in its tarix archive, which only Zeal reads). Two of one
    name (Python and Python_3, a 2012 copy beside today's) are the newer."""
    found = {}
    for folder in sorted(glob.glob(os.path.join(ZEAL, "*.docset"))):
        index_path = os.path.join(folder, "Contents", "Resources", "docSet.dsidx")
        if not os.path.isfile(index_path):
            continue
        plist = read_text(os.path.join(folder, "Contents", "Info.plist"))
        name = plist_value(plist, "CFBundleName") or os.path.basename(folder)[:-len(".docset")].replace("_", " ")
        key = (plist_value(plist, "DocSetPlatformFamily") or plist_value(plist, "CFBundleIdentifier")
               or name.lower().replace(" ", "_"))
        ds = {"key": key, "name": name, "folder": folder, "index": index_path,
              "pages": os.path.isdir(os.path.join(folder, "Contents", "Resources", "Documents")),
              "mtime": os.path.getmtime(index_path)}
        if name not in found or (found[name]["pages"], found[name]["mtime"]) < (ds["pages"], ds["mtime"]):
            found[name] = ds
    return list(found.values())


def dsidx(ds):
    """A docset's index, read only, as it is (Zeal may have it open)."""
    return sqlite3.connect(f"file:{urllib.parse.quote(ds['index'])}?mode=ro&immutable=1", uri=True)


def zeal_doc(ds, name, type_, path):
    return {"id": f"zeal:{ds['key']}:{type_}:{name}", "source": "zeal", "kind": type_.lower(),
            "title": f"{name} — {type_}, {ds['name']}", "path": f"{ds['folder']}\t{path}",
            "excerpt": f"{type_} in the {ds['name']} reference"}


def find_zeal(words, limit, members=True):
    """The entries named by the words in every docset: the name itself first,
    then names starting with it (a range of each index's own NOCASE index,
    a few milliseconds for all), then, only when there are none and MEMBERS
    allows, a member of that name (str.split for split, std::fs::read_dir
    for read_dir: a scan of each docset's names, the docsets side by side,
    half a second over 300,000 entries, so a search over every source asks
    for it only when the words look like code or the catalogue had little),
    shorter names first."""
    q = re.sub(r"\s+", " ", " ".join(words).replace('"', "")).strip()
    if not q or len(q) < 2:
        return []
    sets = docsets()

    def prefix(ds):
        try:
            db = dsidx(ds)
            rows = db.execute("SELECT name, type, path FROM searchIndex WHERE name COLLATE NOCASE >= ? "
                              "AND name COLLATE NOCASE < ? ORDER BY length(name) LIMIT ?",
                              (q, q + "\uffff", limit)).fetchall()
            db.close()
            return ds, rows
        except sqlite3.Error:
            return ds, []

    def member(ds):
        # GLOB minds case (a scan of lower(name) costs twice as much): the
        # word as typed, and in lower case when that differs.
        forms = {q, q.lower()}
        globs = [f"*[.:]{f.replace('[', '[[]').replace('*', '[*]').replace('?', '[?]')}*" for f in forms]
        try:
            db = dsidx(ds)
            rows = db.execute("SELECT name, type, path FROM searchIndex WHERE "
                              + " OR ".join("name GLOB ?" for _ in globs) + " ORDER BY length(name) LIMIT ?",
                              (*globs, limit)).fetchall()
            db.close()
            return ds, rows
        except sqlite3.Error:
            return ds, []

    hits, seen = [], set()

    def take(ds, rows):
        for name, type_, path in rows:
            if (ds["key"], type_, name) in seen:
                continue
            seen.add((ds["key"], type_, name))
            low = name.lower()
            rank = 0 if low == q.lower() else 1 if low.startswith(q.lower()) else 2
            hits.append((rank, len(name), ds["name"], zeal_doc(ds, name, type_ or "Entry", path or "")))

    for ds, rows in map(prefix, sets):
        take(ds, rows)
    if not hits and sets and members:
        from concurrent.futures import ThreadPoolExecutor
        with ThreadPoolExecutor(min(8, len(sets))) as pool:
            for ds, rows in pool.map(member, sets):
                take(ds, rows)
    hits.sort(key=lambda h: h[:3])
    return [h[3] for h in hits[:limit]]


def zeal_get(doc_id):
    """A docset's entry by its id (zeal:KEY:TYPE:NAME), or None."""
    parts = doc_id.split(":", 3)
    if len(parts) < 4:
        return None
    _, key, type_, name = parts
    for ds in docsets():
        if ds["key"] != key:
            continue
        try:
            db = dsidx(ds)
            row = db.execute("SELECT name, type, path FROM searchIndex WHERE name = ? AND type = ? LIMIT 1",
                             (name, type_)).fetchone()
            db.close()
        except sqlite3.Error:
            row = None
        if row:
            return zeal_doc(ds, row[0], row[1] or "Entry", row[2] or "")
    return None


def zeal_page(doc):
    """The entry's page as a file on this machine, with its anchor: (file,
    anchor), or (None, anchor) when the docset keeps its pages compressed."""
    folder, _, path = doc["path"].partition("\t")
    # Some docsets put <dash_entry_...> notes before the path.
    path = re.sub(r"^(<[^>]*>)+", "", path)
    page, _, anchor = path.partition("#")
    file = os.path.join(folder, "Contents", "Resources", "Documents", urllib.parse.unquote(page))
    return (file if os.path.isfile(file) else None), anchor


def zeal_key_name(doc):
    _, key, _, name = doc["id"].split(":", 3)
    return key, name


def zeal_anchor(text, doc):
    """Where the entry is on its page: the anchor its path names (Dash's
    //apple_ref/... form), else an element whose id or name is the entry's
    (Sphinx and most generators write one); (anchor, where it is in the
    text), or (None, None)."""
    _, anchor = zeal_page(doc)
    _, name = zeal_key_name(doc)
    for want in [a for a in (anchor, urllib.parse.unquote(anchor) if anchor else "", name) if a]:
        m = re.search(r'(?i)<[a-z][^>]*\b(?:name|id)="' + re.escape(want) + '"', text)
        if m:
            return want, m.start()
    return None, None


def zeal_text(doc):
    """The entry's own part of its page: from its anchor to the next entry's
    (or the next term defined), or the page when there's no anchor; a word
    when only Zeal can show it."""
    file, _ = zeal_page(doc)
    key, name = zeal_key_name(doc)
    if not file:
        return (f"{doc['title']}\n\nIts page is kept compressed by Zeal, so read it there: "
                f"vikix docs open {doc['id']} (zeal, then {name}).")
    text = read_text(file, whole=True)
    anchor, at = zeal_anchor(text, doc)
    if anchor:
        # To the next entry: the next Dash anchor, or the next term defined
        # once this one's description (its <dd>) has closed.
        rest = text[at:]
        ends = [m.start() for m in [re.search(r'(?i)<a\b[^>]*\bname="//apple_ref/', rest[1:])] if m]
        closed = rest.find("</dd>")
        if closed >= 0:
            nxt = re.search(r"(?i)<dt\b", rest[closed:])
            if nxt:
                ends.append(closed + nxt.start() - 1)
        text = rest[:min(ends) + 1] if ends else rest[:20000]
    return html_plain(text)[:ASK_PASSAGE * 3] or doc["title"]


def zeal_open(doc, other=False):
    """The entry's page in the docs browser when it is a file here; else, and
    the other way, in Zeal at the entry (its own address form)."""
    file, anchor = zeal_page(doc)
    if file and not other:
        if not anchor:
            anchor = zeal_anchor(read_text(file, whole=True), doc)[0] or ""
        docs_open(["file://" + file + (f"#{anchor}" if anchor else "")])
        return
    key, name = zeal_key_name(doc)
    if not shutil.which("zeal"):
        die("Zeal isn't installed (vikix pkg add zeal), and this entry's page is only readable there")
    subprocess.Popen(["setsid", "-f", "zeal",
                      f"dash-plugin://keys={urllib.parse.quote(key)}&query={urllib.parse.quote(name)}"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def zeal_counts():
    """(docsets, entries) Zeal has, for status."""
    sets, entries = 0, 0
    for ds in docsets():
        try:
            db = dsidx(ds)
            entries += db.execute("SELECT count(*) FROM searchIndex").fetchone()[0]
            db.close()
            sets += 1
        except sqlite3.Error:
            continue
    return sets, entries


# --- Links to the web: listed, never fetched ---------------------------------------------------

def web_links():
    """(id, title, url, words) each: the websites of the packages installed,
    the links the language guides in ~/dev list, and your own file of
    links. Nothing here is fetched: a hit says it leaves the machine."""
    if shutil.which("xbps-query"):
        installed = set()
        for line in subprocess.run(["xbps-query", "-l"], capture_output=True, text=True).stdout.splitlines():
            m = re.match(r"^\S+\s+(\S+?)-[^-\s]+\s", line)
            if m:
                installed.add(m.group(1))
        r = subprocess.run(["xbps-query", "-R", "-p", "homepage", "-s", ""], capture_output=True, text=True)
        for line in r.stdout.splitlines():
            m = re.match(r"^(\S+?)-[^-\s]+: (https?://\S+)", line)
            if m and m.group(1) in installed:
                yield f"web:pkg:{m.group(1)}", f"{m.group(1)}: its website", m.group(2), m.group(1)
    for path in sorted(glob.glob(os.path.join(DEV, "*", "README.md"))):
        lang = os.path.basename(os.path.dirname(path))
        for line in read_text(path).splitlines():
            for part in re.split(r"\s·\s", line.strip().lstrip("-*").strip()):
                m = re.search(r"(https?://[^\s)>\]]+)", part)
                if not m:
                    continue
                label = re.sub(r"[\s:—–-]+$", "", part[:m.start()].strip()) or m.group(1)
                yield f"web:dev:{lang}:{m.group(1)}", f"{label} ({lang})", m.group(1), lang
    for n, line in enumerate(read_text(LINKS_FILE).splitlines(), 1):
        line = line.split("#", 1)[0].strip()
        words = line.split()
        urls = [w for w in words if re.match(r"^https?://", w)]
        if not urls:
            continue
        title = " ".join(w for w in words if w != urls[0]) or urls[0]
        yield f"web:own:{urls[0]}", title, urls[0], "yours"


def web_stamp():
    files = glob.glob(os.path.join(DEV, "*", "README.md")) + [LINKS_FILE]
    return xbps_stamp() + " " + " ".join(str(os.path.getmtime(f)) for f in files if os.path.exists(f))


def index_web(db, full):
    stamp = web_stamp()
    if not full and meta(db, "web-stamp") == stamp:
        return 0
    drop_source(db, "web")
    n = 0
    for doc_id, title, url, words in web_links():
        host = urllib.parse.urlsplit(url).netloc
        put(db, {"id": doc_id, "source": "web", "kind": "link", "title": f"{title} — {url}", "path": url,
                 "excerpt": f"on the web ({host}), not on this machine", "mtime": 0},
            f"{title} {words} {host} {re.sub(r'[^\w]+', ' ', url)}")
        n += 1
    meta(db, "web-stamp", stamp)
    return n


# --- PDFs, by the text they carry ------------------------------------------------------------

def pdf_pages(path):
    """The text of a PDF's first pages, one string a page; None when
    pdftotext (poppler-utils) isn't here; [] when it has no text (a scan).
    Kept in the cache by the file's time, so a sweep doesn't read it again."""
    if not shutil.which(PDFTOTEXT):
        return None
    key = hashlib.sha1(f"{path}:{os.path.getmtime(path)}".encode()).hexdigest()[:16]
    cached = os.path.join(CACHE, "pdf", f"{key}.txt")
    if os.path.exists(cached):
        text = read_text(cached)
    else:
        try:
            r = subprocess.run([PDFTOTEXT, "-l", str(PDF_PAGES), path, "-"], capture_output=True, text=True,
                               timeout=120)
        except (OSError, subprocess.SubprocessError):
            return []
        text = r.stdout if r.returncode == 0 else ""
        os.makedirs(os.path.dirname(cached), exist_ok=True)
        with open(cached, "w") as f:
            f.write(text)
    pages = [p.strip() for p in text.split("\f")]
    while pages and not pages[-1]:
        pages.pop()
    return pages if any(pages) else []


def pdf_title(path):
    if shutil.which("pdfinfo"):
        try:
            info = subprocess.run(["pdfinfo", path], capture_output=True, text=True, timeout=30).stdout
            m = re.search(r"^Title:\s+(.+)$", info, re.M)
            if m and m.group(1).strip() and not m.group(1).strip().lower().endswith((".pdf", ".dvi", ".tex")):
                return m.group(1).strip()
        except (OSError, subprocess.SubprocessError):
            pass
    return os.path.basename(path)[:-4]


def pdf_rows(path, source, said):
    """The rows a PDF makes: the whole (id SRC:PATH, kind pdf), then a row a
    page with text (SRC:PATH#page=N), so a hit opens at its page. A scanned
    PDF, or one with no pdftotext to read it, is one row by its name, saying why."""
    pages = pdf_pages(path)
    if pages is None:
        note, body = "its text isn't read: pdftotext (vikix pkg add poppler-utils) isn't installed", ""
    elif not pages:
        note, body = "a scanned PDF: no text to read in it (a later OCR step)", ""
    else:
        note, body = excerpt(pages[0] or next(p for p in pages if p)), "\n\n".join(pages)
    rows = [({"id": f"{source}:{path}", "source": source, "kind": "pdf", "title": said, "path": path,
              "excerpt": note}, body)]
    for n, text in enumerate(pages or [], 1):
        if text:
            rows.append(({"id": f"{source}:{path}#page={n}", "source": source, "kind": "page",
                          "title": f"{said} › page {n}", "path": f"{path}#page={n}", "excerpt": excerpt(text)}, text))
    return rows


def pdf_page_of(doc):
    """(file, page or 0) of a PDF's row."""
    path, _, anchor = doc["path"].partition("#")
    m = re.match(r"^page=(\d+)$", anchor)
    return path, int(m.group(1)) if m else 0


def pdf_text(doc):
    path, page = pdf_page_of(doc)
    pages = pdf_pages(path)
    if pages is None:
        return f"{doc['title']}\n\npdftotext isn't installed (vikix pkg add poppler-utils), so its text can't be read."
    if not pages:
        return f"{doc['title']}\n\nA scanned PDF: it carries no text to read."
    if page:
        return pages[page - 1] if page <= len(pages) else ""
    return "\n\n".join(pages)


def pdf_open(doc, other=False):
    """The PDF in the viewer at the hit's page, where the viewer takes one
    (zathura, evince, mupdf); else as the file opens; --other: its text in
    a terminal."""
    path, page = pdf_page_of(doc)
    if other:
        if shutil.which(PDFTOTEXT):
            terminal(["sh", "-c", f"{shlex.quote(PDFTOTEXT)} -l {PDF_PAGES} {shlex.quote(path)} - | less"])
            return
        print("pdftotext isn't installed, so the PDF opens as a file instead", file=sys.stderr)
    for name, argv in PDF_VIEWERS:
        if shutil.which(name):
            subprocess.Popen(["setsid", "-f", *argv(path, page or 1)], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
            return
    if page:
        print(f"no viewer here opens at a page (zathura, evince, mupdf), so page {page} is yours to find",
              file=sys.stderr)
    subprocess.Popen(["setsid", "-f", "xdg-open", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def index(full=False, quiet=False):
    t0 = time.time()
    db = connect()
    counts = {}
    with db:
        for source, (files, title_of, plain) in FILE_SOURCES.items():
            counts[source] = index_files(db, source, files(), title_of, plain, full)
        counts["own"] = index_own(db, full)
        counts["cuis"] = index_cuis(db, full)
        # VIKIX_DOCS_SOURCES limits what's read (the tests leave the system's out).
        only = os.environ.get("VIKIX_DOCS_SOURCES", "man info tldr arch pkg pkgdoc web").split()
        if "man" in only:
            counts["man"] = index_man(db, full)
        if "info" in only:
            counts["info"] = index_info(db, full)
        if "tldr" in only:
            counts["tldr"] = index_files(db, "tldr", files_tldr(), tldr_title, html_plain, full)
        if "arch" in only:
            counts["arch"] = index_files(db, "arch", files_arch(), arch_title, arch_plain, full)
        if "pkg" in only:
            counts["pkg"] = index_pkg(db, full)
        if "pkgdoc" in only:
            counts["pkgdoc"] = index_pkgdoc(db, full)
        if "web" in only:
            counts["web"] = index_web(db, full)
        meta(db, "indexed", int(time.time()))
    if not quiet:
        read = ", ".join(f"{n} {s}" for s, n in counts.items() if n)
        print(f"Read {read or 'nothing new'} in {time.time() - t0:.1f} s.")
    return counts


def fresh_enough():
    """Read again what changed, when the catalogue is more than a day old."""
    try:
        db = connect()
        last = int(meta(db, "indexed") or 0)
        db.close()
    except sqlite3.Error:
        last = 0
    if time.time() - last > STALE:
        index(quiet=True)


# --- Searching ------------------------------------------------------------------------------

def fts_query(words):
    """Words as in a search box: each the start of a word, "exact words", OR."""
    out = []
    for tok in re.findall(r'"[^"]+"|\S+', " ".join(words)):
        if tok.startswith('"'):
            inner = re.sub(r"[^\w\s]", " ", tok[1:-1]).strip()
            if inner:
                out.append(f'"{inner}"')
        elif tok == "OR":
            out.append("OR")
        else:
            parts = [p for p in re.split(r"[^\w]+", tok) if p]
            out += [f'"{p}"*' for p in parts]
    while out and out[0] == "OR":
        out.pop(0)
    while out and out[-1] == "OR":
        out.pop()
    return " ".join(out)


def find(words, source=None, limit=20):
    """The hits, best first: the catalogue's (find_fts), with the docsets'
    entries (find_zeal) among them: the entry named by the words with the
    documents named by them, the rest after the catalogue's, keeping a
    share of the list so an API reference isn't buried under man pages."""
    if source == "zeal":
        return find_zeal(words, limit)
    hits, named = find_fts(words, source, limit)
    if source:
        return hits
    # The scan for a member (the slow part) only for words written as code
    # is (an underscore, a dot, a colon, a digit, a capital inside) or when
    # the catalogue itself had fewer hits than the list holds: "runit" or
    # "keyboard" has its pages, and needn't wait half a second for a
    # function of that name in a docset.
    q = " ".join(words)
    code_like = bool(re.search(r"[_.:0-9]|[a-z][A-Z]", q))
    zeal = find_zeal(words, max(2, limit // ZEAL_SHARE), members=code_like or len(hits) < limit)
    if not zeal:
        return hits
    # The entry named by the words stands with the documents named by them
    # when the words are written as code, or the catalogue had little; a
    # plain word (keyboard, split, open) keeps the catalogue's own first,
    # as before the docsets came, the entries after.
    exact = [z for z in zeal if z["title"].split(" — ")[0].lower() == q.replace('"', "").strip().lower()]
    if not (code_like or len(hits) < limit):
        exact = []
    rest = [z for z in zeal if z not in exact]
    room = max(0, limit - len(zeal))
    return (hits[:named] + exact + hits[named:room] + rest)[:limit]


def find_fts(words, source=None, limit=20):
    """The catalogue's hits and how many of them are named by the words."""
    q = fts_query(words)
    if not q:
        return [], 0
    db = connect()
    cases = " ".join(f"WHEN '{s}' THEN {b}" for s, b in BOOST.items())
    # The document named by the words themselves comes first: "tar" is
    # tar's own pages (tldr's, man's, the package) before everything that
    # mentions tar, or starts with it (target, tarball), however often. So
    # the named ones are a tier of their own, not a factor: a guide of
    # Vikix's (boosted 3.0) saying "targets" twice outweighed a factor.
    name = re.sub(r"\s+", " ", " ".join(words).replace('"', "")).strip().lower()
    like = name.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
    named = ("(lower(d.title) = ? OR lower(d.title) LIKE ? ESCAPE '\\' OR lower(d.title) LIKE ? ESCAPE '\\'"
             " OR lower(d.title) LIKE ? ESCAPE '\\')")
    sql = (f"SELECT d.id, d.source, d.kind, d.title, d.path, d.excerpt, "
           f"bm25(docs_fts, 10.0, 1.0) * (CASE d.source {cases} ELSE 1 END) AS score, "
           f"(CASE WHEN {named} THEN 0 ELSE 1 END) AS tier "
           f"FROM docs_fts JOIN docs d ON d.rid = docs_fts.rowid WHERE docs_fts MATCH ?")
    args = [name, like + " — %", like + "(%", like + ": %", q]
    if isinstance(source, (list, tuple)):
        sql += " AND d.source IN (" + ",".join("?" * len(source)) + ")"
        args += list(source)
    elif source:
        sql += " AND d.source = ?"
        args.append(source)
    sql += " ORDER BY tier, score LIMIT ?"
    args.append(limit)
    try:
        rows = db.execute(sql, args).fetchall()
    except sqlite3.OperationalError:
        return [], 0
    keys = ("id", "source", "kind", "title", "path", "excerpt")
    return [dict(zip(keys, r[:6])) for r in rows], sum(1 for r in rows if r[7] == 0)


def get(doc_id):
    if doc_id.startswith("zeal:"):
        return zeal_get(doc_id)
    db = connect()
    r = db.execute("SELECT id, source, kind, title, path, excerpt FROM docs WHERE id = ?", (doc_id,)).fetchone()
    return dict(zip(("id", "source", "kind", "title", "path", "excerpt"), r)) if r else None


# --- Reading and opening --------------------------------------------------------------------

def man_args(doc):
    section, name = doc["path"].split(" ", 1)
    return section, name


def is_pdf(doc):
    return own_split(doc)[0].lower().endswith(".pdf") and doc["source"] not in ("man", "info", "pkg", "zeal", "web")


def read(doc):
    """A document as plain text."""
    if doc["source"] == "zeal":
        return zeal_text(doc)
    if doc["source"] == "web":
        return (f"{doc['title']}\n\nA link to the web: nothing of it is on this machine, and the catalogue "
                f"never fetches it. vikix docs open {doc['id']} opens it in the browser.")
    if is_pdf(doc):
        return pdf_text(doc)
    if doc["source"] == "man":
        section, name = man_args(doc)
        r = subprocess.run(["man", section, name], capture_output=True, text=True,
                           env=dict(os.environ, MANPAGER="cat", PAGER="cat", MANWIDTH="80"))
        return re.sub(r".\x08", "", r.stdout)
    if doc["source"] == "info":
        r = subprocess.run(["info", "-o", "-", doc["path"]], capture_output=True, text=True)
        return r.stdout
    if doc["source"] == "pkg":
        r = subprocess.run(["xbps-query", "-R", "-S", doc["path"]], capture_output=True, text=True)
        return r.stdout or doc["title"]
    if doc["source"] == "tldr":
        return tldr_text(doc["path"])
    if doc["source"] == "arch":
        return arch_plain(read_text(doc["path"]))
    if doc["source"] == "own":
        return own_text(doc)
    if doc["source"] == "cuis":
        return cuis_text(doc)
    return read_text(doc["path"])


def own_split(doc):
    """(file, heading or id) of a document of yours: the whole file when it has no section."""
    path, _, anchor = doc["path"].partition("#")
    return path, anchor


def own_text(doc):
    """A document of yours as text: the section alone when it is one."""
    path, anchor = own_split(doc)
    text = read_text(path)
    if not anchor:
        return html_plain(text) if path.endswith(".html") else text
    if path.endswith(".html"):
        for heading, hid, body in html_sections(text):
            if hid == anchor:
                return heading + "\n\n" + html_plain(body)
    else:
        for heading, depth, body in md_sections(text):
            if heading == anchor:
                return "#" * depth + " " + heading + "\n" + body
    return html_plain(text) if path.endswith(".html") else text


def html_id_of(page, heading):
    """The id of the heading HEADING in the page PAGE (a file), as the
    renderer wrote it, or None: matched by the heading's words, so no rule
    of pandoc's has to be known."""
    want = re.sub(r"\s+", " ", re.sub(r"[`*_]", "", heading)).strip().lower()
    for m in re.finditer(r'(?is)<h[1-6]\b[^>]*\bid="([^"]+)"[^>]*>(.*?)</h[1-6]>', read_text(page)):
        if re.sub(r"\s+", " ", html_plain(m.group(2))).strip().lower() == want:
            return m.group(1)
    return None


def own_page(doc):
    """A document of yours as a page to open: its file (HTML), or the
    rendered Markdown, at its section when it has one."""
    path, anchor = own_split(doc)
    if path.endswith(".html"):
        page = path
    else:
        page = md_html(path, doc["title"])
        if page and anchor:
            anchor = html_id_of(page, anchor) or ""
    if not page:
        return None
    return "file://" + page + (f"#{anchor}" if anchor else "")


def guide_page(path):
    """The built HTML page of a guide (~/.local/share/vikix/guide), by its title."""
    guide = os.path.join(DATA, "guide")
    title = md_title(read_text(path), path)
    want = re.sub(r"[^\w]+", "-", title).strip("-").lower()
    for f in glob.glob(os.path.join(guide, "*.html")):
        if re.sub(r"[^\w]+", "-", os.path.basename(f)[:-5]).strip("-").lower() == want:
            return f
    return None


def man_html(doc):
    """A man page as a page styled as the guide is, cached."""
    section, name = man_args(doc)
    out = os.path.join(CACHE, "man", f"{name}.{section}.html")
    if os.path.exists(out):
        return out
    src = subprocess.run(["man", "-w", section, name], capture_output=True, text=True).stdout.strip().splitlines()
    if not src or not shutil.which("mandoc"):
        return None
    css = os.path.join(vikix_dir(), "docs", "guide.css")
    r = subprocess.run(["mandoc", "-Thtml", f"-Ostyle=file://{css}", src[0]], capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout:
        return None
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w") as f:
        f.write(r.stdout)
    return out


def md_html(path, title):
    """A Markdown file as a page styled as the guide is (pandoc, else Python's
    markdown), cached; None when neither is here."""
    key = hashlib.sha1(f"{path}:{os.path.getmtime(path)}".encode()).hexdigest()[:16]
    out = os.path.join(CACHE, "md", f"{key}.html")
    if os.path.exists(out):
        return out
    css = "file://" + os.path.join(vikix_dir(), "docs", "guide.css")
    base = "file://" + os.path.dirname(os.path.abspath(path)) + "/"
    text = read_text(path)
    body = None
    if shutil.which("pandoc"):
        r = subprocess.run(["pandoc", "-f", "gfm", "-t", "html5"], input=text, capture_output=True, text=True)
        body = r.stdout if r.returncode == 0 else None
    if body is None:
        try:
            import markdown
            body = markdown.markdown(text, extensions=["tables", "fenced_code"])
        except ImportError:
            return None
    page = (f'<!doctype html><html><head><meta charset="utf-8"><base href="{html.escape(base)}">'
            f'<title>{html.escape(title)}</title><link rel="stylesheet" href="{css}"></head>'
            f'<body><p class="vikix-docs-from">{html.escape(path)}</p>{body}</body></html>')
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w") as f:
        f.write(page)
    return out


def tldr_html(doc):
    """A tldr page (bare HTML as wikiman keeps it) as a page styled as the
    guide is, saying when the copy is from; cached."""
    path = doc["path"]
    key = hashlib.sha1(f"{path}:{os.path.getmtime(path)}".encode()).hexdigest()[:16]
    out = os.path.join(CACHE, "tldr", f"{key}.html")
    if os.path.exists(out):
        return out
    css = "file://" + os.path.join(vikix_dir(), "docs", "guide.css")
    body = re.sub(r"(?is)^.*?<body[^>]*>|</body>.*$", "", read_text(path))
    when = time.strftime("%Y-%m-%d", time.localtime(os.path.getmtime(path)))
    page = (f'<!doctype html><html><head><meta charset="utf-8"><title>{html.escape(doc["title"])}</title>'
            f'<link rel="stylesheet" href="{css}"></head>'
            f'<body><p class="vikix-docs-from">{html.escape(path)}, the copy of {when}</p>{body}</body></html>')
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w") as f:
        f.write(page)
    return out


def tldr_text(path):
    """A tldr page as text: what the command is, then each example's words
    and, set in, its command."""
    text = read_text(path)
    text = re.sub(r"(?is)<(script|style)[^>]*>.*?</\1>", " ", text)
    text = re.sub(r"(?i)<p>\s*<code>(.*?)</code>\s*</p>", lambda m: "    " + m.group(1), text)
    text = re.sub(r"(?i)</(h1|p|li|blockquote)>", "\n", text)
    text = re.sub(r"(?i)<li>", "- ", text)
    text = re.sub(r"(?i)</?code>", "`", text)
    text = re.sub(r"<[^>]+>", "", text)
    text = "\n".join(line.rstrip() for line in html.unescape(text).splitlines())
    return re.sub(r"\n{3,}", "\n\n", text).strip() + "\n"


def arch_url(doc):
    """The page as it is today, on wiki.archlinux.org (the copy's name is its title)."""
    name = os.path.basename(doc["path"])[:-5]
    return "https://wiki.archlinux.org/title/" + urllib.parse.quote(name, safe="()_,.-:")


def pkg_card(doc):
    """A package as a short page: what it is, installed or not, its website."""
    name = doc["path"]
    info = subprocess.run(["xbps-query", "-R", "-S", name], capture_output=True, text=True).stdout
    fields = dict(re.findall(r"^(\w[\w-]*): (.*)$", info, re.M))
    installed = doc["kind"] == "installed"
    home = fields.get("homepage", "")
    css = "file://" + os.path.join(vikix_dir(), "docs", "guide.css")
    labels = (("pkgver", "Version"), ("license", "Licence"), ("installed_size", "Size, installed"),
              ("maintainer", "Looked after by"))
    rows = "".join(f"<tr><th>{label}</th><td>{html.escape(fields[k])}</td></tr>" for k, label in labels if k in fields)
    page = (f'<!doctype html><html><head><meta charset="utf-8"><title>{html.escape(name)}</title>'
            f'<link rel="stylesheet" href="{css}"></head><body><h1>{html.escape(name)}</h1>'
            f'<p>{html.escape(fields.get("short_desc", doc["title"]))}</p>'
            f'<p><b>{"Installed." if installed else "Not installed."}</b> '
            f'{"" if installed else f"To install it: <code>vikix pkg add {html.escape(name)}</code>"}</p>'
            f'<table>{rows}</table>'
            + (f'<p>Its website (on the web, not this machine): <a href="{html.escape(home)}">{html.escape(home)}</a></p>'
               if home else "") + "</body></html>")
    out = os.path.join(CACHE, "pkg", f"{name}.html")
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w") as f:
        f.write(page)
    return out


def terminal(argv):
    term = (os.environ.get("VIKIX_TERMINAL") or "alacritty").split()
    subprocess.Popen(["setsid", "-f", *term, "-e", *argv], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def emacs(args):
    if shutil.which("emacsclient"):
        subprocess.Popen(["emacsclient", "-c", "-n", *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    return False


def docs_open(paths):
    # VIKIX_DOCS_OPEN: another opener (the tests' stand-in).
    opener = os.environ.get("VIKIX_DOCS_OPEN") or os.path.join(vikix_dir(), "bin", "vikix-docs-open")
    subprocess.Popen([opener, *paths],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def note_opened(doc):
    """A line for `vikix day`, which lists the documents opened each day:
    when, which, its title. Yours alone (600); never a reason to fail."""
    try:
        state = os.environ.get("VIKIX_STATE") or os.path.join(os.path.expanduser("~"), ".local", "state", "vikix")
        os.makedirs(os.path.join(state, "day"), exist_ok=True)
        fd = os.open(os.path.join(state, "day", "docs.log"), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as out:
            title = " ".join(str(doc.get("title") or doc.get("id") or "").split())
            out.write(f"{int(time.time())}\t{doc.get('id', '')}\t{title}\n")
    except OSError:
        pass


def open_doc(doc, other=False):
    note_opened(doc)
    src = doc["source"]
    if src == "zeal":
        zeal_open(doc, other)
    elif src == "web":
        # The default browser, both ways: this one leaves the machine.
        subprocess.Popen(["setsid", "-f", "xdg-open", doc["path"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif is_pdf(doc):
        pdf_open(doc, other)
    elif src == "man":
        section, name = man_args(doc)
        page = None if other else man_html(doc)
        if page:
            docs_open([page])
        else:
            terminal(["man", section, name])
    elif src == "info":
        if other or not emacs(["-e", f'(info "{doc["path"]}")']):
            terminal(["info", doc["path"]])
    elif src == "pkg":
        if other:
            terminal(["sh", "-c", f"xbps-query -R -S {doc['path']} | less"])
        else:
            docs_open([pkg_card(doc)])
    elif src == "tldr":
        if other:
            # tealdeer's own showing when it has its cache (tldr --update);
            # else the page's words, from the copy.
            name = os.path.basename(doc["path"])[:-5]
            txt = os.path.join(CACHE, "tldr", f"{name}.txt")
            os.makedirs(os.path.dirname(txt), exist_ok=True)
            with open(txt, "w") as f:
                f.write(tldr_text(doc["path"]))
            terminal(["sh", "-c", f"tldr {shlex.quote(name)} 2>/dev/null || less {shlex.quote(txt)}"])
        else:
            docs_open([tldr_html(doc)])
    elif src == "arch":
        if other:
            subprocess.Popen(["xdg-open", arch_url(doc)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            docs_open([doc["path"]])
    elif src == "own" and not other:
        page = own_page(doc)
        if page:
            docs_open([page])
        else:
            emacs([own_split(doc)[0]])
    elif src == "cuis":
        # A class in a Browser in the running image; a package, or a class
        # with no image to show it, in Emacs at its definition.
        path, name = own_split(doc)
        if name and not other:
            try:
                if cuis_browse(name):
                    return
            except (OSError, subprocess.SubprocessError):
                pass
            print(f"Cuis isn't running with its door, so {name} opens in its package file instead "
                  "(cuis starts the image; then open it again for a Browser there)", file=sys.stderr)
        if not emacs([f"+{cuis_line(doc)}", path]):
            docs_open([path])
    elif src == "note" or other:
        path = own_split(doc)[0] if src == "own" else doc["path"]
        if not emacs([path]):
            docs_open([path])
    else:
        # A guide as its own built page; any Markdown as a page styled as
        # the guide; an HTML or text file as it is.
        page = guide_page(doc["path"]) if src == "vikix" else None
        if not page and doc["path"].endswith(".md"):
            page = md_html(doc["path"], doc["title"])
        docs_open([page or doc["path"]])


def random_guide(other=False):
    """Draw from the guides left this round, without needing an index."""
    pages = {os.path.basename(path): path for path, kind in files_vikix()
             if kind == "guide" and os.path.basename(path) != "commands.md"
             and os.path.isfile(path)}
    if not pages:
        die("no Vikix guide pages found")
    try:
        state = os.environ.get("VIKIX_STATE") or os.path.join(HOME, ".local/state/vikix")
        folder = os.path.join(state, "docs")
        os.makedirs(folder, exist_ok=True)
        fd = os.open(os.path.join(folder, "random-deck"), os.O_RDWR | os.O_CREAT, 0o600)
        with os.fdopen(fd, "r+", encoding="utf-8", errors="replace") as deck:
            # Two menu presses must draw from the same remaining round.
            fcntl.flock(deck, fcntl.LOCK_EX)
            os.fchmod(deck.fileno(), 0o600)
            remaining = list(dict.fromkeys(line.strip() for line in deck
                                          if line.strip() in pages)) or list(pages)
            name = random.choice(remaining)
            remaining.remove(name)
            deck.seek(0)
            deck.truncate()
            deck.writelines(item + "\n" for item in remaining)
    except OSError:
        # State is optional: a read-only home still gets a guide.
        name = random.choice(list(pages))
    path = pages[name]
    doc = {"id": f"vikix:{path}", "source": "vikix", "kind": "guide",
           "title": md_title(read_text(path), path), "path": path}
    open_doc(doc, other=other)
    print(doc["title"])


def hit_line(h):
    ex = h["excerpt"] if h["source"] in ("man", "info") else ""
    title = h["title"] if not ex or ex in h["title"] else f"{h['title']} — {ex}"
    if h["source"] == "web":
        title = "🌐 " + title   # the globe: this one opens on the web, not on this machine
    return f"{BADGE.get(h['source'], h['source']):<5}  {title[:160]}"


def nyxt_listens(sock):
    """Whether a Nyxt answers on its socket. Asked of the socket itself: with
    none running `nyxt --remote` exits 0 all the same, and says so on the
    terminal it finds (/dev/tty: from the desktop's menu the login's, never
    our pipe), so its words can't be gone by."""
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(2)
    try:
        s.connect(sock)
        return True
    except OSError:
        return False
    finally:
        s.close()


def window_pids():
    """The processes owning the windows the window manager has, on every
    workspace (_NET_CLIENT_LIST, then each one's _NET_WM_PID)."""
    r = subprocess.run(["xprop", "-root", "_NET_CLIENT_LIST"], capture_output=True, text=True)
    pids = set()
    for wid in re.findall(r"0x[0-9a-fA-F]+", r.stdout):
        w = subprocess.run(["xprop", "-id", wid, "_NET_WM_PID"], capture_output=True, text=True)
        m = re.search(r"= (\d+)", w.stdout)
        if m:
            pids.add(int(m.group(1)))
    return pids


def stuck_nyxts():
    """Your Nyxts on this screen whose socket would be ours, now gone: the
    ones without a window (stuck: closing the last window can leave Nyxt
    running with nothing open, and no other Nyxt can reach it), and the ones
    still with windows (in use, only unreachable)."""
    r = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "nyxt"], capture_output=True, text=True)
    mine = []
    for pid in map(int, r.stdout.split()):
        try:
            with open(f"/proc/{pid}/environ", "rb") as f:
                env = dict(kv.split(b"=", 1) for kv in f.read().split(b"\0") if b"=" in kv)
        except OSError:
            continue
        same = all(env.get(k.encode(), b"").decode(errors="replace") == os.environ.get(k, "")
                   for k in ("DISPLAY", "XDG_RUNTIME_DIR"))
        if same:
            mine.append(pid)
    if not mine:
        return [], []
    shown = window_pids()
    return [p for p in mine if p not in shown], [p for p in mine if p in shown]


def stop_stuck_nyxt():
    """Close a Nyxt that can't answer and has nothing open, and say so; one
    that still has windows is the user's to close."""
    stuck, open_ = stuck_nyxts()
    for pid in stuck:
        for sig, wait in ((signal.SIGTERM, 3), (signal.SIGKILL, 1)):
            try:
                os.kill(pid, sig)
            except ProcessLookupError:
                break
            for _ in range(wait * 10):
                if not os.path.exists(f"/proc/{pid}"):
                    break
                time.sleep(0.1)
            if not os.path.exists(f"/proc/{pid}"):
                break
    if stuck:
        subprocess.run(["notify-send", "-a", "Docs", "A stuck Nyxt was closed",
                        "It had no window open and wasn't answering; a new one opens."])
    elif open_:
        subprocess.run(["notify-send", "-a", "Docs", "Nyxt isn't answering",
                        "The one open can't be reached (its socket is gone), so a second one opens. "
                        "Close the old one to have one again."])


def page(query):
    """The catalogue as a page in Nyxt (started first when it isn't running)."""
    if not shutil.which("nyxt"):
        die("the page is Nyxt's (vikix add lisp-apps); without it, Super+F2 or vikix docs find")
    form = f"(nyxt-user::vikix-docs-show {json.dumps(query)})"
    sock = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "nyxt", "nyxt.socket")
    def ask():
        try:
            r = subprocess.run(["nyxt", "--remote", "--quit", "--eval", form],
                               capture_output=True, text=True, timeout=20)
        except subprocess.TimeoutExpired:
            return False
        return r.returncode == 0
    if not (nyxt_listens(sock) and ask()):
        # Started with the page's address: Nyxt opens it after putting your
        # last session back, so it ends up in front. (Asked by --eval
        # instead, the page came first and the restored buffers covered it.)
        # A running Nyxt that didn't take the form takes the address.
        url = "nyxt:nyxt-user::vikix-docs-page?query=" + urllib.parse.quote(query, safe="")
        if not nyxt_listens(sock):
            stop_stuck_nyxt()
        nyxt = subprocess.Popen(["nyxt", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                start_new_session=True)
        for _ in range(60):
            if nyxt_listens(sock) or nyxt.poll() is not None:
                break
            time.sleep(0.5)
        if not nyxt_listens(sock):
            die("Nyxt didn't start (run nyxt in a terminal to see why)")
    # StumpWM brings Nyxt's window forward (vikix-docs-open does the same).
    subprocess.run(["vikix", "eval", '(vikix-raise-class "Nyxt")'], capture_output=True)
    return 0


def pick():
    fresh_enough()
    r = subprocess.run(["rofi", "-dmenu", "-p", "docs", "-l", "0", "-mesg",
                        "Words to find: Vikix's guides, your projects and notes, man and tldr pages, manuals, "
                        "the ArchWiki, the API references, PDFs; a web link says so"],
                       input="", capture_output=True, text=True)
    words = r.stdout.strip()
    if r.returncode != 0 or not words:
        return 0
    hits = find(words.split(), limit=40)
    if not hits:
        subprocess.run(["notify-send", "-a", "Docs", "Nothing found", f"for: {words}"])
        return 0
    # Ctrl+Enter is rofi's own (kb-accept-custom): freed first, or rofi
    # refuses to start ("already bound").
    r = subprocess.run(["rofi", "-dmenu", "-i", "-p", words, "-format", "i",
                        "-kb-accept-custom", "", "-kb-custom-1", "Control+Return",
                        "-mesg", "Enter opens it · Ctrl+Enter opens it the other way (a terminal, Emacs)"],
                       input="\n".join(hit_line(h) for h in hits), capture_output=True, text=True)
    if r.stdout.strip().isdigit() and r.returncode in (0, 10):
        open_doc(hits[int(r.stdout.strip())], other=r.returncode == 10)
    return 0


# --- Asking: a question answered from the documents you chose --------------------------------

ASK_SYSTEM = """You answer questions from the documents on the user's machine, given below in <document> tags, each with a number.
Use only what they say. After each fact, name the document it came from in brackets, like [2].
If the documents don't answer the question, say so plainly rather than guessing."""


def ai_conf():
    """~/.config/vikix/ai, Super+i's choice: use=local|claude, model=."""
    out = {}
    for line in read_text(os.path.join(CONFIG, "vikix", "ai")).splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            k, v = line.split("=", 1)
            out[k.strip()] = v.strip()
    return out


def ollama(path, body=None):
    import urllib.error
    import urllib.request
    host = os.environ.get("OLLAMA_HOST", "127.0.0.1:11434")
    base = host if host.startswith("http") else f"http://{host}"
    data = None if body is None else json.dumps(body).encode()
    try:
        return urllib.request.urlopen(urllib.request.Request(base + path, data=data,
                                                             headers={"content-type": "application/json"}), timeout=600)
    except urllib.error.HTTPError as e:
        die(f"Ollama said {e.code}: {e.read().decode(errors='replace').strip()}")
    except urllib.error.URLError:
        die("local AI isn't answering: vikix ai status (or vikix add local-ai). "
            "Nothing was sent anywhere; --claude sends the passages found to Anthropic instead")


def who_answers(claude=False, model=None):
    """('local', model) or ('claude', model). Local unless --claude or a
    Claude model is named: nothing goes to the cloud that wasn't asked for."""
    conf = ai_conf()
    if model and model.startswith("claude"):
        claude = True
    if claude:
        named = conf.get("model", "")
        return "claude", model or (named if named.startswith("claude") else CLAUDE_DEFAULT)
    if model:
        return "local", model
    named = conf.get("model", "")
    if named and not named.startswith("claude"):
        return "local", named
    names = [m["name"] for m in json.load(ollama("/api/tags"))["models"]]
    chat = [n for n in names if "embed" not in n and "minilm" not in n]
    if not chat:
        die("no local model to answer with: vikix ai models downloads one "
            "(or --claude, which sends the passages found to Anthropic)")
    return "local", LOCAL_DEFAULT if LOCAL_DEFAULT in chat else chat[0]


def asked_by_agent():
    """Whether an agent is above this process: vikix-eval's judgement
    (whose), Vikix's own scripts passed over. Then the user's own documents
    stay closed to it, as docs_search keeps them."""
    try:
        import importlib.machinery
        import importlib.util
        loader = importlib.machinery.SourceFileLoader("vikix_eval", os.path.join(vikix_dir(), "bin", "vikix-eval"))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        ev = importlib.util.module_from_spec(spec)
        loader.exec_module(ev)
        return ev.whose(past_vikix=True)[0] == "agent"
    except Exception:   # a missing or changed script never opens the documents
        return True


def ask_words(question):
    return [w for w in re.findall(r"\w+", question.lower()) if w not in STOP_WORDS and len(w) > 2]


def ask_find(question, sources, limit):
    """The documents that share the most words with the question, from the
    sources chosen; one row a document (a section stands for its file)."""
    words = ask_words(question)
    if not words:
        die("ask what? a question with a few words in it")
    query = []
    for w in words:
        query += [w, "OR"]
    hits, _ = find_fts(query[:-1], sources, limit * 4)
    found, seen = [], set()
    for h in hits:
        base = h["id"].split("#", 1)[0]
        if base in seen:
            continue
        seen.add(base)
        found.append(h)
        if len(found) == limit:
            break
    return found


def ask_local(model, prompt):
    with ollama("/api/chat", {"model": model, "options": {"temperature": 0.2},
                              "messages": [{"role": "system", "content": ASK_SYSTEM},
                                           {"role": "user", "content": prompt}]}) as r:
        for line in r:
            print(json.loads(line).get("message", {}).get("content", ""), end="", flush=True)
    print()


def ask_claude(model, prompt):
    """The passages to Anthropic's API, said plainly first; only when asked for."""
    import urllib.error
    import urllib.request
    key = os.environ.get("ANTHROPIC_API_KEY")
    if not key:
        die("Claude needs your key: vikix ai key set anthropic (then a new terminal); without --claude the answer is local")
    base = os.environ.get("ANTHROPIC_BASE_URL", "https://api.anthropic.com").rstrip("/")
    body = {"model": model, "max_tokens": 4000, "system": ASK_SYSTEM,
            "messages": [{"role": "user", "content": prompt}]}
    req = urllib.request.Request(base + "/v1/messages", data=json.dumps(body).encode(),
                                 headers={"x-api-key": key, "anthropic-version": "2023-06-01",
                                          "content-type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=600) as r:
            reply = json.load(r)
    except urllib.error.HTTPError as e:
        if e.code == 401:
            die("the key was refused: vikix ai key set anthropic")
        die(f"the API said {e.code}: {e.read().decode(errors='replace').strip()[:300]}")
    except urllib.error.URLError:
        die("couldn't reach Anthropic: is the network up? (without --claude the answer is local)")
    print("".join(c.get("text", "") for c in reply.get("content", []) if c.get("type") == "text"))
    if reply.get("stop_reason") == "refusal":
        print("(Claude declined to answer that.)", file=sys.stderr)


def ask(question, sources, claude=False, model=None, limit=ASK_LIMIT, dry=False):
    """A question answered from the documents found for it, with the
    documents named. The web's links are never read; a docset's entries
    are found by name (vikix docs find), not asked."""
    for s in sources:
        if s in ("web", "zeal"):
            die(f"{s} can't be asked: web links are never fetched, and a docset's entries are found by name "
                "(vikix docs find WORDS)")
        if s not in BOOST:
            die(f"no source {s} (vikix docs status lists them)")
    fresh_enough()
    found = ask_find(question, sources, limit)
    closed = 0
    if "own" in sources and asked_by_agent():
        config = own_config()
        kept = [h for h in found if h["source"] != "own" or own_open_to_agents(own_split(h)[0], config)]
        closed = len(found) - len(kept)
        found = kept
    if not found:
        die("nothing found to answer from" + (" (your own documents are closed to agents)" if closed else "")
            + f"; sources: {', '.join(sources)}")
    passages = []
    for n, h in enumerate(found, 1):
        text = " ".join(read(h).split())[:ASK_PASSAGE]
        passages.append(f'<document n="{n}" id="{html.escape(h["id"])}" title="{html.escape(h["title"])}">\n{text}\n</document>')
    prompt = "\n\n".join(passages) + f"\n\nQuestion: {question}"
    if dry:
        print(prompt)
        return
    kind, model = who_answers(claude, model)
    where = "on this laptop" if kind == "local" else f"these {len(found)} passages go to Anthropic"
    print(f"({model}, {where}; from {', '.join(sources)})", file=sys.stderr)
    if closed:
        print(f"({closed} of your own documents left out: closed to agents)", file=sys.stderr)
    (ask_claude if kind == "claude" else ask_local)(model, prompt)
    print("\nFrom:")
    for n, h in enumerate(found, 1):
        print(f"  [{n}] {h['id']} — {' '.join(h['title'].split())}")


# --- The watch on ~/src ---------------------------------------------------------------------
# One inotifywait over ~/src, started and stopped by hand; a document that
# changes there is read within a second, instead of at the day's sweep.
# Nothing else watches the disk.

WATCH_EXTS = (".md", ".pdf", ".org")
WATCH_SKIP = r"/(\.git|node_modules|\.cache|\.venv|__pycache__|out|build|dist)(/|$)"


def state_dir():
    return os.environ.get("VIKIX_STATE") or os.path.join(HOME, ".local/state/vikix")


def watch_pid_file():
    return os.path.join(state_dir(), "docs", "watch.pid")


def watch_pid():
    """The watcher's pid while one of ours is alive, else 0."""
    try:
        pid = int(read_text(watch_pid_file()).strip() or 0)
    except ValueError:
        pid = 0
    if pid <= 0:
        return 0
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            words = f.read().split(b"\0")
    except OSError:
        return 0
    return pid if any(w.endswith(b"vikix-docs") for w in words) and b"watch" in words else 0


def watch_state():
    pid = watch_pid()
    if not pid:
        return "off (vikix docs watch on reads a change in ~/src within a second)"
    since = time.strftime("%Y-%m-%d %H:%M", time.localtime(os.path.getmtime(watch_pid_file())))
    try:
        last = int(meta(connect(), "watch-last") or 0)
    except sqlite3.Error:
        last = 0
    seen = f", last change read {time.strftime('%H:%M', time.localtime(last))}" if last else ""
    return f"on {SRC} since {since} (pid {pid}){seen}"


def watch_on():
    if not shutil.which("inotifywait"):
        die("inotifywait isn't installed: vikix pkg add inotify-tools")
    if not os.path.isdir(SRC):
        die(f"nothing to watch: {SRC} isn't there")
    pid = watch_pid()
    if pid:
        print(f"already watching {SRC} (pid {pid})")
        return
    os.makedirs(os.path.dirname(watch_pid_file()), exist_ok=True)
    log = os.path.join(state_dir(), "docs", "watch.log")
    with open(log, "ab") as out:
        subprocess.Popen(["setsid", "-f", "python3", os.path.join(vikix_dir(), "bin", "vikix-docs"), "watch", "--run"],
                         stdin=subprocess.DEVNULL, stdout=out, stderr=out)
    for _ in range(50):
        if watch_pid():
            print(f"watching {SRC}: a document that changes there is read within a second "
                  "(vikix docs watch off stops it; it ends with the session)")
            return
        time.sleep(0.1)
    die(f"the watch didn't start ({log} says why)")


def watch_off():
    pid = watch_pid()
    if not pid:
        print(f"not watching {SRC}")
        return
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    for _ in range(30):
        if not os.path.exists(f"/proc/{pid}"):
            break
        time.sleep(0.1)
    else:
        os.kill(pid, signal.SIGKILL)
    try:
        os.remove(watch_pid_file())
    except OSError:
        pass
    print(f"the watch on {SRC} is off")


def watch_run():
    """The watcher itself: inotifywait's lines, gathered for a second, then
    those files read again (index_paths); ends with SIGTERM, taking
    inotifywait with it."""
    import select
    os.makedirs(os.path.dirname(watch_pid_file()), exist_ok=True)
    with open(watch_pid_file(), "w") as f:
        f.write(str(os.getpid()))
    child = subprocess.Popen(["inotifywait", "-m", "-r", "-q", "-e", "close_write,moved_to,create,delete,moved_from",
                              "--exclude", WATCH_SKIP, "--format", "%w%f", SRC], stdout=subprocess.PIPE)

    def stop(signum, frame):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    print(f"watching {SRC}", flush=True)
    buf, pending = b"", set()
    try:
        while True:
            ready, _, _ = select.select([child.stdout], [], [], 1.0 if pending else None)
            if ready:
                chunk = os.read(child.stdout.fileno(), 65536)
                if not chunk:
                    break
                buf += chunk
                lines = buf.split(b"\n")
                buf = lines.pop()
                for line in lines:
                    path = line.decode("utf-8", "replace")
                    if path.lower().endswith(WATCH_EXTS):
                        pending.add(path)
            elif pending:
                db = connect()
                with db:
                    n = index_paths(db, pending)
                    meta(db, "watch-last", int(time.time()))
                db.close()
                print(f"{time.strftime('%H:%M:%S')} read {n}: {' '.join(sorted(pending))[:300]}", flush=True)
                pending.clear()
    finally:
        child.terminate()
        try:
            child.wait(timeout=3)
        except subprocess.TimeoutExpired:
            child.kill()
        try:
            if read_text(watch_pid_file()).strip() == str(os.getpid()):
                os.remove(watch_pid_file())
        except OSError:
            pass


# --- Commands -------------------------------------------------------------------------------

def status():
    db = connect()
    rows = db.execute("SELECT source, count(*) FROM docs GROUP BY source ORDER BY count(*) DESC").fetchall()
    last = meta(db, "indexed")
    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(int(last))) if last else "never"
    print(f"{DB}  ({os.path.getsize(DB) / 1e6:.1f} MB), last read {when}")
    for s, n in rows:
        print(f"  {s:<6} {n:>6}")
    if not rows:
        print("  empty: vikix docs index")
    sets, entries = zeal_counts()
    if sets:
        print(f"  zeal   {entries:>6}  in {sets} docsets, read in place ({ZEAL})")
    print(f"  watch  {watch_state()}")


def listing(source=None):
    db = connect()
    if not source:
        for s_, n in db.execute("SELECT source, count(*) FROM docs GROUP BY source ORDER BY count(*) DESC"):
            print(f"{s_}\t{n}")
        sets, entries = zeal_counts()
        if sets:
            print(f"zeal\t{entries}")
        return
    for id_, title in db.execute("SELECT id, title FROM docs WHERE source = ? ORDER BY title COLLATE NOCASE",
                                 (source,)):
        print("\t".join([id_, source, " ".join(title.split()), ""]))


def main(argv):
    cmd = argv[0] if argv else ""
    args = argv[1:]
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
    elif cmd == "get":
        # The download of the offline docs, which plain `vikix docs` was.
        return subprocess.call(["bash", os.path.join(vikix_dir(), "install", "67-dev.sh")],
                               env=dict(os.environ, VIKIX_DOCS="1"))
    elif cmd == "":
        status()
        print("\nvikix docs find WORDS to search; vikix docs get for the offline programming docs "
              "(what plain vikix docs did before).")
    elif cmd == "find":
        as_json, as_tsv = "--json" in args, "--tsv" in args
        source, limit, words = None, 20, []
        it = iter(args)
        for a in it:
            if a in ("--json", "--tsv"):
                continue
            elif a == "--source":
                source = next(it, None)
            elif a == "--limit":
                limit = int(next(it, "20"))
            else:
                words.append(a)
        if not words:
            die("find what? vikix docs find WORDS")
        fresh_enough()
        hits = find(words, source, limit)
        if as_json:
            print(json.dumps(hits, ensure_ascii=False, indent=1))
        elif as_tsv:
            for h in hits:
                print("\t".join(" ".join(str(h[k]).split()) for k in ("id", "source", "title", "excerpt")))
        elif not hits:
            print("nothing found")
        else:
            for h in hits:
                print(hit_line(h))
                print(f"       {h['id']}")
    elif cmd == "list":
        listing(args[args.index("--source") + 1] if "--source" in args[:-1] else None)
    elif cmd == "pick":
        return pick()
    elif cmd == "page":
        return page(" ".join(args))
    elif cmd == "random":
        if any(arg != "--other" for arg in args):
            die("vikix docs random [--other]")
        random_guide(other="--other" in args)
    elif cmd in ("open", "read"):
        if not args:
            die(f"{cmd} which? the id vikix docs find shows")
        doc = get(args[0])
        if not doc:
            die(f"no document {args[0]} (vikix docs find WORDS shows the ids)")
        if doc["source"] not in ("man", "info", "pkg", "zeal", "web") and not os.path.exists(own_split(doc)[0]):
            die(f"{doc['path']} is gone since the last index (vikix docs index catches up)")
        if cmd == "read":
            print(read(doc))
        else:
            open_doc(doc, other="--other" in args)
    elif cmd == "ask":
        sources, claude, model, limit, dry, words = [], False, None, ASK_LIMIT, False, []
        it = iter(args)
        for a in it:
            if a == "--source":
                sources += (next(it, "") or "").split(",")
            elif a == "--claude":
                claude = True
            elif a == "--local":
                claude = False
            elif a == "--model":
                model = next(it, None)
            elif a == "--limit":
                limit = int(next(it, str(ASK_LIMIT)))
            elif a == "--show":
                dry = True
            else:
                words.append(a)
        if not words:
            die('ask what? vikix docs ask "QUESTION"')
        sources = [s for s in sources if s]
        if "all" in sources:
            sources = [s for s in BOOST if s != "web"]
        ask(" ".join(words), sources or list(ASK_SOURCES), claude, model, limit, dry)
    elif cmd == "watch":
        what = args[0] if args else "status"
        if what == "on":
            watch_on()
        elif what == "off":
            watch_off()
        elif what == "--run":
            watch_run()
        elif what == "status":
            print(watch_state())
        else:
            die("vikix docs watch on|off|status")
    elif cmd == "index":
        index(full="--full" in args, quiet="--quiet" in args)
    elif cmd == "status":
        status()
    else:
        die(f"no command {cmd} (vikix docs help)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
