#!/usr/bin/env python3
"""vikix-docs — every document on the machine in one catalogue, found from one key.

  vikix docs find WORDS... [--source S] [--limit N] [--json]
                                  the documents that match, best first: words
                                  as in a search box (the start of a word is
                                  enough), "exact words", a OR b
  vikix docs pick                 a search box, then the hits to open
                                  (Super+F2): Enter opens it, Ctrl+Enter in
                                  the other place (a terminal for a man page,
                                  Emacs for a page of Markdown)
  vikix docs open ID [--other]    open one, by the id find shows
  vikix docs read ID              one as plain text (what the agents read)
  vikix docs index [--full] [--quiet]
                                  read again what changed (--full: all of
                                  it); vikix update does it
  vikix docs status               how many from where, and when last read
  vikix docs get                  download the offline programming docs
                                  into ~/dev (a few GB, slow; what plain
                                  vikix docs did before)

What it covers, each with whose words they are: Vikix's guides (vikix);
the README, DESIGN, TODO, CLAUDE and log files and docs/ of your projects in
~/src (repo); the language guides in ~/dev (dev); your Org notes in
~/Dropbox/notes (note); every man page (man) and Info manual (info) on the
machine. Vikix's guides rank first, then yours, then the system's.

It reads again by itself what changed, when a search finds the catalogue
more than a day old (a few seconds); vikix update reads the man pages and
manuals again. A man page opens as a page in the docs browser, styled as the
guide is (cached in ~/.cache/vikix/docs/); an Info manual and your notes in
Emacs, a Markdown file in Emacs too.

The catalogue is one SQLite file, ~/.local/share/vikix/docs/index.db: table
docs (id, source, kind, title, path, excerpt, mtime) and docs_fts, its
full-text index. Nothing in it leaves the machine.
"""
import glob
import html
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
# The checkout this runs from (vikix mcp loads it without a __file__).
HERE = os.path.dirname(os.path.dirname(os.path.realpath(
    globals().get("__file__") or os.path.join(os.environ.get("VIKIX_DIR", os.path.expanduser("~/vikix")), "bin", "vikix-docs"))))
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share"), "vikix")
DB = os.environ.get("VIKIX_DOCS_DB") or os.path.join(DATA, "docs", "index.db")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "vikix", "docs")
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
SRC = os.environ.get("VIKIX_DOCS_SRC") or os.path.join(HOME, "src")
DEV = os.environ.get("VIKIX_DOCS_DEV") or os.path.join(HOME, "dev")
STALE = 24 * 3600                       # a search reads again what changed, after a day
BODY = 200_000                          # characters of a document indexed
BOOST = {"vikix": 3.0, "repo": 2.0, "dev": 2.0, "note": 2.0, "man": 1.0, "info": 1.0}
BADGE = {"vikix": "vikix", "repo": "repo", "dev": "dev", "note": "note", "man": "man", "info": "info"}
REPO_FILES = ("README.md", "DESIGN.md", "TODO.md", "CLAUDE.md", "IDEAS.md", "bugs.md", "log.md")


def die(msg):
    sys.exit(f"vikix docs: {msg}")


# --- The catalogue -------------------------------------------------------------------------

def connect():
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    db = sqlite3.connect(DB, timeout=30)
    db.executescript("""
      PRAGMA journal_mode=WAL;
      CREATE TABLE IF NOT EXISTS docs (rid INTEGER PRIMARY KEY, id TEXT UNIQUE, source TEXT, kind TEXT,
                                       title TEXT, path TEXT, excerpt TEXT, mtime REAL);
      -- Its rows are docs' by rowid: found and dropped by it, at once.
      CREATE VIRTUAL TABLE IF NOT EXISTS docs_fts USING fts5(title, body,
                                                             tokenize='unicode61 remove_diacritics 2');
      CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v TEXT);
    """)
    return db


def meta(db, k, v=None):
    if v is None:
        row = db.execute("SELECT v FROM meta WHERE k = ?", (k,)).fetchone()
        return row[0] if row else None
    db.execute("INSERT OR REPLACE INTO meta VALUES (?, ?)", (k, str(v)))


def put(db, doc, body):
    drop(db, doc["id"])
    cur = db.execute("INSERT INTO docs (id, source, kind, title, path, excerpt, mtime) VALUES (?, ?, ?, ?, ?, ?, ?)",
                     (doc["id"], doc["source"], doc["kind"], doc["title"], doc["path"], doc.get("excerpt", ""),
                      doc["mtime"]))
    db.execute("INSERT INTO docs_fts (rowid, title, body) VALUES (?, ?, ?)", (cur.lastrowid, doc["title"], body[:BODY]))


def drop(db, doc_id):
    row = db.execute("SELECT rid FROM docs WHERE id = ?", (doc_id,)).fetchone()
    if row:
        db.execute("DELETE FROM docs_fts WHERE rowid = ?", (row[0],))
        db.execute("DELETE FROM docs WHERE rid = ?", (row[0],))


def drop_source(db, source):
    db.execute("DELETE FROM docs_fts WHERE rowid IN (SELECT rid FROM docs WHERE source = ?)", (source,))
    db.execute("DELETE FROM docs WHERE source = ?", (source,))


def excerpt(text):
    text = re.sub(r"\s+", " ", text).strip()
    return text[:300]


# --- Where documents come from ------------------------------------------------------------

def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read(BODY)
    except OSError:
        return ""


def md_title(text, path):
    m = re.search(r"^# +(.+)$", text, re.M)
    return m.group(1).strip() if m else os.path.basename(path)


def md_plain(text):
    """Markdown, its marks taken off, for the excerpt."""
    text = re.sub(r"```.*?```", " ", text, flags=re.S)
    text = re.sub(r"^#+ +.*$", " ", text, count=1, flags=re.M)
    text = re.sub(r"[`*_>#|]", " ", text)
    return re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", text)


def vikix_dir():
    return os.environ.get("VIKIX_DIR") or HERE


def files_vikix():
    for path in sorted(glob.glob(os.path.join(vikix_dir(), "docs", "*.md"))):
        if os.path.basename(path) == "README.md":
            continue
        yield path, "guide"
    yield os.path.join(vikix_dir(), "README.md"), "readme"


def files_repo():
    if not os.path.isdir(SRC):
        return
    for name in sorted(os.listdir(SRC)):
        project = os.path.join(SRC, name)
        # A project, not a worktree of one (its .git is a file there).
        if not os.path.isdir(os.path.join(project, ".git")):
            continue
        for f in REPO_FILES:
            p = os.path.join(project, f)
            if os.path.isfile(p):
                kind = {"README.md": "readme", "TODO.md": "todo", "log.md": "log"}.get(f, "design")
                yield p, kind
        for p in sorted(glob.glob(os.path.join(project, "DESIGN-*.md"))):
            yield p, "design"
        # A checkout of Vikix: its guides are the vikix source's already.
        if os.path.exists(os.path.join(project, "docs", "guide.css")):
            continue
        for root, dirs, files in os.walk(os.path.join(project, "docs")):
            dirs[:] = [d for d in dirs if not d.startswith(".") and d != "node_modules"]
            if root.count(os.sep) - project.count(os.sep) > 3:
                continue
            for f in sorted(files):
                if f.endswith(".md"):
                    yield os.path.join(root, f), "doc"


def files_dev():
    for p in sorted(glob.glob(os.path.join(DEV, "*", "README.md"))):
        yield p, "guide"


def notes_dir():
    """The notes: the inbox plugin's folder, or ~/Dropbox/notes."""
    settings = os.path.join(CONFIG, "vikix", "plugins", "inbox", "settings")
    try:
        with open(settings) as f:
            for line in f:
                k, _, v = line.partition("=")
                if k.strip() == "file" and v.strip():
                    return os.path.dirname(os.path.expanduser(v.strip()))
    except FileNotFoundError:
        pass
    return os.path.join(HOME, "Dropbox", "notes")


def files_note():
    root = notes_dir()
    for dirpath, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d != "attachments"]
        for f in sorted(files):
            if f.endswith(".org"):
                yield os.path.join(dirpath, f), "note"


def org_title(text, path):
    m = re.search(r"^#\+title:\s*(.+)$", text, re.M | re.I)
    if m:
        return m.group(1).strip()
    m = re.search(r"^\*+ +(.+)$", text, re.M)
    return m.group(1).strip() if m and os.path.basename(path) == "inbox.org" else os.path.basename(path)[:-4]


def org_plain(text):
    text = re.sub(r"^:PROPERTIES:.*?^:END:\s*$", " ", text, flags=re.M | re.S)
    text = re.sub(r"^#\+\w+:.*$", " ", text, flags=re.M)
    text = re.sub(r"\[\[[^\]]*\]\[([^\]]*)\]\]", r"\1", text)
    return re.sub(r"\[\[([^\]]*)\]\]", r"\1", text)


def index_files(db, source, files, title_of, plain, full):
    """Each file read again when it changed; the gone ones dropped."""
    seen = set()
    known = dict(db.execute("SELECT id, mtime FROM docs WHERE source = ?", (source,)).fetchall())
    changed = 0
    for path, kind in files:
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            continue
        doc_id = f"{source}:{path}"
        seen.add(doc_id)
        if not full and known.get(doc_id) == mtime:
            continue
        text = read_text(path)
        body = plain(text)
        title = title_of(text, path)
        if source == "repo":
            title = f"{title} ({os.path.relpath(path, SRC)})"
        put(db, {"id": doc_id, "source": source, "kind": kind, "title": title, "path": path,
                 "excerpt": excerpt(body), "mtime": mtime}, body)
        changed += 1
    for doc_id in set(known) - seen:
        drop(db, doc_id)
    return changed


def man_db_mtime():
    stamps = []
    for d in ("/usr/share/man", "/usr/local/share/man", os.path.join(HOME, ".local/share/man")):
        p = os.path.join(d, "mandoc.db")
        if os.path.exists(p):
            stamps.append(os.path.getmtime(p))
    return max(stamps) if stamps else 0


def index_man(db, full):
    """Every man page's names and one line, from apropos (makewhatis's index)."""
    stamp = str(man_db_mtime())
    if not full and meta(db, "man-stamp") == stamp:
        return 0
    r = subprocess.run(["apropos", "."], capture_output=True, text=True,
                       env=dict(os.environ, MANPATH=os.environ.get("MANPATH") or
                                f"{HOME}/.local/share/man:/usr/local/share/man:/usr/share/man"))
    drop_source(db, "man")
    n = 0
    for line in r.stdout.splitlines():
        m = re.match(r"^(.+?)\(([^)]+)\)\s+-\s+(.*)$", line)
        if not m:
            continue
        names = [x.strip() for x in m.group(1).split(",") if x.strip()]
        section = m.group(2).split(",")[0].strip()
        desc = m.group(3).strip()
        name = names[0]
        doc_id = f"man:{name}({section})"
        put(db, {"id": doc_id, "source": "man", "kind": "man", "title": f"{name}({section}) — {desc}",
                 "path": f"{section} {name}", "excerpt": desc, "mtime": 0}, " ".join(names) + " " + desc)
        n += 1
    meta(db, "man-stamp", stamp)
    return n


def index_info(db, full):
    """Each Info manual, from the directories' dir files."""
    dirs = [d for d in (os.path.join(HOME, ".local/share/info"), "/usr/local/share/info", "/usr/share/info")
            if os.path.exists(os.path.join(d, "dir"))]
    stamp = str(max((os.path.getmtime(os.path.join(d, "dir")) for d in dirs), default=0))
    if not full and meta(db, "info-stamp") == stamp:
        return 0
    drop_source(db, "info")
    n = 0
    for d in dirs:
        text = read_text(os.path.join(d, "dir"))
        for m in re.finditer(r"^\* ([^:]+): \(([^)]+)\)([^.]*)\.\s*(.*(?:\n {10,}.*)*)", text, re.M):
            name, manual, node, desc = m.group(1).strip(), m.group(2), m.group(3).strip() or "Top", " ".join(m.group(4).split())
            doc_id = f"info:({manual}){node}"
            if db.execute("SELECT 1 FROM docs WHERE id = ?", (doc_id,)).fetchone():
                continue
            put(db, {"id": doc_id, "source": "info", "kind": "info", "title": f"{name} — {desc}" if desc else name,
                     "path": f"({manual}){node}", "excerpt": desc, "mtime": 0}, f"{name} {manual} {desc}")
            n += 1
    meta(db, "info-stamp", stamp)
    return n


def index(full=False, quiet=False):
    t0 = time.time()
    db = connect()
    counts = {}
    with db:
        counts["vikix"] = index_files(db, "vikix", files_vikix(), md_title, md_plain, full)
        counts["repo"] = index_files(db, "repo", files_repo(), md_title, md_plain, full)
        counts["dev"] = index_files(db, "dev", files_dev(), md_title, md_plain, full)
        counts["note"] = index_files(db, "note", files_note(), org_title, org_plain, full)
        # VIKIX_DOCS_SOURCES limits what's read (the tests leave the system's out).
        only = os.environ.get("VIKIX_DOCS_SOURCES", "man info").split()
        if "man" in only:
            counts["man"] = index_man(db, full)
        if "info" in only:
            counts["info"] = index_info(db, full)
        meta(db, "indexed", int(time.time()))
    if not quiet:
        read = ", ".join(f"{n} {s}" for s, n in counts.items() if n)
        print(f"Read {read or 'nothing new'} in {time.time() - t0:.1f} s.")
    return counts


def fresh_enough():
    """Read again what changed, when the catalogue is more than a day old."""
    try:
        db = connect()
        last = int(meta(db, "indexed") or 0)
        db.close()
    except sqlite3.Error:
        last = 0
    if time.time() - last > STALE:
        index(quiet=True)


# --- Searching ------------------------------------------------------------------------------

def fts_query(words):
    """Words as in a search box: each the start of a word, "exact words", OR."""
    out = []
    for tok in re.findall(r'"[^"]+"|\S+', " ".join(words)):
        if tok.startswith('"'):
            inner = re.sub(r"[^\w\s]", " ", tok[1:-1]).strip()
            if inner:
                out.append(f'"{inner}"')
        elif tok == "OR":
            out.append("OR")
        else:
            parts = [p for p in re.split(r"[^\w]+", tok) if p]
            out += [f'"{p}"*' for p in parts]
    while out and out[0] == "OR":
        out.pop(0)
    while out and out[-1] == "OR":
        out.pop()
    return " ".join(out)


def find(words, source=None, limit=20):
    q = fts_query(words)
    if not q:
        return []
    db = connect()
    cases = " ".join(f"WHEN '{s}' THEN {b}" for s, b in BOOST.items())
    sql = (f"SELECT d.id, d.source, d.kind, d.title, d.path, d.excerpt, "
           f"bm25(docs_fts, 10.0, 1.0) * (CASE d.source {cases} ELSE 1 END) AS score "
           f"FROM docs_fts JOIN docs d ON d.rid = docs_fts.rowid WHERE docs_fts MATCH ?")
    args = [q]
    if source:
        sql += " AND d.source = ?"
        args.append(source)
    sql += " ORDER BY score LIMIT ?"
    args.append(limit)
    try:
        rows = db.execute(sql, args).fetchall()
    except sqlite3.OperationalError:
        return []
    keys = ("id", "source", "kind", "title", "path", "excerpt")
    return [dict(zip(keys, r[:6])) for r in rows]


def get(doc_id):
    db = connect()
    r = db.execute("SELECT id, source, kind, title, path, excerpt FROM docs WHERE id = ?", (doc_id,)).fetchone()
    return dict(zip(("id", "source", "kind", "title", "path", "excerpt"), r)) if r else None


# --- Reading and opening --------------------------------------------------------------------

def man_args(doc):
    section, name = doc["path"].split(" ", 1)
    return section, name


def read(doc):
    """A document as plain text."""
    if doc["source"] == "man":
        section, name = man_args(doc)
        r = subprocess.run(["man", section, name], capture_output=True, text=True,
                           env=dict(os.environ, MANPAGER="cat", PAGER="cat", MANWIDTH="80"))
        return re.sub(r".\x08", "", r.stdout)
    if doc["source"] == "info":
        r = subprocess.run(["info", "-o", "-", doc["path"]], capture_output=True, text=True)
        return r.stdout
    return read_text(doc["path"])


def guide_page(path):
    """The built HTML page of a guide (~/.local/share/vikix/guide), by its title."""
    guide = os.path.join(DATA, "guide")
    title = md_title(read_text(path), path)
    want = re.sub(r"[^\w]+", "-", title).strip("-").lower()
    for f in glob.glob(os.path.join(guide, "*.html")):
        if re.sub(r"[^\w]+", "-", os.path.basename(f)[:-5]).strip("-").lower() == want:
            return f
    return None


def man_html(doc):
    """A man page as a page styled as the guide is, cached."""
    section, name = man_args(doc)
    out = os.path.join(CACHE, "man", f"{name}.{section}.html")
    if os.path.exists(out):
        return out
    src = subprocess.run(["man", "-w", section, name], capture_output=True, text=True).stdout.strip().splitlines()
    if not src or not shutil.which("mandoc"):
        return None
    css = os.path.join(vikix_dir(), "docs", "guide.css")
    r = subprocess.run(["mandoc", "-Thtml", f"-Ostyle=file://{css}", src[0]], capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout:
        return None
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w") as f:
        f.write(r.stdout)
    return out


def terminal(argv):
    term = (os.environ.get("VIKIX_TERMINAL") or "alacritty").split()
    subprocess.Popen(["setsid", "-f", *term, "-e", *argv], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def emacs(args):
    if shutil.which("emacsclient"):
        subprocess.Popen(["emacsclient", "-c", "-n", *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    return False


def docs_open(paths):
    subprocess.Popen([os.path.join(vikix_dir(), "bin", "vikix-docs-open"), *paths],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def open_doc(doc, other=False):
    src = doc["source"]
    if src == "man":
        section, name = man_args(doc)
        page = None if other else man_html(doc)
        if page:
            docs_open([page])
        else:
            terminal(["man", section, name])
    elif src == "info":
        if other or not emacs(["-e", f'(info "{doc["path"]}")']):
            terminal(["info", doc["path"]])
    elif src == "vikix" and not other:
        page = guide_page(doc["path"])
        docs_open([page]) if page else emacs([doc["path"]]) or docs_open([doc["path"]])
    else:
        if not emacs([doc["path"]]):
            docs_open([doc["path"]])


def hit_line(h):
    ex = h["excerpt"] if h["source"] in ("man", "info") else ""
    title = h["title"] if not ex or ex in h["title"] else f"{h['title']} — {ex}"
    return f"{BADGE.get(h['source'], h['source']):<5}  {title[:160]}"


def pick():
    fresh_enough()
    r = subprocess.run(["rofi", "-dmenu", "-p", "docs", "-l", "0", "-mesg",
                        "Words to find: Vikix's guides, your projects and notes, man pages, manuals"],
                       input="", capture_output=True, text=True)
    words = r.stdout.strip()
    if r.returncode != 0 or not words:
        return 0
    hits = find(words.split(), limit=40)
    if not hits:
        subprocess.run(["notify-send", "-a", "Docs", "Nothing found", f"for: {words}"])
        return 0
    # Ctrl+Enter is rofi's own (kb-accept-custom): freed first, or rofi
    # refuses to start ("already bound").
    r = subprocess.run(["rofi", "-dmenu", "-i", "-p", words, "-format", "i",
                        "-kb-accept-custom", "", "-kb-custom-1", "Control+Return",
                        "-mesg", "Enter opens it · Ctrl+Enter opens it the other way (a terminal, Emacs)"],
                       input="\n".join(hit_line(h) for h in hits), capture_output=True, text=True)
    if r.stdout.strip().isdigit() and r.returncode in (0, 10):
        open_doc(hits[int(r.stdout.strip())], other=r.returncode == 10)
    return 0


# --- Commands -------------------------------------------------------------------------------

def status():
    db = connect()
    rows = db.execute("SELECT source, count(*) FROM docs GROUP BY source ORDER BY count(*) DESC").fetchall()
    last = meta(db, "indexed")
    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(int(last))) if last else "never"
    print(f"{DB}  ({os.path.getsize(DB) / 1e6:.1f} MB), last read {when}")
    for s, n in rows:
        print(f"  {s:<6} {n:>6}")
    if not rows:
        print("  empty: vikix docs index")


def main(argv):
    cmd = argv[0] if argv else ""
    args = argv[1:]
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
    elif cmd == "get":
        # The download of the offline docs, which plain `vikix docs` was.
        return subprocess.call(["bash", os.path.join(vikix_dir(), "install", "67-dev.sh")],
                               env=dict(os.environ, VIKIX_DOCS="1"))
    elif cmd == "":
        status()
        print("\nvikix docs find WORDS to search; vikix docs get for the offline programming docs "
              "(what plain vikix docs did before).")
    elif cmd == "find":
        as_json = "--json" in args
        source, limit, words = None, 20, []
        it = iter(args)
        for a in it:
            if a == "--json":
                continue
            elif a == "--source":
                source = next(it, None)
            elif a == "--limit":
                limit = int(next(it, "20"))
            else:
                words.append(a)
        if not words:
            die("find what? vikix docs find WORDS")
        fresh_enough()
        hits = find(words, source, limit)
        if as_json:
            print(json.dumps(hits, ensure_ascii=False, indent=1))
        elif not hits:
            print("nothing found")
        else:
            for h in hits:
                print(hit_line(h))
                print(f"       {h['id']}")
    elif cmd == "pick":
        return pick()
    elif cmd in ("open", "read"):
        if not args:
            die(f"{cmd} which? the id vikix docs find shows")
        doc = get(args[0])
        if not doc:
            die(f"no document {args[0]} (vikix docs find WORDS shows the ids)")
        if cmd == "read":
            print(read(doc))
        else:
            open_doc(doc, other="--other" in args)
    elif cmd == "index":
        index(full="--full" in args, quiet="--quiet" in args)
    elif cmd == "status":
        status()
    else:
        die(f"no command {cmd} (vikix docs help)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
