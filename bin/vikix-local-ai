#!/usr/bin/env bash
# vikix-local-ai — AI models that run on this machine, with Ollama.
#
#   vikix ai setup        install Ollama (its CPU and Vulkan parts, as you,
#                         in ~/.local/opt/ollama; no password) and start it.
#                         It starts with the desktop from then on
#   vikix ai models       pick a model to download: each says what it's
#                         for, its size, and how it runs on this machine
#                         (fast, well, slowly); ones too big aren't offered
#   vikix ai chat [MODEL] talk to one, in the terminal (/bye or Ctrl+D to
#                         leave); Super+m, Local AI: talk to a model
#   vikix ai list         the models you have, and their sizes
#   vikix ai remove MODEL delete one (it can be downloaded again)
#   vikix ai status       installed? running? which model is loaded, how
#                         much memory it holds and until when
#   vikix ai stop         unload the model now (it unloads by itself after
#                         5 minutes unused)
#   vikix ai uninstall [--models]   take Ollama away; --models deletes the
#                         downloaded models too
#   vikix ai llm [--default MODEL]   Simon Willison's llm on the command line
#                         (with its Ollama and Anthropic plugins), so that
#                         cat notes.md | llm "summarise" works. Its default
#                         is a local model if you have one, else Claude
#                         when ANTHROPIC_API_KEY is set (vikix ai key)
#
# Its API is on http://127.0.0.1:11434 (only this machine; the Windows VM
# can't reach it). The bar says "ai" while a model is loaded in memory.
# Models are big: they're in ~/.ollama/models, and backups leave them out.
#
# Honest about a laptop without a graphics card. Measured on an i7-7500U
# with llama3.2:3b: about 4 s to load, then about 11 s for two sentences.
# Models of 1-2 billion parameters are about twice as quick, 7-8 billion
# about three times as slow; bigger ones don't fit.

set -euo pipefail
VIKIX_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../lib/common.sh
. "$VIKIX_DIR/lib/common.sh"

# Pinned: a new version means a new line here. The checksum is the one
# GitHub publishes for the release asset. (The VIKIX_OLLAMA_* variables are
# for tests/ai-local.sh.)
OLLAMA_VERSION=0.34.4
OLLAMA_URL=${VIKIX_OLLAMA_URL:-https://github.com/ollama/ollama/releases/download/v$OLLAMA_VERSION/ollama-linux-amd64.tar.zst}
OLLAMA_SHA256=${VIKIX_OLLAMA_SHA256:-c238986e61d40c0cc5f4a9b9e40b9eea104350b77efa34741fc134e105cb9533}

OPT="${VIKIX_OLLAMA_OPT:-$HOME/.local/opt/ollama}"
OLLAMA="$OPT/bin/ollama"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/vikix"
HOST=127.0.0.1:11434
LOADED="$VIKIX_STATE/ai-loaded"         # the bar's "ai": the loaded models, one a line
MODELS_TABLE="$VIKIX_DIR/lib/ai-models.tsv"
API="http://$HOST/api"

installed() { [ -x "$OLLAMA" ]; }
running() { curl -fsS --max-time 2 "$API/version" >/dev/null 2>&1; }
need_installed() { installed || die "Ollama isn't installed: vikix ai setup"; }

# Ollama's commands talk to its server: start one if it isn't there (the
# desktop starts it at login; this is for a shell outside it, or before).
need_running() {
  need_installed
  running && return 0
  setsid "$0" serve >/dev/null 2>&1 < /dev/null &
  local _
  for _ in $(seq 30); do running && return 0; sleep 0.5; done
  die "Ollama didn't start; see $VIKIX_STATE/ollama.log"
}

ollama() { OLLAMA_HOST=$HOST "$OLLAMA" "$@"; }

# --- setup -------------------------------------------------------------------------
cmd_setup() {
  if installed && [ "$(cat "$OPT/VERSION" 2>/dev/null)" = "$OLLAMA_VERSION" ]; then
    say "Ollama $OLLAMA_VERSION is installed"
  else
    local archive="$CACHE/ollama-linux-amd64-v$OLLAMA_VERSION.tar.zst"
    mkdir -p "$CACHE"
    if [ -f "$archive" ] && [ "$(sha256sum "$archive" | cut -d' ' -f1)" = "$OLLAMA_SHA256" ]; then
      say "Ollama $OLLAMA_VERSION: already downloaded"
    else
      say "downloading Ollama $OLLAMA_VERSION (1.4 GB; most of it is for graphics cards, and isn't kept)"
      curl -fL --retry 3 -C - -o "$archive.part" "$OLLAMA_URL" || die "couldn't download $OLLAMA_URL"
      if [ "$(sha256sum "$archive.part" | cut -d' ' -f1)" != "$OLLAMA_SHA256" ]; then
        rm -f "$archive.part"
        die "the download isn't what it should be (its checksum doesn't match); deleted it. Try again later."
      fi
      mv "$archive.part" "$archive"
    fi
    say "unpacking the parts this machine uses (the CPU's, and Vulkan's for later)"
    rm -rf "$OPT.new"
    mkdir -p "$OPT.new"
    # Python unpacks zstd (3.14) and refuses paths that leave the folder
    # (filter="data"). NVIDIA's and AMD's libraries (2 GB) stay out.
    python3 - "$archive" "$OPT.new" <<'PY' || { rm -rf "$OPT.new"; die "couldn't unpack Ollama"; }
import sys, tarfile
from compression import zstd
archive, dest = sys.argv[1:]
skip = ("lib/ollama/cuda_", "lib/ollama/rocm", "lib/ollama/mlx")
with zstd.open(archive) as f, tarfile.open(fileobj=f, mode="r|") as t:
    for m in t:
        name = m.name.lstrip("./")
        if name.startswith(skip):
            continue
        t.extract(m, dest, filter="data")
PY
    [ -x "$OPT.new/bin/ollama" ] || { rm -rf "$OPT.new"; die "the download had no bin/ollama"; }
    echo "$OLLAMA_VERSION" > "$OPT.new/VERSION"
    # A running one keeps its old files open; it gets the new ones at the next start.
    rm -rf "$OPT.old"; [ -d "$OPT" ] && mv "$OPT" "$OPT.old"
    mv "$OPT.new" "$OPT"; rm -rf "$OPT.old"
    rm -f "$archive"                    # 1.4 GB, not needed now
    say "installed Ollama $OLLAMA_VERSION in $OPT ($(du -sh "$OPT" | cut -f1))"
  fi
  # `ollama` on PATH, for ollama run and the like.
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$OLLAMA" "$HOME/.local/bin/ollama"
  # Models are big, and can be downloaded again: backups leave them out.
  local exclude="${XDG_CONFIG_HOME:-$HOME/.config}/vikix/backup-exclude"
  if [ -f "$exclude" ] && ! grep -qF '.ollama/models' "$exclude"; then
    ensure_block "$exclude" ollama-models \
'# Local AI models (vikix ai): big, and they download again
$HOME/.ollama/models'
  fi
  if running; then
    say "Ollama is running on $HOST"
  else
    setsid "$0" serve >/dev/null 2>&1 < /dev/null &
    say "Ollama is starting (from now on, with the desktop)"
  fi
  echo "   Next, choose a model: vikix ai models (or Super+m, Local AI: choose a model)"
}

# --- serving, for the session --------------------------------------------------------
# Runs Ollama, and every 15 s notes which models are loaded, for the bar.
# vikix-session starts it; it ends with Ollama.
cmd_serve() {
  need_installed
  running && exit 0                    # one is enough
  mkdir -p "$VIKIX_STATE"
  # Ollama logs every request: keep one old log, not a growing one.
  local log="$VIKIX_STATE/ollama.log"
  if [ -f "$log" ] && [ "$(stat -c %s "$log")" -gt 1048576 ]; then mv -f "$log" "$log.old"; fi
  OLLAMA_HOST=$HOST "$OLLAMA" serve >> "$VIKIX_STATE/ollama.log" 2>&1 &
  # Global, not local: the EXIT trap runs after this function has returned.
  SERVE_PID=$!
  echo $$ > "$VIKIX_STATE/ollama-serve.pid"       # for uninstall: this one, not any by name
  trap 'kill "${SERVE_PID:-}" 2>/dev/null || true; rm -f "$LOADED" "$VIKIX_STATE/ollama-serve.pid"' EXIT INT TERM
  while kill -0 "$SERVE_PID" 2>/dev/null; do
    note_loaded
    sleep 15
  done
}

note_loaded() {
  local names
  names=$(curl -fsS --max-time 2 "$API/ps" 2>/dev/null |
          python3 -c 'import json,sys; [print(m["name"]) for m in json.load(sys.stdin).get("models", [])]' 2>/dev/null) || names=''
  if [ -n "$names" ]; then printf '%s\n' "$names" > "$LOADED"; else rm -f "$LOADED"; fi
}

# --- models -------------------------------------------------------------------------
# The table, for this machine: MODEL GB SPEED WHAT, with SPEED one of
# fast, well, slowly, or "too big" when it wouldn't fit in memory.
mem_gb() { awk '/^MemTotal:/ { printf "%.0f", $2 / 1048576 }' "${VIKIX_MEMINFO:-/proc/meminfo}"; }
offer() {
  local mem
  mem=$(mem_gb)
  read_list "$MODELS_TABLE" | awk -F'\t' -v mem="$mem" '
    { b = $2 + 0; gb = $3 + 0
      # In memory it takes a little more than its download, and the
      # desktop needs room too.
      if (gb * 1.3 + 3 > mem) speed = "too big"
      else if (b <= 2) speed = "fast"
      else if (b <= 4) speed = "well"
      else if (b <= 8) speed = "slowly"
      else speed = "too big"
      printf "%s\t%s\t%s\t%s\n", $1, $3, speed, $4 }'
}

have_models() { running && ollama list 2>/dev/null | awk 'NR > 1 { print $1 }' || true; }

cmd_models() {
  local how=${1:-}
  if [ "$how" = --rofi ] && ! installed; then
    notify-send -a Vikix "Local AI isn't set up" "In a terminal: vikix ai setup (no password needed)" 2>/dev/null || true
    exit 0
  fi
  need_installed
  local have rows line model
  have=$(have_models)
  rows=$(offer | awk -F'\t' '$3 != "too big"')
  [ -n "$rows" ] || die "this machine hasn't the memory for any of the models ($(mem_gb) GB)"
  menu() {
    printf '%s\n' "$rows" | while IFS=$'\t' read -r m gb speed what; do
      mark=' '; grep -qx -- "$m" <<<"$have" && mark='✓'
      printf '%s %-20s %5s GB  runs %-7s %s\n' "$mark" "$m" "$gb" "$speed" "$what"
    done
  }
  if [ "$how" = --print ]; then menu; return 0; fi
  if [ "$how" = --rofi ]; then
    # The list first, then rofi: a pipe into it, with pipefail, reads as
    # "cancelled" whenever rofi returns before reading all of it.
    local choices; choices=$(menu)
    line=$(rofi -dmenu -i -p "Model to download ($(mem_gb) GB of memory here)" -no-custom <<<"$choices") || exit 0
  else
    echo "Models for this machine ($(mem_gb) GB of memory, $(nproc) CPU threads, no graphics card used):"
    echo "✓ = you have it. Bigger answers better, and slower. Roughly, on a laptop like this:"
    echo "  fast: a short answer in 5-10 s   well: 10-20 s   slowly: a minute or more"
    menu | nl -w2 -s') '
    local n
    read -r -p "Number to download (Enter for none): " n
    [ -n "$n" ] || exit 0
    line=$(menu | sed -n "${n}p")
    [ -n "$line" ] || die "no model number $n"
  fi
  # The first word with a colon (llama3.2:3b): the line may start with a
  # ✓ or with nothing, so no fixed column.
  model=$(awk '{ for (i = 1; i <= NF; i++) if ($i ~ /:/) { print $i; exit } }' <<<"$line")
  [ -n "$model" ] || die "couldn't tell which model that was: $line"
  if [ "$how" = --rofi ]; then
    # A download takes minutes, and shows its progress: in a terminal.
    exec "${VIKIX_TERMINAL:-alacritty}" -e sh -c "\"$0\" pull '$model'; printf '\\nEnter closes this window. '; read x"
  fi
  cmd_pull "$model"
}

cmd_pull() {
  local model=${1:-}
  [ -n "$model" ] || die "which model? Choose one with: vikix ai models"
  need_running
  say "downloading $model (it's kept in ~/.ollama/models)"
  ollama pull "$model"
  say "ready. Try it: ollama run $model"
}

cmd_list() {
  need_running
  ollama list
  echo "(in ~/.ollama/models; vikix ai remove MODEL deletes one)"
}

# Ollama's terminal control codes, out of messages.
plain() { sed 's/\x1b\[[0-9;?]*[A-Za-z]//g; s/\r//g'; }

# The models you have, one name a line (from the API: no terminal codes).
have_names() {
  curl -fsS --max-time 5 "$API/tags" 2>/dev/null |
    python3 -c 'import json,sys; [print(m["name"]) for m in json.load(sys.stdin).get("models", [])]' 2>/dev/null || true
}

# The loaded models: NAME<TAB>GB of memory<TAB>unloads at HH:MM
loaded_models() {
  curl -fsS --max-time 2 "$API/ps" 2>/dev/null | python3 -c '
import json, sys, datetime
for m in json.load(sys.stdin).get("models", []):
    until = ""
    try:
        until = datetime.datetime.fromisoformat(m["expires_at"]).astimezone().strftime("%H:%M")
    except Exception:
        pass
    print("%s\t%.1f\t%s" % (m["name"], m.get("size", 0) / 1e9, until))' 2>/dev/null || true
}

cmd_remove() {
  local model=${1:-}
  [ -n "$model" ] || die "which model? vikix ai list shows the ones you have"
  need_running
  grep -qx -- "$model" <<<"$(have_names)" || die "you don't have $model (vikix ai list)"
  ollama rm "$model" 2>&1 | plain
}

cmd_status() {
  if ! installed; then echo "Ollama: not installed (vikix ai setup)"; return 0; fi
  local v; v=$(cat "$OPT/VERSION" 2>/dev/null || echo "?")
  echo "Ollama:  $v in $OPT$([ "$v" != "$OLLAMA_VERSION" ] && echo "; $OLLAMA_VERSION is out: vikix ai setup")"
  if running; then
    echo "running: yes, on $HOST (this machine only)"
    local loaded name gb until
    loaded=$(loaded_models)
    if [ -z "$loaded" ]; then
      echo "loaded:  none (a model loads when it's asked something)"
    else
      while IFS=$'\t' read -r name gb until; do
        echo "loaded:  $name, holding $gb GB of memory${until:+, until $until} (vikix ai stop frees it now)"
      done <<<"$loaded"
    fi
  else
    echo "running: no (it starts with the desktop; vikix ai setup starts it now)"
  fi
  [ -d "$HOME/.ollama/models" ] && echo "models:  $(du -sh "$HOME/.ollama/models" 2>/dev/null | cut -f1) on disk in ~/.ollama/models (not backed up; vikix ai list)"
  echo "log:     $VIKIX_STATE/ollama.log"
  return 0
}

# Unload now, through the API (keep_alive 0): no terminal codes, and a
# notification when it's asked from Super+m.
cmd_stop() {
  local how=${1:-} said
  say_it() { if [ "$how" = --notify ]; then notify-send -a Vikix "Local AI" "$1" 2>/dev/null || true; else say "$1"; fi; }
  installed || { say_it "Local AI isn't set up (vikix ai setup)"; return 0; }
  running || { say_it "Ollama isn't running, so nothing is loaded"; return 0; }
  local m freed=''
  while IFS=$'\t' read -r m _ _; do
    [ -n "$m" ] || continue
    curl -fsS --max-time 30 "$API/generate" -d "{\"model\": \"$m\", \"keep_alive\": 0}" >/dev/null 2>&1 &&
      freed+="${freed:+, }$m"
  done <<<"$(loaded_models)"
  note_loaded
  if [ -n "$freed" ]; then said="unloaded $freed: its memory is free"; else said="no model was loaded"; fi
  say_it "$said"
}

# Talk to a model you have: ollama run, in this terminal or (from Super+m)
# a new one. One model: that one; several: pick.
cmd_chat() {
  local how='' model=''
  for a in "$@"; do case $a in --rofi) how=--rofi ;; *) model=$a ;; esac; done
  if [ "$how" = --rofi ] && ! installed; then
    notify-send -a Vikix "Local AI isn't set up" "In a terminal: vikix ai setup (no password needed)" 2>/dev/null || true; exit 0
  fi
  need_running
  local names; names=$(have_names)
  if [ -z "$names" ]; then
    if [ "$how" = --rofi ]; then
      notify-send -a Vikix "No local model yet" "Choose one: Super+m, Local AI: choose a model" 2>/dev/null || true; exit 0
    fi
    die "no model yet: choose one with vikix ai models"
  fi
  if [ -z "$model" ]; then
    if [ "$(wc -l <<<"$names")" = 1 ]; then
      model=$names
    elif [ "$how" = --rofi ]; then
      model=$(rofi -dmenu -i -p "Talk to" -no-custom <<<"$names") || exit 0
    else
      nl -w2 -s') ' <<<"$names"
      local n; read -r -p "Which (number): " n
      model=$(sed -n "${n}p" <<<"$names")
    fi
  fi
  grep -qx -- "$model" <<<"$names" || die "you don't have $model (vikix ai list)"
  local hello="Talking to $model, on this machine. To leave: /bye, or Ctrl+D. (What you type is kept in ~/.ollama/history.)"
  if [ "$how" = --rofi ]; then
    exec "${VIKIX_TERMINAL:-alacritty}" -e sh -c "echo '$hello'; echo; OLLAMA_HOST=$HOST '$OLLAMA' run '$model'"
  fi
  echo "$hello"; echo
  exec env OLLAMA_HOST=$HOST "$OLLAMA" run "$model"
}

# Take it all away: Ollama, its link, and (with --models) the models.
cmd_uninstall() {
  local models=''
  [ "${1:-}" = --models ] && models=1
  # Only this install's own processes: the serve loop by its PID file, and
  # ollama by its full path (a name alone could match another install's).
  local pidfile="$VIKIX_STATE/ollama-serve.pid"
  [ -f "$pidfile" ] && kill "$(cat "$pidfile")" 2>/dev/null || true
  rm -f "$pidfile"
  pkill -u "$(id -u)" -f "^$OLLAMA serve" 2>/dev/null || true
  rm -rf "${OPT:?}" "$OPT.new" "$OPT.old"
  [ "$(readlink "$HOME/.local/bin/ollama" 2>/dev/null)" = "$OLLAMA" ] && rm -f "$HOME/.local/bin/ollama"
  rm -f "$LOADED"
  if [ -n "$models" ]; then
    rm -rf "$HOME/.ollama"
    say "Ollama and the models are gone"
  else
    say "Ollama is gone; the models stay in ~/.ollama ($(du -sh "$HOME/.ollama" 2>/dev/null | cut -f1)): vikix ai uninstall --models deletes them"
  fi
}

# --- llm, on the command line ----------------------------------------------------------
# Pinned, like Ollama: a new version is a new line here. uv installs them
# as you, in their own environment, with `llm` in ~/.local/bin.
LLM_PINS=(llm==0.36 llm-ollama==0.17.1 llm-anthropic==0.29)
CLAUDE_DEFAULT=claude-sonnet-5
LLM="$HOME/.local/bin/llm"
UV=${VIKIX_UV:-uv}                  # tests name their stand-in (or a missing one)
# llm writes default_model.txt in its folder only when someone chooses a
# default; without it, the default is llm's own (an OpenAI model).
LLM_DIR=${LLM_USER_PATH:-$HOME/.config/io.datasette.llm}

cmd_llm() {
  local wanted='' refresh=0
  while [ $# -gt 0 ]; do
    case $1 in
      --default) wanted=${2:-}; [ -n "$wanted" ] || die "--default needs a model: llama3.2:3b, $CLAUDE_DEFAULT ..."; shift 2 ;;
      --refresh) refresh=1; shift ;;
      *) die "vikix ai llm [--default MODEL]" ;;
    esac
  done
  # vikix update: only when llm is here and not the pinned version.
  if [ "$refresh" = 1 ]; then
    [ -x "$LLM" ] || return 0
    local have
    have=$("$LLM" --version 2>/dev/null || true)
    [ "${have##* }" = "${LLM_PINS[0]#llm==}" ] && return 0
  fi
  command -v "$UV" >/dev/null 2>&1 || die "uv installs llm, and it isn't here: it comes with Python's list (vikix update installs it)"
  local with=() p
  for p in "${LLM_PINS[@]:1}"; do with+=(--with "$p"); done
  say "installing llm ${LLM_PINS[0]#llm==}, with its Ollama and Anthropic plugins (uv, as you; a minute the first time)"
  "$UV" tool install --quiet --force "${LLM_PINS[0]}" "${with[@]}" || die "uv couldn't install llm (above)"
  [ -x "$LLM" ] || die "llm didn't land in ~/.local/bin"
  # The default model. Yours, if you chose one; else a local model (free,
  # offline, nothing leaves the laptop); else Claude, with a key. The one
  # Vikix picked is remembered, so it's picked again next time (a local
  # model downloaded later wins over Claude) and never taken for yours.
  local current='' picked='' ours="$VIKIX_STATE/llm-default" choice='' local_models=''
  [ -s "$LLM_DIR/default_model.txt" ] && current=$(cat "$LLM_DIR/default_model.txt")
  [ -s "$ours" ] && picked=$(cat "$ours")
  running && local_models=$(have_names)
  if grep -qx 'llama3.2:3b' <<<"$local_models"; then choice=llama3.2:3b
  elif [ -n "$local_models" ]; then choice=$(head -1 <<<"$local_models")
  elif [ -n "${ANTHROPIC_API_KEY:-}" ]; then choice=$CLAUDE_DEFAULT
  fi
  if [ -n "$wanted" ]; then
    "$LLM" models default "$wanted" || die "llm doesn't know the model $wanted (llm models lists them)"
    rm -f "$ours"
    say "llm's default model: $wanted (yours: vikix ai llm won't change it)"
  elif [ -n "$current" ] && [ "$current" != "$picked" ] && [ "$current" != "$choice" ]; then
    say "llm's default stays $current (yours; vikix ai llm --default MODEL changes it)"
  elif [ -n "$choice" ]; then
    "$LLM" models default "$choice" || die "llm doesn't know the model $choice (llm models lists them)"
    mkdir -p "$VIKIX_STATE"; echo "$choice" > "$ours"
    say "llm's default model: $choice"
  elif [ -n "$current" ]; then
    say "llm's default stays $current (no local model or Anthropic key now to pick instead)"
  else
    # llm's own default is an OpenAI model: with an OpenAI key, a plain
    # llm would send your text there, and bill it. So no "Try:" with it.
    warn "no model for llm yet: a local one (vikix ai models), or Claude with a key (vikix ai key set anthropic); then vikix ai llm again"
    warn "until then a plain llm uses llm's own default, $("$LLM" models default 2>/dev/null || echo 'an OpenAI model'), from OpenAI (paid, with an OpenAI key)"
    return 0
  fi
  [ "$refresh" = 1 ] && return 0
  echo "   Try: echo 'Vikix is a desktop for Void Linux.' | llm 'say it shorter'"
  echo "        git diff | llm 'write the commit message'     llm models -q ollama (your local models)"
  echo "        llm -m $CLAUDE_DEFAULT '...' with the key from vikix ai key set anthropic (not llm keys set; new terminals get it)"
  echo "   Everything asked is kept, to search later: llm logs -n 3, llm logs -q WORD (llm logs off stops it)"
}

# For vikix doctor: quiet when local AI isn't set up.
cmd_check() {
  installed || return 0
  if running; then say "local AI (Ollama) is running on $HOST"
  elif [ -n "${DISPLAY:-}" ]; then warn "local AI (Ollama) is installed but not running: vikix ai setup starts it (see $VIKIX_STATE/ollama.log)"; return 1
  fi
}

case ${1:-help} in
  setup)  cmd_setup ;;
  serve)  cmd_serve ;;
  models) shift; cmd_models "${1:-}" ;;
  pull)   shift; cmd_pull "${1:-}" ;;
  list)   cmd_list ;;
  remove|rm) shift; cmd_remove "${1:-}" ;;
  status) cmd_status ;;
  stop)   shift; cmd_stop "${1:-}" ;;
  chat)   shift; cmd_chat "$@" ;;
  uninstall) shift; cmd_uninstall "${1:-}" ;;
  check)  cmd_check ;;
  llm)    shift; cmd_llm "$@" ;;
  help|-h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "vikix ai: unknown command $1 (vikix ai help)" ;;
esac
