#!/usr/bin/env bash
# vikix-publish — books from Markdown: an EPUB and a PDF, built and checked
# the same way in every project (vikix add publish).
#
#   vikix publish [NAME|DIR] [epub|pdf|check|links] [--no-log]
#                     build the book in DIR, or the project called NAME in
#                     ~/src (the folder's name, or the name in its
#                     publish.yml), or the folder you're in: an EPUB and a
#                     PDF into its out/ (both, without a format), and an
#                     entry in the project's log.md saying what was built
#                     (--no-log: none); check checks the spelling and the
#                     links, then builds both into a scratch folder and
#                     keeps nothing; links checks the links alone: a #heading
#                     must be in the book, a file beside the text must be
#                     there, an address on the web must answer (asked once
#                     a week; with no network, left for next time)
#   vikix publish [NAME|DIR] --send [--to FOLDER]
#                     build the EPUB, then put it on the reader plugged in:
#                     a Kindle or Kobo mounted as a drive (into documents/,
#                     or the top), any drive with a Books folder, an
#                     Android reader such as a BOOX in file transfer mode
#                     (its Books folder, over MTP), or one with USB
#                     debugging (adb, /sdcard/Books); --to names the folder
#   vikix publish FILE --send [--to FOLDER] [--format auto|epub|pdf|azw3]
#                     send an existing EPUB or PDF without building a book;
#                     auto keeps its format except EPUB on a mounted Kindle,
#                     converted locally to AZW3 with Calibre; --format chooses
#                     the output explicitly, also for a book built above;
#                     the original stays untouched, temporary conversion
#                     files are removed after the transfer
#   vikix publish [NAME|DIR] spell [--keep] [--no-commit]
#                     the words the dictionary doesn't know, by chapter;
#                     --keep adds them to the book's words.txt, to read,
#                     and in a git repository commits that file
#   vikix publish new DIR [--title TITLE] [--lang LANG] [--no-commit]
#                     start a book in DIR (made if it isn't there):
#                     publish.yml, a first chapter, an empty words.txt,
#                     out/ in .gitignore, and the make targets in its
#                     Makefile (the line added to one already there);
#                     never over a book that's there. In a git repository
#                     what it wrote is committed
#   vikix publish skill [ZIP]
#                     the doc-to-epub skill for claude.ai, made from this
#                     pipeline (its SKILL.md, fix-tables.py and epub.css),
#                     as a zip to upload (Settings, Capabilities, Skills);
#                     ~/Downloads/doc-to-epub.zip without ZIP
#   vikix publish setup
#                     the packages, epubcheck (a pinned release, checked
#                     against its checksum), the British English, Esperanto
#                     and Arabic dictionaries (LibreOffice's, pinned and
#                     checked the same way) and the shared make targets
#   vikix publish status
#                     which tools and fonts are here
#   vikix publish uninstall
#
# A book is a folder with publish.yml (pandoc's metadata: title, author,
# lang; and Vikix's: name, chapters, mainfont) and its text in
# chapters/*.md (taken in name order) or book.md. The EPUB goes through
# pandoc, then the fix for e-ink readers (tables become row cards, one-cell
# boxes asides: what the doc-to-epub skill learned on a 7-inch screen),
# then epubcheck; one epubcheck rejects is kept as NAME.epub.rejected, not
# as the book. The PDF goes through pandoc's Typst writer, in IBM Plex
# Serif (Amiri when lang is Arabic, or mainfont in publish.yml), and one
# Typst warned about is NAME.pdf.rejected. The spelling is the book's lang
# (any English is checked as British), and a passage marked ::: {lang=eo}
# or [vorto]{lang=ar} in its own; code isn't prose. words.txt beside
# publish.yml holds the book's own words, one a line.
#
# A build into out/ is noted in the project's log (the log.md vikix
# project knows, when the book is a project): a dated entry, "published",
# with the files and their sizes. --no-log, or VIKIX_PUBLISH_LOG=0, leaves
# the log alone.
#
# What this command writes into a book that is in a git repository (its
# words.txt, a new book's first files, the log's entry) it commits, those
# files alone: nobody else would, and the project would say "not
# committed" at every push. A file that had changes of yours waiting is
# left to you, and said; so is everything during a merge or a rebase.
# --no-commit, or VIKIX_PUBLISH_COMMIT=0, leaves git alone.
#
# In a project's Makefile, last, the same as make targets (epub, pdf,
# check):
#
#   -include $(HOME)/.local/share/vikix/publish/publish.mk

set -uo pipefail
VIKIX_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../lib/common.sh
. "$VIKIX_DIR/lib/common.sh"
# shellcheck source=../lib/features.sh
. "$VIKIX_DIR/lib/features.sh"

# epubcheck: W3C's validator, the only one there is. Not in Void, so a
# release, checked against the checksum GitHub publishes for it.
EPUBCHECK_VERSION=5.4.0
EPUBCHECK_SHA256=33350c61038e71dfb3d45a76aed04bf5481e6d5500cb780f6e98db8bbd15a28c
EPUBCHECK_URL=https://github.com/w3c/epubcheck/releases/download/v$EPUBCHECK_VERSION/epubcheck-$EPUBCHECK_VERSION.zip
# The dictionaries: LibreOffice's, at a commit, each file's checksum here.
DICTS_COMMIT=32b006a2c22a4ac7e8ed3f03346f7b3d85a970a4
DICTS_URL=https://raw.githubusercontent.com/LibreOffice/dictionaries/$DICTS_COMMIT
DICTS_FILES="en/en_GB.aff:0fd6ed120ef28957847d98ba5149b117e27116cf81b5aa36208453f6755a36fd
en/en_GB.dic:04e90f34f5263bf26780e9c4a442e9ad16584e227af49ddd1b3b21b01df5b29c
eo/eo.aff:28d48b2d17c9fd20ae9924f14dc2832c8277c9d03715f939957e2c93bcd767b1
eo/eo.dic:d3d8f84c7b5d6fcb348ce8c11b07c70e007c4b0075350d6bd796196419d42ac4
ar/ar.aff:cec30b8621001e49618feb05aec1984c5fcfbf7d2ec309901d5cbf66585217a3
ar/ar.dic:2a3e5367f61c1583734db9d66734f5603e6be5c2d227cf5c5cd7e4ca586e34fe"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
DICTS_DIR="$DATA/vikix/hunspell"
EPUBCHECK_DIR="$DATA/vikix/epubcheck"
SHARED="$DATA/vikix/publish"
BUILD="$VIKIX_DIR/lib/publish/build"
# Tests name a stand-in (this one reaches the network).
CURL=${VIKIX_CURL:-curl}

epubcheck_ok() {
  [ -f "$EPUBCHECK_DIR/epubcheck.jar" ] && [ "$(cat "$EPUBCHECK_DIR/.vikix-version" 2>/dev/null)" = "$EPUBCHECK_VERSION" ]
}

fetch_epubcheck() {
  epubcheck_ok && return 0
  say "fetching epubcheck $EPUBCHECK_VERSION"
  if [ "$DRY_RUN" = 1 ]; then printf '   would fetch %s into %s\n' "$EPUBCHECK_URL" "$EPUBCHECK_DIR"; return 0; fi
  local tmp
  tmp=$(mktemp -d) || die "no temporary folder"
  # shellcheck disable=SC2064  # the folder is known now
  trap "rm -rf '$tmp'" RETURN
  "$CURL" -fsSL -o "$tmp/epubcheck.zip" "$EPUBCHECK_URL" || die "couldn't download epubcheck ($EPUBCHECK_URL)"
  [ "$(sha256sum "$tmp/epubcheck.zip" | cut -d' ' -f1)" = "$EPUBCHECK_SHA256" ] ||
    die "epubcheck's download isn't the release it should be (checksum differs): not installed"
  unzip -q "$tmp/epubcheck.zip" -d "$tmp" || die "couldn't unpack epubcheck"
  rm -rf "$EPUBCHECK_DIR"
  mkdir -p "$(dirname "$EPUBCHECK_DIR")"
  mv "$tmp/epubcheck-$EPUBCHECK_VERSION" "$EPUBCHECK_DIR" || die "couldn't put epubcheck in $EPUBCHECK_DIR"
  echo "$EPUBCHECK_VERSION" > "$EPUBCHECK_DIR/.vikix-version"
}

dicts_ok() {
  [ "$(cat "$DICTS_DIR/.vikix-commit" 2>/dev/null)" = "$DICTS_COMMIT" ]
}

fetch_dicts() {
  dicts_ok && return 0
  say "fetching the dictionaries (British English, Esperanto, Arabic)"
  if [ "$DRY_RUN" = 1 ]; then printf '   would fetch them into %s\n' "$DICTS_DIR"; return 0; fi
  local tmp line path sum file
  tmp=$(mktemp -d) || die "no temporary folder"
  # shellcheck disable=SC2064  # the folder is known now
  trap "rm -rf '$tmp'" RETURN
  while IFS= read -r line; do
    path=${line%%:*} sum=${line#*:} file=${path#*/}
    "$CURL" -fsSL -o "$tmp/$file" "$DICTS_URL/$path" || die "couldn't download $file ($DICTS_URL/$path)"
    [ "$(sha256sum "$tmp/$file" | cut -d' ' -f1)" = "$sum" ] ||
      die "$file isn't the one it should be (checksum differs): the dictionaries aren't installed"
  done <<<"$DICTS_FILES"
  rm -rf "$DICTS_DIR"
  mkdir -p "$DICTS_DIR"
  mv "$tmp"/*.aff "$tmp"/*.dic "$DICTS_DIR"/ || die "couldn't put the dictionaries in $DICTS_DIR"
  echo "$DICTS_COMMIT" > "$DICTS_DIR/.vikix-commit"
}

cmd_setup() {
  record_features publish
  local p missing=0
  while IFS= read -r p; do pkg_installed "$p" || missing=1; done < <(read_list "$VIKIX_DIR/packages/optional/publish.list")
  if [ "$missing" = 1 ]; then
    VIKIX_LISTS=publish bash "$VIKIX_DIR/install/10-packages.sh" || die "couldn't install the packages publish needs"
  fi
  fetch_epubcheck
  fetch_dicts
  # The make targets, where a project's Makefile includes them from.
  run mkdir -p "$(dirname "$SHARED")"
  link_managed "$VIKIX_DIR/lib/publish" "$SHARED"
  command -v java >/dev/null 2>&1 || warn "no java: epubcheck needs it (vikix add java)"
  say "ready: vikix publish NAME (vikix publish -h)"
}

cmd_status() {
  local t
  for t in pandoc typst java; do
    if command -v "$t" >/dev/null 2>&1; then printf '%-10s %s\n' "$t" "$("$t" --version 2>&1 | head -1)"
    else printf '%-10s missing (vikix add publish)\n' "$t"; fi
  done
  if epubcheck_ok; then printf '%-10s %s (%s)\n' epubcheck "$EPUBCHECK_VERSION" "$EPUBCHECK_DIR"
  else printf '%-10s missing (vikix publish setup)\n' epubcheck; fi
  local d
  for d in en_GB eo ar; do
    if [ -f "$DICTS_DIR/$d.dic" ]; then printf '%-10s %s\n' spelling "$d ($DICTS_DIR)"
    else printf '%-10s %s missing (vikix publish setup)\n' spelling "$d"; fi
  done
  command -v hunspell >/dev/null 2>&1 || printf '%-10s %s\n' hunspell "missing (vikix add publish)"
  python3 -c 'import bs4, lxml, yaml' 2>/dev/null && printf '%-10s %s\n' python "bs4, lxml and yaml are here" ||
    printf '%-10s %s\n' python "missing bs4, lxml or yaml (vikix add publish)"
  local f
  for f in "IBM Plex Serif" Amiri; do
    if fc-list : family 2>/dev/null | grep -qF "$f"; then printf '%-10s %s\n' font "$f"
    else printf '%-10s %s missing (vikix add publish)\n' font "$f"; fi
  done
  if [ -e "$SHARED/publish.mk" ]; then printf '%-10s %s\n' make "$SHARED/publish.mk"
  else printf '%-10s %s\n' make "no shared targets (vikix publish setup)"; fi
}

cmd_uninstall() {
  [ -L "$SHARED" ] && run rm -f "$SHARED"
  run rm -rf "$EPUBCHECK_DIR" "$DICTS_DIR"
  say "removed epubcheck, the dictionaries and the shared make targets; your books and their out/ folders are left"
  forget_features publish
}

# The book's folder: a folder given, the project of that name in ~/src
# (two levels down too: ~/src/living-series/living-in-sql), one whose
# publish.yml has that name, or the folder you're in.
find_book() {
  local want=${1:-} d
  if [ -z "$want" ]; then
    [ -f publish.yml ] || die "no publish.yml here: vikix publish NAME, or cd into the book"
    pwd; return
  fi
  if [ -f "$want/publish.yml" ]; then (cd "$want" && pwd); return; fi
  for d in "$HOME"/src/"$want" "$HOME"/src/*/"$want"; do
    [ -f "$d/publish.yml" ] && { echo "$d"; return; }
  done
  for d in "$HOME"/src/*/publish.yml "$HOME"/src/*/*/publish.yml; do
    [ -f "$d" ] && grep -qxE "name: *[\"']?${want}[\"']?" "$d" && { dirname "$d"; return; }
  done
  die "no book called $want: a folder with publish.yml in ~/src, or a path"
}

# Where a reader plugged in takes books. Each way says the file it copied
# to; none found is an error saying what to try.
MEDIA=${VIKIX_MEDIA:-/run/media/$USER}
GIO=${VIKIX_GIO:-gio}
ADB=${VIKIX_ADB:-adb}
CONVERTER=${VIKIX_EBOOK_CONVERT:-ebook-convert}

# Called inside send_book's private temporary folder; stdout is a path,
# so Calibre's progress belongs on stderr. Never convert beside the source.
reader_file() {
  local file=$1 target=$2 ext=${1##*.} output
  ext=${ext,,}
  [ "$SEND_FORMAT" = auto ] || target=$SEND_FORMAT
  [ "$target" != auto ] || target=$ext
  if [ "$target" = "$ext" ]; then printf '%s\n' "$file"; return 0; fi
  command -v "$CONVERTER" >/dev/null 2>&1 || { warn "conversion needs Calibre: vikix add publish"; return 1; }
  output="$SEND_TMP/$(basename -- "${file%.*}").$target"
  timeout --kill-after=5s 180s "$CONVERTER" "$file" "$output" >&2 || {
    warn "couldn't convert $file to $target; nothing sent"; return 1;
  }
  [ -s "$output" ] || { warn "conversion produced no book; nothing sent"; return 1; }
  printf '%s\n' "$output"
}

send_to_drive() {
  local epub=$1 d dest target prepared
  local drives=("$MEDIA"/*/)
  # An explicit media root confines tests and callers to that root.
  [ -n "${VIKIX_MEDIA:-}" ] || drives+=(/media/"$USER"/*/)
  for d in "${drives[@]}"; do
    [ -d "$d" ] || continue
    dest=""; target=auto
    if [ -d "$d/documents" ] && [ -d "$d/system" ]; then
      dest="$d/documents"
      case ${epub,,} in *.epub) target=azw3 ;; esac   # a Kindle
    elif [ -d "$d/.kobo" ]; then dest="$d"                                    # a Kobo
    elif [ -d "$d/Books" ]; then dest="$d/Books"
    elif [ -d "$d/books" ]; then dest="$d/books"
    fi
    [ -n "$dest" ] || continue
    prepared=$(reader_file "$epub" "$target") || return 2
    cp -- "$prepared" "$dest/" && sync || return 2
    echo "${dest%/}/$(basename "$prepared")"; return 0
  done
  return 1
}

send_over_mtp() {
  local epub=$1 root storage prepared
  command -v "$GIO" >/dev/null 2>&1 || return 1
  root=$("$GIO" mount -li 2>/dev/null | sed -n 's/.*activation_root=\(mtp:\/\/[^ ]*\).*/\1/p' | head -1)
  [ -n "$root" ] || return 1
  "$GIO" mount "$root" >/dev/null 2>&1 || true   # mounted already is fine
  # The device's first storage (a BOOX has one: "Internal shared storage").
  storage=$("$GIO" list "$root" 2>/dev/null | head -1)
  [ -n "$storage" ] || return 1
  "$GIO" mkdir -p "${root%/}/$storage/Books" >/dev/null 2>&1 || true
  prepared=$(reader_file "$epub" auto) || return 2
  "$GIO" copy -- "$prepared" "${root%/}/$storage/Books/" || return 2
  echo "${root%/}/$storage/Books/$(basename "$prepared")"
}

send_over_adb() {
  local epub=$1 devices prepared
  command -v "$ADB" >/dev/null 2>&1 || return 1
  devices=$("$ADB" devices 2>/dev/null | awk 'NR > 1 && $2 == "device"' | wc -l)
  [ "$devices" = 1 ] || return 1
  prepared=$(reader_file "$epub" auto) || return 2
  "$ADB" push "$prepared" /sdcard/Books/ >/dev/null || return 2
  echo "adb:/sdcard/Books/$(basename "$prepared")"
}

send_book() (
  local epub=$1 to=$2 where prepared status backend
  SEND_FORMAT=${3:-auto}
  [ -f "$epub" ] && [ -r "$epub" ] || die "no readable file $epub to send"
  epub=$(realpath -- "$epub") || exit 1
  if [ "$DRY_RUN" = 1 ]; then say "would send: $epub (format $SEND_FORMAT) to ${to:-the connected reader}"; return 0; fi
  SEND_TMP=$(mktemp -d) || die "couldn't make a conversion folder"
  trap 'rm -rf -- "$SEND_TMP"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  if [ -n "$to" ]; then
    [ -d "$to" ] || die "no folder $to"
    prepared=$(reader_file "$epub" auto) || exit 1
    cp -- "$prepared" "$to/" && sync || die "couldn't copy it into $to"
    where="${to%/}/$(basename "$prepared")"
  else
    status=1
    for backend in send_to_drive send_over_mtp send_over_adb; do
      where=$("$backend" "$epub"); status=$?
      [ "$status" = 1 ] || break
    done
    [ "$status" != 2 ] || die "reader found, but conversion or transfer failed"
    [ "$status" = 0 ] || die "no reader found: plug it in (on an Android reader, choose file transfer), or --to FOLDER"
  fi
  say "sent: $where"
)

# --- Keeping what it writes in git ---------------------------------------------------

COMMIT=${VIKIX_PUBLISH_COMMIT:-1}

# git_ready DIR: is DIR in a git work tree, with no merge or rebase under
# way, and committing wanted?
git_ready() {
  [ "$COMMIT" = 1 ] && [ "$DRY_RUN" != 1 ] || return 1
  local top gitdir
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || return 1
  [ -n "$top" ] || return 1
  gitdir=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) || return 1
  [ ! -e "$gitdir/MERGE_HEAD" ] && [ ! -d "$gitdir/rebase-merge" ] && [ ! -d "$gitdir/rebase-apply" ] &&
    [ ! -e "$gitdir/CHERRY_PICK_HEAD" ]
}

# git_clean DIR FILE: has FILE (in DIR) nothing of yours waiting? True for
# one that isn't there and isn't known to git, and for one git has as it is.
git_clean() {
  if [ -e "$1/$2" ] || git -C "$1" ls-files --error-unmatch -- "$2" >/dev/null 2>&1; then
    git -C "$1" ls-files --error-unmatch -- "$2" >/dev/null 2>&1 &&
      [ -z "$(git -C "$1" status --porcelain -- "$2" 2>/dev/null)" ]
  else
    return 0
  fi
}

# git_keep DIR MESSAGE FILE...: commit those files of DIR as they are now,
# and nothing else: whatever else is changed or staged stays as it was.
git_keep() {
  local dir=$1 message=$2 id; shift 2
  [ $# -gt 0 ] || return 0
  if git -C "$dir" add -- "$@" 2>/dev/null &&
     git -C "$dir" commit -q -m "$message" -- "$@" >/dev/null 2>&1; then
    id=$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)
    say "committed: $* ($id); your next push takes it"
  else
    git -C "$dir" reset -q -- "$@" 2>/dev/null || true
    warn "not committed: $* (git commit didn't go through: git -C $dir status says more)"
  fi
}

# log_entry find|write DIR [BODY]: the log of the project DIR is (vikix
# project's own finder and writer, so the log keeps its shape: newest
# first, dated): find prints its path, write adds a "published" entry for
# today with BODY; nothing printed when DIR is no project. VIKIX_TODAY
# dates it, for the tests.
log_entry() {
  python3 - "$VIKIX_DIR/bin/vikix-project" "$1" "$2" "${3:-}" <<'PY'
import importlib.util, sys
from importlib.machinery import SourceFileLoader
from pathlib import Path
sys.dont_write_bytecode = True   # loading vikix-project must not leave a __pycache__ in bin/
script, what, folder, body = sys.argv[1:]
loader = SourceFileLoader("vikix_project", script)
spec = importlib.util.spec_from_loader("vikix_project", loader)
vp = importlib.util.module_from_spec(spec)
loader.exec_module(vp)
here = Path(folder).resolve()
for p in vp.discover():
    if p.path.resolve() == here:
        if what == "write":
            vp.add_entry(p, body, status="published", agent=True)
        print(p.log)
        break
PY
}

# note_build DIR FORMAT...: the entry for what a build just put in DIR's
# out/, committed as words.txt is when the log had nothing of yours
# waiting (asked before the entry goes in).
note_build() {
  local dir=$1 name f what=() log logdir logname clean=0; shift
  name=$(python3 "$BUILD" name) || return 0
  for f in "$@"; do
    [ -f "$dir/out/$name.$f" ] || continue
    what+=("out/$name.$f ($(( $(stat -c %s -- "$dir/out/$name.$f") / 1024 )) KB, $([ "$f" = epub ] && echo "passed epubcheck" || echo "no Typst warnings"))")
  done
  [ "${#what[@]}" -gt 0 ] || return 0
  log=$(log_entry find "$dir") || return 0
  [ -n "$log" ] || return 0
  logdir=$(dirname -- "$log"); logname=$(basename -- "$log")
  git_ready "$logdir" && git_clean "$logdir" "$logname" && clean=1
  local body
  body="Built by vikix publish: $(printf '%s, ' "${what[@]}" | sed 's/, $//')."
  log_entry write "$dir" "$body" >/dev/null || { warn "couldn't write the entry in $log"; return 0; }
  say "noted in $log"
  if [ "$clean" = 1 ]; then
    git_keep "$logdir" "$name: published ($logname)" "$logname"
  elif git_ready "$logdir"; then
    say "$logname had changes of yours waiting: left for you to commit"
  fi
}

cmd_build() {
  local book="" formats=() keep=() send=0 to="" output_format=auto a log=${VIKIX_PUBLISH_LOG:-1}
  while [ $# -gt 0 ]; do
    a=$1; shift
    case $a in
      epub|pdf|check|spell|links) formats+=("$a") ;;
      --keep) keep=(--keep) ;;
      --no-commit) COMMIT=0 ;;
      --no-log) log=0 ;;
      --send) send=1 ;;
      --format) output_format=${1:-}; [ $# -gt 0 ] || die "--format needs auto, epub, pdf or azw3"; shift
        case $output_format in auto|epub|pdf|azw3) ;; *) die "--format needs auto, epub, pdf or azw3" ;; esac ;;
      --to) send=1; to=${1:-}; [ -n "$to" ] || die "--to which folder?"; shift ;;
      -*) die "vikix publish: $a? (vikix publish -h)" ;;
      *) [ -z "$book" ] || die "one book at a time"; book=$a ;;
    esac
  done
  if [ -f "$book" ] || [[ "${book,,}" == *.epub || "${book,,}" == *.pdf ]]; then
    [ "$send" = 1 ] || die "an existing file needs --send or --to FOLDER"
    [ "${#formats[@]}" = 0 ] && [ "${#keep[@]}" = 0 ] || die "existing files cannot use build or spell actions"
    case ${book,,} in *.epub|*.pdf) ;; *) die "send an EPUB or PDF file" ;; esac
    send_book "$book" "$to" "$output_format"
    return $?
  fi
  [ "$output_format" = auto ] || [ "$send" = 1 ] || die "--format needs --send or --to FOLDER"
  if [ "${#formats[@]}" -eq 0 ]; then
    if [ "$send" = 1 ]; then formats=(epub); else formats=(epub pdf); fi
  fi
  local dir
  dir=$(find_book "$book") || exit 1
  cd "$dir" || die "can't go into $dir"
  # The book's words, kept (spell --keep): committed, when the file had
  # nothing of yours waiting before.
  local words_clean=0 words_before=0 words_now name
  if [ "${#keep[@]}" -gt 0 ] && git_ready "$dir" && git_clean "$dir" words.txt; then
    words_clean=1
    [ -e words.txt ] && words_before=$(grep -c . words.txt || true)
  fi
  local f
  for f in "${formats[@]}"; do
    python3 "$BUILD" "$f" "${keep[@]}" || exit 1
  done
  if [ "$words_clean" = 1 ] && [ -e words.txt ] && ! git_clean "$dir" words.txt; then
    words_now=$(grep -c . words.txt || true)
    name=$(basename -- "$dir")
    local n=$((words_now - words_before)) w=words
    [ "$n" = 1 ] && w=word
    git_keep "$dir" "$name: $n $w the spell check keeps (words.txt)" words.txt
  elif [ "${#keep[@]}" -gt 0 ] && [ "$words_clean" = 0 ] && git_ready "$dir" && ! git_clean "$dir" words.txt; then
    say "words.txt had changes of yours waiting: left for you to commit"
  fi
  # What went into out/ is noted in the project's log (check, spell and
  # links write nothing there, so they note nothing).
  local into=()
  for f in "${formats[@]}"; do
    case $f in epub|pdf) into+=("$f") ;; esac
  done
  if [ "$log" = 1 ] && [ "$DRY_RUN" != 1 ] && [ "${#into[@]}" -gt 0 ]; then
    note_build "$dir" "${into[@]}"
  fi
  [ "$send" = 1 ] || return 0
  send_book "$dir/out/$(python3 "$BUILD" name).epub" "$to" "$output_format"
}

cmd_new() {
  local dir="" title="" lang=en-GB a
  while [ $# -gt 0 ]; do
    a=$1; shift
    case $a in
      --title) title=${1:-}; shift || true ;;
      --lang)  lang=${1:-}; shift || true ;;
      --no-commit) COMMIT=0 ;;
      -*) die "vikix publish new: $a? (vikix publish -h)" ;;
      *) [ -z "$dir" ] || die "one book at a time"; dir=$a ;;
    esac
  done
  [ -n "$dir" ] || die "vikix publish new DIR [--title TITLE] [--lang LANG]"
  [ -e "$dir/publish.yml" ] && die "$dir has a book already ($dir/publish.yml): left as it is"
  run mkdir -p "$dir/chapters"
  local name author
  name=$(basename -- "$(cd "$dir" 2>/dev/null && pwd || echo "$dir")")
  # The title from the folder (living-toki-pona: "Living toki pona") until
  # you say otherwise, here or in publish.yml.
  [ -n "$title" ] || title=$(printf '%s' "$name" | tr '_-' '  ' | sed 's/^./\U&/')
  author=$(git config user.name 2>/dev/null || true)
  [ -n "$author" ] || author=$USER
  # Inside YAML's double quotes, a quote or a backslash needs its own.
  title=${title//\\/\\\\}; title=${title//\"/\\\"}
  author=${author//\\/\\\\}; author=${author//\"/\\\"}
  if [ "$DRY_RUN" = 1 ]; then printf '   would write %s/publish.yml, a chapter, words.txt, the Makefile line\n' "$dir"; return 0; fi
  # Which of its files have nothing of yours waiting, asked before they are
  # written: those are committed afterwards, the others left to you.
  local f mine=() left=()
  if git_ready "$dir"; then
    for f in publish.yml chapters/01-start.md words.txt .gitignore Makefile; do
      if git_clean "$dir" "$f"; then mine+=("$f"); else left+=("$f"); fi
    done
  fi
  {
    echo "# publish.yml: the book's metadata for vikix publish. pandoc reads it as"
    echo "# it is (title, subtitle, author, lang, date, rights ...); name, chapters"
    echo "# and mainfont are Vikix's (vikix publish -h)."
    echo "title: \"$title\""
    echo "author: \"$author\""
    echo "lang: $lang"
    echo "name: $name"
  } > "$dir/publish.yml"
  [ -e "$dir/chapters/01-start.md" ] ||
    printf '# %s\n\nThe first chapter. Each file in chapters/ is one, taken in name order.\n' "$title" > "$dir/chapters/01-start.md"
  [ -e "$dir/words.txt" ] || : > "$dir/words.txt"
  grep -qxF 'out/' "$dir/.gitignore" 2>/dev/null || printf '# The book, built by vikix publish.\nout/\n' >> "$dir/.gitignore"
  # shellcheck disable=SC2016  # make's $(HOME), written as it is
  local line='-include $(HOME)/.local/share/vikix/publish/publish.mk'
  if ! grep -qxF -- "$line" "$dir/Makefile" 2>/dev/null; then
    [ -s "$dir/Makefile" ] && printf '\n' >> "$dir/Makefile"
    printf '# The book: make epub, make pdf, make check (vikix publish -h).\n%s\n' "$line" >> "$dir/Makefile"
  fi
  say "a book in $dir: write in chapters/, then vikix publish $dir (or make epub there)"
  # Committed: what was written just now, of the files that were clean.
  local wrote=()
  for f in "${mine[@]}"; do
    [ -e "$dir/$f" ] && ! git_clean "$dir" "$f" && wrote+=("$f")
  done
  [ "${#wrote[@]}" -eq 0 ] || git_keep "$dir" "$name: a book for vikix publish (publish.yml, a first chapter, words.txt)" "${wrote[@]}"
  for f in "${left[@]}"; do
    git_clean "$dir" "$f" || say "$f had changes of yours waiting: left for you to commit"
  done
}

# The cloud skill, from the same files the laptop builds with: the skill
# synced from claude.ai can't be changed here, only replaced by an upload.
cmd_skill() {
  local zip=${1:-$HOME/Downloads/doc-to-epub.zip}
  local src="$VIKIX_DIR/lib/publish"
  if [ "$DRY_RUN" = 1 ]; then printf '   would write %s\n' "$zip"; return 0; fi
  mkdir -p "$(dirname "$zip")"
  python3 - "$src" "$zip" <<'PY' || die "couldn't write $1"
import sys, zipfile
src, out = sys.argv[1], sys.argv[2]
with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
    z.write(f"{src}/skill/SKILL.md", "doc-to-epub/SKILL.md")
    z.write(f"{src}/fix-tables.py", "doc-to-epub/scripts/fix_tables.py")
    z.write(f"{src}/epub.css", "doc-to-epub/references/epub.css")
PY
  say "the skill: $zip; on claude.ai, Settings, Capabilities, Skills: upload it in place of doc-to-epub"
}

case ${1:-} in
  new)       shift; cmd_new "$@" ;;
  skill)     shift; cmd_skill "${1:-}" ;;
  setup)     cmd_setup ;;
  status)    cmd_status ;;
  uninstall) cmd_uninstall ;;
  -h|--help|help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) cmd_build "$@" ;;
esac
