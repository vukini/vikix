#!/usr/bin/env bash
# vikix-publish — books from Markdown: an EPUB and a PDF, built and checked
# the same way in every project (vikix add publish).
#
#   vikix publish [NAME|DIR] [epub|pdf|check]
#                     build the book in DIR, or the project called NAME in
#                     ~/src (the folder's name, or the name in its
#                     publish.yml), or the folder you're in: an EPUB and a
#                     PDF into its out/ (both, without a format); check
#                     builds both into a scratch folder, keeps nothing, and
#                     checks the spelling
#   vikix publish [NAME|DIR] --send [--to FOLDER]
#                     build the EPUB, then put it on the reader plugged in:
#                     a Kindle or Kobo mounted as a drive (into documents/,
#                     or the top), any drive with a Books folder, an
#                     Android reader such as a BOOX in file transfer mode
#                     (its Books folder, over MTP), or one with USB
#                     debugging (adb, /sdcard/Books); --to names the folder
#   vikix publish [NAME|DIR] spell [--keep]
#                     the words the dictionary doesn't know, by chapter;
#                     --keep adds them to the book's words.txt, to read
#   vikix publish new DIR [--title TITLE] [--lang LANG]
#                     start a book in DIR (made if it isn't there):
#                     publish.yml, a first chapter, an empty words.txt,
#                     out/ in .gitignore, and the make targets in its
#                     Makefile (the line added to one already there);
#                     never over a book that's there
#   vikix publish setup
#                     the packages, epubcheck (a pinned release, checked
#                     against its checksum), the British English, Esperanto
#                     and Arabic dictionaries (LibreOffice's, pinned and
#                     checked the same way) and the shared make targets
#   vikix publish status
#                     which tools and fonts are here
#   vikix publish uninstall
#
# A book is a folder with publish.yml (pandoc's metadata: title, author,
# lang; and Vikix's: name, chapters, mainfont) and its text in
# chapters/*.md (taken in name order) or book.md. The EPUB goes through
# pandoc, then the fix for e-ink readers (tables become row cards, one-cell
# boxes asides: what the doc-to-epub skill learned on a 7-inch screen),
# then epubcheck; one epubcheck rejects is kept as NAME.epub.rejected, not
# as the book. The PDF goes through pandoc's Typst writer, in IBM Plex
# Serif (Amiri when lang is Arabic, or mainfont in publish.yml), and one
# Typst warned about is NAME.pdf.rejected. The spelling is the book's lang
# (any English is checked as British), and a passage marked ::: {lang=eo}
# or [vorto]{lang=ar} in its own; code isn't prose. words.txt beside
# publish.yml holds the book's own words, one a line.
#
# In a project's Makefile, last, the same as make targets (epub, pdf,
# check):
#
#   -include $(HOME)/.local/share/vikix/publish/publish.mk

set -uo pipefail
VIKIX_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../lib/common.sh
. "$VIKIX_DIR/lib/common.sh"
# shellcheck source=../lib/features.sh
. "$VIKIX_DIR/lib/features.sh"

# epubcheck: W3C's validator, the only one there is. Not in Void, so a
# release, checked against the checksum GitHub publishes for it.
EPUBCHECK_VERSION=5.4.0
EPUBCHECK_SHA256=33350c61038e71dfb3d45a76aed04bf5481e6d5500cb780f6e98db8bbd15a28c
EPUBCHECK_URL=https://github.com/w3c/epubcheck/releases/download/v$EPUBCHECK_VERSION/epubcheck-$EPUBCHECK_VERSION.zip
# The dictionaries: LibreOffice's, at a commit, each file's checksum here.
DICTS_COMMIT=32b006a2c22a4ac7e8ed3f03346f7b3d85a970a4
DICTS_URL=https://raw.githubusercontent.com/LibreOffice/dictionaries/$DICTS_COMMIT
DICTS_FILES="en/en_GB.aff:0fd6ed120ef28957847d98ba5149b117e27116cf81b5aa36208453f6755a36fd
en/en_GB.dic:04e90f34f5263bf26780e9c4a442e9ad16584e227af49ddd1b3b21b01df5b29c
eo/eo.aff:28d48b2d17c9fd20ae9924f14dc2832c8277c9d03715f939957e2c93bcd767b1
eo/eo.dic:d3d8f84c7b5d6fcb348ce8c11b07c70e007c4b0075350d6bd796196419d42ac4
ar/ar.aff:cec30b8621001e49618feb05aec1984c5fcfbf7d2ec309901d5cbf66585217a3
ar/ar.dic:2a3e5367f61c1583734db9d66734f5603e6be5c2d227cf5c5cd7e4ca586e34fe"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
DICTS_DIR="$DATA/vikix/hunspell"
EPUBCHECK_DIR="$DATA/vikix/epubcheck"
SHARED="$DATA/vikix/publish"
BUILD="$VIKIX_DIR/lib/publish/build"
# Tests name a stand-in (this one reaches the network).
CURL=${VIKIX_CURL:-curl}

epubcheck_ok() {
  [ -f "$EPUBCHECK_DIR/epubcheck.jar" ] && [ "$(cat "$EPUBCHECK_DIR/.vikix-version" 2>/dev/null)" = "$EPUBCHECK_VERSION" ]
}

fetch_epubcheck() {
  epubcheck_ok && return 0
  say "fetching epubcheck $EPUBCHECK_VERSION"
  if [ "$DRY_RUN" = 1 ]; then printf '   would fetch %s into %s\n' "$EPUBCHECK_URL" "$EPUBCHECK_DIR"; return 0; fi
  local tmp
  tmp=$(mktemp -d) || die "no temporary folder"
  # shellcheck disable=SC2064  # the folder is known now
  trap "rm -rf '$tmp'" RETURN
  "$CURL" -fsSL -o "$tmp/epubcheck.zip" "$EPUBCHECK_URL" || die "couldn't download epubcheck ($EPUBCHECK_URL)"
  [ "$(sha256sum "$tmp/epubcheck.zip" | cut -d' ' -f1)" = "$EPUBCHECK_SHA256" ] ||
    die "epubcheck's download isn't the release it should be (checksum differs): not installed"
  unzip -q "$tmp/epubcheck.zip" -d "$tmp" || die "couldn't unpack epubcheck"
  rm -rf "$EPUBCHECK_DIR"
  mkdir -p "$(dirname "$EPUBCHECK_DIR")"
  mv "$tmp/epubcheck-$EPUBCHECK_VERSION" "$EPUBCHECK_DIR" || die "couldn't put epubcheck in $EPUBCHECK_DIR"
  echo "$EPUBCHECK_VERSION" > "$EPUBCHECK_DIR/.vikix-version"
}

dicts_ok() {
  [ "$(cat "$DICTS_DIR/.vikix-commit" 2>/dev/null)" = "$DICTS_COMMIT" ]
}

fetch_dicts() {
  dicts_ok && return 0
  say "fetching the dictionaries (British English, Esperanto, Arabic)"
  if [ "$DRY_RUN" = 1 ]; then printf '   would fetch them into %s\n' "$DICTS_DIR"; return 0; fi
  local tmp line path sum file
  tmp=$(mktemp -d) || die "no temporary folder"
  # shellcheck disable=SC2064  # the folder is known now
  trap "rm -rf '$tmp'" RETURN
  while IFS= read -r line; do
    path=${line%%:*} sum=${line#*:} file=${path#*/}
    "$CURL" -fsSL -o "$tmp/$file" "$DICTS_URL/$path" || die "couldn't download $file ($DICTS_URL/$path)"
    [ "$(sha256sum "$tmp/$file" | cut -d' ' -f1)" = "$sum" ] ||
      die "$file isn't the one it should be (checksum differs): the dictionaries aren't installed"
  done <<<"$DICTS_FILES"
  rm -rf "$DICTS_DIR"
  mkdir -p "$DICTS_DIR"
  mv "$tmp"/*.aff "$tmp"/*.dic "$DICTS_DIR"/ || die "couldn't put the dictionaries in $DICTS_DIR"
  echo "$DICTS_COMMIT" > "$DICTS_DIR/.vikix-commit"
}

cmd_setup() {
  record_features publish
  local p missing=0
  while IFS= read -r p; do pkg_installed "$p" || missing=1; done < <(read_list "$VIKIX_DIR/packages/optional/publish.list")
  if [ "$missing" = 1 ]; then
    VIKIX_LISTS=publish bash "$VIKIX_DIR/install/10-packages.sh" || die "couldn't install the packages publish needs"
  fi
  fetch_epubcheck
  fetch_dicts
  # The make targets, where a project's Makefile includes them from.
  run mkdir -p "$(dirname "$SHARED")"
  link_managed "$VIKIX_DIR/lib/publish" "$SHARED"
  command -v java >/dev/null 2>&1 || warn "no java: epubcheck needs it (vikix add java)"
  say "ready: vikix publish NAME (vikix publish -h)"
}

cmd_status() {
  local t
  for t in pandoc typst java; do
    if command -v "$t" >/dev/null 2>&1; then printf '%-10s %s\n' "$t" "$("$t" --version 2>&1 | head -1)"
    else printf '%-10s missing (vikix add publish)\n' "$t"; fi
  done
  if epubcheck_ok; then printf '%-10s %s (%s)\n' epubcheck "$EPUBCHECK_VERSION" "$EPUBCHECK_DIR"
  else printf '%-10s missing (vikix publish setup)\n' epubcheck; fi
  local d
  for d in en_GB eo ar; do
    if [ -f "$DICTS_DIR/$d.dic" ]; then printf '%-10s %s\n' spelling "$d ($DICTS_DIR)"
    else printf '%-10s %s missing (vikix publish setup)\n' spelling "$d"; fi
  done
  command -v hunspell >/dev/null 2>&1 || printf '%-10s %s\n' hunspell "missing (vikix add publish)"
  python3 -c 'import bs4, lxml, yaml' 2>/dev/null && printf '%-10s %s\n' python "bs4, lxml and yaml are here" ||
    printf '%-10s %s\n' python "missing bs4, lxml or yaml (vikix add publish)"
  local f
  for f in "IBM Plex Serif" Amiri; do
    if fc-list : family 2>/dev/null | grep -qF "$f"; then printf '%-10s %s\n' font "$f"
    else printf '%-10s %s missing (vikix add publish)\n' font "$f"; fi
  done
  if [ -e "$SHARED/publish.mk" ]; then printf '%-10s %s\n' make "$SHARED/publish.mk"
  else printf '%-10s %s\n' make "no shared targets (vikix publish setup)"; fi
}

cmd_uninstall() {
  [ -L "$SHARED" ] && run rm -f "$SHARED"
  run rm -rf "$EPUBCHECK_DIR" "$DICTS_DIR"
  say "removed epubcheck, the dictionaries and the shared make targets; your books and their out/ folders are left"
  forget_features publish
}

# The book's folder: a folder given, the project of that name in ~/src
# (two levels down too: ~/src/living-series/living-in-sql), one whose
# publish.yml has that name, or the folder you're in.
find_book() {
  local want=${1:-} d
  if [ -z "$want" ]; then
    [ -f publish.yml ] || die "no publish.yml here: vikix publish NAME, or cd into the book"
    pwd; return
  fi
  if [ -f "$want/publish.yml" ]; then (cd "$want" && pwd); return; fi
  for d in "$HOME"/src/"$want" "$HOME"/src/*/"$want"; do
    [ -f "$d/publish.yml" ] && { echo "$d"; return; }
  done
  for d in "$HOME"/src/*/publish.yml "$HOME"/src/*/*/publish.yml; do
    [ -f "$d" ] && grep -qxE "name: *[\"']?${want}[\"']?" "$d" && { dirname "$d"; return; }
  done
  die "no book called $want: a folder with publish.yml in ~/src, or a path"
}

# Where a reader plugged in takes books. Each way says the file it copied
# to; none found is an error saying what to try.
MEDIA=${VIKIX_MEDIA:-/run/media/$USER}
GIO=${VIKIX_GIO:-gio}
ADB=${VIKIX_ADB:-adb}

send_to_drive() {
  local epub=$1 d dest
  for d in "$MEDIA"/*/ /media/"$USER"/*/; do
    [ -d "$d" ] || continue
    dest=""
    if [ -d "$d/documents" ] && [ -d "$d/system" ]; then dest="$d/documents"   # a Kindle
    elif [ -d "$d/.kobo" ]; then dest="$d"                                    # a Kobo
    elif [ -d "$d/Books" ]; then dest="$d/Books"
    elif [ -d "$d/books" ]; then dest="$d/books"
    fi
    [ -n "$dest" ] || continue
    cp -- "$epub" "$dest/" && sync && { echo "${dest%/}/$(basename "$epub")"; return 0; }
  done
  return 1
}

send_over_mtp() {
  local epub=$1 root storage
  command -v "$GIO" >/dev/null 2>&1 || return 1
  root=$("$GIO" mount -li 2>/dev/null | sed -n 's/.*activation_root=\(mtp:\/\/[^ ]*\).*/\1/p' | head -1)
  [ -n "$root" ] || return 1
  "$GIO" mount "$root" >/dev/null 2>&1 || true   # mounted already is fine
  # The device's first storage (a BOOX has one: "Internal shared storage").
  storage=$("$GIO" list "$root" 2>/dev/null | head -1)
  [ -n "$storage" ] || return 1
  "$GIO" mkdir -p "${root%/}/$storage/Books" >/dev/null 2>&1 || true
  "$GIO" copy -- "$epub" "${root%/}/$storage/Books/" || return 1
  echo "${root%/}/$storage/Books/$(basename "$epub")"
}

send_over_adb() {
  local epub=$1 devices
  command -v "$ADB" >/dev/null 2>&1 || return 1
  devices=$("$ADB" devices 2>/dev/null | awk 'NR > 1 && $2 == "device"' | wc -l)
  [ "$devices" = 1 ] || return 1
  "$ADB" push "$epub" /sdcard/Books/ >/dev/null || return 1
  echo "adb:/sdcard/Books/$(basename "$epub")"
}

send_book() {
  local epub=$1 to=$2 where
  [ -f "$epub" ] || die "no $epub to send"
  if [ -n "$to" ]; then
    [ -d "$to" ] || die "no folder $to"
    cp -- "$epub" "$to/" && sync || die "couldn't copy it into $to"
    where="${to%/}/$(basename "$epub")"
  else
    where=$(send_to_drive "$epub") || where=$(send_over_mtp "$epub") || where=$(send_over_adb "$epub") ||
      die "no reader found: plug it in (on an Android reader, choose file transfer), or --to FOLDER"
  fi
  say "sent: $where"
}

cmd_build() {
  local book="" formats=() keep=() send=0 to="" a
  while [ $# -gt 0 ]; do
    a=$1; shift
    case $a in
      epub|pdf|check|spell) formats+=("$a") ;;
      --keep) keep=(--keep) ;;
      --send) send=1 ;;
      --to) send=1; to=${1:-}; [ -n "$to" ] || die "--to which folder?"; shift ;;
      -*) die "vikix publish: $a? (vikix publish -h)" ;;
      *) [ -z "$book" ] || die "one book at a time"; book=$a ;;
    esac
  done
  if [ "${#formats[@]}" -eq 0 ]; then
    if [ "$send" = 1 ]; then formats=(epub); else formats=(epub pdf); fi
  fi
  local dir
  dir=$(find_book "$book") || exit 1
  cd "$dir" || die "can't go into $dir"
  local f
  for f in "${formats[@]}"; do
    python3 "$BUILD" "$f" "${keep[@]}" || exit 1
  done
  [ "$send" = 1 ] || return 0
  send_book "$dir/out/$(python3 "$BUILD" name).epub" "$to"
}

cmd_new() {
  local dir="" title="" lang=en-GB a
  while [ $# -gt 0 ]; do
    a=$1; shift
    case $a in
      --title) title=${1:-}; shift || true ;;
      --lang)  lang=${1:-}; shift || true ;;
      -*) die "vikix publish new: $a? (vikix publish -h)" ;;
      *) [ -z "$dir" ] || die "one book at a time"; dir=$a ;;
    esac
  done
  [ -n "$dir" ] || die "vikix publish new DIR [--title TITLE] [--lang LANG]"
  [ -e "$dir/publish.yml" ] && die "$dir has a book already ($dir/publish.yml): left as it is"
  run mkdir -p "$dir/chapters"
  local name author
  name=$(basename -- "$(cd "$dir" 2>/dev/null && pwd || echo "$dir")")
  # The title from the folder (living-toki-pona: "Living toki pona") until
  # you say otherwise, here or in publish.yml.
  [ -n "$title" ] || title=$(printf '%s' "$name" | tr '_-' '  ' | sed 's/^./\U&/')
  author=$(git config user.name 2>/dev/null || true)
  [ -n "$author" ] || author=$USER
  # Inside YAML's double quotes, a quote or a backslash needs its own.
  title=${title//\\/\\\\}; title=${title//\"/\\\"}
  author=${author//\\/\\\\}; author=${author//\"/\\\"}
  if [ "$DRY_RUN" = 1 ]; then printf '   would write %s/publish.yml, a chapter, words.txt, the Makefile line\n' "$dir"; return 0; fi
  {
    echo "# publish.yml: the book's metadata for vikix publish. pandoc reads it as"
    echo "# it is (title, subtitle, author, lang, date, rights ...); name, chapters"
    echo "# and mainfont are Vikix's (vikix publish -h)."
    echo "title: \"$title\""
    echo "author: \"$author\""
    echo "lang: $lang"
    echo "name: $name"
  } > "$dir/publish.yml"
  [ -e "$dir/chapters/01-start.md" ] ||
    printf '# %s\n\nThe first chapter. Each file in chapters/ is one, taken in name order.\n' "$title" > "$dir/chapters/01-start.md"
  [ -e "$dir/words.txt" ] || : > "$dir/words.txt"
  grep -qxF 'out/' "$dir/.gitignore" 2>/dev/null || printf '# The book, built by vikix publish.\nout/\n' >> "$dir/.gitignore"
  # shellcheck disable=SC2016  # make's $(HOME), written as it is
  local line='-include $(HOME)/.local/share/vikix/publish/publish.mk'
  if ! grep -qxF -- "$line" "$dir/Makefile" 2>/dev/null; then
    [ -s "$dir/Makefile" ] && printf '\n' >> "$dir/Makefile"
    printf '# The book: make epub, make pdf, make check (vikix publish -h).\n%s\n' "$line" >> "$dir/Makefile"
  fi
  say "a book in $dir: write in chapters/, then vikix publish $dir (or make epub there)"
}

case ${1:-} in
  new)       shift; cmd_new "$@" ;;
  setup)     cmd_setup ;;
  status)    cmd_status ;;
  uninstall) cmd_uninstall ;;
  -h|--help|help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) cmd_build "$@" ;;
esac
