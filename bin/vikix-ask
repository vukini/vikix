#!/usr/bin/env bash
# vikix-ask — AI on the text you selected, anywhere on the desktop (Super+i).
#
#   vikix-ask             a menu: Ask, Proofread, Rewrite, Translate, Explain
#   vikix-ask ACTION      one of those straight away (ask, proofread,
#                         rewrite, translate, explain): for keys of your own
#                         in user.lisp
#   vikix-ask use [local|claude|codex|cloud]  which model answers (vikix ai use); alone, says which
#   vikix-ask which [translate]
#                         the model (Translate's with translate), where the text goes, which of the
#                         three it is and Codex's effort, tab-separated
#                         (for vikix-voice: Super+F10 asks the same model)
#
# The text is what you last highlighted (X keeps it after the highlight
# is gone), else the clipboard: the notification while it works shows it. Proofread, Rewrite and Translate put their result on the
# clipboard, to paste where you want it; Ask and Explain show the answer,
# in a notification when it's short, else in a terminal. A local model and
# Claude answer through llm (vikix ai llm), so it's all in llm logs too.
#
# Which model answers is yours to choose, in ~/.config/vikix/ai (made on
# first use): a local one (free, offline, the text stays on this laptop),
# Claude (better, paid, the text goes to Anthropic), Codex (the Codex
# you installed and signed in to with codex login; the text goes to
# OpenAI), or a cloud service that speaks OpenAI's API (use=cloud:
# OpenRouter unless cloud_url= says another, with a key of yours by name,
# cloud_key=, and the service's model in cloud_model=; the text goes to that
# service and the model's host; lib/cloud-ask.sh). It never leaves the
# local model by itself.
#
# Codex is an agent, so Super+i asks it with its tools switched off: no
# commands, no web search, none of the apps connected to your ChatGPT
# account, and nothing kept of the session. What you select can come from
# any page, and a line in it written for an agent finds nothing to act
# with. It takes some ten seconds an answer, fewer with a faster model
# (model=) and effort=low in that file, which leave Codex in the terminal
# as it was; the editors' chats and note know only local and Claude, and
# stay on the local model meanwhile.

set -uo pipefail
VIKIX_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../lib/codex-ask.sh
. "$VIKIX_DIR/lib/codex-ask.sh"
# shellcheck source=../lib/cloud-ask.sh
. "$VIKIX_DIR/lib/cloud-ask.sh"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/vikix/ai"
LLM=${VIKIX_LLM:-$HOME/.local/bin/llm}   # tests name their stand-in
TERMINAL=${VIKIX_TERMINAL:-alacritty}
API=http://127.0.0.1:11434/api
CLAUDE_DEFAULT=claude-sonnet-5
MAX=12000     # characters of the selection sent: a small model's context is short
RUN="${XDG_RUNTIME_DIR:-/tmp}"

note() {   # note TITLE [BODY] — a notification (it replaces "working" once there is one)
  notify-send -a Vikix ${NOTE_ID:+-r "$NOTE_ID"} "$1" "${2:-}" 2>/dev/null || true
}
fail() { note "$1" "${2:-}"; exit 1; }
# Notification bodies are markup: an & or < in the text would hide it.
escape() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

make_conf() {
  [ -e "$CONF" ] && return 0
  mkdir -p "$(dirname "$CONF")"
  cat > "$CONF" <<'EOF'
# Vikix AI on the selected text (Super+i): which model answers.
# vikix ai use local|claude|codex|cloud switches, or edit it here.
#
#   use=local    a model on this laptop: free, offline, the text stays here
#                (vikix ai models gets one)
#   use=claude   Claude: better, paid, the text goes to Anthropic
#                (vikix ai key set anthropic first)
#   use=codex    Codex, with its tools off: the text goes to OpenAI
#                (install it and codex login first)
#   use=cloud    a service that speaks OpenAI's API: OpenRouter unless
#                cloud_url= says another; paid, the text goes there and to
#                the model's host (vikix ai key set openrouter first)
use=local

# A model by name (llm models lists them). Empty: llama3.2:3b, or your
# first local model; claude-sonnet-5 for Claude; Codex's own for Codex.
# One line for those three: empty it before switching between them. The
# cloud has its own line below, so a local model here stays.
model=

# Cloud only (use=cloud): the service's address, any that speaks OpenAI's
# API (empty: https://openrouter.ai/api/v1); which key of yours, by the
# name vikix ai key set gave it (empty: openrouter; groq, mistral,
# deepseek, xai ... or the variable itself, MY_SERVICE_API_KEY); and its
# model, by the service's own name (empty: openai/gpt-4o-mini; OpenRouter's
# are at openrouter.ai/models). model= and translate_model= don't apply.
cloud_url=
cloud_key=
cloud_model=

# Translate only: a model of its own, under the same use= (translategemma:27b
# is made for it; vikix ai models gets it). Empty: model= translates too.
translate_model=

# Codex only: how hard it thinks (low, medium, high). Empty: Codex's own
# setting, in ~/.codex/config.toml. Low answers soonest.
effort=

# The languages Translate offers, first to last (you can also type another).
languages=English Esperanto French Spanish Arabic Hindi

# Local models only: run them on a graphics chip that shares the memory
# (AMD's Ryzen AI Max)? Empty or auto: yes when the chip may take 32 GB or
# more; on: always; off: the CPU runs them. vikix ai restart applies it.
graphics=
EOF
}

conf() {   # conf KEY — its value in the file, without comments or spaces
  sed -n "s/^[[:space:]]*$1[[:space:]]*=//p" "$CONF" 2>/dev/null | tail -1 |
    sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

# The model, from the file (its model= line, or the one KEY names: Translate
# has translate_model=); says what's missing, instead of guessing.
pick_model() {   # pick_model [KEY]
  local use model names key=${1:-model}
  use=$(conf use); use=${use,,}; model=$(conf "$key")
  [ "$use" = codex ] || [ -x "$LLM" ] || fail "Super+i needs llm" "In a terminal: vikix ai llm"
  case $model in [!A-Za-z0-9]*|*[!A-Za-z0-9._:/-]*) fail "$key= in ~/.config/vikix/ai looks wrong" "$(escape <<<"$model")" ;; esac
  case ${use:-local} in
    local)
      names=$(curl -fsS --max-time 3 "$API/tags" 2>/dev/null |
        python3 -c 'import json,sys; [print(m["name"]) for m in json.load(sys.stdin).get("models", [])]' 2>/dev/null)
      [ -n "$names" ] || {
        curl -fsS --max-time 2 "$API/version" >/dev/null 2>&1 ||
          fail "Local AI isn't running" "In a terminal: vikix ai setup. Or Claude: vikix ai use claude"
        fail "No local model yet" "Super+m, Local AI: choose a model. Or Claude: vikix ai use claude"
      }
      if [ -n "$model" ]; then
        grep -qxF -- "$model" <<<"$names" ||
          fail "You don't have the model $model" "vikix ai models gets it, or change $key= in ~/.config/vikix/ai"
      elif grep -qx 'llama3.2:3b' <<<"$names"; then model=llama3.2:3b
      else model=$(head -1 <<<"$names")
      fi
      WHERE="on this laptop" ;;
    claude)
      have_key ||
        fail "Claude needs your Anthropic key" "In a terminal: vikix ai key set anthropic. Or back to local: vikix ai use local"
      model=${model:-$CLAUDE_DEFAULT}
      WHERE="sent to Anthropic" ;;
    cloud)
      cloud_ready || fail "$CLOUD_MISSING" "$CLOUD_FIX. Or back to local: vikix ai use local"
      # Its own line: model= names a local model (or Claude's), which the
      # service wouldn't know.
      model=$(conf cloud_model)
      case $model in [!A-Za-z0-9]*|*[!A-Za-z0-9._:/-]*) fail "cloud_model= in ~/.config/vikix/ai looks wrong" "$(escape <<<"$model")" ;; esac
      model=${model:-$VIKIX_CLOUD_MODEL_DEFAULT}
      vikix_cloud_llm_entry "$CLOUD_URL" "$model"
      WHERE="sent to $(vikix_cloud_host "$CLOUD_URL")" ;;
    codex)
      codex_ready || fail "$CODEX_MISSING" "$CODEX_FIX. Or back to local: vikix ai use local"
      # No name: the model Codex itself is set to (~/.codex/config.toml).
      CODEX_MODEL=$model; model=${model:-codex}
      CODEX_EFFORT=$(conf effort); CODEX_EFFORT=${CODEX_EFFORT,,}
      case $CODEX_EFFORT in *[!a-z]*) fail "effort= in ~/.config/vikix/ai looks wrong" "A word such as low, medium or high: $(escape <<<"$CODEX_EFFORT")" ;; esac
      WHERE="sent to OpenAI" ;;
    *) fail "use= in ~/.config/vikix/ai should be local, claude, codex or cloud" "$(escape <<<"$use")" ;;
  esac
  MODEL=$model; USE=${use:-local}
}

# The cloud service's address and key are there (CLOUD_URL, CLOUD_KEY);
# else what's missing, and what to do.
cloud_ready() {
  local url name
  url=$(conf cloud_url); name=$(conf cloud_key); name=${name:-$VIKIX_CLOUD_KEY_DEFAULT}
  CLOUD_URL=$(vikix_cloud_url "$url") || { CLOUD_MISSING="cloud_url= in ~/.config/vikix/ai isn't an address"; CLOUD_FIX="https://... (empty: OpenRouter)"; return 1; }
  CLOUD_KEY=$(vikix_cloud_key_value "$name") || { CLOUD_MISSING="cloud_key= in ~/.config/vikix/ai isn't a key's name"; CLOUD_FIX="a name from vikix ai key list, such as openrouter"; return 1; }
  [ -n "$CLOUD_KEY" ] || { CLOUD_MISSING="The cloud service needs its key"; CLOUD_FIX="In a terminal: vikix ai key set $name"; return 1; }
  return 0
}

# Codex is there and signed in; else what's missing, and what to do.
codex_ready() {
  vikix_codex_ready
  case $? in
    0) return 0 ;;
    1) CODEX_MISSING="Codex isn't installed"; CODEX_FIX="In a terminal: vikix add codex, then codex login" ;;
    *) CODEX_MISSING="Codex isn't signed in"; CODEX_FIX="In a terminal: codex login" ;;
  esac
  return 1
}

have_key() {
  # A key set since login isn't in the desktop's environment yet.
  if [ -z "${ANTHROPIC_API_KEY:-}" ] && [ -r "$VIKIX_DIR/lib/secrets.sh" ]; then
    # shellcheck source=../lib/secrets.sh
    . "$VIKIX_DIR/lib/secrets.sh"; vikix_export_secrets
  fi
  [ -n "${ANTHROPIC_API_KEY:-}" ]
}

# use local|claude|codex: rewrite use= in the file (and only that line).
set_use() {
  local to=${1:-}
  # Without one: which it is now, one word (editors read it).
  if [ -z "$to" ]; then local use; use=$(conf use); use=${use,,}; echo "${use:-local}"; exit 0; fi
  case $to in local|claude|codex|cloud) ;; *) echo "usage: vikix ai use local|claude|codex|cloud" >&2; exit 2 ;; esac
  if [ "$to" = claude ] && ! have_key; then
    echo "Claude needs your Anthropic key first: vikix ai key set anthropic" >&2
    note "Claude needs your Anthropic key" "In a terminal: vikix ai key set anthropic"; exit 1
  fi
  if [ "$to" = codex ] && ! codex_ready; then
    echo "$CODEX_MISSING. $CODEX_FIX" >&2
    note "$CODEX_MISSING" "$CODEX_FIX"; exit 1
  fi
  if [ "$to" = cloud ] && ! cloud_ready; then
    echo "$CLOUD_MISSING. $CLOUD_FIX" >&2
    note "$CLOUD_MISSING" "$CLOUD_FIX"; exit 1
  fi
  if grep -q '^[[:space:]]*use[[:space:]]*=' "$CONF"; then
    sed --follow-symlinks -i "s/^[[:space:]]*use[[:space:]]*=.*/use=$to/" "$CONF"
  else
    echo "use=$to" >> "$CONF"
  fi
  local what="a model on this laptop: free, offline, the text stays here"
  [ "$to" = claude ] && what="Claude: better, paid, the text you select goes to Anthropic"
  [ "$to" = cloud ] && what="the cloud service at $(vikix_cloud_host "$CLOUD_URL"): paid, the text you select goes there and to the model's host"
  if [ "$to" = codex ]; then
    # The editors' chats and note know only local and Claude.
    what="Codex, with its tools off: the text you select goes to OpenAI"
    echo "Super+i and the voice key now use $what"
    echo "The editors' chats and note stay on the local model."
    note "Super+i and the voice key now use codex" "$what. The editors' chats and note stay on the local model."
    return 0
  fi
  echo "Super+i and the editors' chats now use $what"
  note "Super+i and the editors' chats now use $to" "$what"
}

# Proofread: what changed, word by word, so a change for the worse shows.
changes() {   # changes BEFORE AFTER
  python3 - "$1" "$2" <<'PY'
import difflib, sys
a, b = sys.argv[1].split(), sys.argv[2].split()
out = []
for op, i1, i2, j1, j2 in difflib.SequenceMatcher(None, a, b).get_opcodes():
    if op != "equal":
        out.append((" ".join(a[i1:i2]) or "+") + " → " + (" ".join(b[j1:j2]) or "(gone)"))
n = len(out)
if n:
    print(f"{n} change{'s' if n > 1 else ''}: " + "; ".join(x[:40] for x in out[:5]) + ("; …" if n > 5 else ""))
PY
}

selection() {
  local s
  s=$(timeout 2 xclip -o -selection primary 2>/dev/null || true)
  [ -n "${s//[[:space:]]/}" ] || s=$(timeout 2 xclip -o -selection clipboard 2>/dev/null || true)
  [ -n "${s//[[:space:]]/}" ] || s=''
  printf '%s' "$s"
}

# Small models like to open with "Here is the corrected text:", and to
# wrap the answer in quotes; the clipboard should get the text alone.
tidy() {
  python3 -c '
import re, sys
t = sys.stdin.read().strip()
lines = t.split("\n")
if len(lines) > 1 and re.match(r"(here|sure|certainly|of course|okay|ok)\b.*:\s*$", lines[0], re.I):
    t = "\n".join(lines[1:]).strip()
if len(t) > 1 and t[0] == t[-1] and t[0] in "\"“" and t.count(t[0]) == 2:
    t = t[1:-1].strip()
if t.startswith("```") and t.endswith("```") and t.count("```") == 2:
    t = re.sub(r"^```[^\n]*\n", "", t)[:-3].strip()
print(t, end="")
'
}

make_conf
if [ "${1:-}" = use ]; then set_use "${2:-}"; exit; fi
pick_model
# Translate's own model, when the file names one.
translate_model() { [ -z "$(conf translate_model)" ] || pick_model translate_model; }
# The model, where the words go, which of the three it is and Codex's
# effort (last: it may be empty), tab-separated (vikix-voice asks the same one);
# which translate: Translate's.
if [ "${1:-}" = which ]; then
  [ "${2:-}" = translate ] && translate_model
  printf '%s\t%s\t%s\t%s\n' "$MODEL" "$WHERE" "$USE" "${CODEX_EFFORT:-}"; exit 0
fi
TEXT=$(selection)
if [ "${#TEXT}" -gt "$MAX" ]; then TEXT=${TEXT:0:$MAX}; CUT=1; else CUT=0; fi

preview() {   # the selection's start, on one line, for rofi's message
  if [ -z "$TEXT" ]; then echo "Nothing selected: Ask works on its own; select text for the rest."
  else
    local one=${TEXT//[$'\n\t']/ }
    printf '%s' "${one:0:90}" | escape; [ "${#one}" -gt 90 ] && printf '…'
  fi
  return 0
}

ACTION=${1:-}
if [ -z "$ACTION" ]; then
  menu=$'Ask about it\nProofread\nRewrite: clearer\nTranslate\nExplain'
  # The other two, each only when it could answer.
  [ "$USE" = local ] || menu+=$'\nUse the local model instead (free; the text stays here)'
  [ "$USE" = claude ] || menu+=$'\nUse Claude instead (paid; the text goes to Anthropic)'
  if [ "$USE" != cloud ] && cloud_ready 2>/dev/null; then menu+="
Use the cloud service instead (paid; the text goes to $(vikix_cloud_host "$CLOUD_URL"))"; fi
  if [ "$USE" != codex ] && vikix_codex_ready; then menu+=$'\nUse Codex instead (the text goes to OpenAI)'; fi
  pick=$(rofi -dmenu -i -no-custom -p "AI ($MODEL, $WHERE)" -mesg "$(preview)" <<<"$menu") || exit 0
  case $pick in
    Ask*) ACTION=ask ;; Proofread*) ACTION=proofread ;; Rewrite*) ACTION=rewrite ;;
    Translate*) ACTION=translate ;; Explain*) ACTION=explain ;;
    "Use Claude"*) set_use claude; exit ;; "Use the local"*) set_use local; exit ;;
    "Use Codex"*) set_use codex; exit ;; "Use the cloud"*) set_use cloud; exit ;;
    *) exit 0 ;;
  esac
fi

case $ACTION in
  ask)
    question=$(rofi -dmenu -p "Ask $MODEL" -mesg "$(preview)" </dev/null) || exit 0
    [ -n "${question//[[:space:]]/}" ] || exit 0
    system="Answer plainly, in at most three short sentences, without lists, headings or Markdown. If text is given before the question, the question is about it."
    title="AI: $question" ;;
  proofread)
    system="Correct the spelling, grammar and punctuation of the text. Keep its meaning, tone, language, paragraphs and line breaks, and change nothing that is already correct. Reply with the corrected text only: no introduction, no comments, no quotes around it."
    title="Proofread" ;;
  rewrite)
    system="Rewrite the text to be clearer and more concise, in the same language, keeping its meaning, its paragraphs and line breaks. Reply with the rewritten text only: no introduction, no comments, no quotes around it."
    title="Rewritten" ;;
  translate)
    langs=$(conf languages); langs=${langs:-English Esperanto}
    lang=$(tr ' ' '\n' <<<"$langs" | grep -v '^$' | rofi -dmenu -i -p "Translate into" -mesg "$(preview)") || exit 0
    # Any language you type (Português, 日本語); only one line of it.
    lang=${lang//[$'\r\t']/ }; lang=${lang%%$'\n'*}; lang=${lang:0:40}
    [ -n "${lang//[[:space:]]/}" ] || exit 0
    translate_model
    system="Translate the text into $lang. Reply with the translation only: no introduction, no notes, no quotes around it."
    title="In $lang" ;;
  explain)
    system="Explain the text in plain language, in at most three short sentences, without lists, headings or Markdown. If it is code or a command, say what it does. If it is an error message, say what it means and how to fix it. Don't suggest fixes for anything that isn't wrong."
    title="Explained" ;;
  *) echo "usage: vikix-ask [ask|proofread|rewrite|translate|explain] | use local|claude|codex|cloud" >&2
     fail "vikix-ask doesn't know \"$(escape <<<"${ACTION:0:40}")\"" "It knows ask, proofread, rewrite, translate, explain" ;;
esac
if [ -z "$TEXT" ] && [ "$ACTION" != ask ]; then
  fail "Select some text first" "Highlight it (or copy it), then Super+i again"
fi

# One at a time: a second press while the model works would only queue up.
exec 9>"$RUN/vikix-ask.lock"
flock -n 9 || fail "AI is still working on the last one" ""

NOTE_ID=$(notify-send -p -a Vikix -t 300000 "AI is working…" "$MODEL, $WHERE
$(if [ -n "$TEXT" ]; then printf '“'; preview; printf '”'; fi)" 2>/dev/null || true)
[[ $NOTE_ID =~ ^[0-9]+$ ]] || NOTE_ID=''
err="$RUN/vikix-ask.err"
# One answer: the text on stdin, from Codex or through llm.
answer() {
  if [ "$USE" = codex ]; then
    vikix_codex_ask "$system" "${question:-}" "${CODEX_MODEL:-}" "${CODEX_EFFORT:-}"
  else
    local args=(-m "$MODEL" -s "$system")
    [ "$ACTION" = ask ] && args+=("$question")
    if [ "$USE" = cloud ]; then
      # llm's entry for the service, with the key in its environment only.
      args[1]=vikix-cloud
      OPENAI_API_KEY=$CLOUD_KEY timeout 300 "$LLM" "${args[@]}"
    else
      timeout 300 "$LLM" "${args[@]}"
    fi
  fi
}
if [ -n "$TEXT" ]; then
  out=$(printf '%s\n' "$TEXT" | answer 2>"$err")
else
  out=$(answer </dev/null 2>"$err")
fi
rc=$?
if [ "$rc" != 0 ] || [ -z "${out//[[:space:]]/}" ]; then
  why=$(grep -v '^\s*$' "$err" 2>/dev/null | tail -1); why=$(printf '%s' "${why:0:200}" | escape)
  if [ "$rc" = 124 ]; then
    why="It took over 5 minutes; a smaller model answers faster (vikix ai models)"
    [ "$USE" = codex ] && why="It took over 5 minutes"
  fi
  case $why in *"No key found"*) why="Your Anthropic key: vikix ai key set anthropic" ;; esac
  fail "AI didn't answer" "${why:-no answer from $MODEL}"
fi
rm -f "$err"
out=$(tidy <<<"$out")
[ "$CUT" = 1 ] && cut_note=" (only the first $MAX characters were sent)" || cut_note=''

case $ACTION in
  proofread|rewrite|translate)
    printf '%s' "$out" | xclip -selection clipboard
    body=$(printf '%s' "${out:0:300}" | head -8 | escape)
    [ "${#out}" -gt 300 ] || [ "$(wc -l <<<"$out")" -gt 8 ] && body+='…'
    if [ "$ACTION" = proofread ]; then
      what=$(changes "$TEXT" "$out")
      if [ -z "$what" ]; then note "Proofread: nothing to correct" "$MODEL$cut_note"
      else note "Proofread, on the clipboard$cut_note" "$(escape <<<"$what")"$'\n\n'"$body"
      fi
    else
      note "$title, on the clipboard$cut_note" "$body"
    fi ;;
  ask|explain)
    # Short: a notification. Long: a terminal to read it in.
    if [ "${#out}" -le 450 ] && [ "$(wc -l <<<"$out")" -le 6 ]; then
      note "$(printf '%s' "${title:0:80}" | escape)" "$(printf '%s' "$out" | escape)"
    else
      note "AI answered" "In a terminal: q closes it"
      answer="$RUN/vikix-ask-answer.txt"
      { printf '%s (%s, %s)%s\n\n' "$title" "$MODEL" "$WHERE" "$cut_note"; printf '%s\n' "$out"; } > "$answer"
      # 9>&-: the terminal mustn't keep the lock, or Super+i would say
      # "still working" for as long as the answer is open.
      kept=", llm logs keeps it"; [ "$USE" = codex ] && kept=''
      exec "$TERMINAL" -e less -P "AI answer: q closes, /word searches$kept" "$answer" 9>&-
    fi ;;
esac
