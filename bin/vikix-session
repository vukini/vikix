#!/bin/sh
# vikix-session — everything that runs for the length of a desktop session.
#
# Started by ~/.xinitrc inside dbus-run-session, so every program here
# shares one session bus. Without systemd there are no "user services":
# the background programs are simply started here, and they end when
# StumpWM (the last line) exits.

# Everything this session prints (StumpWM's messages, errors from the
# programs below) goes to a log, so a desktop that won't start can be
# looked into from another console. The previous session's log is kept.
log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/vikix"
mkdir -p "$log_dir"
[ -f "$log_dir/session.log" ] && mv "$log_dir/session.log" "$log_dir/session.log.old"
exec >"$log_dir/session.log" 2>&1
echo "vikix-session started $(date)"
set -x    # each command is written to the log before it runs

# API keys from `vikix ai key set`, for everything the desktop starts
# (Emacs, a terminal, an agent). lib/secrets.sh never prints them, but the
# trace above would write each export, key and all, into session.log: so
# the trace is off while they load.
{ set +x; } 2>/dev/null
# shellcheck source=../lib/secrets.sh
. "$(dirname "$(readlink -f "$0")")/../lib/secrets.sh"
set -x

# The Vikix manual (the guides in docs/, made by 40-config), for Emacs's
# C-h i and `info vikix`. The empty entry at the end keeps the system's.
case ":${INFOPATH:-}:" in
  *":$HOME/.local/share/info:"*) ;;
  *) INFOPATH="$HOME/.local/share/info:${INFOPATH:-}"; export INFOPATH ;;
esac

[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"
xsetroot -cursor_name left_ptr
"$HOME/.local/bin/vikix-keyboard"    # layout and options from ~/.config/vikix/keyboard
command -v autorandr >/dev/null 2>&1 && autorandr --change --default default 2>/dev/null
"$HOME/.local/bin/vikix-wallpaper"     # yours, or the theme's (Super+m, Wallpaper)

# One ssh-agent for the whole session, started before anything that may
# use it (Emacs pushing with Magit, every terminal), so a key's passphrase
# is asked once; `AddKeysToAgent yes` in ~/.ssh/config adds the key on its
# first use. An agent that is already there (forwarded, or started by the
# login shell) is used as it is, and only our own is stopped at the end.
if [ -z "${SSH_AUTH_SOCK:-}" ] && command -v ssh-agent >/dev/null 2>&1; then
  eval "$(ssh-agent -s)" >/dev/null
  vikix_ssh_agent=1
fi

pipewire &                             # audio (starts WirePlumber and pipewire-pulse)
dunst &                                # notifications
clipmenud &                            # remembers what you copy (Super+c)
"$HOME/.local/bin/vikix-drives" start &   # USB drives mount when plugged in (udiskie)
# The compositor forks itself. glx is its fast backend on real graphics.
# A virtual machine's OpenGL is drawn in software, where glx starts fine
# but misses redraws (the bar's clock stops), so there it uses xrender.
# And if glx won't start at all, xrender again.
if grep -qw hypervisor /proc/cpuinfo 2>/dev/null; then
  picom -b --backend xrender
else
  picom -b || picom -b --backend xrender
fi
"$HOME/.local/bin/vikix-idle" apply    # lock and screen-off times (~/.config/vikix/idle)
"$HOME/.local/bin/vikix-nightlight" start   # warmer in the evening, unless switched off
xss-lock -- "$HOME/.local/bin/vikix-lock" --locker &   # locks then; also on suspend

# Emacs as a daemon, so `e` (emacsclient) opens a frame at once. The first
# start on a new machine installs the config's packages; that happens here,
# in the background, not while you wait.
command -v emacs >/dev/null 2>&1 && emacs --fg-daemon >/dev/null 2>&1 &

# A warning when the battery runs low; only on machines that have one.
# And, on battery, a suspend after a while with nobody there (vikix-idle).
for battery in /sys/class/power_supply/BAT*; do
  [ -e "$battery" ] || break
  "$HOME/.local/bin/vikix-battery" &
  "$HOME/.local/bin/vikix-idle" --watch &
  break
done

# Updates waiting, for the bar: checked a minute after login and then every
# 6 hours, in the background (bin/vikix-updates).
"$HOME/.local/bin/vikix-updates" --watch &

# The password box programs show when they need admin rights.
for agent in /usr/libexec/polkit-gnome-authentication-agent-1 \
             /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1; do
  if [ -x "$agent" ]; then "$agent" & break; fi
done

# Inside a VM only (installed by install/70-vm.sh): shared clipboard and
# a screen that follows the window size. VBoxClient-all for VirtualBox,
# spice-vdagent for KVM/QEMU; both fork themselves.
command -v VBoxClient-all >/dev/null 2>&1 && VBoxClient-all
command -v spice-vdagent >/dev/null 2>&1 && spice-vdagent

# Not exec: when StumpWM exits, the X server ends, which takes the X
# programs with it, but pipewire is not an X program and would live on.
set +x
echo "starting StumpWM"
"$HOME/.local/bin/stumpwm"
echo "StumpWM exited with status $?"
[ -n "${vikix_ssh_agent:-}" ] && ssh-agent -k >/dev/null
# shellcheck disable=SC2046  # split on purpose: one argument per job
kill $(jobs -p) 2>/dev/null
