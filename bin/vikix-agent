#!/usr/bin/env bash
# vikix-agent — an AI agent in this terminal, after a snapshot of your files
# (so whatever it changes can be seen with vikix changes, and undone with
# vikix undo). Super+a and `vikix agent` (alias: a) start it.
#
#   vikix agent [ARGS]            your agent (Claude Code, unless you chose
#                                 another); ARGS go to it
#   vikix agent --use NAME [ARGS]  another one, this time: claude, opencode,
#                                 codex, gemini, antigravity, aider
#   vikix agent --local [--model M]   on a model on this laptop (Ollama):
#                                 opencode, codex and aider can. Small models
#                                 do little as agents, and a laptop CPU takes
#                                 minutes per answer
#   vikix agent --mode supervised|autonomous|unrestricted [--use codex]
#                                 how free Codex is this session (Codex only,
#                                 for now): supervised, its sandbox narrowed
#                                 to this folder and every step out of it
#                                 asked of you; autonomous, the same sandbox,
#                                 a reviewer of Codex's own answering those
#                                 steps and the network on, what a worker at
#                                 a desk gets when nothing says otherwise
#                                 (mode= in ~/.config/vikix/office);
#                                 unrestricted, no sandbox and no approvals,
#                                 for a VM or a container: typed each time,
#                                 warned about, and refused in a project's
#                                 own folder
#   vikix agent --default NAME    the one Super+a starts
#   vikix agent --list            the agents, which are here, and yours
#   vikix agent --ask TEXT        start with this question (vikix diagnose)
#   vikix agent --exec [NAME] [ARGS]   for editors: the same start (the
#                                 guide, no keys, a snapshot), but nothing
#                                 of Vikix's on stdout (it's the agent's:
#                                 ACP talks over it), no questions, and an
#                                 error if it isn't installed. NAME: yours
#                                 when left out. Editors run e.g.
#                                 vikix agent --exec gemini --experimental-acp
#   vikix agent --acp [NAME] [ARGS]   the same, as an ACP agent (Agent
#                                 Client Protocol: Neovim's CodeCompanion,
#                                 Emacs's agent-shell, Zed): claude and codex
#                                 through their adapters (installed with
#                                 them), gemini and opencode as they are;
#                                 aider and antigravity don't speak it
#   vikix agent --which           the agent Super+a starts, one word
#   vikix agent --install NAME    install one (its official installer, or
#   vikix agent --uninstall NAME  for antigravity Google's release pinned
#                                 and checked here; also vikix add/remove
#                                 NAME), or take it away. For one you have,
#                                 --install adds only what's missing (its
#                                 ACP adapter, say)
#
# Every agent is told how Vikix works by the same guide: Claude Code and
# OpenCode read the Vikix skill (~/.claude/skills/vikix); the others read
# ~/.local/share/vikix/AGENTS.md, made from that skill at each update and
# each start: linked as ~/.codex/AGENTS.md, imported by a one-line
# ~/.gemini/GEMINI.md, included by a rule file of Vikix's own for
# Antigravity CLI (~/.gemini/antigravity-cli/rules/vikix.md), given to
# Aider with --read; never over a file of yours.
#
# Antigravity CLI (agy) is where a personal Google account signs in now: in
# June 2026 Gemini CLI stopped serving the free, AI Pro and AI Ultra
# accounts, and keeps working with a Gemini API key or a Code Assist
# licence from work. Both are here. Antigravity signs in in your browser
# at its first start and keeps the sign-in in the system keyring (/logout
# in it drops it); with modelProvider gemini in its settings it uses
# GEMINI_API_KEY instead, which it then keeps from vikix ai key.
#
# What an agent doesn't get, so a prompt injection (a web page, a README it
# reads) can't use it: your API keys and other secrets from the environment
# (each agent signs in its own way; Aider has no login, so it keeps the
# model companies' keys; VIKIX_AGENT_API_KEY=1 keeps them all), and your SSH
# agent, which after your first push would let it push as you
# (VIKIX_AGENT_SSH=1 keeps it). This prevents accidents; it isn't a sandbox:
# the agent runs as you and can read your files.
#
# Claude Code and Antigravity CLI also get the office's house rules: a hook
# that runs vikix agents touch before each edit, so two agents on one file
# are caught and a crossing into another agent's folder is recorded (see
# vikix agents). Claude Code gets it for the session; agy takes no such
# option, so for it the hook is a plugin of Vikix's (agy plugin list shows
# vikix), put in place at each start. VIKIX_OFFICE=0 leaves it out, and
# for agy leaves the plugin as it is.
#
# Codex gets three more things on its command line, for the session only
# (~/.codex/config.toml is yours and is never written). The repository's
# instructions: Codex reads AGENTS.md from the repository's root down to
# the folder, never CLAUDE.md, so a repository with only a CLAUDE.md (Vikix,
# most projects made with Claude Code) is given it as the file to fall back
# on, with Codex's cap raised to hold it whole; a repository with an
# AGENTS.md is read as its author meant. A mode (--mode above): in a desk
# (a git worktree) the house default, mode= in ~/.config/vikix/office,
# which Vikix writes as autonomous the first time; elsewhere Codex runs as
# your own settings say unless --mode is typed. The two sandboxed modes
# make this folder Codex's only writable root (your writable_roots are set
# aside for the session), so the project's own folder, ~/vikix and the
# other desks are read-only to what Codex runs, and link Vikix's rules
# (~/.codex/rules/vikix.rules, through vikix agents hooks codex --install)
# which let a desk's day (git on its branch, the tests, vikix, the release)
# run without a prompt. And trust for the house rules' hook: Codex runs a
# hook of yours only once you trusted it in /hooks, by its hash, which every
# release that changes the file undoes; when ~/.codex/hooks.json is Vikix's
# and the folder is one of your projects (vikix project list), the start
# passes --dangerously-bypass-hook-trust, since Vikix vets that file by
# making it; in a stranger's repository Codex's own prompt stays.
# VIKIX_CODEX_HOOK_TRUST=ask keeps the prompt everywhere.

set -euo pipefail
VIKIX_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../lib/common.sh
. "$VIKIX_DIR/lib/common.sh"
# shellcheck source=../lib/features.sh
. "$VIKIX_DIR/lib/features.sh"

AGENTS=(claude opencode codex gemini antigravity aider)
LOCAL_OK=" opencode codex aider "
# Aider's keys: the model companies it can use. Every other secret goes.
AIDER_KEYS=" ANTHROPIC_API_KEY OPENAI_API_KEY GEMINI_API_KEY OPENROUTER_API_KEY DEEPSEEK_API_KEY MISTRAL_API_KEY GROQ_API_KEY XAI_API_KEY "
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/vikix/agent"
GUIDE="${XDG_DATA_HOME:-$HOME/.local/share}/vikix/AGENTS.md"
SKILL="$VIKIX_DIR/config/claude/skills/vikix/SKILL.md"
BIN="$HOME/.local/bin"
# Tests name their stand-ins: a missing one must not fall through to the
# real tool, which would download and run an installer.
CURL=${VIKIX_CURL:-curl}
NPM=${VIKIX_NPM:-npm}
UV=${VIKIX_UV:-uv}
API=http://127.0.0.1:11434
# ACP adapters for the agents that don't speak it themselves, pinned: a
# new version is Vikix's to test (vikix agent --acp NAME in Neovim).
# Without their per-platform packages (--os=none; --omit=optional isn't
# enough for a global install): each would bring its own copy of the agent
# (Claude's is 230 MB), and they're pointed at yours (CLAUDE_CODE_EXECUTABLE,
# CODEX_PATH).
acp_package() {
  case $1 in
    claude) echo @agentclientprotocol/claude-agent-acp@0.84.0 ;;
    codex)  echo @agentclientprotocol/codex-acp@2.0.0 ;;
  esac
}
acp_version() {   # the adapter's installed version, if it's there
  local pkg; pkg=$(acp_package "$1")
  sed -n 's/^  "version": "\(.*\)",$/\1/p' "$HOME/.local/lib/node_modules/${pkg%@*}/package.json" 2>/dev/null | head -1
}
acp_bin() { case $1 in claude) echo "$BIN/claude-agent-acp" ;; *) echo "$BIN/$1-acp" ;; esac; }
PATH="$BIN:$PATH"    # the installers put them here; codex's leaves .bashrc alone when it's on PATH

# Codex's home, from the environment only when it's a folder of yours
# under $HOME (uninstall deletes a folder in it).
codex_home() {
  local h=${CODEX_HOME:-}
  case $h in "$HOME"/?*) [ -d "$h" ] && [ ! -L "$h" ] && { echo "$h"; return; } ;; esac
  echo "$HOME/.codex"
}

# Started by Super+a, the terminal closes when this ends: an error would
# vanish before it's read. So in a terminal window of its own, wait.
own_window() {
  [ -t 0 ] || return 1
  case $(ps -o comm= -p "$PPID" 2>/dev/null) in alacritty|kitty|xterm|foot|st|urxvt|wezterm-gui) return 0 ;; esac
  return 1
}
pause_on_error() {
  local rc=$?
  if [ "$rc" != 0 ] && own_window; then printf '\nEnter closes this window. '; read -r _ || true; fi
}
trap pause_on_error EXIT

about() {
  case $1 in
    claude)   echo "Claude Code (Anthropic): your Claude login" ;;
    opencode) echo "OpenCode: any model company, or local" ;;
    codex)    echo "Codex (OpenAI): your ChatGPT login, or local" ;;
    gemini)   echo "Gemini CLI (Google): a Gemini API key, or a Code Assist licence from work (a personal account: antigravity); needs Node (vikix add javascript)" ;;
    antigravity) echo "Antigravity CLI (Google): your Google account (free, AI Pro, AI Ultra), or a Gemini API key" ;;
    aider)    echo "Aider: with an API key (vikix ai key), or local" ;;
  esac
}

# agent_cmd NAME — the program's name, where it isn't the agent's.
agent_cmd() { case $1 in antigravity) echo agy ;; *) echo "$1" ;; esac; }
agent_bin() {
  case $1 in
    opencode) echo "$HOME/.opencode/bin/opencode" ;;
    *)        echo "$BIN/$(agent_cmd "$1")" ;;
  esac
}
is_agent() { printf '%s\n' "${AGENTS[@]}" | grep -qx -- "${1:-}"; }
need_agent() {
  [ -n "${1:-}" ] || die "which agent? ${AGENTS[*]} (vikix agent --list)"
  is_agent "$1" || die "no agent called '$1': ${AGENTS[*]}"
}
installed() { [ -x "$(agent_bin "$1")" ] || command -v "$(agent_cmd "$1")" >/dev/null 2>&1; }

chosen() {
  local a=''
  [ -r "$CONF" ] && a=$(sed -n 's/^[[:space:]]*agent[[:space:]]*=[[:space:]]*\([a-z]*\).*/\1/p' "$CONF" | tail -1)
  is_agent "$a" && echo "$a" || echo claude
}

# --- The guide ---------------------------------------------------------------
# The skill without its header, as AGENTS.md. Rewritten only when it changes.
write_guide() {
  [ -r "$SKILL" ] || return 0
  local new tmp
  new=$({
    echo "<!-- Made from $SKILL by Vikix (vikix update, vikix agent); edits here are replaced. -->"
    echo
    awk 'NR == 1 && /^---$/ { head = 1; next } head && /^---$/ { head = 0; next } !head' "$SKILL" |
      sed 's/this skill/this guide/g'
  })
  if [ "$DRY_RUN" = 1 ]; then printf '   would write %s\n' "$GUIDE"; return 0; fi
  [ -f "$GUIDE" ] && [ ! -L "$GUIDE" ] && [ "$(cat "$GUIDE")" = "$new" ] && return 0
  mkdir -p "$(dirname "$GUIDE")"
  tmp=$(mktemp "$GUIDE.XXXXXX")
  printf '%s\n' "$new" > "$tmp" && mv -f "$tmp" "$GUIDE"
}

# Where each agent looks. Codex: a link to the guide. Gemini: a one-line
# GEMINI.md that imports it; a link would let Gemini's save_memory write
# into the guide the others read (and the next start wipe it).
gemini_md() { echo "${GEMINI_CLI_HOME:-$HOME}/.gemini/GEMINI.md"; }
gemini_line() { echo "@$GUIDE"; }
# Antigravity CLI reads its global rules from ~/.gemini/antigravity-cli/rules/
# (each with YAML frontmatter), and a rule may include a file: so a file of
# Vikix's own there, one line that includes the guide, is never a line in a
# file of yours, and agy's memory can't write into the guide through it.
agy_rule() { echo "$HOME/.gemini/antigravity-cli/rules/vikix.md"; }
agy_rule_text() {
  local path=$GUIDE
  # shellcheck disable=SC2088  # a literal ~/, for agy to expand (its documented form)
  case $path in "$HOME"/*) path="~/${path#"$HOME"/}" ;; esac
  cat <<EOF
---
trigger: always_on
description: "How this Vikix desktop (Void Linux, StumpWM) is put together, whose files are whose, and how to change it safely: read it before touching the desktop, its keys, themes, packages or the vikix command."
---
<!-- Made by Vikix (vikix agent); edits here are replaced. The guide itself: $GUIDE -->
@[The Vikix guide for agents]($path)
EOF
}
link_guide() {
  local to
  case $1 in
    codex)
      to="$(codex_home)/AGENTS.md"
      [ -L "$to" ] && [ "$(readlink "$to")" = "$GUIDE" ] && return 0
      if [ -e "$to" ] || [ -L "$to" ]; then
        say "your $to is kept; the Vikix guide for agents is $GUIDE (copy what you want from it)"; return 0
      fi
      run mkdir -p "$(dirname "$to")"
      run ln -sT "$GUIDE" "$to" ;;
    gemini)
      to=$(gemini_md)
      # 0.49.0 made it a link: now the import line.
      if [ -L "$to" ] && [ "$(readlink "$to")" = "$GUIDE" ]; then run rm -f "$to"; fi
      [ -f "$to" ] && [ "$(cat "$to")" = "$(gemini_line)" ] && return 0
      if [ -e "$to" ] || [ -L "$to" ]; then
        grep -qxF -- "$(gemini_line)" "$to" 2>/dev/null ||
          say "your $to is kept; to give Gemini the Vikix guide too, add this line to it: $(gemini_line)"
        return 0
      fi
      run mkdir -p "$(dirname "$to")"
      if [ "$DRY_RUN" = 1 ]; then printf '   would write %s\n' "$to"; else gemini_line > "$to"; fi ;;
    antigravity)
      to=$(agy_rule)
      [ -f "$to" ] && [ ! -L "$to" ] && [ "$(cat "$to")" = "$(agy_rule_text)" ] && return 0
      if { [ -e "$to" ] || [ -L "$to" ]; } && ! grep -q '^<!-- Made by Vikix' "$to" 2>/dev/null; then
        say "your $to is kept; to give Antigravity CLI the Vikix guide too, add this line to it (or to ~/.gemini/GEMINI.md): @[The Vikix guide for agents]($GUIDE)"
        return 0
      fi
      run mkdir -p "$(dirname "$to")"
      if [ "$DRY_RUN" = 1 ]; then printf '   would write %s\n' "$to"; else agy_rule_text > "$to"; fi ;;
  esac
}
unlink_guide() {
  local to
  case $1 in
    codex)  to="$(codex_home)/AGENTS.md"
            [ -L "$to" ] && [ "$(readlink "$to")" = "$GUIDE" ] && run rm -f "$to" ;;
    gemini) to=$(gemini_md)
            [ -f "$to" ] && [ ! -L "$to" ] && [ "$(cat "$to")" = "$(gemini_line)" ] && run rm -f "$to" ;;
    antigravity) to=$(agy_rule)
            [ -f "$to" ] && [ ! -L "$to" ] && grep -q '^<!-- Made by Vikix' "$to" && run rm -f "$to" ;;
  esac
  return 0
}

# --- The house rules for Antigravity CLI ---------------------------------------
# The same hook Claude Code gets (config/claude/office.json), before each
# edit and command. agy takes no settings for one session, so it is a
# plugin of Vikix's, installed with agy plugin install (staged under
# ~/.gemini/config/plugins/vikix; agy plugin list shows it), never a line
# in a file of yours; put in again when what it says changed. Its answer
# has agy's shape (vikix agents touch sees which agent asks).
agy_office_dir() { echo "$HOME/.gemini/config/plugins/vikix"; }
agy_office_json() {
  python3 -c 'import json, shlex, sys
print(json.dumps({"vikix-office": {"PreToolUse": [{
  "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
  "hooks": [{"type": "command", "command": shlex.quote(sys.argv[1]) + " touch", "timeout": 15}]}]}}, indent=2))' "$VIKIX_DIR/bin/vikix-agents"
}
agy_exe() { local e; e=$(agent_bin antigravity); [ -x "$e" ] && { echo "$e"; return; }; command -v agy 2>/dev/null; }
agy_office() {
  local exe dir
  [ "${VIKIX_OFFICE:-1}" != 0 ] || return 0
  exe=$(agy_exe) || return 0
  [ -f "$(agy_office_dir)/hooks.json" ] && [ "$(cat "$(agy_office_dir)/hooks.json")" = "$(agy_office_json)" ] && return 0
  if [ "$DRY_RUN" = 1 ]; then printf '   would install the house rules as the agy plugin vikix (%s)\n' "$(agy_office_dir)"; return 0; fi
  dir=$(mktemp -d)
  printf '{\n  "name": "vikix",\n  "version": "%s",\n  "description": "The house rules of the Vikix desktop: vikix agents touch before each edit and command (vikix agents help)"\n}\n' \
    "$(cat "$VIKIX_DIR/VERSION" 2>/dev/null || echo 0)" > "$dir/plugin.json"
  agy_office_json > "$dir/hooks.json"
  "$exe" plugin install "$dir" >/dev/null 2>&1 ||
    warn "the house rules didn't install as an agy plugin (agy plugin install $dir failed); antigravity runs without them"
  rm -rf "$dir"
}
agy_office_remove() {
  local exe
  [ -d "$(agy_office_dir)" ] || return 0
  exe=$(agy_exe) || { run rm -rf "$(agy_office_dir)"; return 0; }
  run "$exe" plugin uninstall vikix
}

# --- Installing ----------------------------------------------------------------

node_major() { node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0; }

# Antigravity CLI: Google's installer (antigravity.google/cli/install.sh)
# reads a manifest (version, URL, SHA-512) from its update server, checks
# the download against it, puts agy in ~/.local/bin and then runs `agy
# install`, which writes a PATH line into .bashrc, .profile and
# .bash_profile (--skip-path and --skip-aliases are that step's, not the
# script's). Vikix fetches the release the manifest named when this was
# written, checks the sum itself, and puts the program in ~/.local/bin,
# which is on PATH already: nothing of yours is edited. Moving the pin is
# a Vikix release: the manifests are linux_amd64.json and linux_arm64.json
# under https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/
# (version, url, sha512). Once installed, agy updates itself in the
# background, as Claude Code does (AGY_CLI_DISABLE_AUTO_UPDATE=true stops that).
AGY_VERSION=1.3.0
agy_release() {   # "URL SHA-512" for this machine, or nothing
  if [ -n "${VIKIX_AGY_RELEASE:-}" ]; then echo "$VIKIX_AGY_RELEASE"; return; fi   # the tests'
  case $(uname -m) in
    x86_64)  echo "https://storage.googleapis.com/antigravity-public/antigravity-cli/1.3.0-6233328509124608/linux-x64/cli_linux_x64.tar.gz f6f5e16f356ae8a345fd6ab265ad2a4e4dc8d0b7f4ac345249d0e250a06edd496677b8ac0193b258971feb7ccfbba2fccc2f482db1d62cc650498e352ef85280" ;;
    aarch64) echo "https://storage.googleapis.com/antigravity-public/antigravity-cli/1.3.0-6233328509124608/linux-arm/cli_linux_arm64.tar.gz 8a880575accf28b03de00e748209dc735c11e59847de8b137cba07aaaab166c892836574cacd9a0d6fa1e24d6e19197d25f36b7e0a49fd84d64ea84ee26ab21d" ;;
  esac
}
install_agy() {
  local release url sum f dir
  release=$(agy_release)
  [ -n "$release" ] || die "no Antigravity CLI release is pinned here for $(uname -m): Google's installer is at https://antigravity.google/docs/cli/install"
  url=${release% *}; sum=${release##* }
  f=$(fetch "$url")
  if ! printf '%s  %s\n' "$sum" "$f" | sha512sum -c --status; then
    rm -f "$f"; die "the download of Antigravity CLI $AGY_VERSION doesn't match its SHA-512 ($url): nothing installed"
  fi
  dir=$(mktemp -d)
  tar -xzf "$f" -C "$dir" antigravity || { rm -rf "$f" "$dir"; die "couldn't unpack $url (it should hold one file, antigravity)"; }
  mkdir -p "$BIN"
  install -m 755 "$dir/antigravity" "$BIN/agy"
  rm -rf "$f" "$dir"
}

# fetch URL — an installer script, whole, into a temp file: piping curl
# into a shell would run half a script if the download broke off.
fetch() {
  local f; f=$(mktemp)
  "$CURL" -fsSL "$1" -o "$f" || { rm -f "$f"; die "couldn't download $1"; }
  [ -s "$f" ] || { rm -f "$f"; die "$1 was empty"; }
  echo "$f"
}

install_agent() {
  local name=$1 script=''
  # One you have is left as it is (each updates itself): only what's
  # missing is added, its ACP adapter, say, after an update of Vikix's.
  if installed "$name"; then
    local pkg; pkg=$(acp_package "$name")
    if [ -n "$pkg" ] && [ "$(acp_version "$name")" = "${pkg##*@}" ] && [ -x "$(acp_bin "$name")" ]; then
      say "$name is already installed, with its ACP adapter for editors (vikix agent --acp $name)"
    else
      say "$name is already installed"
    fi
    install_acp "$name"; write_guide; link_guide "$name"
    [ "$name" = antigravity ] && agy_office
    [ "$name" = claude ] || record_features "$name"
    return 0
  fi
  say "installing $name: $(about "$name")"
  if [ "$DRY_RUN" = 1 ]; then
    if [ "$name" = antigravity ]; then printf '   would download Antigravity CLI %s (pinned, checked) into %s/agy\n' "$AGY_VERSION" "$BIN"
    else printf '   would install %s with its official installer\n' "$name"; fi
    return 0
  fi
  # The installers run without your keys (as the install stages do).
  (
    drop_keys
    case $name in
      claude)
        script=$(fetch https://claude.ai/install.sh); bash "$script"; rm -f "$script" ;;
      opencode)
        # --no-modify-path: its installer would add ~/.opencode/bin to your
        # .bashrc; a link in ~/.local/bin does the same, and is Vikix's.
        script=$(fetch https://opencode.ai/install); bash "$script" --no-modify-path; rm -f "$script"
        if [ -x "$HOME/.opencode/bin/opencode" ] && { [ ! -e "$BIN/opencode" ] || [ -L "$BIN/opencode" ]; }; then
          mkdir -p "$BIN"; ln -sfn "$HOME/.opencode/bin/opencode" "$BIN/opencode"
        fi ;;
      codex)
        # With ~/.local/bin on PATH, its installer leaves your .bashrc alone.
        script=$(fetch https://chatgpt.com/codex/install.sh); CODEX_NON_INTERACTIVE=1 sh "$script"; rm -f "$script" ;;
      gemini)
        command -v node >/dev/null 2>&1 || die "Gemini CLI runs on Node, which isn't here: vikix add javascript"
        [ "$(node_major)" -ge 20 ] || die "Gemini CLI needs Node 20 or newer; this is $(node --version)"
        # --prefix: into ~/.local, as you, not the system's node_modules.
        "$NPM" install -g --prefix "$HOME/.local" @google/gemini-cli ;;
      antigravity)
        install_agy ;;   # not Google's installer: see agy_release
      aider)
        # Aider runs on Python 3.10-3.12, not Void's 3.14: uv brings 3.12
        # along. The same command its official installer runs.
        if command -v "$UV" >/dev/null 2>&1; then
          "$UV" tool install --force --python python3.12 --with pip aider-chat@latest
        else
          script=$(fetch https://aider.chat/install.sh); UV_NO_MODIFY_PATH=1 sh "$script"; rm -f "$script"
        fi ;;
    esac
  )
  installed "$name" || die "$name didn't install (above)"
  install_acp "$name"
  write_guide
  link_guide "$name"
  [ "$name" = antigravity ] && agy_office
  # So vikix features shows it, and vikix remove can take it away.
  [ "$name" = claude ] || record_features "$name"
  say "$name is installed: start it with vikix agent --use $name (not plain $(agent_cmd "$name"): that skips the snapshot); vikix agent --default $name makes it Super+a's"
  [ "$name" = antigravity ] && say "Antigravity CLI $AGY_VERSION: it signs in in your browser at the first start (a Google account, or GEMINI_API_KEY with modelProvider gemini in ~/.gemini/antigravity-cli/settings.json), and updates itself from then on"
  return 0
}

# install_acp NAME — its ACP adapter, for editors, where it needs one. Not
# having Node isn't a failure: the agent works in a terminal all the same.
install_acp() {
  local pkg; pkg=$(acp_package "$1")
  [ -n "$pkg" ] || return 0
  [ "$(acp_version "$1")" = "${pkg##*@}" ] && [ -x "$(acp_bin "$1")" ] && return 0
  if [ "$DRY_RUN" = 1 ]; then printf '   would install %s (for editors) with npm\n' "$pkg"; return 0; fi
  if ! command -v "$NPM" >/dev/null 2>&1 || [ "$(node_major)" -lt 22 ]; then
    say "for editors (ACP), $1 needs an adapter that runs on Node 22 or newer: vikix add neovim (or javascript), then vikix agent --install $1"
    return 0
  fi
  ( drop_keys; "$NPM" install -g --prefix "$HOME/.local" --omit=optional --os=none --no-fund --no-audit "$pkg" ) ||
    { warn "$1's ACP adapter didn't install (above); $1 itself did"; return 0; }
  say "$1 can also run in editors: vikix agent --acp $1"
}

uninstall_agent() {
  local name=$1 link target exe
  [ "$name" = claude ] && die "Claude Code has its own uninstall: https://docs.claude.com/en/docs/claude-code"
  installed "$name" || say "$name isn't installed"
  case $name in
    opencode)
      link="$BIN/opencode"; target="$HOME/.opencode/bin/opencode"
      [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ] && run rm -f "$link"
      [ -d "$HOME/.opencode" ] && [ ! -L "$HOME/.opencode" ] && run rm -rf "$HOME/.opencode" && say "removed ~/.opencode (the program, and plugins installed there)"
      say "its settings and sessions stay: ~/.config/opencode, ~/.local/share/opencode" ;;
    codex)
      link="$BIN/codex"
      case $(readlink "$link" 2>/dev/null) in "$(codex_home)"/packages/standalone/*) run rm -f "$link" ;; esac
      [ -d "$(codex_home)/packages/standalone" ] && run rm -rf "$(codex_home)/packages/standalone" && say "removed $(codex_home)/packages/standalone"
      say "its settings, login and sessions stay: $(codex_home)" ;;
    gemini)
      command -v "$NPM" >/dev/null 2>&1 && [ -e "$BIN/gemini" ] && run "$NPM" uninstall -g --prefix "$HOME/.local" @google/gemini-cli
      say "its settings and login stay: ~/.gemini" ;;
    aider)
      command -v "$UV" >/dev/null 2>&1 && [ -e "$BIN/aider" ] && run "$UV" tool uninstall aider-chat
      say "its settings and history stay: ~/.aider*, and .aider* in your projects" ;;
    antigravity)
      # Vikix's own pieces first, through agy while it is still here: the
      # house rules' plugin and the MCP server vikix mcp register added.
      agy_office_remove
      if exe=$(agy_exe) && "$exe" mcp list 2>/dev/null | grep -q '^vikix[[:space:]]'; then run "$exe" mcp remove vikix; fi
      [ -f "$BIN/agy" ] && [ ! -L "$BIN/agy" ] && run rm -f "$BIN/agy"
      say "its settings, conversations and skills stay: ~/.gemini/antigravity-cli (and ~/.gemini/config); its sign-in stays in the keyring until you /logout in it" ;;
  esac
  local pkg; pkg=$(acp_package "$name")
  if [ -n "$pkg" ] && [ -e "$(acp_bin "$name")" ] && command -v "$NPM" >/dev/null 2>&1; then
    run "$NPM" uninstall -g --prefix "$HOME/.local" "${pkg%@*}"
  fi
  unlink_guide "$name"
  forget_features "$name"
  if [ "$(chosen)" = "$name" ]; then
    set_default claude
    installed claude || say "Claude Code isn't installed either: Super+a offers to install it"
  fi
  installed "$name" && warn "$name is still found: $(command -v "$(agent_cmd "$name")")" || say "$name is gone"
}

set_default() {
  need_agent "${1:-}"
  run mkdir -p "$(dirname "$CONF")"
  if [ "$DRY_RUN" = 1 ]; then printf '   would write %s: agent=%s\n' "$CONF" "$1"; return 0; fi
  printf '# The AI agent Super+a starts: %s\nagent=%s\n' "${AGENTS[*]}" "$1" > "$CONF"
  say "Super+a starts $1 from now on: $(about "$1")"
  installed "$1" || say "it isn't installed yet: the first Super+a offers to"
}

list_agents() {
  local a mine; mine=$(chosen)
  for a in "${AGENTS[@]}"; do
    printf '%s %-9s %-13s %s\n' "$([ "$a" = "$mine" ] && echo '*' || echo ' ')" "$a" \
      "$(installed "$a" && echo installed || echo -)" "$(about "$a")"
  done
  echo "* starts with Super+a (vikix agent --default NAME changes it)"
  echo "New to this? Claude Code is the one Vikix is made with; OpenCode or Aider to work offline (--local)."
}

# --- Local models -------------------------------------------------------------

local_model() {   # local_model [WANTED] — a model Ollama has, better coders first
  local names m
  names=$("$CURL" -fsS --max-time 3 "$API/api/tags" 2>/dev/null |
    python3 -c 'import json,sys; [print(m["name"]) for m in json.load(sys.stdin).get("models", [])]' 2>/dev/null) || true
  [ -n "$names" ] || die "no local model: vikix ai setup, then vikix ai models"
  if [ -n "${1:-}" ]; then
    grep -qxF -- "$1" <<<"$names" || die "you don't have $1 (vikix ai list)"
    echo "$1"; return
  fi
  for m in qwen2.5-coder:14b qwen2.5-coder:7b qwen3:8b qwen2.5:7b llama3.1:8b qwen2.5-coder:3b llama3.2:3b; do
    grep -qxF -- "$m" <<<"$names" && { echo "$m"; return; }
  done
  head -1 <<<"$names"
}

# OpenCode runs commands and edits without asking, unless told: ask first,
# as Claude Code does, when your own config says nothing about it.
opencode_asks() {
  local f
  for f in "${XDG_CONFIG_HOME:-$HOME/.config}"/opencode/opencode.json{,c}; do
    [ -f "$f" ] && grep -q '"permission"' "$f" && return 1
  done
  return 0
}

# --- Codex at a desk: the project's instructions, a mode, the hook's trust ------
# Codex's levers, as 0.160.1 has them (its --help, and codex debug
# prompt-input and codex sandbox tried here on 2026-10-10): every setting
# takes -c key=value for one session; sandbox_workspace_write.writable_roots=[]
# on the command line sets your roots aside, so the folder and /tmp are the
# only places its shell can write (a desk's .git, a file pointing into the
# repository's, stays read-only, which is what the rules file is for);
# --approve-for-me routes each step out of the sandbox to a reviewer of
# Codex's own; --dangerously-bypass-approvals-and-sandbox is the whole lot
# off. One row a mode, the only place they are written.
MODES=(supervised autonomous unrestricted)
OFFICE_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/vikix/office"
is_mode() { printf '%s\n' "${MODES[@]}" | grep -qx -- "${1:-}"; }
codex_mode_args() {   # codex_mode_args MODE: Codex's words for it, one a line
  case $1 in
    supervised|autonomous)
      printf '%s\n' -c 'sandbox_mode="workspace-write"' -c 'sandbox_workspace_write.writable_roots=[]' \
        -c 'approval_policy="on-request"'
      if [ "$1" = autonomous ]; then printf '%s\n' -c 'sandbox_workspace_write.network_access=true' --approve-for-me
      else printf '%s\n' -c 'sandbox_workspace_write.network_access=false'; fi ;;
    unrestricted) echo --dangerously-bypass-approvals-and-sandbox ;;
  esac
}
# The house default, mode= in ~/.config/vikix/office: written once, with
# its meaning, so it is a setting one can read, never a guess of Vikix's.
office_mode() {
  local m=''
  [ -r "$OFFICE_CONF" ] && m=$(sed -n 's/^[[:space:]]*mode[[:space:]]*=[[:space:]]*\([a-z]*\).*/\1/p' "$OFFICE_CONF" | tail -1)
  is_mode "$m" && echo "$m" || echo autonomous
}
office_conf_write() {
  [ -e "$OFFICE_CONF" ] && return 0
  [ "$DRY_RUN" = 1 ] && { printf '   would write %s: mode=autonomous\n' "$OFFICE_CONF"; return 0; }
  mkdir -p "$(dirname "$OFFICE_CONF")"
  cat > "$OFFICE_CONF" <<'EOF'
# The office (vikix agents). mode: how free a Codex worker is at a desk when
# nothing says otherwise. supervised: its sandbox is the desk alone, and every
# step out of it (a commit, the tests) asks you, unless Vikix's rules allow it.
# autonomous: the same sandbox, a reviewer of Codex's own answering those
# steps, and the network on. unrestricted is never a default: no sandbox, no
# approvals, typed each time (vikix agent --mode unrestricted). --mode on
# vikix agent, vikix agents worker, desk and resume overrides this for one.
mode=autonomous
EOF
}
# Where Codex starts: whether the repository is one of your projects and
# whether the folder is a desk or a project's own, asked of the office
# (vikix agents place), which judges the house rules by the same words.
codex_place() {   # "known|unknown|none desk|own|none"
  python3 "$VIKIX_DIR/bin/vikix-agents" place "$PWD" 2>/dev/null || echo "none none"
}
# The hook's trust: ours when ~/.codex/hooks.json is Vikix's file (the link
# itself, or its content: the installed checkout's copy is the same file).
codex_hooks_ours() {
  local f ours="$VIKIX_DIR/config/codex/hooks.json"
  f="$(codex_home)/hooks.json"
  [ -L "$f" ] || return 1
  [ "$(readlink -f "$f")" = "$(readlink -f "$ours")" ] && return 0
  cmp -s "$f" "$ours"
}
codex_args() {   # codex_args MODE PLACE: the session's words for Codex, one a line
  local mode=$1 known=${2% *}
  # The repository's instructions: CLAUDE.md where there is no AGENTS.md,
  # whole (Vikix's is 78 KB; the cap is 256 KiB, and tests/codex.sh fails
  # when CLAUDE.md outgrows it).
  printf '%s\n' -c 'project_doc_fallback_filenames=["CLAUDE.md"]' -c 'project_doc_max_bytes=262144'
  [ -n "$mode" ] && codex_mode_args "$mode"
  if [ "${VIKIX_CODEX_HOOK_TRUST:-}" != ask ] && [ "$known" = known ] && codex_hooks_ours; then
    echo --dangerously-bypass-hook-trust
  fi
  return 0
}

# --- Starting ------------------------------------------------------------------

start() {
  local name=$1 local=$2 model=$3; shift 3
  if [ "$EXEC" = 1 ]; then
    # stdout is the agent's alone: Vikix's words go to stderr, and the
    # agent gets the real stdout back (fd 3) when it starts. No window to
    # keep open on an error: the editor shows stderr.
    exec 3>&1 1>&2
    trap - EXIT
  fi
  if [ "$ACP" = 1 ]; then
    [ "$name" = aider ] && die "Aider doesn't speak ACP: in an editor, run it in a terminal (vikix agent --use aider)"
    [ "$name" = antigravity ] && die "Antigravity CLI doesn't speak ACP (nothing of it in agy --help, $AGY_VERSION): in an editor, run it in a terminal (vikix agent --use antigravity)"
    [ "$local" = 1 ] && die "--local is for the terminal; as an ACP agent, $name uses its own models"
  fi
  if [ "$local" = 1 ]; then
    case $LOCAL_OK in *" $name "*) ;; *) die "$name has no local models; opencode, codex and aider do (vikix agent --use NAME --local)" ;; esac
  fi
  if ! installed "$name"; then
    say "$name isn't installed: $(about "$name")"
    { [ "$EXEC" = 0 ] && [ -t 0 ]; } || die "to install it: vikix agent --install $name"
    local answer
    read -r -p "Install it now, with its official installer? [y/N] " answer
    case $answer in
      y|Y|yes) install_agent "$name" ;;
      *) say "not installed"; own_window && { printf 'Enter closes this window. '; read -r _ || true; }; return 1 ;;
    esac
  fi
  local exe; exe=$(agent_bin "$name"); [ -x "$exe" ] || exe=$(command -v "$(agent_cmd "$name")" || agent_cmd "$name")

  # What it needs: the guide, and where to look for it.
  write_guide
  link_guide "$name"
  [ "$name" = antigravity ] && agy_office
  local args=() setenv=("VIKIX_AGENT=$name") oc='{}'
  # As an ACP agent: the adapter runs your agent, or the agent's own ACP mode.
  if [ "$ACP" = 1 ]; then
    case $name in
      claude|codex)
        [ -x "$(acp_bin "$name")" ] || die "$name's ACP adapter isn't installed: vikix agent --install $name"
        if [ "$name" = claude ]; then setenv+=("CLAUDE_CODE_EXECUTABLE=$exe"); else setenv+=("CODEX_PATH=$exe"); fi
        exe=$(acp_bin "$name") ;;
      gemini)   args+=(--acp) ;;
      opencode) args+=(acp) ;;
    esac
  fi
  # The office's house rules (vikix agents touch): Claude Code runs them
  # before each edit, from settings added to yours for this session only
  # (--settings merges with your files; nothing is written to them). The
  # ACP adapter takes no such option.
  if [ "$name" = claude ] && [ "$ACP" = 0 ] && [ "${VIKIX_OFFICE:-1}" != 0 ]; then
    args+=(--settings "$VIKIX_DIR/config/claude/office.json")
  fi
  # Codex in a terminal: the project's instructions, its mode, the hook's
  # trust (see the top). The ACP adapter takes none of it; a report
  # (vikix diagnose) keeps its read-only sandbox, so no mode there.
  if [ -n "$MODE" ] && [ "$name" != codex ]; then
    die "--mode is Codex's for now (${MODES[*]}); $name runs as its own settings say (vikix agent --use codex --mode $MODE)"
  fi
  if [ -n "$MODE" ] && [ "$ACP" = 1 ]; then die "--mode is for the terminal; as an ACP agent, codex runs as the editor asks"; fi
  if [ "$name" = codex ] && [ "$ACP" = 0 ]; then
    local place mode=$MODE
    place=$(codex_place)
    office_conf_write
    # No mode typed: the house default at a desk, your own settings elsewhere.
    # A report (vikix diagnose) is read read-only, whatever mode was typed.
    if [ -z "$mode" ] && [ -z "$REPORT" ] && [ "${place#* }" = desk ]; then mode=$(office_mode); fi
    if [ -n "$REPORT" ] && [ -n "$mode" ]; then say "a report is read in Codex's read-only sandbox: --mode $mode set aside"; mode=''; fi
    if [ "$mode" = unrestricted ]; then
      [ "${place#* }" = own ] && die "unrestricted runs at a desk, in a VM or a container, never in a project's own folder ($PWD is one: vikix agents sit $(basename "$PWD") TOPIC takes a desk)"
      warn "unrestricted: Codex runs with no sandbox and no approvals here, as you; the house rules' hook still runs, the rest is on you"
      command -v notify-send >/dev/null 2>&1 && notify-send -u critical "Codex unrestricted" "No sandbox, no approvals, in $PWD (vikix agent --mode unrestricted)" 2>/dev/null || true
    elif [ -n "$mode" ]; then
      say "Codex $mode: its sandbox is this folder (and /tmp); Vikix's rules (vikix agents hooks codex) let git on this branch, the tests and vikix run without a prompt"
    fi
    local w; while IFS= read -r w; do args+=("$w"); done < <(codex_args "$mode" "$place")
    [ -n "$REPORT" ] || [ -z "$mode" ] || setenv+=("VIKIX_AGENT_MODE=$mode")
  fi
  if [ "$local" = 1 ]; then
    model=$(local_model "$model")
    say "on $model, on this laptop: expect minutes per answer on a laptop's CPU, and little done on its own by a small model (vikix ai models has bigger ones)"
    case $name in
      codex)  args+=(--oss --local-provider ollama -m "$model") ;;
      aider)  args+=(--model "ollama_chat/$model"); setenv+=("OLLAMA_API_BASE=$API") ;;
      opencode)
        oc=$(python3 -c '
import json, sys
m = sys.argv[1]
print(json.dumps({"model": "ollama/" + m, "provider": {"ollama": {
  "npm": "@ai-sdk/openai-compatible", "name": "Ollama (this laptop)",
  "options": {"baseURL": sys.argv[2] + "/v1"}, "models": {m: {"name": m}}}}}))' "$model" "$API") ;;
    esac
  fi
  # Aider reads the guide; a local model gets it only when it's big enough
  # to use it (it's most of what a small model would be sent).
  if [ "$name" = aider ]; then
    case $model in ''|*:1[4-9]b|*:[2-9][0-9]b|*:[7-9]b) args+=(--read "$GUIDE") ;; esac
  fi
  # A first question, in each agent's own way. Aider only has one-shot
  # messages: it gets the report to read, and you ask.
  if [ -n "$ASK" ]; then
    case $name in
      claude|codex) set -- "$@" "$ASK" ;;
      opencode)     args+=(--prompt "$ASK") ;;
      gemini)       args+=(-i "$ASK") ;;
      antigravity)  args+=(-i "$ASK") ;;   # --prompt-interactive: asked, then the session goes on
      aider)        say "ask it: $ASK" ;;
    esac
  fi
  # Given a report (vikix diagnose), it starts by reading and proposing,
  # where the agent can be told so: its logs are other programs' words.
  if [ -n "$REPORT" ]; then
    case $name in
      claude) args+=(--permission-mode plan) ;;
      codex)  args+=(--sandbox read-only) ;;
      antigravity) args+=(--mode plan) ;;   # reads and outlines first (agy has --mode, not --permission-mode)
      aider)  args+=(--read "$REPORT" --no-git) ;;   # not making a git repository where it starts
    esac
  fi
  if [ "$name" = opencode ]; then
    # Its config is merged with yours; this adds only what isn't there.
    opencode_asks && oc=$(python3 -c '
import json, sys
c = json.loads(sys.argv[1])
c["permission"] = {"bash": "ask", "edit": "ask", "webfetch": "ask"}
print(json.dumps(c))' "$oc")
    [ "$oc" = '{}' ] || setenv+=("OPENCODE_CONFIG_CONTENT=$oc")
  fi

  # What it doesn't get (see the top).
  local unset=() v keep=''
  [ "$name" = aider ] && [ "$local" != 1 ] && keep=$AIDER_KEYS
  # Antigravity set to a Gemini API key instead of a Google account: that one key.
  if [ "$name" = antigravity ] && grep -qs '"modelProvider"[[:space:]]*:[[:space:]]*"gemini"' "$HOME/.gemini/antigravity-cli/settings.json"; then keep=" GEMINI_API_KEY "; fi
  if [ "${VIKIX_AGENT_API_KEY:-}" != 1 ]; then
    for v in $(compgen -e); do
      case $v in
        *_API_KEY|*_KEY|*_KEY_ID|*_TOKEN|*_SECRET|*_PASSWORD|*_PASSWD|*_CREDENTIALS|DATABASE_URL) ;;
        *) continue ;;
      esac
      case $keep in *" $v "*) continue ;; esac
      unset+=(-u "$v")
    done
  fi
  if [ "${VIKIX_AGENT_SSH:-}" != 1 ]; then unset+=(-u SSH_AUTH_SOCK -u SSH_AGENT_PID); fi

  if "$VIKIX_DIR/bin/vikix" snapshot "before an agent session ($name)"; then
    say "to see what the agent changed: vikix changes    to take it back: vikix undo"
  else
    warn "no snapshot of your files this time (above), so vikix undo can't take this session back"
  fi
  trap - EXIT
  [ "$EXEC" = 1 ] && exec env "${unset[@]}" "${setenv[@]}" "$exe" "${args[@]}" "$@" 1>&3 3>&-
  exec env "${unset[@]}" "${setenv[@]}" "$exe" "${args[@]}" "$@"
}

ASK='' REPORT='' EXEC=0 ACP=0 MODE=''
main() {
  local use='' local=0 model=''
  while [ $# -gt 0 ]; do
    case $1 in
      --ask)       ASK=${2:-}; [ -n "$ASK" ] || die "--ask needs the question"; shift 2 ;;
      --report)    REPORT=${2:-}; [ -n "$REPORT" ] || die "--report needs a file"; shift 2 ;;
      --use)       need_agent "${2:-}"; use=$2; shift 2 ;;
      --exec|--acp) EXEC=1; [ "$1" = --acp ] && ACP=1
                   # A word that isn't an agent is a typo, not an argument
                   # for yours: it would start the default (maybe paid) one.
                   # The agent's own options start with -, or follow --.
                   case ${2:-} in ''|-*) shift ;; *) need_agent "$2"; use=$2; shift 2 ;; esac ;;
      --which)     chosen; return ;;
      --local)     local=1; shift ;;
      --mode)      MODE=${2:-}; is_mode "$MODE" || die "--mode which? ${MODES[*]} (vikix agent -h says what each is)"; shift 2 ;;
      --model)     model=${2:-}; [ -n "$model" ] || die "--model needs a name (vikix ai list)"; shift 2 ;;
      --default)   set_default "${2:-}"; return ;;
      --list)      list_agents; return ;;
      --install)   need_agent "${2:-}"; install_agent "$2"; return ;;
      --uninstall) need_agent "${2:-}"; uninstall_agent "$2"; return ;;
      --write-guide) write_guide; return ;;
      -h|--help)   sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; return ;;
      --)          shift; break ;;
      *)           break ;;
    esac
  done
  # --model is for --local: without it, the agent would quietly use its
  # own model, which may be a paid one.
  [ -z "$model" ] || [ "$local" = 1 ] || die "--model is for --local (a model on this laptop); for the agent's own models, its option after --"
  start "${use:-$(chosen)}" "$local" "$model" "$@"
}

main "$@"
