#!/bin/sh
# vikix-updates — what `vikix update` would bring: Void packages with a newer
# version, and new Vikix commits; and firmware updates waiting on LVFS
# (`vikix firmware update` installs those). The bar shows it (modeline.lisp).
#
#   vikix-updates          check now, print the result, and save it
#   vikix-updates --watch  check a minute from now, then every 6 hours (every
#                          10 minutes while GitHub's tests run on the commit
#                          this machine runs); vikix-session runs this for
#                          the whole session
#
# The result goes to ~/.local/state/vikix/updates as "PACKAGES COMMITS
# FIRMWARE TESTS", with ? for a count that couldn't be checked (offline,
# say). TESTS is GitHub's verdict on the commit this machine runs: ok,
# failed, running, ? when it couldn't be asked, or - on the good channel,
# where what runs has passed by definition. A machine on main takes every
# commit before its tests, so the bar says "tests failed" when they do,
# within ten minutes, and a notification says it once per commit. Checking
# takes a few seconds of network, so it happens here, in the background,
# and the bar only reads the file.

state="${XDG_STATE_HOME:-$HOME/.local/state}/vikix"
out="$state/updates"
# This file is a link in ~/.local/bin; the checkout is where it points.
vikix_dir=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)

check() {
  # -M: the package index is fetched into memory, so no root is needed and
  # the system's own copy is left alone.
  if list=$(xbps-install -Mun 2>/dev/null); then
    packages=$(printf '%s' "$list" | grep -c .)
  else
    packages='?'
  fi
  # Never ask for a password or a passphrase: fail and say ? instead.
  # GitHub over HTTPS even when the checkout's remote is SSH, as
  # `vikix update` pulls (git_pull in lib/common.sh): this runs with no
  # terminal, so an SSH remote with a passphrase would always give ?.
  # The commits are counted to what vikix update would take: the good tag on
  # the good channel (~/.config/vikix/channel, the default; vikix_channel in
  # lib/common.sh), main's tip on main. A moved tag needs its own fetch: a
  # plain fetch refuses to move a tag it has.
  channel=$(sed -n '1{s/#.*//;s/[[:space:]]//g;p;}' "${XDG_CONFIG_HOME:-$HOME/.config}/vikix/channel" 2>/dev/null)
  [ "$channel" = main ] || channel=good
  gitq() {
    GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -o BatchMode=yes' \
      git -C "$vikix_dir" -c 'url.https://github.com/.insteadOf=git@github.com:' \
        -c 'url.https://github.com/.insteadOf=ssh://git@github.com/' "$@" 2>/dev/null
  }
  if gitq fetch -q; then
    if [ "$channel" = good ] && gitq fetch -q origin '+refs/tags/good:refs/tags/good' &&
       git -C "$vikix_dir" rev-parse -q --verify refs/tags/good >/dev/null 2>&1; then
      commits=$(git -C "$vikix_dir" rev-list --count 'HEAD..good' 2>/dev/null || echo '?')
    else
      commits=$(git -C "$vikix_dir" rev-list --count 'HEAD..@{upstream}' 2>/dev/null || echo '?')
    fi
  else
    commits='?'
  fi
  # Devices with a firmware update (0 without fwupd; ? if it couldn't tell).
  firmware=$("$vikix_dir/bin/vikix-firmware" count 2>/dev/null || echo '?')
  mkdir -p "$state"
  if [ "$channel" = main ]; then
    sha=$(git -C "$vikix_dir" rev-parse HEAD 2>/dev/null || echo none)
    tests=$(verdict)
    # Said once per commit, as it is a thing to act on (wait for the fix,
    # or vikix update --back), and the bar is easy to miss.
    if [ "$tests" = failed ] && [ "$(cat "$state/tests-told" 2>/dev/null)" != "$sha" ] &&
       [ -n "${DISPLAY:-}" ] && command -v notify-send >/dev/null 2>&1; then
      echo "$sha" > "$state/tests-told"
      notify-send -u critical "Vikix" "GitHub's tests failed on the commit this machine runs ($(printf '%.7s' "$sha")). The bar says 'tests failed' until a commit that passed is installed; vikix update --back puts the one before back." || true
    fi
  else
    tests=-
  fi
  echo "$packages $commits $firmware $tests" > "$out.tmp" && mv "$out.tmp" "$out"
}

# GitHub's verdict on the commit this checkout runs, from its public API
# (no key; sixty asks an hour from one address, plenty): ok when a run of
# the test workflow on it passed, failed when every run ended and one
# failed, running while one is still going, ? when it couldn't be told
# (offline, no run yet, a remote that isn't GitHub). The repository is
# the remote's, so a fork asks about itself.
verdict() {
  [ "$sha" != none ] || { echo '?'; return; }
  repo=$(git -C "$vikix_dir" ls-remote --get-url origin 2>/dev/null |
           sed -n 's#^\(https://github\.com/\|git@github\.com:\|ssh://git@github\.com/\)\([^/]*/[^/]*\)$#\2#p' | sed 's/\.git$//')
  [ -n "$repo" ] || { echo '?'; return; }
  curl -fsS -m 20 -H 'Accept: application/vnd.github+json' \
    "https://api.github.com/repos/$repo/actions/runs?head_sha=$sha&per_page=30" 2>/dev/null |
    python3 -c '
import json, sys
try:
    runs = json.load(sys.stdin).get("workflow_runs", [])
except ValueError:
    sys.exit(1)
runs = [r for r in runs if r.get("path") == ".github/workflows/test.yml" or r.get("name") == "test"]
ended = [r.get("conclusion") for r in runs if r.get("status") == "completed"]
if "success" in ended: print("ok")
elif len(ended) < len(runs): print("running")
elif any(c in ("failure", "timed_out", "startup_failure") for c in ended): print("failed")
else: print("?")
' 2>/dev/null || echo '?'
}

if [ "${1:-}" = --watch ]; then
  # One watcher per user, however often the session is restarted.
  mkdir -p "$state"
  exec 9>"$state/updates.lock"
  flock -n 9 || exit 0
  sleep 60                      # let the network come up after login
  while :; do
    check
    case "$packages $commits $tests" in
      *'?'*)     sleep 900 ;;   # couldn't check: try again in 15 minutes
      *running*) sleep 600 ;;   # GitHub's tests are running on this commit: the verdict within 10 minutes
      *)         sleep 21600 ;;
    esac
  done
fi

check
echo "packages: $packages  Vikix commits: $commits  tests on this commit: $tests"
