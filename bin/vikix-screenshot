#!/bin/sh
# vikix-screenshot — keep a picture of an area, a window or the whole screen.
#
#   vikix-screenshot [WHAT] [WHERE]
#     WHAT    area     drag out an area, or click a window    (Print)
#             window   the focused window                     (Ctrl+Print)
#             screen   the whole monitor the pointer is on    (Super+Print)
#     WHERE   clip     to the clipboard, ready to paste
#             file     to ~/Pictures/Screenshots/<date>.png   (add Shift)
#
#   vikix-screenshot text     drag out an area: the text in it, read by
#                             tesseract (OCR), to the clipboard
#   vikix-screenshot colour   click anywhere: that colour, as #rrggbb, to
#                             the clipboard (xcolor)
#   vikix-screenshot --geometry area|screen
#                             print the area as WxH+X+Y (vikix-record uses it)
#
# Text and colour are both in the Super+Ctrl+Print menu. The OCR language is
# English; VIKIX_OCR_LANG=deu+eng (with tesseract-ocr-deu installed) reads
# others.
#
# Both words are optional: plain vikix-screenshot is "area clip", and
# "vikix-screenshot file" is "area file", as before there were three kinds.
# Escape or a right-click while choosing an area cancels, and nothing is kept.

# The monitor under the pointer, as WxH+X+Y; nothing if xrandr can't say.
# xrandr --listactivemonitors prints lines like
#   0: +*eDP-1 1920/344x1080/194+0+0  eDP-1
monitor() {
  eval "$(xdotool getmouselocation --shell 2>/dev/null)"
  xrandr --listactivemonitors 2>/dev/null |
    sed -n 's|.* \([0-9]*\)/[0-9]*x\([0-9]*\)/[0-9]*+\([0-9]*\)+\([0-9]*\).*|\1 \2 \3 \4|p' |
    while read -r w h x y; do
      if [ "${X:-0}" -ge "$x" ] && [ "${X:-0}" -lt $((x + w)) ] &&
         [ "${Y:-0}" -ge "$y" ] && [ "${Y:-0}" -lt $((y + h)) ]; then
        echo "${w}x${h}+${x}+${y}"
        break
      fi
    done
}

# area_shot FILE — drag out an area (or click a window) and take it; false
# when cancelled. Not maim -s: slop's own window must be off the screen
# first. Under picom it fades out for a moment after the pick, and a picom
# that blurs what's behind translucent windows (a config of your own,
# without Vikix's blur-background-exclude for slop) blurs the very area
# being taken. So pick with slop, wait for the fade, then take it.
# VIKIX_SHOT_SETTLE sets the wait (tests use 0).
area_shot() {
  g=$(slop -f '%wx%h+%x+%y') || return 1
  settle=${VIKIX_SHOT_SETTLE:-}
  if [ -z "$settle" ]; then
    if pgrep -x picom >/dev/null 2>&1; then settle=0.5; else settle=0; fi
  fi
  [ "$settle" = 0 ] || sleep "$settle"
  maim -g "$g" "$1"
}

if [ "${1:-}" = --geometry ]; then
  case ${2:-} in
    area)   slop -f '%wx%h+%x+%y' ;;          # fails when cancelled
    screen) g=$(monitor); [ -n "$g" ] && echo "$g" ;;
    *)      echo "usage: vikix-screenshot --geometry area|screen" >&2; exit 2 ;;
  esac
  exit
fi

# --- colour -----------------------------------------------------------------
if [ "${1:-}" = colour ] || [ "${1:-}" = color ]; then
  command -v xcolor >/dev/null 2>&1 || {
    notify-send -a Vikix "No colour picker" "xcolor isn't installed (desktop.list; vikix update installs it)."
    exit 1
  }
  hex=$(xcolor 2>/dev/null) || exit 0    # Escape cancels
  case $hex in \#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ;; *) exit 0 ;; esac
  printf '%s' "$hex" | xclip -selection clipboard
  # A swatch of it in the notification.
  swatch=$(mktemp --suffix=.png) || exit 1
  ffmpeg -loglevel error -y -f lavfi -i "color=c=0x${hex#\#}:s=64x64" -frames:v 1 "$swatch" 2>/dev/null
  notify-send -a Vikix -t 4000 -i "$swatch" "Colour $hex copied" "Paste it with Ctrl+v."
  ( sleep 10; rm -f "$swatch" ) &
  exit 0
fi

# --- text (OCR) --------------------------------------------------------------
if [ "${1:-}" = text ]; then
  # Void names it tesseract-ocr (tesseract is a game there); elsewhere it's tesseract.
  ocr=$(command -v tesseract-ocr || command -v tesseract) || {
    notify-send -a Vikix "No OCR" "tesseract-ocr isn't installed (desktop.list; vikix update installs it)."
    exit 1
  }
  shot=$(mktemp --suffix=.png) || exit 1
  big=$(mktemp --suffix=.png) || exit 1
  trap 'rm -f "$shot" "$big"' EXIT
  area_shot "$shot" || exit 0        # cancelled
  # Screen text is small, and tesseract reads it far better three times
  # the size; without ffmpeg, it reads the picture as it is.
  if ! ffmpeg -loglevel error -y -i "$shot" -vf 'scale=iw*3:ih*3:flags=lanczos,format=gray' "$big" 2>/dev/null; then
    cp "$shot" "$big"
  fi
  # --psm 6: one block of text, which is what an area on a screen mostly is.
  # Spaces at line ends and the blank lines around the text go (tesseract
  # ends with a form feed); blank lines inside it stay.
  text=$("$ocr" "$big" stdout -l "${VIKIX_OCR_LANG:-eng}" --psm 6 2>/dev/null |
         sed 's/[[:space:]]*$//' |
         awk 'NF { while (seen && gap) { print ""; gap-- } gap = 0; seen = 1; print; next } seen { gap++ }')
  if [ -z "$(printf '%s' "$text" | tr -d '[:space:]')" ]; then
    notify-send -a Vikix "No text found" "Try a bigger area, or one with plainer background."
    exit 0
  fi
  printf '%s' "$text" | xclip -selection clipboard
  first=$(printf '%s\n' "$text" | head -n 1 | cut -c1-60)
  lines=$(printf '%s\n' "$text" | wc -l)
  more=; [ "$lines" -gt 1 ] && more=" (and $((lines - 1)) more lines)"
  notify-send -a Vikix -t 4000 "Text copied" "$first$more"
  exit 0
fi

what=area where=clip
for word in "$@"; do
  case $word in
    area|window|screen) what=$word ;;
    clip|file)          where=$word ;;
    *) echo "usage: vikix-screenshot [area|window|screen] [clip|file] | text | colour" >&2; exit 2 ;;
  esac
done

shot=$(mktemp --suffix=.png) || exit 1
trap 'rm -f "$shot"' EXIT

case $what in
  area)
    area_shot "$shot" || exit 0        # cancelled
    ;;
  window)
    # StumpWM keeps _NET_ACTIVE_WINDOW up to date, so this is the focused one.
    win=$(xdotool getactivewindow 2>/dev/null) || {
      notify-send -a Vikix "No window to take a picture of" "Focus a window first."
      exit 1
    }
    maim -i "$win" "$shot" || exit 1
    ;;
  screen)
    # One monitor, not every monitor side by side; maim alone takes them all.
    g=$(monitor)
    if [ -n "$g" ]; then maim -g "$g" "$shot"; else maim "$shot"; fi || exit 1
    ;;
esac

# The folder files go to: ~/Pictures/Screenshots, or Screenshots in the
# pictures folder you named (xdg-user-dir answers ~/Pictures, or yours).
shots_dir() {
  pictures=$(xdg-user-dir PICTURES 2>/dev/null)
  if [ -z "$pictures" ] || [ "$pictures" = "$HOME" ]; then
    pictures="$HOME/Pictures"
  fi
  echo "$pictures/Screenshots"
}

# open_folder DIR — Esploro when it's installed, else the usual file manager.
open_folder() {
  if command -v esploro >/dev/null 2>&1; then esploro "$1"; else xdg-open "$1"; fi
}

case $where in
  clip)
    xclip -selection clipboard -t image/png < "$shot"
    # Said every time, an area too: a picture that's only in the clipboard
    # is easily lost, and Shift is the way to keep it.
    dir=$(shots_dir)
    notify-send -a Vikix -t 4000 "Screenshot copied" \
      "Paste it with Ctrl+v. To keep it as a file, add Shift (Shift+Print): it goes to ${dir#"$HOME/"}."
    ;;
  file)
    dir=$(shots_dir)
    mkdir -p "$dir"
    file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
    # Two in the same second get -2, -3 ..., never one over the other.
    n=1 base=${file%.png}
    while [ -e "$file" ]; do n=$((n + 1)); file="$base-$n.png"; done
    cp "$shot" "$file"
    # With an action: notify-send waits for the answer, so in the
    # background, and this script ends at once. Dunst runs an action on a
    # middle click (a left click closes), so the text says so.
    (
      action=$(notify-send -a Vikix -A open="Show folder" "Screenshot saved" \
                 "$file
Middle-click to show the folder." 2>/dev/null)
      [ "$action" = open ] && open_folder "$dir"
    ) >/dev/null 2>&1 &
    ;;
esac
