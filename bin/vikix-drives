#!/usr/bin/env bash
# vikix-drives — USB drives: mounted when plugged in, ejected from a menu.
#
#   vikix-drives start      run udiskie (vikix-session does, at login): it
#                           mounts a drive when it's plugged in, says so with
#                           an "Open" button (PCManFM), and asks for an
#                           encrypted drive's passphrase in rofi
#   vikix-drives eject      pick a mounted drive in rofi (Super+Ctrl+e, or
#                           Super+m, Eject a drive); it is unmounted and
#                           powered off, and a notification says when it's
#                           safe to pull out
#   vikix-drives list       the mounted drives, one mount folder per line
#   vikix-drives bar        "usb" while a drive is mounted, for the bar
#   vikix-drives waiting    the USB4 (Thunderbolt) drives plugged in that wait
#                           to be authorized, a name a line: such a drive
#                           shows no disk until then. udev's rule
#                           (config/udev/70-vikix-thunderbolt.rules) authorizes
#                           one as it arrives when the IOMMU protects memory;
#                           the bar's round tells you of one left waiting
#   vikix-drives trust [NAME]  authorize the waiting drives, or the one named
#                           (sudo asks): the disk appears and mounts by itself
#
# udiskie calls back for two things: `password DEVICE` (the rofi prompt)
# and `event EVENT MOUNT_PATH`. On a mount, if it's the drive `vikix backup
# setup` chose and a backup is due, the backup starts by itself.
#
# Drives are what udisks mounts for you, under /run/media/$USER. A USB4 SSD
# is one too, once its Thunderbolt device is authorized: without the rule it
# looked dead (no disk, nothing in lsusb), since it isn't USB storage at all.

set -euo pipefail
VIKIX_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
MOUNTS=${VIKIX_MOUNTS:-/proc/mounts}              # a test can point these elsewhere
MEDIA=${VIKIX_MEDIA:-/run/media/$USER}
BACKUP=${VIKIX_DRIVES_BACKUP:-$VIKIX_DIR/bin/vikix-backup}
SYS=${VIKIX_SYS:-/sys}                                # a test's made-up /sys
config="${XDG_CONFIG_HOME:-$HOME/.config}/vikix"
state="${XDG_STATE_HOME:-$HOME/.local/state}/vikix"
told="$state/drives-told"                             # the waiting drives told of

notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a Vikix "$@" || true; }

# The mount folders under $MEDIA. /proc/mounts writes a space in a name as
# \040 (and a tab as \011); printf %b turns those back.
list() {
  local mnt rest
  while read -r _ mnt rest; do     # the device, then where it is mounted
    mnt=$(printf '%b' "$mnt")
    case $mnt in "$MEDIA"/*) printf '%s\n' "$mnt" ;; esac
  done < "$MOUNTS"
}

# A USB4 drive comes through Thunderbolt and waits, unauthorized, for a 1 in
# its authorized file; udev's rule writes it when the IOMMU protects memory.
# What still waits, "PATH<tab>NAME" a line. The host's own entries (no
# device_name) and the retimers aren't drives.
waiting_paths() {
  local d name
  for d in "$SYS"/bus/thunderbolt/devices/*/; do
    d=${d%/}
    [ -f "$d/authorized" ] && [ -s "$d/device_name" ] || continue
    [ "$(cat "$d/authorized")" = 0 ] || continue
    name="$(cat "$d/vendor_name" 2>/dev/null || true) $(cat "$d/device_name")"
    printf '%s\t%s\n' "$d" "${name# }"
  done
}
waiting() { waiting_paths | cut -f2; }

# The rule left this drive waiting on purpose (no DMA protection), so the
# 1 is written on the user's word, as root.
trust() {
  local want=${1:-} path name any=''
  while IFS=$'\t' read -r path name; do
    [ -z "$want" ] || [ "$name" = "$want" ] || continue
    any=1
    if sudo sh -c "echo 1 > '$path/authorized'"; then
      echo "$name is authorized: its disk appears in a moment and mounts by itself"
    else
      echo "couldn't authorize $name ($path/authorized)" >&2
      return 1
    fi
  done < <(waiting_paths)
  if [ -z "$any" ]; then
    echo "no Thunderbolt drive is waiting${want:+ as $want} (vikix-drives waiting lists them)" >&2
    return 1
  fi
}

# Told once per drive while it waits: the ids told are kept and dropped when
# the drive is gone or authorized, so the next plug tells again.
tell_waiting() {
  local path name id before now=()
  before=$(cat "$told" 2>/dev/null || true)
  while IFS=$'\t' read -r path name; do
    id=$(cat "$path/unique_id" 2>/dev/null || echo "$name")
    now+=("$id")
    grep -qxF "$id" <<<"$before" && continue
    notify -u normal "$name is waiting to be trusted" \
      "A Thunderbolt drive shows no disk until it's authorized. In a terminal: vikix-drives trust"
  done < <(waiting_paths)
  if [ ${#now[@]} -gt 0 ]; then
    mkdir -p "$state"; printf '%s\n' "${now[@]}" > "$told"
  else
    rm -f "$told"
  fi
}

# The bar reads this every 10 seconds; an event also asks it to look now.
bar() { tell_waiting; [ -n "$(list)" ] && echo usb || true; }
nudge_bar() {
  ( python3 "$VIKIX_DIR/bin/vikix-eval" '(vikix-usb-refresh)' >/dev/null 2>&1 & ) || true
}

eject() {
  local drives pick
  drives=$(list)
  if [ -z "$drives" ]; then
    notify "No drive to eject" "Nothing is mounted under $MEDIA."
    return 0
  fi
  # rofi shows the drives' names; the answer is its line number.
  pick=$(printf '%s\n' "$drives" | sed 's|.*/||' |
         rofi -dmenu -i -p eject -format i -no-custom) || return 0
  pick=$(printf '%s\n' "$drives" | sed -n "$((pick + 1))p")
  [ -n "$pick" ] || return 0
  # --detach powers the drive off after unmounting, so it can be pulled out.
  if udiskie-umount --detach "$pick" >/dev/null 2>&1; then
    notify "Safe to remove ${pick##*/}" "It's unmounted and powered off."
  else
    notify -u critical "${pick##*/} is still in use" \
      "Close the files and windows open on it (a terminal in it counts), then eject again."
  fi
  nudge_bar
}

# rofi as udiskie's passphrase prompt; what it prints is the passphrase.
password() {
  rofi -dmenu -password -p "Passphrase for ${1:-the drive}" \
    -theme-str 'listview { enabled: false; } entry { placeholder: ""; }' </dev/null
}

# The backup drive plugged in: back up if one is due. Due means none yet, or
# the last is DAYS or more old (the bar's "backup 9d" reminder, the same test).
maybe_backup() {
  local mnt=$1 repo last days
  # No backup set up is the usual case: sed failing must not stop the script.
  repo=$(sed -n 's/^REPO=//p' "$config/backup" 2>/dev/null | tail -n 1 || true)
  case $repo in "$mnt"|"$mnt"/*) ;; *) return 0 ;; esac
  read -r last days 2>/dev/null < "$state/backup" || { last=0; days=7; }
  case ${last:-0}${days:-7} in *[!0-9]*) last=0 days=7 ;; esac
  if [ "${last:-0}" -gt 0 ] && [ $(( $(date +%s) - last )) -lt $(( ${days:-7} * 86400 )) ]; then
    return 0
  fi
  mkdir -p "$state/logs"
  setsid -f "$BACKUP" now --notify >>"$state/logs/backup-on-plug.log" 2>&1 < /dev/null
}

event() {
  local what=${1:-} mnt=${2:-}
  case $what in
    device_mounted)
      [ -n "$mnt" ] && maybe_backup "$mnt"
      nudge_bar ;;
    device_unmounted|device_removed)
      nudge_bar ;;
  esac
}

start() {
  command -v udiskie >/dev/null 2>&1 || exit 0     # in the base (apps.list)
  pgrep -x udiskie >/dev/null 2>&1 && exit 0       # one per session
  # Vikix's settings (which notifications), unless you have your own.
  local config=()
  [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/udiskie/config.yml" ] ||
    config=(--config "$VIKIX_DIR/config/udiskie/config.yml")
  # xdg-open: the program you open folders with (Esploro, with the feature).
  exec udiskie "${config[@]}" --automount --notify --no-tray --file-manager xdg-open \
    --password-prompt "vikix-drives password {device_presentation}" \
    --event-hook "vikix-drives event {event} {mount_path}"
}

case ${1:-} in
  start)    start ;;
  eject)    eject ;;
  list)     list ;;
  bar)      bar ;;
  waiting)  waiting ;;
  trust)    shift; trust "$@" ;;
  password) shift; password "$@" ;;
  event)    shift; event "$@" ;;
  *) echo "usage: vikix-drives start | eject | list | bar | waiting | trust [NAME]" >&2; exit 2 ;;
esac
