#!/usr/bin/env bash
# vikix-dictate — speak, and it types what you said. On this laptop only:
# whisper.cpp, built from source, turns your voice into text on the CPU.
#
#   vikix dictate setup      build whisper.cpp (pinned) and fetch its model
#                            (checked); a few minutes, once; no password
#   vikix dictate toggle     start listening, or stop and type it (Super+F9);
#                            a recording that stopped by itself (after 5
#                            minutes) is typed by the next press
#   vikix dictate toggle ask | agent
#                            the same, but what you said goes to the AI,
#                            which answers aloud (vikix voice: Super+F10 the
#                            chat model, Super+F11 the agent)
#   vikix dictate start [ask|agent] | stop
#   vikix dictate cancel     stop listening, type nothing (Super+Shift+F9)
#   vikix dictate models [base.en|small]
#                            which model: base.en, English (150 MB, a second
#                            or two a sentence), or small, many languages
#                            (490 MB, a few seconds)
#   vikix dictate file WAV   print what a recording says
#   vikix dictate status
#   vikix dictate uninstall [--models]
#
# While it listens, the bar says mic. On stop, the text is typed into the
# window you were in when you pressed the key, once it's written down (and
# put on the clipboard, in case that window didn't take it; if you've
# moved to another window meanwhile, it's only put on the clipboard). The recording is kept only until it's written down, in your
# runtime folder (memory, yours alone); nothing leaves the laptop.

set -uo pipefail
VIKIX_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../lib/common.sh
. "$VIKIX_DIR/lib/common.sh"
# shellcheck source=../lib/features.sh
. "$VIKIX_DIR/lib/features.sh"

WHISPER_VERSION=v1.9.4
WHISPER_COMMIT=927cfce34f31707e17f2bff35c349632fb9e2c3a
WHISPER_REPO=https://github.com/ggml-org/whisper.cpp
MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main
declare -A MODEL_SHA=(
  [base.en]=a03779c86df3323075f5e796cb2ce5029f00ec8869eee3fdfb897afe36c6d002
  [small]=1be3a9b2063867b937e64e2ec7483364a79917e157fa98c5d94b5c1fffea987b
)
# Voice activity detection (Silero, 865 KB): only speech reaches whisper,
# which would otherwise hear silence as "you" or "(crickets chirping)",
# and a microphone's hiss is as loud as speech on some laptops.
VAD_URL=https://huggingface.co/ggml-org/whisper-vad/resolve/main/ggml-silero-v6.2.0.bin
VAD_SHA=2aa269b785eeb53a82983a20501ddf7c1d9c48e33ab63a41391ac6c9f7fb6987
# tests/dictate.sh's stand-in downloads can't match the real checksums.
if [ -n "${VIKIX_TEST_SHA:-}" ]; then MODEL_SHA[base.en]=$VIKIX_TEST_SHA; MODEL_SHA[small]=$VIKIX_TEST_SHA; VAD_SHA=$VIKIX_TEST_SHA; fi
OPT="$HOME/.local/opt/whisper.cpp"
WHISPER=${VIKIX_WHISPER:-$OPT/build/bin/whisper-cli}
MODELS="${XDG_DATA_HOME:-$HOME/.local/share}/vikix/whisper"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/vikix/dictation"
PIDFILE="$VIKIX_STATE/dictating"
RUN="${XDG_RUNTIME_DIR:-/tmp}"
WAV="$RUN/vikix-dictation.wav"
MAX_SECONDS=300          # a forgotten microphone stops itself
LAST_PRESS="$RUN/vikix-dictation.last"
TO="$RUN/vikix-dictation.to"   # where it goes: typed (empty), ask or agent
# Tests name their stand-ins (these reach the network or build for minutes).
CURL=${VIKIX_CURL:-curl}
GIT=${VIKIX_GIT:-git}
CMAKE=${VIKIX_CMAKE:-cmake}

note() { notify-send -a Vikix ${NOTE_ID:+-r "$NOTE_ID"} "$1" "${2:-}" 2>/dev/null || true; }
bar() { python3 "$VIKIX_DIR/bin/vikix-eval" '(vikix-record-refresh)' >/dev/null 2>&1 || true; }

model_name() {
  local m=''
  [ -r "$CONF" ] && m=$(sed -n 's/^[[:space:]]*model[[:space:]]*=[[:space:]]*\([a-z.]*\).*/\1/p' "$CONF" | tail -1)
  [ -n "$m" ] && [ -n "${MODEL_SHA[$m]:-}" ] && echo "$m" || echo base.en
}
model_file() { echo "$MODELS/ggml-$1.bin"; }
vad_file() { echo "$MODELS/ggml-silero-v6.2.0.bin"; }
ready() { [ -x "$WHISPER" ] && [ -s "$(model_file "$(model_name)")" ] && [ -s "$(vad_file)" ]; }

listening() {
  local pid
  pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# --- Setting up ---------------------------------------------------------------

fetch_model() {   # fetch_model NAME — download, check, then put in place
  local name=$1 file url sha tmp got
  if [ "$name" = vad ]; then file=$(vad_file); url=$VAD_URL; sha=$VAD_SHA
  else file=$(model_file "$name"); url="$MODEL_URL/ggml-$name.bin"; sha=${MODEL_SHA[$name]}; fi
  if [ -s "$file" ] && [ "$(sha256sum < "$file" | cut -d' ' -f1)" = "$sha" ]; then
    say "the $name model is here"; return 0
  fi
  if [ "$DRY_RUN" = 1 ]; then printf '   would download the %s model into %s\n' "$name" "$MODELS"; return 0; fi
  mkdir -p "$MODELS"
  tmp=$(mktemp "$MODELS/.download.XXXXXX")
  say "downloading the $name model"
  "$CURL" -fL --progress-bar -o "$tmp" "$url" || { rm -f "$tmp"; die "couldn't download the $name model"; }
  got=$(sha256sum < "$tmp" | cut -d' ' -f1)
  if [ "$got" != "$sha" ]; then
    rm -f "$tmp"; die "the $name model isn't the one expected (its checksum differs): not used"
  fi
  mv -f "$tmp" "$file"
  say "the $name model is here, checked"
}

build_whisper() {
  if [ -x "$OPT/build/bin/whisper-cli" ] && [ "$("$GIT" -C "$OPT" rev-parse HEAD 2>/dev/null)" = "$WHISPER_COMMIT" ]; then
    say "whisper.cpp $WHISPER_VERSION is built"; return 0
  fi
  if [ "$DRY_RUN" = 1 ]; then printf '   would build whisper.cpp %s in %s\n' "$WHISPER_VERSION" "$OPT"; return 0; fi
  command -v "$CMAKE" >/dev/null 2>&1 || die "cmake isn't here: vikix add dictation installs it"
  say "fetching whisper.cpp $WHISPER_VERSION"
  if [ -d "$OPT/.git" ]; then
    "$GIT" -C "$OPT" fetch -q --depth 1 origin "refs/tags/$WHISPER_VERSION:refs/tags/$WHISPER_VERSION" || die "couldn't fetch whisper.cpp"
    "$GIT" -c advice.detachedHead=false -C "$OPT" checkout -q --force "$WHISPER_VERSION" || die "couldn't check out $WHISPER_VERSION"
  else
    mkdir -p "$(dirname "$OPT")"
    "$GIT" -c advice.detachedHead=false clone -q --depth 1 --branch "$WHISPER_VERSION" "$WHISPER_REPO" "$OPT" || die "couldn't fetch whisper.cpp"
  fi
  # The tag's commit, as pinned: a tag moved on GitHub isn't built.
  [ "$("$GIT" -C "$OPT" rev-parse HEAD)" = "$WHISPER_COMMIT" ] ||
    die "whisper.cpp's $WHISPER_VERSION isn't the commit expected: not built"
  local log="$VIKIX_STATE/logs/whisper-build.log"
  mkdir -p "$(dirname "$log")"
  say "building it (a few minutes; for this computer's CPU; log: $log)"
  { "$CMAKE" -S "$OPT" -B "$OPT/build" -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=ON \
      -DWHISPER_BUILD_TESTS=OFF -DWHISPER_BUILD_EXAMPLES=ON -DBUILD_SHARED_LIBS=OFF &&
    "$CMAKE" --build "$OPT/build" -j "$(nproc)" --config Release --target whisper-cli; } > "$log" 2>&1 ||
    { tail -n 20 "$log"; die "whisper.cpp didn't build (the end of $log is above)"; }
  [ -x "$OPT/build/bin/whisper-cli" ] || die "whisper-cli isn't where it should be"
}

cmd_setup() {
  local name
  # The build tools (cmake, a compiler): the feature's package list.
  record_features dictation
  local p missing=0
  while IFS= read -r p; do pkg_installed "$p" || missing=1; done < <(read_list "$VIKIX_DIR/packages/optional/dictation.list")
  if [ "$missing" = 1 ]; then
    VIKIX_LISTS=dictation bash "$VIKIX_DIR/install/10-packages.sh" || die "couldn't install the build tools"
  fi
  build_whisper
  name=$(model_name)
  fetch_model "$name"
  fetch_model vad
  [ -r "$CONF" ] || { mkdir -p "$(dirname "$CONF")"; printf '# Dictation (Super+F9): base.en (English) or small (many languages)\nmodel=%s\n' "$name" > "$CONF"; }
  say "dictation is ready: Super+F9 starts listening, Super+F9 again types what you said"
}

cmd_models() {
  local want=${1:-} m
  if [ -z "$want" ]; then
    for m in base.en small; do
      printf '%s %-8s %s\n' "$([ "$m" = "$(model_name)" ] && echo '*' || echo ' ')" "$m" \
        "$([ -s "$(model_file "$m")" ] && echo here || echo '(downloads when chosen)')"
    done
    echo "* is used. base.en: English, fast. small: many languages, slower. vikix dictate models NAME"
    return
  fi
  [ -n "${MODEL_SHA[$want]:-}" ] || die "no model called $want: base.en or small"
  fetch_model "$want"
  mkdir -p "$(dirname "$CONF")"
  if [ -f "$CONF" ] && grep -q '^[[:space:]]*model[[:space:]]*=' "$CONF"; then
    sed --follow-symlinks -i "s/^[[:space:]]*model[[:space:]]*=.*/model=$want/" "$CONF"
  else
    echo "model=$want" >> "$CONF"
  fi
  say "dictation uses $want from now on"
}

cmd_uninstall() {
  rm -rf "$OPT" && say "removed whisper.cpp ($OPT)"
  if [ "${1:-}" = --models ]; then rm -rf "$MODELS" && say "removed the models"; else say "the models stay in $MODELS (--models removes them)"; fi
  forget_features dictation
}

# --- Listening ------------------------------------------------------------------

cmd_start() {
  local to=${1:-}
  if ! ready; then
    note "Dictation isn't set up" "In a terminal: vikix add dictation (a few minutes, once)"; return 1
  fi
  listening && { note "Already listening" "Super+F9 stops and types it"; return 0; }
  command -v pw-record >/dev/null 2>&1 || { note "Can't listen" "pw-record (PipeWire) isn't here"; return 1; }
  if [ -n "$to" ]; then
    [ -x "$VIKIX_DIR/bin/vikix-voice" ] || { note "Can't send it to the AI" "vikix-voice isn't here"; return 1; }
    # The microphone mustn't hear the AI talking.
    "$VIKIX_DIR/bin/vikix-voice" quiet
  fi
  (umask 077; : > "$WAV")
  printf '%s' "$to" > "$TO"
  # 16 kHz mono, as whisper wants it. timeout: a forgotten microphone stops.
  timeout "$MAX_SECONDS" pw-record --rate 16000 --channels 1 --format s16 "$WAV" >/dev/null 2>&1 &
  local pid=$!
  echo "$pid" > "$PIDFILE"
  # When the limit stops it, say so: the recording waits for Super+F9.
  ( sleep $((MAX_SECONDS + 1))
    if [ "$(cat "$PIDFILE" 2>/dev/null)" = "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PIDFILE"; bar
      notify-send -a Vikix -u critical "Dictation stopped after $((MAX_SECONDS / 60)) minutes" "Super+F9 types what you said" 2>/dev/null || true
    fi ) >/dev/null 2>&1 &
  bar
  case $to in
    ask)   note "Listening, for the AI…" "Super+F10 again sends it (Super+Shift+F9 cancels)" ;;
    agent) note "Listening, for the agent…" "Super+F11 again sends it (Super+Shift+F9 cancels)" ;;
    *)     note "Listening…" "Super+F9 again types what you said (Super+Shift+F9 cancels)" ;;
  esac
}

# The recording stops: pw-record writes its file's end on INT.
stop_recording() {
  local pid; pid=$(cat "$PIDFILE" 2>/dev/null) || true
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill -INT "$pid" 2>/dev/null || true
    for _ in $(seq 30); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
    kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$PIDFILE"
  bar
}

# What whisper heard, as one line of text. Its descriptions of sounds go
# (it hears silence as "(crickets chirping)", or "[BLANK_AUDIO]"): speech
# hardly ever has brackets, and typing them into a window would be wrong.
transcribe() {   # transcribe WAV
  local lang=en m; m=$(model_name)
  [ "$m" = small ] && lang=auto
  "$WHISPER" -m "$(model_file "$m")" -f "$1" -l "$lang" -nt -np --vad -vm "$(vad_file)" -t "$(nproc)" 2>/dev/null |
    sed -E 's/\[[^]]*\]//g; s/\([^)]*\)//g; s/\*[^*]*\*//g; s/♪+//g' |
    tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//'
}

cmd_stop() {
  listening || [ -s "$WAV" ] || { note "Not listening" "Super+F9 starts"; return 0; }
  # The window you were in: the text goes there, and only there.
  local win now text work to
  win=$(xdotool getactivewindow 2>/dev/null || true)
  to=$(cat "$TO" 2>/dev/null || true); rm -f "$TO"
  stop_recording
  # Moved aside at once: a new Super+F9 records into a fresh file while
  # this one is written down.
  work=$(mktemp "$RUN/vikix-dictation.XXXXXX") && mv -f "$WAV" "$work" || { note "Couldn't read the recording" ""; return 1; }
  NOTE_ID=$(notify-send -p -a Vikix -t 0 "Writing it down…" "on this laptop ($(model_name))" 2>/dev/null || true)
  [[ ${NOTE_ID:-} =~ ^[0-9]+$ ]] || NOTE_ID=''
  text=$(transcribe "$work")
  rm -f "$work"
  if [ -z "$text" ]; then note "Heard nothing" "Is the microphone on? (pavucontrol, Input devices)"; return 0; fi
  # For the AI: it goes there, not into a window.
  case $to in
    ask)   export NOTE_ID   # "Writing it down…" becomes "Thinking…"
           exec "$VIKIX_DIR/bin/vikix-voice" ask "$text" ;;
    agent) note "To the agent" "$(printf '%s' "${text:0:200}" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g')"
           exec "$VIKIX_DIR/bin/vikix-voice" agent "$text" ;;
  esac
  # A space after it, so the next dictation doesn't run into this one.
  case $text in *[.?!,:\;]) text="$text " ;; esac
  printf '%s' "$text" | xclip -selection clipboard 2>/dev/null || true
  now=$(xdotool getactivewindow 2>/dev/null || true)
  if [ -n "$win" ] && [ "$now" != "$win" ]; then
    note "On the clipboard" "You moved to another window while it was written down: paste it where you want it"; return 0
  fi
  # --clearmodifiers: Super may still be down from the key.
  xdotool type --clearmodifiers --delay 3 -- "$text" 2>/dev/null ||
    { note "Couldn't type it" "It's on the clipboard: paste it with Ctrl+v"; return 0; }
  note "Typed" "$(printf '%s' "${text:0:120}" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g')"
}

cmd_cancel() {
  stop_recording; rm -f "$WAV" "$TO"
  note "Dictation cancelled" ""
}

cmd_status() {
  if listening; then echo "listening"; elif ready; then echo "ready ($(model_name))"; else echo "not set up (vikix dictate setup)"; fi
}

case ${1:-} in
  setup)     cmd_setup ;;
  toggle)
    case ${2:-} in ''|ask|agent) ;; *) die "vikix dictate toggle [ask|agent]" ;; esac
    # A held key repeats, and a double tap is quick: presses within 0.7 s
    # of the last are one press.
    now=$(date +%s%N); last=$(cat "$LAST_PRESS" 2>/dev/null || echo 0)
    [ $(( (now - last) / 1000000 )) -ge 700 ] || exit 0
    echo "$now" > "$LAST_PRESS"
    # Listening, or a recording the 5-minute limit stopped: type it.
    if listening || [ -s "$WAV" ]; then cmd_stop; else cmd_start "${2:-}"; fi ;;
  start)     cmd_start "${2:-}" ;;
  stop)      cmd_stop ;;
  cancel)    cmd_cancel ;;
  models)    shift; cmd_models "${1:-}" ;;
  file)
    shift; [ -n "${1:-}" ] || die "vikix dictate file WAV"
    [ -r "$1" ] || die "no file $1"
    ready || die "not set up: vikix add dictation"
    text=$(transcribe "$1")
    [ -n "$text" ] || die "no speech found in $1 (or it isn't audio)"
    printf '%s\n' "$text" ;;
  status)    cmd_status ;;
  uninstall) shift; cmd_uninstall "${1:-}" ;;
  -h|--help|'') sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "vikix dictate: setup, toggle, start, stop, cancel, models, file, status, uninstall" ;;
esac
