#!/usr/bin/env python3
"""vikix-mcp — the Vikix desktop as an MCP server, for any agent that
speaks MCP (Claude Code, Codex, Gemini CLI, OpenCode).

  vikix mcp register [--allow-eval] [--allow-undo]
                      add it to Claude Code (claude mcp add, for you), and
                      print the lines for Codex, Gemini CLI and OpenCode;
                      register again without a flag to take that tool away
  vikix mcp status    whether Claude Code has it, with which tools, and the
                      last calls
  vikix mcp unregister
  vikix mcp tools     what it offers
  vikix-mcp serve [--allow-eval] [--allow-undo]
                      the server itself, on stdin and stdout: what an agent
                      starts (nothing listens on a port)

Why: your agent can already run commands, but each needs your yes. These
tools are a small, checked set: allow them once (in Claude Code, "always
allow" for vikix), and the agent can look at the desktop and make small,
undoable changes without asking each time, while other commands still ask.

The tools, a fixed set:
  read only   desktop (workspaces, windows, screens, theme), keys, commands
              (the desktop's commands an agent may run), rules (the
              desktop's rules, and why a window is where it is), doctor,
              history, changes, themes, version
  small acts  notify, snapshot, set_theme, switch_workspace, focus_window,
              run_command: each checked against what's there, and easy to
              take back. run_command runs one of the desktop's own commands
              by name, and only those its registry marks for agents
              (registry.lisp, :agent t: do not disturb, night light, gaps,
              focus left ...); the desktop refuses any other
  proposals   propose_file_changes (a plan shown in Esploro) and
              propose_rule (a rule shown under Super+m, Rules): checked
              whole, and only your choice there changes anything
  off unless  eval (any Lisp in the window manager: --allow-eval) and
  switched on undo (your files back a snapshot: --allow-undo). These are a
              convenience, not a wall: an agent that can run commands can
              run vikix eval, or register the server again, itself.

Nothing an agent sends reaches Lisp or a shell except as a value checked
against the desktop (a workspace that exists, a theme there is, a number),
or, for propose_rule, as text the window manager reads without running
and holds until you decide.
Every call, refused ones too, is logged in ~/.local/state/vikix/mcp.log
(600): the tool, whether it worked, its arguments (secrets taken out, long
ones cut, with their length and a hash).
"""
import datetime
import hashlib
import importlib.util
import json
import os
import re
import shutil
import subprocess
import tempfile
import sys

VIKIX_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
VIKIX = os.path.join(VIKIX_DIR, "bin", "vikix")
# Tests name a stand-in for vikix-eval (the live window manager).
EVAL = os.environ.get("VIKIX_EVAL") or os.path.join(VIKIX_DIR, "bin", "vikix-eval")
STATE = os.environ.get("VIKIX_STATE") or os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "vikix")
LOG = os.path.join(STATE, "mcp.log")
# One file per running server, named by its pid, saying the version it
# runs: an update's new version starts only at each one's next call, and
# `vikix mcp status` shows where they are.
RUNNING = os.path.join(STATE, "mcp-servers")
# The user's rules for where their files go, given to every agent with
# propose_file_changes, so a correction made once holds for all of them.
SORTING = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                       "esploro", "sorting.md")
SORTING_MAX = 4000
VERSIONS = ["2025-11-25", "2025-06-18", "2025-03-26", "2024-11-05"]
MAX_OUT = 20000
MAX_LINE = 1 << 20          # a request longer than 1 MB isn't one
FLAGS = ("--allow-eval", "--allow-undo")


def version():
    try:
        with open(os.path.join(VIKIX_DIR, "VERSION")) as f:
            return f.read().strip()
    except OSError:
        return "?"


# The secrets scrubber vikix debug uses: what a tool hands the agent (and
# the model's company) and what the log keeps go through it.
_spec = importlib.util.spec_from_file_location("debug_report", os.path.join(VIKIX_DIR, "lib", "debug-report.py"))
_report = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(_report)


def scrub(text):
    return _report.scrub(text)


def session_env():
    """The display, D-Bus and runtime folder of the desktop session, when
    the agent started this server without them (Codex trims its servers'
    environment): vikix-session writes them at login."""
    try:
        with open(os.path.join(STATE, "session.env")) as f:
            for line in f:
                name, _, value = line.rstrip("\n").partition("=")
                if name in ("DISPLAY", "DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR") \
                        and value and not os.environ.get(name):
                    os.environ[name] = value
    except OSError:
        pass


def log(tool, args, outcome):
    try:
        os.makedirs(STATE, exist_ok=True)
        if os.path.exists(LOG) and os.path.getsize(LOG) > 1 << 20:
            os.replace(LOG, LOG + ".old")
        text = json.dumps(args, ensure_ascii=True)       # a newline can't start a fake entry
        if len(text) > 500:
            text = f"{text[:500]}… ({len(text)} chars, sha256 {hashlib.sha256(text.encode()).hexdigest()[:16]})"
        fd = os.open(LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(f"{datetime.datetime.now():%Y-%m-%d %H:%M:%S} {outcome} {tool} {scrub(text)}\n")
    except (OSError, ValueError):
        pass


def run(cmd, timeout=60, cap=MAX_OUT):
    """Run a command (a list, never a shell); its output, and whether it worked."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                           stdin=subprocess.DEVNULL, errors="replace")
        out = (p.stdout + p.stderr).strip()
        out = re.sub(r"\x1b\[[0-9;]*m", "", out)
        return out[:cap], p.returncode == 0
    except subprocess.TimeoutExpired:
        return f"(no answer within {timeout} s)", False
    except OSError as e:
        return str(e), False


def lisp_string(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def eval_cmd(form):
    # The real one is a Python file; a test's stand-in runs by itself.
    return (["python3", EVAL] if EVAL.endswith("/bin/vikix-eval") else [EVAL]) + [form]


class ToolError(Exception):
    pass


def evaluate(form):
    """A form in the running StumpWM: its value (a Lisp string's contents),
    or an error. The value is the last line starting with "=> ", so a
    window title containing "=> " can't cut it short."""
    out, ok = run(eval_cmd(form), timeout=20, cap=4 << 20)
    if not ok or out.startswith("error:"):
        raise ToolError("the window manager didn't answer: " + (out[:300] or "is it running?"))
    lines = [l for l in out.splitlines() if l.startswith("=> ")]
    if not lines:
        raise ToolError("the window manager's answer wasn't one")
    value = lines[-1][3:].strip()
    if value.startswith('"') and value.endswith('"'):
        value = re.sub(r'\\(.)', r"\1", value[1:-1])
    return value


# --- Lisp forms (fixed; values go in only through lisp_string) -----------------

JSON_HELPERS = r"""
(labels ((esc (s) (with-output-to-string (o)
                    (loop for c across (princ-to-string (or s ""))
                          do (case c
                               (#\" (write-string "\\\"" o))
                               (#\\ (write-string "\\\\" o))
                               (t (if (< (char-code c) 32)
                                      (format o "\\u~4,'0x" (char-code c))
                                      (write-char c o)))))))
         (str (s) (format nil "\"~a\"" (esc s)))
         ;; A title is other programs' text: 200 characters are plenty.
         (short (s) (let ((s (princ-to-string (or s "")))) (subseq s 0 (min 200 (length s)))))
         (bool (x) (if x "true" "false")))
  %s)
"""

DESKTOP_FORM = JSON_HELPERS % r"""
  (let ((cw (current-window)))
    (format nil "{\"workspaces\":[~{~a~^,~}],\"screens\":[~{~a~^,~}]}"
      (mapcar (lambda (g)
                (format nil "{\"name\":~a,\"number\":~d,\"current\":~a,\"kind\":~a,\"strip\":~a,\"windows\":[~{~a~^,~}]}"
                  (str (short (group-name g))) (group-number g) (bool (eq g (current-group)))
                  ;; tiles, a strip (viri.lisp: its columns left to right, each
                  ;; its share of the screen, its windows top to bottom by
                  ;; number, and whether it's wholly on the screen), or floating.
                  (str (cond ((and (fboundp 'viri-group-p) (funcall 'viri-group-p g)) "strip")
                             ((typep g 'tile-group) "tiles")
                             (t "floating")))
                  (if (and (fboundp 'viri-group-p) (funcall 'viri-group-p g))
                      (let ((shown (ignore-errors (funcall 'viri-visible g))))
                        (format nil "{\"columns\":[~{~a~^,~}]}"
                          (loop for c in (funcall 'viri-cols g)
                                for i from 0
                                collect (format nil "{\"width\":~a,\"on_screen\":~a,\"windows\":[~{~d~^,~}]}"
                                          (str (funcall 'viri-col-width c)) (bool (member i shown))
                                          (mapcar #'window-number (funcall 'viri-col-windows c))))))
                      "null")
                  (mapcar (lambda (w)
                            (format nil "{\"number\":~d,\"title\":~a,\"class\":~a,\"focused\":~a}"
                              (window-number w) (str (short (window-title w))) (str (short (window-class w))) (bool (eq w cw))))
                          (group-windows g))))
              (sort (copy-list (screen-groups (current-screen))) #'< :key #'group-number))
      (mapcar (lambda (h)
                (format nil "{\"number\":~d,\"x\":~d,\"y\":~d,\"width\":~d,\"height\":~d}"
                  (head-number h) (head-x h) (head-y h) (head-width h) (head-height h)))
              (screen-heads (current-screen)))))
"""

KEYS_FORM = JSON_HELPERS % r"""
  (format nil "[~{~a~^,~}]"
    (mapcar (lambda (b) (format nil "{\"key\":~a,\"command\":~a,\"does\":~a}"
                          (str (first b)) (str (second b)) (str (third b))))
            *vikix-bindings*))
"""

# The commands an agent may run (registry.lisp); null from a desktop older
# than the registry.
COMMANDS_FORM = JSON_HELPERS % r"""
  (if (not (fboundp 'vikix-agent-commands))
      "null"
      (format nil "[~{~a~^,~}]"
        (mapcar (lambda (c)
                  (format nil "{\"name\":~a,\"does\":~a,\"key\":~a}"
                    (str (string-downcase (princ-to-string (getf c :name))))
                    (str (getf c :does))
                    (if (getf c :key)
                        (str (if (fboundp 'vikix-pretty-key) (funcall 'vikix-pretty-key (getf c :key)) (getf c :key)))
                        "null")))
                (funcall 'vikix-agent-commands))))
"""


RULES_FORM = JSON_HELPERS % r"""
  (if (not (fboundp 'vikix-rules-list))
      "null"
      (labels ((long (s) (let ((s (princ-to-string (or s "")))) (subseq s 0 (min 600 (length s)))))
               (word (k) (str (string-downcase (princ-to-string k))))
               (or-null (x) (or x "null"))
               (rule (r)
                 (format nil "{\"number\":~d,\"on\":~a,\"off\":~a,\"rule\":~a,\"name\":~a,\"from\":~a,\"runs_on\":~a,\"runs\":~d,\"last_run\":~a,\"last_error\":~a}"
                   (getf r :number) (bool (getf r :on))
                   (case (getf r :off)
                     (:you (str "by the user, until the next reload"))
                     (:failures (str "after failing three times, until the next reload"))
                     (t "null"))
                   (str (long (getf r :text)))
                   (or-null (and (getf r :name) (str (short (getf r :name)))))
                   (str (getf r :from)) (word (getf r :event)) (getf r :runs)
                   (or-null (and (getf r :last-run) (str (funcall 'vikix-rules-when (getf r :last-run)))))
                   (or-null (and (getf r :last-error) (str (short (getf r :last-error)))))))
               (why (w)
                 (multiple-value-bind (ran waiting) (funcall 'vikix-rules-why w)
                   (format nil "{\"window\":~a,\"ran\":[~{~a~^,~}],\"match_but_have_not_run\":[~{~a~^,~}]}"
                     (str (short (funcall 'vikix-rules-window-line w)))
                     (mapcar (lambda (e)
                               (destructuring-bind (stamp event rule key failure) e
                                 (format nil "{\"at\":~a,\"on\":~a,\"rule\":~a,\"text\":~a,\"failed\":~a}"
                                   (or-null (and stamp (str (funcall 'vikix-rules-when stamp))))
                                   (or-null (and event (word event)))
                                   (or-null (and rule (format nil "~d" (funcall 'vikix-rule-number rule))))
                                   (str (long (if rule (funcall 'vikix-rule-text rule) key)))
                                   (or-null (and failure (str (short failure)))))))
                             ran)
                     (mapcar (lambda (e)
                               (format nil "{\"rule\":~d,\"text\":~a,\"why_not\":~a}"
                                 (funcall 'vikix-rule-number (first e))
                                 (str (long (funcall 'vikix-rule-text (first e))))
                                 (str (cdr (assoc (second e) (symbol-value '*vikix-rule-waiting-words*))))))
                             waiting)))))
        (let ((w %WINDOW%))
          (format nil "{\"rules\":[~{~a~^,~}],\"proposed\":[~{~a~^,~}],\"why\":~a}"
            (mapcar #'rule (funcall 'vikix-rules-list))
            (mapcar (lambda (p)
                      (format nil "{\"rule\":~a,\"state\":~a}"
                        (str (long (getf p :text)))
                        (str (case (getf p :state)
                               (:waiting "waiting for the user")
                               (:added "added by the user")
                               (t "dropped by the user")))))
                    (and (fboundp 'vikix-rule-proposals-list) (funcall 'vikix-rule-proposals-list)))
            (if w (why w) "null")))))
"""


def desktop():
    try:
        return json.loads(evaluate(DESKTOP_FORM))
    except ValueError:
        raise ToolError("the window manager's answer wasn't the desktop")


def workspace_names():
    return [w["name"] for w in desktop()["workspaces"]]


THEME_NAME = re.compile(r"[A-Za-z0-9_-]{1,40}")


def themes():
    out, _ = run([VIKIX, "theme"])
    cur = re.search(r"theme: (\S+)", out)
    names = re.search(r"themes: (.*)", out)
    return (cur.group(1) if cur else ""), [n for n in (names.group(1).split() if names else []) if THEME_NAME.fullmatch(n)]


def checked(out, ok, what):
    """A command's output as the tool's answer, scrubbed; its failure as an error."""
    if not ok:
        raise ToolError(scrub(out) or f"{what} failed")
    return scrub(out)


# --- The tools ------------------------------------------------------------------

def t_desktop(a):
    d = desktop()
    d["theme"] = themes()[0]
    return json.dumps(d, indent=1, ensure_ascii=False)


def t_keys(a):
    try:
        return json.dumps(json.loads(evaluate(KEYS_FORM)), indent=1, ensure_ascii=False)
    except ValueError:
        raise ToolError("the window manager's answer wasn't the keys")


def t_commands(a):
    try:
        value = json.loads(evaluate(COMMANDS_FORM))
    except ValueError:
        raise ToolError("the window manager's answer wasn't the commands")
    if value is None:
        raise ToolError("this desktop is older than the commands list: vikix update brings it")
    return json.dumps(value, indent=1, ensure_ascii=False)


def t_run_command(a):
    """One of the desktop's commands, by its name in the registry. The name
    is checked here for its shape and by the desktop for the rest: it runs
    only a command marked for agents, and says why not otherwise."""
    name = str(a.get("name", ""))
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,40}", name):
        raise ToolError("name: a command's name, as commands lists them (do-not-disturb is not one; quiet is)")
    out = evaluate("(if (fboundp 'vikix-agent-run) (funcall 'vikix-agent-run %s) "
                   "\"refused: this desktop is older than run_command: vikix update brings it\")" % lisp_string(name))
    if not out.startswith("done:"):
        raise ToolError(out[:300])
    return out[:300]


def t_doctor(a):
    # vikix doctor fails when it finds a problem: that's its answer, not an error.
    return scrub(run([VIKIX, "doctor"], timeout=60)[0])


def t_history(a):
    return checked(*run([VIKIX, "history"]), "vikix history")


def snapshot_id(a):
    snap = a.get("snapshot", "")
    if not isinstance(snap, str) or snap and not re.fullmatch(r"[0-9a-f]{4,40}", snap):
        raise ToolError("snapshot: a snapshot's id, as the history tool shows it")
    return snap


def t_changes(a):
    snap = snapshot_id(a)
    return checked(*run([VIKIX, "changes"] + ([snap] if snap else [])), "vikix changes") or "(no changes)"


def t_themes(a):
    cur, names = themes()
    return json.dumps({"current": cur, "themes": names})


def t_version(a):
    return version()


# The record store (vikix records): what plugins found, read here, never
# written: the tools below only search and read it.
def records_module():
    spec = importlib.util.spec_from_loader("vikix_records", loader=None)
    mod = importlib.util.module_from_spec(spec)
    with open(os.path.join(VIKIX_DIR, "bin", "vikix-records")) as f:
        exec(compile(f.read(), "vikix-records", "exec"), mod.__dict__)
    return mod


def t_records_search(a):
    rec = records_module()
    text = str(a.get("query", "")).strip()
    limit = min(int(a.get("limit") or 10), 25)
    plugin = a.get("plugin") or None
    try:
        rows = rec.search(text, plugin, limit) if text else rec.listing(plugin, a.get("kind"), None, limit)
    except rec.Problem as e:
        raise ToolError(str(e))
    return json.dumps([{"id": r["id"], "plugin": r["plugin"], "kind": r["kind"], "at": rec.when(r["at"]),
                        "title": r["title"], "body": r["body"][:600], "link": r["link"]} for r in rows],
                      ensure_ascii=False)


def t_records_get(a):
    rec = records_module()
    db = rec.connect()
    row = db and db.execute("SELECT * FROM records WHERE id = ?", (int(a["id"]),)).fetchone()
    if not row:
        raise ToolError(f"there's no record {a['id']}")
    text = json.dumps(rec.as_dict(row), ensure_ascii=False)
    return text[:30000] + (" [cut short]" if len(text) > 30000 else "")


def docs_module():
    spec = importlib.util.spec_from_loader("vikix_docs", loader=None)
    mod = importlib.util.module_from_spec(spec)
    mod.__dict__["__file__"] = os.path.join(VIKIX_DIR, "bin", "vikix-docs")
    with open(os.path.join(VIKIX_DIR, "bin", "vikix-docs")) as f:
        exec(compile(f.read(), "vikix-docs", "exec"), mod.__dict__)
    return mod


def t_docs_search(a):
    docs = docs_module()
    query = str(a.get("query", "")).strip()
    if not query:
        raise ToolError("docs_search needs a query: the words to find")
    docs.fresh_enough()
    hits = docs.find(query.split(), a.get("source") or None, min(int(a.get("limit") or 10), 25))
    return json.dumps([{"id": h["id"], "source": h["source"], "kind": h["kind"], "title": h["title"],
                        "excerpt": h["excerpt"][:300]} for h in hits], ensure_ascii=False)


def t_docs_read(a):
    docs = docs_module()
    doc = docs.get(str(a.get("id", "")))
    if not doc:
        raise ToolError(f"there's no document {a.get('id')} (docs_search gives the ids)")
    text = docs.read(doc)
    return text[:30000] + (" [cut short]" if len(text) > 30000 else "")


def esc(s):
    return s.replace("&", "&amp;").replace("<", "&lt;")


def t_notify(a):
    title = str(a.get("title", ""))[:80].strip()
    body = str(a.get("body", ""))[:400]
    if not title:
        raise ToolError("notify needs a title: what the notification says")
    # "Agent:" in the title itself: the notification daemon may not show
    # the app's name, and an agent mustn't pass for another program.
    checked(*run(["notify-send", "-a", "Vikix (agent)", "--", "Agent: " + esc(title), esc(body)]), "notify-send")
    return "shown"


def t_snapshot(a):
    msg = re.sub(r"[^\w .,:;!?()'/+-]", "", str(a.get("message", "")))[:100].strip() or "by an agent"
    return checked(*run([VIKIX, "snapshot", "agent: " + msg]), "vikix snapshot")


def t_set_theme(a):
    name = str(a.get("name", ""))
    cur, names = themes()
    if not THEME_NAME.fullmatch(name) or name not in names:
        raise ToolError(f"no theme called {name[:40]!r}: {', '.join(names)}")
    checked(*run([VIKIX, "theme", name], timeout=60), "vikix theme")
    return f"theme {name} (it was {cur}; set_theme {cur} puts it back)"


def t_switch_workspace(a):
    name = str(a.get("name", ""))
    names = workspace_names()
    if name not in names:
        raise ToolError(f"no workspace called {name[:40]!r}: {', '.join(names)}")
    # switch-to-group, not gselect: gselect is a command, whose argument is
    # text as typed after Super+m (a group object made it fail).
    evaluate(f"(switch-to-group (find-group (current-screen) {lisp_string(name)}))")
    return f"on workspace {name}"


def window_named(a):
    """The window an agent names by its workspace's name and its number,
    checked against the desktop: (NAME, NUMBER), both as the desktop has them."""
    name = str(a.get("workspace", ""))
    number = a.get("number")
    if not isinstance(number, int) or isinstance(number, bool) or not 0 <= number < 1000:
        raise ToolError("number: the window's number, as desktop shows it")
    ws = {w["name"]: w for w in desktop()["workspaces"]}
    if name not in ws:
        raise ToolError(f"no workspace called {name[:40]!r}: {', '.join(ws)}")
    there = [w["number"] for w in ws[name]["windows"]]
    if number not in there:
        raise ToolError(f"workspace {name} has no window {number}; it has: {', '.join(map(str, there)) or 'none'}")
    return name, number


def t_rules(a):
    window = "nil"
    asked = a.get("workspace") is not None or a.get("number") is not None
    if asked:
        name, number = window_named(a)
        window = (f"(let ((g (find-group (current-screen) {lisp_string(name)}))) "
                  f"(and g (find {number} (group-windows g) :key #'window-number)))")
    try:
        found = json.loads(evaluate(RULES_FORM.replace("%WINDOW%", window)))
    except ValueError:
        raise ToolError("the window manager's answer wasn't the rules")
    if found is None:
        raise ToolError("this desktop was started before it could list its rules: reload it (Super+m, Reload config)")
    if not asked:
        del found["why"]
    elif found["why"] is None:
        raise ToolError("that window isn't there any more")
    return json.dumps(found, indent=1, ensure_ascii=False)


def t_propose_rule(a):
    """An agent never writes the user's rules: the rule goes to the window
    manager as text, is checked there (a rule made only of verbs and plain
    values), and waits for the user's choice under Super+m, Rules."""
    rule = a.get("rule")
    if not isinstance(rule, str) or not rule.strip():
        raise ToolError('propose_rule needs rule: one rule as it would be written, like '
                        '(when-window (:class "Firefox") (workspace 2))')
    if len(rule) > 1000:
        raise ToolError("a rule is at most 1000 characters")
    if re.search(r"[\x00-\x08\x0b-\x1f\x7f]", rule):
        raise ToolError("a rule is plain text, without control characters")
    why = re.sub(r"\s+", " ", re.sub(r"[\x00-\x1f\x7f]", " ", str(a.get("why", "")))).strip()[:300]
    out = evaluate("(if (fboundp 'vikix-rule-propose) (vikix-rule-propose "
                   f"{lisp_string(' '.join(rule.split()))} {lisp_string(why)}) \"old\")")
    if out.startswith("proposed "):
        return (out + "\nThe user sees it under Super+m, Rules (a notification says so); nothing changes "
                "until they add it there, and the rules tool shows what they chose.")
    if out == "old":
        raise ToolError("this desktop was started before rules could be proposed: the user reloads it "
                        "(Super+m, Reload config)")
    if out.startswith("refused: "):
        raise ToolError("not proposed, nothing changed. " + out[len("refused: "):])
    raise ToolError("the window manager's answer wasn't one: " + scrub(out)[:300])


def t_focus_window(a):
    name, number = window_named(a)
    evaluate(f"(let* ((g (find-group (current-screen) {lisp_string(name)})) "
             f"(w (find {number} (group-windows g) :key #'window-number))) "
             f"(switch-to-group g) (when w (focus-all w)) t)")
    return f"window {number} on workspace {name} has the focus"


def t_eval(a):
    form = str(a.get("form", ""))
    if not form.strip():
        raise ToolError("form: the Lisp to run")
    out, ok = run(eval_cmd(form), timeout=20)
    if not ok or re.search(r"(?m)^error:", out):
        raise ToolError(out)
    return out


def t_undo(a):
    snap = snapshot_id(a)
    return checked(*run([VIKIX, "undo"] + ([snap] if snap else [])), "vikix undo")


PLAN_OPS = {"copy": 2, "move": 2, "rename": 2, "mkdir": 1, "trash": 1, "tag": 2}


def esploro_program():
    mine = os.path.expanduser("~/.local/bin/esploro")
    return mine if os.access(mine, os.X_OK) else shutil.which("esploro")


def t_propose(a):
    """An agent never changes files itself: its plan goes to Esploro, checked,
    and waits there for the user's Apply (journaled, so undo takes it back)."""
    prog = esploro_program()
    if not prog:
        raise ToolError("Esploro isn't installed, so there's nowhere to show a plan: the user can add it (vikix add esploro)")
    steps = a.get("steps")
    if not isinstance(steps, list) or not steps:
        raise ToolError("propose_file_changes needs steps: [{op, path, to}], op one of " + ", ".join(PLAN_OPS))
    if len(steps) > 200:
        raise ToolError("at most 200 steps in a plan")
    lines = []
    for i, step in enumerate(steps, 1):
        if not isinstance(step, dict):
            raise ToolError(f"step {i}: an object {{op, path, to}}")
        op, path, to = step.get("op"), step.get("path"), step.get("to")
        if op not in PLAN_OPS:
            raise ToolError(f"step {i}: op is one of {', '.join(PLAN_OPS)}")
        if not isinstance(path, str) or not path.startswith("/"):
            raise ToolError(f"step {i}: path must be a whole path, starting with /")
        line = f"(:{op} {lisp_string(path)}"
        if PLAN_OPS[op] == 2:
            if op == "tag":
                # to: the file's tags from now on, comma-separated ("" takes them off).
                if not isinstance(to, str) or len(to) > 300 or re.search(r"[\x00-\x1f]", to):
                    raise ToolError(f"step {i}: tag needs to: the file's tags, comma-separated (\"\" takes them off)")
                lines.append(line + " " + lisp_string(to) + ")")
                continue
            if not isinstance(to, str) or not to:
                raise ToolError(f"step {i}: {op} needs to: " + ("the new name" if op == "rename" else "a whole path"))
            if op == "rename" and "/" in to:
                raise ToolError(f"step {i}: rename's to is a name, without /")
            if op != "rename" and not to.startswith("/"):
                raise ToolError(f"step {i}: to must be a whole path, starting with /")
            line += " " + lisp_string(to)
        lines.append(line + ")")
    why = re.sub(r"[\x00-\x1f]", " ", str(a.get("why", "")))[:300]
    fd, plan = tempfile.mkstemp(prefix="vikix-plan-", suffix=".lisp")
    try:
        with os.fdopen(fd, "w") as f:
            f.write("\n".join(lines) + "\n")
        out, ok = run([prog, "propose", plan, why], timeout=30)
    finally:
        os.unlink(plan)
    if ":proposed" in out:
        n = len(lines)
        return (f"proposed {n} step{'s' if n != 1 else ''}: the user reviews them in Esploro, on their workspace; "
                "nothing changes until they choose Apply, and undo takes it back after")
    if ":refused" in out:
        raise ToolError("not proposed, nothing changed; the plan has problems: " + scrub(out))
    raise ToolError(scrub(out) or "esploro propose failed")


def t_file_changes(a):
    """What changed in the user's files through Esploro, newest first: read
    only (esploro changes --lines), for "what did I move yesterday?"."""
    prog = esploro_program()
    if not prog:
        raise ToolError("Esploro isn't installed, so no changes are kept: the user can add it (vikix add esploro)")
    limit = a.get("limit", 30)
    if not isinstance(limit, int) or not 1 <= limit <= 200:
        raise ToolError("limit is 1 to 200")
    out, ok = run([prog, "changes", "--lines", str(limit)], timeout=20)
    if not ok:
        raise ToolError(scrub(out) or "esploro changes failed")
    return out.strip() or "no changes yet: Esploro hasn't changed any files"


def schema(props=None, required=None):
    s = {"type": "object", "properties": props or {}, "additionalProperties": False}
    if required:
        s["required"] = required
    return s


