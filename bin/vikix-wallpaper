#!/bin/sh
# vikix-wallpaper — the picture behind the windows.
#
#   vikix-wallpaper          show the wallpaper (vikix-session runs this at login)
#   vikix-wallpaper pick     choose one in rofi, with pictures (Super+m, Wallpaper)
#   vikix-wallpaper FILE     use FILE from now on
#   vikix-wallpaper cycle [MINUTES]
#                            a new picture every MINUTES (30 unless set), and
#                            one at once: the default
#   vikix-wallpaper next     the next picture now, when cycling
#   vikix-wallpaper theme    follow the theme
#   vikix-wallpaper off      leave the wallpaper alone: for your own tool
#                            (feh, nitrogen, a script that rotates them)
#   vikix-wallpaper which    print the picture it would show
#   vikix-wallpaper --watch  change it on time; vikix-session runs this
#
# Unless you choose otherwise, the wallpaper cycles: every picture once,
# in a shuffled order, before any comes again, and one you add is shown
# next, from Vid's collection (the feature wallpapers, in
# ~/.local/share/vikix/wallpapers, which a fresh install has),
# ~/Pictures/Wallpapers and ~/wallpapers (put yours in either). The one
# showing is remembered in ~/.local/state/vikix/wallpaper-now, the round
# in wallpaper-queue and wallpaper-shown beside it, the minutes in
# ~/.config/vikix/wallpaper-minutes.
#
# Following the theme (~/.config/vikix/wallpaper-theme), its own picture is
# the one next to its theme file with the same name (themes/void.jpg, or
# ~/.config/vikix/themes/mine.jpg beside mine.theme), so `vikix theme`
# changes it too. A theme without a picture gets a plain background in its
# own colour; so does cycling with no pictures to cycle. Your choice is
# ~/.config/vikix/wallpaper, a link to the file; off is
# ~/.config/vikix/wallpaper-off. Each choice ends the others.
#
# The picker lists the theme's, Cycle, then all the pictures; its last
# entry is off.

VIKIX_DIR=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}
CHOICE="$CONFIG/vikix/wallpaper"
OFF="$CONFIG/vikix/wallpaper-off"
THEME="$CONFIG/vikix/wallpaper-theme"
MINUTES="$CONFIG/vikix/wallpaper-minutes"
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/vikix
NOW="$STATE/wallpaper-now"
QUEUE="$STATE/wallpaper-queue"
SHOWN="$STATE/wallpaper-shown"
USER_THEMES="$CONFIG/vikix/themes"
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/vikix
COLLECTION=${XDG_DATA_HOME:-$HOME/.local/share}/vikix/wallpapers

theme() { cat "$CONFIG/vikix/theme/current" 2>/dev/null || echo void; }

# picture_of NAME — the theme's own picture, if it has one (yours first)
picture_of() {
  for dir in "$USER_THEMES" "$VIKIX_DIR/themes"; do
    for ext in jpg jpeg png webp; do
      [ -f "$dir/$1.$ext" ] && { echo "$dir/$1.$ext"; return 0; }
    done
  done
  return 1
}

# plain NAME — a one-pixel picture in the theme's background colour.
# (A plain X background colour won't do: under picom it shows black.)
plain() {
  file=$(for dir in "$USER_THEMES" "$VIKIX_DIR/themes"; do
           [ -f "$dir/$1.theme" ] && { echo "$dir/$1.theme"; break; }
         done)
  bg=$(sed -n 's/^bg=#\([0-9A-Fa-f]\{6\}\).*/\1/p' "$file" 2>/dev/null | head -n 1)
  [ -n "$bg" ] || bg=1e1e2e
  mkdir -p "$CACHE"
  # PPM, the simplest picture format there is: size, then red green blue.
  printf 'P3\n1 1\n255\n%d %d %d\n' "0x$(echo "$bg" | cut -c1-2)" \
    "0x$(echo "$bg" | cut -c3-4)" "0x$(echo "$bg" | cut -c5-6)" > "$CACHE/plain-$bg.ppm"
  echo "$CACHE/plain-$bg.ppm"
}

# mode — off, chosen, theme or cycle (the default)
mode() {
  if [ -e "$OFF" ]; then echo off
  elif [ -e "$CHOICE" ]; then echo chosen
  elif [ -e "$THEME" ]; then echo theme
  else echo cycle
  fi
}

# now — the picture cycling shows, if it's still there
now() {
  f=$(cat "$NOW" 2>/dev/null) && [ -f "$f" ] && echo "$f"
}

# next — a new picture to cycle to: every picture once, in a shuffled
# order, before any comes again. (Drawn afresh each time, a few came
# again and again while a new one waited its luck: plain to see at a
# picture a minute.) QUEUE is what's left of this round, in order, SHOWN
# what it has had; a picture in neither is new and goes to the front, one
# that has gone is dropped.
next() {
  current=$(cat "$NOW" 2>/dev/null)
  all=$(pool)
  [ -n "$all" ] || return 1
  mkdir -p "$STATE"
  touch "$QUEUE" "$SHOWN"
  order=$(
    printf '%s\n' "$all" | grep -vxF -f "$QUEUE" -f "$SHOWN" -e "${current:-/}" | shuf
    printf '%s\n' "$all" | grep -xF -f - "$QUEUE" | grep -vxF -e "${current:-/}"
  )
  if [ -n "$order" ]; then
    # The one showing has been shown, whoever put it there.
    [ -z "$current" ] || grep -qxF -e "$current" "$SHOWN" || echo "$current" >> "$SHOWN"
  else
    # The round is over: all of them again, not starting with the one
    # showing (only one picture: that one again).
    order=$(printf '%s\n' "$all" | shuf)
    if [ "$(printf '%s\n' "$order" | head -n 1)" = "$current" ]; then
      order=$(printf '%s\n' "$order" | sed 1d; echo "$current")
    fi
    : > "$SHOWN"
  fi
  f=$(printf '%s\n' "$order" | head -n 1)
  printf '%s\n' "$order" | sed 1d > "$QUEUE"
  echo "$f" >> "$SHOWN"
  echo "$f" > "$NOW"
  echo "$f"
}

which_one() {
  case $(mode) in
    chosen) readlink -f "$CHOICE" ;;
    cycle)  now || next || picture_of "$(theme)" || plain "$(theme)" ;;
    *)      picture_of "$(theme)" || plain "$(theme)" ;;
  esac
}

show() {
  [ -n "${DISPLAY:-}" ] || return 0
  [ -e "$OFF" ] && return 0
  feh --no-fehbg --bg-fill "$(which_one)"
}

# choose FILE — remember FILE and show it
choose() {
  file=$(readlink -f "$1") && [ -f "$file" ] || { echo "vikix-wallpaper: no such file: $1" >&2; exit 1; }
  mkdir -p "$(dirname "$CHOICE")"
  ln -sfn "$file" "$CHOICE"
  rm -f "$OFF" "$THEME"
  show
}

follow_theme() { rm -f "$CHOICE" "$OFF"; mkdir -p "$(dirname "$THEME")"; : > "$THEME"; show; }
off() { mkdir -p "$(dirname "$OFF")"; : > "$OFF"; }

# cycle [MINUTES] — cycle from now on, starting with a new picture
cycle() {
  if [ -n "${1:-}" ]; then
    case $1 in
      *[!0-9]*|0*) echo "vikix-wallpaper: minutes are a whole number from 1: $1" >&2; exit 2 ;;
    esac
    mkdir -p "$(dirname "$MINUTES")"
    echo "$1" > "$MINUTES"
  fi
  rm -f "$CHOICE" "$OFF" "$THEME"
  next >/dev/null
  show
}

minutes() {
  m=$(cat "$MINUTES" 2>/dev/null)
  case $m in ''|*[!0-9]*|0*) echo 30 ;; *) echo "$m" ;; esac
}

# watch — a new picture every few minutes while cycling. A minute at a
# time, so a change of minutes or of mode counts from the next one.
watch() {
  mkdir -p "$STATE"
  exec 9>"$STATE/wallpaper.lock"
  flock -n 9 || exit 0          # one watcher, however often the session restarts
  waited=0
  while :; do
    sleep 60
    waited=$((waited + 1))
    if [ "$(mode)" != cycle ]; then waited=0; continue; fi
    if [ "$waited" -ge "$(minutes)" ]; then
      next >/dev/null && show
      waited=0
    fi
  done
}

# pool — the pictures cycling chooses from: everything but the themes'
pool() {
  pictures | grep -vF -e "$(readlink -f "$VIKIX_DIR/themes")/" \
    -e "$(readlink -f "$USER_THEMES" 2>/dev/null || echo /nonexistent)/"
}

pictures() {
  seen=' '
  for dir in "$VIKIX_DIR/themes" "$USER_THEMES" "$HOME/Pictures/Wallpapers" "$HOME/wallpapers" "$COLLECTION"; do
    [ -d "$dir" ] || continue
    # The collection may be a link to ~/wallpapers (vikix-wallpapers): once.
    real=$(readlink -f "$dir")
    case $seen in *" $real "*) continue ;; esac
    seen="$seen$real "
    find "$real" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' \
      -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null | sort -V
  done
}

pick() {
  list=$(pictures)
  # rofi reads one entry per line: a label, then after \0 the picture to
  # show as its icon. -format i gives back the line number picked.
  n=$(
    {
      printf 'Theme: %s\0icon\037%s\n' "$(theme)" "$(picture_of "$(theme)" || plain "$(theme)")"
      printf 'Cycle: every %s minutes\0icon\037%s\n' "$(minutes)" "$(now || pool | head -n 1)"
      printf '%s\n' "$list" | while IFS= read -r f; do
        [ -n "$f" ] && printf '%s\0icon\037%s\n' "$(basename "${f%.*}")" "$f"
      done
      echo 'My own tool'   # off; no picture, since Vikix won't show one
    } | rofi -dmenu -i -show-icons -format i -p wallpaper \
          -theme-str 'window { width: 60%; } listview { columns: 3; lines: 3; flow: horizontal; } element { orientation: vertical; } element-icon { size: 8em; } element-text { horizontal-align: 0.5; }'
  ) || exit 0
  count=$(printf '%s\n' "$list" | grep -c .)
  if [ "$n" = 0 ]; then
    follow_theme
  elif [ "$n" = 1 ]; then
    cycle                      # already cycling: the next picture
  elif [ "$n" -gt $((count + 1)) ]; then
    off
  else
    choose "$(printf '%s\n' "$list" | sed -n "$((n - 1))p")"
  fi
}

case ${1:-} in
  "")      show ;;
  pick)    pick ;;
  cycle)   cycle "${2:-}" ;;
  next)    [ "$(mode)" = cycle ] || { echo "vikix-wallpaper: not cycling (vikix-wallpaper cycle)" >&2; exit 1; }
           next >/dev/null && show ;;
  theme)   follow_theme ;;
  off)     off ;;
  which)   which_one ;;
  --watch) watch ;;
  -*)      echo "usage: vikix-wallpaper [pick | FILE | cycle [MINUTES] | next | theme | off | which | --watch]" >&2; exit 2 ;;
  *)     choose "$1" ;;
esac
