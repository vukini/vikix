#!/usr/bin/env python3
"""vikix-eval — run Lisp inside the running StumpWM and print the result.

    vikix eval '(current-group)'             one or more forms as an argument
    vikix eval < file.lisp                   or read them from standard input,
                                             a file or a pipe:
                                             echo '(vikix-apply-theme :paper)' | vikix eval
    vikix eval --door FORM                   check the forms as an agent's, whoever sends them
    vikix eval --whose                       say whose a form from here would be: yours, or an
                                             agent's and which, and whether the door stands

The forms are read in the STUMPWM package, so Vikix's and StumpWM's own
names work without a prefix. For each form it prints what the form
printed, then "=> " and the value.

It talks to the Swank server that config/stumpwm/vikix/swank.lisp starts
on 127.0.0.1:4004 (VIKIX_SWANK_PORT changes the port). When ~/.slime-secret
exists (40-config makes it), Swank lets in only a client that sends its
first line first, as Emacs's SLIME does; so does this. The Lisp side,
vikix-eval-for-agent, catches errors, so a bad form prints "error: ..."
instead of leaving this command waiting.

Exit status: 0 when every form ran, 1 when one failed, 2 when StumpWM
could not be reached, 3 when the door held the forms.

The door (config/stumpwm/vikix/door.lisp). When an agent is above this
command in the process tree (Claude Code, Codex, OpenCode, Gemini, Aider
or Antigravity, with no script of Vikix's between: `vikix theme` run by
an agent sends Vikix's Lisp, not the agent's), the forms are an agent's,
and the desktop walks each before anything runs: every function it calls
must be on the door's list (`vikix door allowed`). A form that runs a
program, touches a file, defines or changes code, sets a global or waits
on the desktop is held for the user instead (Super+m, Door; `vikix door`),
with why printed here. Your own `vikix eval` at a terminal is yours and
isn't checked. The door stands only at the desktop's own Swank (port 4004):
a test's StumpWM on another port asks for it with --door.

Changes made this way live in the running StumpWM only. They are gone
after a restart or a reload; to keep one, put it in ~/.stumpwm.d/user.lisp.
"""

import os
import socket
import sys

HOST = "127.0.0.1"
PORT = int(os.environ.get("VIKIX_SWANK_PORT", "4004"))
DESKTOP_PORT = 4004   # the door stands here; a test's StumpWM is on a port of its own
TIMEOUT = 30  # seconds; the Lisp side gives up on a busy main thread sooner
PROC = os.environ.get("VIKIX_PROC") or "/proc"
# The agents, as bin/vikix-agents knows them (PROGRAMS, NAMES there; tests/door.sh
# holds the two together). Not imported: that file is large, and this one runs
# at every click of the bar.
AGENTS = ("claude", "codex", "opencode", "gemini", "aider", "agy")
AGENT_NAMES = {"agy": "antigravity"}


def cmdline(pid):
    try:
        with open(f"{PROC}/{pid}/cmdline", "rb") as f:
            return [w.decode("utf-8", "replace") for w in f.read().split(b"\0") if w]
    except OSError:
        return []


def parent_of(pid):
    try:
        with open(f"{PROC}/{pid}/stat") as f:
            return int(f.read().rpartition(")")[2].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


def whose(past_vikix=False):
    """Whose forms these are: ("agent", "claude 1234") when an agent is above
    this process with nothing of Vikix's between, else ("me", why). The
    first thing met going up decides: an agent's shell runs the agent's
    Lisp; a script of Vikix's (vikix-theme, vikix-mcp) runs its own, even
    under an agent. With PAST_VIKIX the scripts are passed over: the agent
    above the MCP server, to name it."""
    pid = int(os.environ.get("VIKIX_EVAL_PARENT") or 0) or os.getppid()
    for _ in range(16):
        if pid <= 1:
            break
        for word in cmdline(pid)[:2]:
            name = os.path.basename(word).lstrip("-")
            if name in AGENTS:
                return "agent", f"{AGENT_NAMES.get(name, name)} {pid}"
            if not past_vikix and (name == "vikix" or name.startswith("vikix-")):
                return "me", f"sent by {name}"
        pid = parent_of(pid)
    return "me", "no agent above this shell"


def lisp_string(text):
    """TEXT as a Lisp string literal."""
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def send(sock, message):
    """Swank's framing: six hex digits of length, then the message (UTF-8)."""
    body = message.encode("utf-8")
    sock.sendall(b"%06x" % len(body) + body)


def receive(sock):
    """One Swank message, as text."""
    def exactly(n):
        data = b""
        while len(data) < n:
            chunk = sock.recv(n - len(data))
            if not chunk:
                raise ConnectionError("StumpWM closed the connection")
            data += chunk
        return data
    length = int(exactly(6), 16)
    return exactly(length).decode("utf-8", errors="replace")


def lisp_strings(text):
    """Every string literal in a Swank reply, in order, unescaped.
    The replies we care about look like
        (:return (:ok ("what was printed" ":OK")) 1)
    so the strings are all we need to pull out. A reply cut off in the
    middle of a string gives what arrived of it, rather than an error."""
    found, i = [], 0
    while i < len(text):
        if text[i] == '"':
            i += 1
            chars = []
            while i < len(text) and text[i] != '"':
                if text[i] == "\\" and i + 1 < len(text):
                    i += 1
                chars.append(text[i])
                i += 1
            found.append("".join(chars))
        i += 1
    return found


def slime_secret():
    """The first line of ~/.slime-secret, or None. Swank checks it the same way."""
    try:
        with open(os.path.expanduser("~/.slime-secret"), encoding="utf-8") as f:
            return f.readline().rstrip("\n")
    except OSError:
        return None


def listener_uid(port):
    """The user owning the socket listening on PORT on 127.0.0.1 (or on
    every address), from /proc/net/tcp; None when there's none to read."""
    try:
        with open("/proc/net/tcp") as f:
            next(f)
            for line in f:
                cols = line.split()
                addr, hexport = cols[1].split(":")
                if int(hexport, 16) == port and cols[3] == "0A" and addr in ("0100007F", "00000000"):
                    return int(cols[7])
    except (OSError, ValueError, IndexError, StopIteration):
        pass
    return None


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    door = False
    while args and args[0] in ("--door", "--whose"):
        if args[0] == "--whose":
            kind, who = whose()
            at_desktop = PORT == DESKTOP_PORT
            if kind == "agent":
                print(f"an agent's: {who}; the door {'stands' if at_desktop else 'is off (not the desktop: port ' + str(PORT) + ')'}")
            else:
                print(f"yours ({who}); the door is off")
            return 0
        door = True
        args = args[1:]
    kind, who = whose()
    if kind == "agent" and PORT == DESKTOP_PORT:
        door = True
    if door and kind != "agent":
        # Asked for (the MCP server's eval tool, a test): the agent above, if there is one.
        kind, who = whose(past_vikix=True)
    sender = who if kind == "agent" else "a test"
    code = " ".join(args) if args else sys.stdin.read()
    if not code.strip():
        print("vikix eval: no Lisp to run (try: vikix eval '(+ 1 2)')", file=sys.stderr)
        return 2

    try:
        sock = socket.create_connection((HOST, PORT), timeout=5)
    except OSError:
        print(f"vikix eval: nothing is listening on {HOST}:{PORT}.\n"
              "Is StumpWM running with Vikix's config? (swank.lisp starts the server)",
              file=sys.stderr)
        return 2
    sock.settimeout(TIMEOUT)

    # The port must be yours: when StumpWM's Swank isn't up (a text
    # console, StumpWM stopped), another user could listen there and be
    # sent the password.
    owner = listener_uid(PORT)
    if owner is not None and owner != os.getuid():
        sock.close()
        print(f"vikix eval: {HOST}:{PORT} is another user's (uid {owner}), not StumpWM's: "
              "the password isn't sent", file=sys.stderr)
        return 2

    # The password, before anything else: a Swank with ~/.slime-secret drops
    # a client that doesn't send it (anything that can reach the port,
    # such as a VM through passt's gateway, would otherwise run code here).
    # Sent as it is, not as a Lisp string: Swank compares the packet's raw
    # text (swank/rpc.lisp read-packet), as SLIME's slime-send-secret sends it.
    secret = slime_secret()
    if secret is not None:
        send(sock, secret)

    # Ask Swank to call our safe evaluator, and to hand back what it printed.
    # The fboundp check keeps Swank out of its debugger when StumpWM is
    # still running a config from before `vikix eval` existed.
    if door:
        # An agent's forms go through the door, or nowhere: a desktop from
        # before the door (an older config still running) is told to reload.
        inner = ("(if (fboundp 'stumpwm::vikix-door-check)"
                 " (stumpwm::vikix-eval-for-agent %s :door t :from %s)"
                 " :missing-door)" % (lisp_string(code), lisp_string(sender)))
    else:
        inner = ("(if (fboundp 'stumpwm::vikix-eval-for-agent)"
                 " (stumpwm::vikix-eval-for-agent %s)"
                 " :missing)" % lisp_string(code))
    send(sock, '(:emacs-rex (swank:eval-and-grab-output %s) "STUMPWM" t 1)'
         % lisp_string(inner))

    try:
        while True:
            reply = receive(sock)
            if reply.startswith("(:return"):
                break
            if reply.startswith("(:debug "):
                # Swank's debugger opened. vikix-eval-for-agent never lets
                # that happen, so this is a fault in Swank itself. Leave the
                # debugger and wait until Swank confirms, so no thread is
                # left stuck in it.
                thread = reply.split()[1]
                send(sock, '(:emacs-rex (swank:throw-to-toplevel) "STUMPWM" %s 2)'
                     % thread)
                while not receive(sock).startswith("(:return"):
                    pass
                problem = (lisp_strings(reply) or ["?"])[0]
                print(f"vikix eval: Swank failed: {problem}", file=sys.stderr)
                return 2
            # Anything else (:indentation-update, :new-features ...) is
            # Swank talking to Emacs; skip it.
    except (socket.timeout, ConnectionError) as e:
        print(f"vikix eval: no answer from StumpWM ({e})", file=sys.stderr)
        return 2
    finally:
        sock.close()

    if not reply.startswith("(:return (:ok"):
        print("vikix eval: StumpWM aborted the request:\n" + reply, file=sys.stderr)
        return 2

    strings = lisp_strings(reply)
    printed = strings[0] if strings else ""
    status = strings[1] if len(strings) > 1 else ""
    if status == ":MISSING":
        print("vikix eval: the running StumpWM has an older Vikix config.\n"
              "Reload it (Super+m, then Reload config) and try again.",
              file=sys.stderr)
        return 2
    if status == ":MISSING-DOOR":
        print("vikix eval: the running StumpWM has a Vikix config from before the door,\n"
              "so an agent's Lisp can't be checked, and isn't run. Ask the user to reload\n"
              "the desktop (Super+m, then Reload config), then try again.",
              file=sys.stderr)
        return 2
    sys.stdout.write(printed)
    if printed and not printed.endswith("\n"):
        sys.stdout.write("\n")
    if status == ":HELD":
        return 3
    return 0 if status == ":OK" else 1


if __name__ == "__main__":
    sys.exit(main())
