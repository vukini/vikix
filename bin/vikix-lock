#!/bin/sh
# vikix-lock — lock the screen, with only ever one locker.
#
#   vikix-lock            lock now
#   vikix-lock --locker   the locker itself, for xss-lock to start
#
# The session runs xss-lock, which starts `vikix-lock --locker` after 10
# idle minutes and before a suspend. The key (s-Escape) and the menu run
# plain `vikix-lock`, which asks xss-lock to lock now: a second i3lock
# started beside xss-lock's would need unlocking twice. Without xss-lock
# (another session), it locks by itself.
#
# The lock screen is i3lock-color: the wallpaper (the one showing, through
# vikix-wallpaper which), a clock and the date, and a ring that shows what
# is typed, in the theme's colours (vikix theme writes them to
# ~/.config/vikix/theme/palette). The ring is the accent; a key lights it
# in the foreground, backspace in the alert colour; while the password is
# checked it goes subtle, and wrong turns it the alert colour and says so.
# With plain i3lock instead, a screen in the theme's background colour.
#
# While the screen is locked, notifications wait: dunst draws its windows
# above everything, i3lock's too, so a message could be read on a locked
# screen. They are shown once it's unlocked, unless they were already
# paused (Do not disturb), which is kept.
#
# A key that wakes the dark screen isn't kept as part of the password.

THEME="${XDG_CONFIG_HOME:-$HOME/.config}/vikix/theme"

# hex6 X: whether X is a colour as i3lock takes one, rrggbb.
hex6() {
  case $1 in [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;; *) return 1 ;; esac
}

# The theme's background (vikix theme writes it), or void's.
colour=$(cat "$THEME/lock" 2>/dev/null)
hex6 "$colour" || colour=1e1e2e

# colour_of KEY FALLBACK: a colour from the theme's palette, as rrggbb.
colour_of() {
  c=$(sed -n "s/^$1=#//p" "$THEME/palette" 2>/dev/null | head -n 1)
  if hex6 "$c"; then echo "$c"; else echo "$2"; fi
}

# lock_screen: i3lock in the foreground (-n). i3lock-color's usage points
# at its manpage; plain i3lock's doesn't, and knows only the colour.
# Enter with nothing typed is still an attempt (no -e): with a fingerprint
# reader (vikix fingerprint), that is how the finger is asked for.
lock_screen() {
  if ! i3lock --help 2>&1 | grep -q manpage; then
    i3lock -n -c "$colour"
    return
  fi
  bg=$(colour_of bg "$colour") fg=$(colour_of fg ffffff)
  subtle=$(colour_of subtle "$fg") accent=$(colour_of accent "$fg") alert=$(colour_of alert "$fg")
  set -- -n -c "${bg}ff"
  # The wallpaper, when it is a picture i3lock can show (not the plain
  # PPM vikix-wallpaper makes for a theme without one).
  pic=$(command -v vikix-wallpaper >/dev/null 2>&1 && vikix-wallpaper which 2>/dev/null)
  case $pic in
    *.png|*.PNG|*.jpg|*.jpeg|*.JPG|*.JPEG) [ -f "$pic" ] && set -- "$@" -i "$pic" -F ;;
  esac
  set -- "$@" --force-clock --indicator --radius=110 --ring-width=6 \
    --time-str='%H:%M' --time-size=40 --time-color="${fg}ff" \
    --date-str='%A %-d %B' --date-size=16 --date-color="${subtle}ff" \
    --inside-color="${bg}e6" --insidever-color="${bg}e6" --insidewrong-color="${bg}e6" \
    --ring-color="${accent}ff" --ringver-color="${subtle}ff" --ringwrong-color="${alert}ff" \
    --keyhl-color="${fg}ff" --bshl-color="${alert}ff" \
    --line-color=00000000 --separator-color=00000000 \
    --verif-color="${fg}ff" --wrong-color="${alert}ff" \
    --modif-color="${subtle}ff" --layout-color="${subtle}ff" \
    --verif-text='' --wrong-text='wrong' --noinput-text='' \
    --lock-text='' --lockfailed-text='lock failed'
  i3lock "$@"
}

# while_locked: two things i3lock can't do for itself, while it runs.
#
# The key that wakes a dark screen also reaches i3lock, as the first letter
# of the password, which then can't be right. So when the monitor comes
# back on from DPMS, Escape (i3lock's "clear what's typed") goes to it.
# Woken by the mouse, it clears nothing.
#
# And the lock screen is kept in front. A window raised after it (one that
# opens, the drawer, a dialog) goes above it; i3lock would raise itself
# again when it is told it's covered, but with a compositor running (picom)
# no window is ever told that. The desktop then shows, with i3lock behind
# it holding the keyboard: every key looks dead (2026-10-04). So its
# window is raised again every half second.
while_locked() {
  command -v xdotool >/dev/null 2>&1 || return 0
  was=on; turn=0; lock=
  # $$ is the locker itself: when it is gone (ended from outside), so is this.
  while kill -0 $$ 2>/dev/null && sleep 0.1; do
    case $(xset q 2>/dev/null) in
      *"Monitor is On"*) [ "$was" = off ] && xdotool key Escape 2>/dev/null; was=on ;;
      *"Monitor is "*) was=off ;;
    esac
    turn=$((turn + 1))
    [ $((turn % 5)) = 0 ] || continue
    [ -n "$lock" ] || lock=$(xdotool search --class i3lock 2>/dev/null | head -1)
    [ -z "$lock" ] || xdotool windowraise "$lock" 2>/dev/null || lock=
  done
}

# locked: the lock screen, notifications paused till it exits.
locked() {
  paused=
  if command -v dunstctl >/dev/null 2>&1; then
    paused=$(dunstctl is-paused 2>/dev/null)
    [ "$paused" = false ] && dunstctl set-paused true 2>/dev/null
  fi
  while_locked &
  waker=$!
  lock_screen
  status=$?
  kill "$waker" 2>/dev/null
  [ "$paused" = false ] && dunstctl set-paused false 2>/dev/null
  return "$status"
}

if [ "${1:-}" = --locker ]; then
  locked                               # xss-lock waits for this to exit
  exit $?
fi

if pgrep -x -u "$(id -u)" xss-lock >/dev/null; then
  exec xset s activate
fi
# Without xss-lock nothing waits for it, so it waits in the background.
locked &
