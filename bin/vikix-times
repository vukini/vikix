#!/usr/bin/env python3
"""vikix-times — how long the desktop takes.

  vikix times            this desktop's own measures: logging in (the
                         session started to the desktop ready) and each
                         Reload config, the last and the usual (the median
                         of the last 10), against their limits
  vikix times files      the last load of the config (a login or a reload),
                         file by file: how long each took, and whether it
                         came from its compiled copy or from its text
  vikix times soak [MINUTES]   the desktop used hard for an hour (or MINUTES)
                         on a hidden screen: windows opening, closing,
                         moving, floating, splits, reloads; fails when
                         StumpWM answers slowly, grows, keeps timers or
                         hooks, or writes an error (lib/soak.py)
  vikix times soak --ask  first asks in a dialog (cron, weekly), then runs
                         at low priority and says how it went in a
                         notification
  vikix times measure    measure now on a hidden screen, with this
                         checkout's config (a few seconds, nothing on your
                         screen): StumpWM's start, a reload, a key to its
                         command, an Emacs frame, StumpWM answering (and
                         answering with a tiled xterm open, when xterm is
                         installed); kept, so the next one says what changed

The limits are lib/times.limits; tests/times.sh fails above them.
"""
import os
import statistics
import subprocess
import sys

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "vikix")
LOG = os.path.join(STATE, "times.log")
MEASURED = os.path.join(STATE, "times-measured.log")
NAMES = {"login": "logging in", "reload": "Reload config", "start": "StumpWM's start",
         "key": "a key to its command", "emacs": "an Emacs frame", "answer": "StumpWM answering", "answer-swank": "answering over Swank",
         "xterm": "answering, an xterm open"}


def limits():
    out = {}
    with open(os.path.join(HERE, "lib", "times.limits")) as f:
        for line in f:
            parts = line.split("#")[0].split()
            if len(parts) == 2:
                out[parts[0]] = float(parts[1])
    return out


def fmt(s):
    return f"{s * 1000:.0f} ms" if s < 1 else f"{s:.1f} s"


def read(path):
    rows = []
    try:
        with open(path) as f:
            for line in f:
                p = line.split()
                if len(p) == 3:
                    rows.append((p[0], p[1], float(p[2])))
    except (FileNotFoundError, ValueError):
        pass
    return rows


def show():
    lim, rows = limits(), read(LOG)
    if not rows:
        print("Nothing measured on this desktop yet: the next login and Reload config are.\n"
              "vikix times measure measures now, on a hidden screen.")
        return 0
    slow = 0
    for what in ("login", "reload"):
        mine = [r for r in rows if r[1] == what]
        if not mine:
            continue
        last, usual = mine[-1][2], statistics.median(r[2] for r in mine[-10:])
        over = what in lim and last > lim[what]
        slow += over
        print(f"{NAMES[what]:<22} {fmt(last):>8}  (usual {fmt(usual)}, limit {fmt(lim.get(what, 0))})"
              f"{'   SLOW' if over else ''}   {mine[-1][0].replace('T', ' ')}")
    return 1 if slow else 0


def measure():
    lim = limits()
    before = {}
    for when, what, s in read(MEASURED):
        before[what] = s
    r = subprocess.run(["bash", os.path.join(HERE, "lib", "times-measure.sh")], capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(r.stderr.strip() or "vikix times: measuring failed")
    from datetime import datetime
    stamp = datetime.now().strftime("%Y-%m-%dT%H:%M:%S")
    slow = 0
    os.makedirs(STATE, exist_ok=True)
    with open(MEASURED, "a") as out:
        for line in r.stdout.split("\n"):
            p = line.split()
            if len(p) != 2:
                continue
            what, s = p[0], float(p[1])
            out.write(f"{stamp} {what} {s}\n")
            over = what in lim and s > lim[what]
            slow += over
            was = f", was {fmt(before[what])}" if what in before else ""
            print(f"{NAMES.get(what, what):<22} {fmt(s):>8}  (limit {fmt(lim.get(what, 0))}{was})"
                  f"{'   SLOW' if over else ''}")
    return 1 if slow else 0


def soak(args):
    ask = "--ask" in args
    args = [a for a in args if a != "--ask"]
    minutes = args[0] if args else "60"
    script = os.path.join(HERE, "lib", "soak.py")
    if not ask:
        return subprocess.run(["nice", sys.executable, script, minutes]).returncode
    # From cron: the desktop's display and D-Bus, then a question first.
    try:
        with open(os.path.join(STATE, "session.env")) as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                if k and v:
                    os.environ.setdefault(k, v)
    except FileNotFoundError:
        return 0                                   # no desktop to ask on
    os.environ["PATH"] = os.path.expanduser("~/.local/bin") + os.pathsep + os.environ.get("PATH", "")
    r = subprocess.run(["zenity", "--question", "--title", "Vikix soak test", "--width", "460",
                        "--ok-label", "Run it now", "--cancel-label", "Not now",
                        "--text", f"Run the weekly soak test? {minutes} minutes of a hidden desktop worked "
                                  "hard (windows opening, closing, reloads), to catch StumpWM slowing down "
                                  "or growing. Your screen isn't touched, but the laptop works harder "
                                  "and the fans may run. A notification says how it went."],
                       capture_output=True)
    if r.returncode != 0:
        return 0
    out = subprocess.run(["nice", "-n", "15", sys.executable, script, minutes], capture_output=True, text=True)
    last = (out.stdout.strip().splitlines() or [out.stderr.strip() or "soak: no result"])[-1]
    subprocess.run(["notify-send", "-a", "Vikix soak test", "-u", "critical" if out.returncode == 1 else "normal",
                    "Soak test " + ("failed" if out.returncode == 1 else "done"), last])
    return out.returncode


def files():
    """The last load, file by file, slowest first (init.lisp writes it)."""
    path = os.path.join(STATE, "load-times")
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        print("No load written down yet: the next login or Reload config is.")
        return 0
    total, what = (lines[0].split() + ["", ""])[:2]
    rows = []
    for line in lines[1:]:
        ms, how, name = (line.split(None, 2) + ["", ""])[:3]
        if ms.isdigit():
            rows.append((int(ms), how, name))
    print(f"The last {'reload' if what == 'reload' else 'start'} took {total} s:")
    for ms, how, name in sorted(rows, reverse=True):
        way = {"compiled": "its compiled copy", "source": "its text",
               "yours": "its text (yours, or a plugin's)"}.get(how, how)
        print(f"  {ms:>5} ms  {name:<26} from {way}")
    waiting = [name for _, how, name in rows
               if how == "source" and name not in ("errors.lisp", "registry.lisp")]
    if waiting:
        print("Read from their text this time, and compiled in the background for the next: "
              + ", ".join(waiting) + ".")
    print("Vikix's files are compiled once (~/.cache/vikix/fasl/) and loaded from there until they change;\n"
          "errors.lisp and registry.lisp, the plugins' files and yours are always read from their text.")
    return 0


def main(argv):
    cmd = argv[0] if argv else "show"
    if cmd == "soak":
        return soak(argv[1:])
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if cmd == "measure":
        return measure()
    if cmd == "show":
        return show()
    if cmd == "files":
        return files()
    sys.exit(f"vikix times: no command {cmd} (vikix times help)")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
