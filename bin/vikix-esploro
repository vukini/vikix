#!/usr/bin/env bash
# vikix-esploro — Esploro, Vid's file explorer (github.com/vukini/esploro):
# a frame of Emacs, on dired, with menus, a tool bar, the mouse and drag
# and drop; its core, which does every change to files (journaled, so it
# can be undone), is Common Lisp, and knows which window has each file open.
#
#   vikix esploro setup [--rebuild]
#                           build its command from a pinned commit into
#                           ~/.local/opt/esploro (SBCL alone, seconds); the
#                           window's code is emacs/esploro.el beside it,
#                           which the command loads into Emacs the first
#                           time. --rebuild builds it again
#                           (vikix add esploro runs this; vikix update runs
#                           it too, and it builds only when the pin moved)
#   vikix esploro status
#   vikix esploro doctor   is it built at the pin, linked, the folder program,
#                          answering Show in folder, loaded in Emacs (vikix
#                          doctor runs this when you have the feature)
#   vikix esploro menu     Esploro's file commands for the file behind the
#                          focused window, in rofi (Super+Alt+x): open it,
#                          copy its path, compress, extract, shrink, yours;
#                          one that changes files is a plan to review first
#   vikix esploro try [CLONE]
#                          your clone's commit (~/src/esploro) on the desktop
#                          now: built, linked, the running Emacs reloaded; no
#                          GitHub. Kept by updates while it's newer than the
#                          pin; a release whose pin passes it takes over
#   vikix esploro uninstall
#                           removes it (vikix remove esploro)
#
# Command: esploro [FOLDER] (through Emacs's server: Vikix runs Emacs as a
# daemon); Super+e opens it, or goes to its frame; it's in the launcher
# (Super+d) and Super+m, Apps; M-x esploro in Emacs once it's been opened.

set -uo pipefail
VIKIX_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../lib/common.sh
. "$VIKIX_DIR/lib/common.sh"
# shellcheck source=../lib/features.sh
. "$VIKIX_DIR/lib/features.sh"
# shellcheck source=../lib/mimeapps.sh
. "$VIKIX_DIR/lib/mimeapps.sh"

# A commit, not a branch: an update brings a new Esploro only when Vikix
# moves this pin, after trying it.
ESPLORO_REPO=https://github.com/vukini/esploro
ESPLORO_COMMIT=36093fae95fc9c167a3868a8b96dedc508eb53b4 # Names Only ( ( ); a right-click on a place down the side; picture tools
OPT="$HOME/.local/opt/esploro"
BIN="$HOME/.local/bin"
APPS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
INFO="$HOME/.local/share/info"   # beside vikix.info: info esploro, Emacs's C-h i
# The browsers' "Show in folder": the session bus runs esploro --dbus the
# first time it's asked, which makes the running Emacs answer.
DBUS_SERVICE="${XDG_DATA_HOME:-$HOME/.local/share}/dbus-1/services/org.freedesktop.FileManager1.service"
MIMEAPPS="${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list"
LOGS="$VIKIX_STATE/logs"
# Tests name their stand-ins (these reach the network or build for minutes).
GIT=${VIKIX_GIT:-git}
SBCL=${VIKIX_SBCL:-sbcl}

built() {
  [ -x "$OPT/esploro" ] || return 1
  local have
  have=$(cat "$OPT/.vikix-built" 2>/dev/null)
  [ "$have" = "$ESPLORO_COMMIT" ] && return 0
  # A commit tried from your clone (vikix esploro try) stays while it's
  # newer than the pin: an update doesn't take it back. A release whose
  # pin passes it builds the pin again.
  tried_ahead
}

tried_ahead() {
  local have tried
  have=$(cat "$OPT/.vikix-built" 2>/dev/null)
  tried=$(cat "$OPT/.vikix-tried" 2>/dev/null)
  [ -n "$tried" ] && [ "$tried" = "$have" ] && [ "$tried" != "$ESPLORO_COMMIT" ] && [ -d "$OPT/.git" ] &&
    "$GIT" -C "$OPT" merge-base --is-ancestor "$ESPLORO_COMMIT" "$tried" 2>/dev/null
}

fetch() {
  if [ -d "$OPT/.git" ] && [ "$("$GIT" -C "$OPT" rev-parse HEAD 2>/dev/null)" = "$ESPLORO_COMMIT" ]; then
    return 0
  fi
  say "fetching Esploro (commit ${ESPLORO_COMMIT:0:7})"
  if [ ! -d "$OPT/.git" ]; then
    mkdir -p "$OPT"
    "$GIT" -C "$OPT" init -q || die "couldn't make $OPT"
    "$GIT" -C "$OPT" remote add origin "$ESPLORO_REPO" 2>/dev/null || true
  fi
  # Fetched by its id: nothing a branch moved to since.
  "$GIT" -C "$OPT" "${GIT_HTTPS_GITHUB[@]}" fetch -q --depth 1 origin "$ESPLORO_COMMIT" || die "couldn't fetch Esploro"
  "$GIT" -c advice.detachedHead=false -C "$OPT" checkout -q --force FETCH_HEAD || die "couldn't check out Esploro"
  [ "$("$GIT" -C "$OPT" rev-parse HEAD)" = "$ESPLORO_COMMIT" ] ||
    die "Esploro isn't the commit expected: not built"
}

build() {
  if [ "${1:-}" != --rebuild ] && built; then say "Esploro is built"; return 0; fi
  if [ "$DRY_RUN" = 1 ]; then printf '   would build Esploro (%s) in %s\n' "${ESPLORO_COMMIT:0:7}" "$OPT"; return 0; fi
  fetch
  local log="$LOGS/esploro-build.log"
  mkdir -p "$LOGS"
  say "building Esploro's command (a few seconds; log: $log)"
  # As its Makefile does, without needing make: build.lisp writes
  # ./esploro.new, one program that starts at once. SBCL alone: the
  # window is Emacs.
  ( cd "$OPT" && "$SBCL" --noinform --non-interactive --no-userinit --load build.lisp ) > "$log" 2>&1 &&
    mv -f "$OPT/esploro.new" "$OPT/esploro" ||
    { tail -n 20 "$log"; die "Esploro didn't build (the end of $log is above)"; }
  [ -x "$OPT/esploro" ] || die "Esploro's program isn't where it should be ($OPT/esploro)"
  echo "$ESPLORO_COMMIT" > "$OPT/.vikix-built"
  rm -f "$OPT/.vikix-tried"
  say "Esploro is built"
}

# vikix esploro try [CLONE]: your clone's commit (~/src/esploro), built and
# put on the desktop now, the running Emacs reloaded; no GitHub, no key.
cmd_try() {
  local clone=${1:-$HOME/src/esploro} commit log
  "$GIT" -C "$clone" rev-parse --git-dir >/dev/null 2>&1 || die "$clone isn't a clone of Esploro"
  commit=$("$GIT" -C "$clone" rev-parse HEAD) || die "no commit in $clone"
  if [ -n "$("$GIT" -C "$clone" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
    warn "$clone has changes not committed: only what's committed (${commit:0:7}) is tried"
  fi
  if [ "$DRY_RUN" = 1 ]; then printf '   would build Esploro %s from %s\n' "${commit:0:7}" "$clone"; return 0; fi
  if [ ! -d "$OPT/.git" ]; then
    mkdir -p "$OPT"
    "$GIT" -C "$OPT" init -q || die "couldn't make $OPT"
    "$GIT" -C "$OPT" remote add origin "$ESPLORO_REPO" 2>/dev/null || true
  fi
  say "trying Esploro ${commit:0:7} from $clone"
  "$GIT" -C "$OPT" fetch -q "$clone" "$commit" || die "couldn't take $commit from $clone"
  "$GIT" -c advice.detachedHead=false -C "$OPT" checkout -q --force FETCH_HEAD || die "couldn't check it out"
  log="$LOGS/esploro-build.log"
  mkdir -p "$LOGS"
  ( cd "$OPT" && "$SBCL" --noinform --non-interactive --no-userinit --load build.lisp ) > "$log" 2>&1 &&
    mv -f "$OPT/esploro.new" "$OPT/esploro" ||
    { tail -n 20 "$log"; die "Esploro didn't build (the end of $log is above)"; }
  echo "$commit" > "$OPT/.vikix-built"
  echo "$commit" > "$OPT/.vikix-tried"
  if built; then
    cmd_setup
    say "Esploro ${commit:0:7} is on your desktop; Vikix's pin is ${ESPLORO_COMMIT:0:7}, and a release moving it on keeps this"
  else
    # Older than the pin, or beside it: kept until the next update builds the pin.
    reload_in_emacs
    warn "Esploro ${commit:0:7} isn't newer than Vikix's pin (${ESPLORO_COMMIT:0:7}): the next vikix update builds the pin again"
  fi
}

# reload_in_emacs — a running Emacs that has Esploro loaded gets the new
# window code at once, as vikix update does for vikix-ai.el, so no restart.
# Its keymaps are unbound first: defvar-keymap keeps one that exists, and
# new keys (C-x C-c closing only Esploro) would otherwise wait for a restart.
# The places down the side are one buffer that lives on: it is given its
# mode again (the new keymap) and drawn again, or a new key or menu of
# theirs would wait for a restart all the same.
reload_in_emacs() {
  [ "$DRY_RUN" = 1 ] && { printf '   would reload Esploro in a running Emacs\n'; return 0; }
  [ -f "$OPT/emacs/esploro.el" ] && command -v emacsclient >/dev/null 2>&1 || return 0
  local form
  # The state variables are unbound too: from 0.71.39 each view keeps its
  # own (buffer-local), and an older Esploro's global values would become
  # every new view's. Its one buffer, *Esploro*, is then made a view.
  # Its loader first, loaded or not: M-x esploro and embark's , and J on
  # file names, before Esploro is first opened (your config loads it at
  # Emacs's start from then on).
  form="(progn (load \"$OPT/emacs/esploro-loaddefs\" t t) (when (featurep 'esploro)
          (dolist (v '(esploro-mode-map esploro-places-mode-map esploro-tool-bar-map esploro-manual-mode-map esploro-preview-mode-map
                       esploro-review-mode-map esploro-plan-edit-mode-map esploro-project-mode-map esploro-habits-mode-map esploro-grid-mode-map esploro-changes-mode-map esploro-compare-mode-map
                       esploro--back esploro--forward esploro--sort esploro--reverse
                       esploro--hidden esploro--filter))
            (makunbound v))
          (load \"$OPT/emacs/esploro\" nil t)
          (when (get-buffer \"*Esploro*\")
            (with-current-buffer \"*Esploro*\" (setq esploro--view t)))
          (when (get-buffer \"*Esploro places*\")
            (with-current-buffer \"*Esploro places*\" (esploro-places-mode))
            (esploro-places-refresh))
          'reloaded))"
  case $(timeout 5 emacsclient -e "$form" 2>/dev/null) in
    reloaded) say "Esploro reloaded in the running Emacs" ;;
  esac
  return 0
}

cmd_setup() {
  local rebuild=${1:-}
  case $rebuild in ''|--rebuild) ;; *) die "vikix esploro setup [--rebuild]" ;; esac
  record_features esploro
  command -v emacs >/dev/null 2>&1 || [ "$DRY_RUN" = 1 ] || warn "Emacs isn't here, and Esploro's window is in Emacs: vikix add emacs"
  # The programs its preview makes thumbnails with.
  local p missing=0
  while IFS= read -r p; do pkg_installed "$p" || missing=1; done < <(read_list "$VIKIX_DIR/packages/optional/esploro.list")
  if [ "$missing" = 1 ]; then
    VIKIX_LISTS=esploro bash "$VIKIX_DIR/install/10-packages.sh" || warn "the programs for previews didn't install; Esploro works without them"
  fi
  command -v "$SBCL" >/dev/null 2>&1 || [ "$DRY_RUN" = 1 ] || die "sbcl isn't here"
  build "$rebuild"
  link_managed "$OPT/esploro" "$BIN/esploro"
  if [ "$DRY_RUN" = 1 ]; then
    printf '   would write %s\n' "$APPS/vikix-esploro.desktop"
  else
    mkdir -p "$APPS"
    cat > "$APPS/vikix-esploro.desktop" <<DESKTOP
[Desktop Entry]
# Written by vikix esploro setup; vikix esploro uninstall removes it.
Name=Esploro
Comment=A file explorer in Emacs: menus, the mouse, drag and drop, undo, and which window has each file
Exec=$BIN/esploro %F
Icon=system-file-manager
Terminal=false
Type=Application
Categories=System;FileManager;
MimeType=inode/directory;
DESKTOP
  fi
  # Its manual, where Info looks (40-config puts vikix.info there too).
  if [ -f "$OPT/doc/esploro.info" ]; then
    link_managed "$OPT/doc/esploro.info" "$INFO/esploro.info"
    if command -v install-info >/dev/null 2>&1; then
      run install-info --info-dir="$INFO" "$INFO/esploro.info" >/dev/null 2>&1 || warn "the manual isn't in Info's list: info esploro still finds it"
    fi
  fi
  # Esploro, the file manager: folders open in it (and so drives, since
  # vikix-drives opens them with xdg-open), and the browsers' "Show in
  # folder" reaches it. Only over Vikix's own earlier choice, PCManFM.
  set_mime_default "$MIMEAPPS" inode/directory vikix-esploro.desktop pcmanfm.desktop ||
    say "folders keep opening in the program you chose (inode/directory in $MIMEAPPS)"
  if [ "$DRY_RUN" = 1 ]; then
    printf '   would write %s\n' "$DBUS_SERVICE"
  else
    mkdir -p "$(dirname "$DBUS_SERVICE")"
    printf '%s\n' "[D-BUS Service]" "# Written by vikix esploro setup: the browsers' \"Show in folder\" opens Esploro." \
      "Name=org.freedesktop.FileManager1" "Exec=$BIN/esploro --dbus" > "$DBUS_SERVICE"
  fi
  reload_in_emacs
  say "ready: Super+e, or esploro [FOLDER] (also in Super+d); folders and Show in folder open in it; its manual: ? in it, or info esploro"
}

cmd_status() {
  if tried_ahead; then echo "esploro  tried, commit $(head -c 7 "$OPT/.vikix-tried") from your clone, ahead of the pin ${ESPLORO_COMMIT:0:7} ($OPT)"
  elif built; then echo "esploro  built, commit ${ESPLORO_COMMIT:0:7} ($OPT)"
  elif [ -x "$OPT/esploro" ]; then echo "esploro  built from another commit: vikix esploro setup builds this one"
  else echo "esploro  not built (vikix add esploro)"; fi
}

cmd_doctor() {
  local ok=1 now
  if tried_ahead; then say "Esploro is $(head -c 7 "$OPT/.vikix-tried"), tried from your clone, ahead of Vikix's pin (${ESPLORO_COMMIT:0:7}): a release catches up"
  elif built; then say "Esploro is built at Vikix's pin (${ESPLORO_COMMIT:0:7})"
  elif [ -x "$OPT/esploro" ]; then warn "Esploro is built from another commit: vikix esploro setup builds Vikix's"; ok=0
  else warn "Esploro isn't built: vikix esploro setup"; ok=0; fi
  if [ -L "$BIN/esploro" ] && [ "$(readlink "$BIN/esploro")" = "$OPT/esploro" ]; then say "esploro is the command"
  elif [ -e "$BIN/esploro" ]; then say "esploro in $BIN is one of your own"
  else warn "esploro isn't in $BIN: vikix esploro setup links it"; ok=0; fi
  # Your choice, when it isn't Esploro: said, not counted.
  now=$(xdg-mime query default inode/directory 2>/dev/null)
  if [ "$now" = vikix-esploro.desktop ]; then say "folders open in Esploro"
  else say "folders open in ${now:-nothing set} (inode/directory in $MIMEAPPS)"; fi
  if grep -q "esploro --dbus" "$DBUS_SERVICE" 2>/dev/null; then
    case $(timeout 3 gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
             --method org.freedesktop.DBus.NameHasOwner org.freedesktop.FileManager1 2>/dev/null) in
      "(true,)") say "Show in folder reaches Esploro (it's answering now)" ;;
      *)         say "Show in folder reaches Esploro (the session bus starts it when first asked)" ;;
    esac
  else
    warn "Show in folder doesn't reach Esploro ($DBUS_SERVICE is missing): vikix esploro setup"; ok=0
  fi
  case $(timeout 3 emacsclient -e "(and (featurep 'esploro) (fboundp 'esploro-review-plan) 'loaded)" 2>/dev/null) in
    loaded) say "the running Emacs has Esploro loaded" ;;
    nil)    say "the running Emacs hasn't loaded Esploro yet (Super+e does)" ;;
    *)      say "no Emacs is answering (Esploro's window is in Emacs: it opens with Emacs's server)" ;;
  esac
  [ "$ok" = 1 ]
}

# rofi's -mesg and notification bodies are markup: an & or < in a file's
# name would hide the whole line.
# (The replacements quoted: bash 5.2 reads a bare & in one as the match.)
markup_escape() {
  local s=${1//&/"&amp;"}
  s=${s//</"&lt;"}
  printf '%s' "${s//>/"&gt;"}"
}

cmd_menu() {
  local es file lines pick name answer shown label made
  es=$(command -v esploro) || { notify-send "Esploro" "Esploro isn't installed: vikix add esploro"; return 1; }
  file=$("$es" reveal --print 2>/dev/null | head -n1)
  if [ -z "$file" ]; then
    notify-send "Esploro" "No file behind this window: Esploro's commands are for a file another window has"
    return 0
  fi
  shown=$(markup_escape "${file/#$HOME/\~}")
  lines=$("$es" commands --lines "$file" 2>/dev/null)
  [ -n "$lines" ] || { notify-send "Esploro" "No commands for $shown"; return 0; }
  pick=$(printf '%s\n' "$lines" | rofi -dmenu -i -no-custom -p "${file##*/}" -mesg "$shown" \
           -display-columns 2 -display-column-separator $'\t') || return 0
  [ -n "$pick" ] || return 0
  name=${pick%%$'\t'*}
  answer=$("$es" run "$name" "$file" 2>&1)
  case $answer in
    "(:error "*) notify-send "Esploro" "$(markup_escape "$(sed 's/^(:error "\(.*\)")$/\1/' <<<"$answer")")" ;;
    # Compress, Extract, Shrink: what it made, since nothing else shows it.
    *":made ("*)
      label=${pick#*$'\t'}
      made=$(sed 's/.*:made (//; s/))$//' <<<"$answer" | grep -o '"[^"]*"' | tr -d '"' | sed "s|^$HOME|~|")
      notify-send "Esploro" "$(markup_escape "${label%%:*}: made ${made//$'\n'/, }")" ;;
  esac
  return 0
}

cmd_uninstall() {
  # The link only while it's still ours: never your own esploro (make install).
  if [ -L "$BIN/esploro" ] && [ "$(readlink "$BIN/esploro")" = "$OPT/esploro" ]; then
    run rm -f "$BIN/esploro"
  fi
  run rm -f "$APPS/vikix-esploro.desktop"
  # Folders back to PCManFM, when they went to Esploro; Show in folder goes.
  set_mime_default "$MIMEAPPS" inode/directory pcmanfm.desktop vikix-esploro.desktop || true
  grep -q "esploro --dbus" "$DBUS_SERVICE" 2>/dev/null && run rm -f "$DBUS_SERVICE"
  if [ -L "$INFO/esploro.info" ]; then
    command -v install-info >/dev/null 2>&1 && run install-info --delete --info-dir="$INFO" "$INFO/esploro.info" >/dev/null 2>&1
    run rm -f "$INFO/esploro.info"
  fi
  run rm -rf "$OPT"
  forget_features esploro
  say "removed Esploro"
}

case ${1:-} in
  setup)     shift; cmd_setup "${1:-}" ;;
  status)    cmd_status ;;
  doctor)    cmd_doctor ;;
  menu)      cmd_menu ;;
  try)       shift; cmd_try "${1:-}" ;;
  uninstall) cmd_uninstall ;;
  -h|--help|help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "vikix esploro: setup, status, doctor, menu, try, uninstall" ;;
esac
