#!/usr/bin/env bash
# vikix-theme — the colour theme, everywhere (`vikix theme`).
#
#   vikix theme                  the current theme, and the ones there are
#   vikix theme NAME             switch to NAME, everywhere, now
#   vikix theme import SOURCE [NAME] [--force] [--no-switch]
#                                an Omarchy theme, as a theme of yours, then
#                                switch to it. SOURCE is an https git URL,
#                                OWNER/REPO on GitHub, or a folder with a git
#                                repository. NAME is the repository's name
#                                without omarchy- and -theme, unless you give
#                                one. --force replaces a theme of yours with
#                                that name (the old files are kept as
#                                .vikix-bak); --no-switch only imports
#   vikix theme --refresh        write the current theme's files again
#                                (40-config does this, so a Vikix update
#                                reaches them)
#
# A theme is a file of named colours: themes/NAME.theme in Vikix, or your own
# in ~/.config/vikix/themes/. Switching remembers the choice and writes the
# colours out for each program into ~/.config/vikix/theme/, which your config
# files include; the programs that are running pick the new colours up now
# (StumpWM, dunst, kitty, the editors, Nyxt, GTK and Qt), and the theme's own
# wallpaper comes with it. Super+m → Theme is the same, with each theme shown
# as you move to it. vikix (the everyday command) hands `vikix theme` over
# to this script.

set -euo pipefail

VIKIX_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
export VIKIX_DIR
# shellcheck source=../lib/common.sh
. "$VIKIX_DIR/lib/common.sh"

# --- Themes ------------------------------------------------------------------
# A theme is a file of named colours: themes/NAME.theme in Vikix, or your own
# in ~/.config/vikix/themes/. `vikix theme NAME` remembers the choice and
# writes the colours out for each program into ~/.config/vikix/theme/. Your
# config files include those (alacritty.toml imports alacritty.toml; rofi's
# config.rasi names rofi.rasi; kitty.conf can include kitty.conf), and dunst
# reads its drop-in by itself. StumpWM reads the saved name when it starts,
# so the theme survives a restart.

THEME_OUT="${XDG_CONFIG_HOME:-$HOME/.config}/vikix/theme"
USER_THEMES="${XDG_CONFIG_HOME:-$HOME/.config}/vikix/themes"
DUNST_DROPIN="${XDG_CONFIG_HOME:-$HOME/.config}/dunst/dunstrc.d/10-vikix-theme.conf"
THEME_KEYS="bg fg subtle dim accent alert color0 color1 color2 color3 color4 color5
            color6 color7 color8 color9 color10 color11 color12 color13 color14 color15"
# Keys a theme may leave out, with what stands in: themes made before
# 0.23.0 have no sel, and keep working; the three agent_ colours (what an
# agent's terminal needs of you: it asks, its desk is released and waits
# for gup, that is pushed and the terminal can go) are the terminal's
# yellow, green and cyan unless the theme says otherwise (agents.lisp has
# the same fallbacks).
THEME_OPTIONAL="sel agent_asks agent_released agent_pushed"

# A theme's name is its file's name, and it goes to StumpWM as a Lisp
# keyword: letters, digits, - and _ only, or a file named to be Lisp would
# run as you (at vikix theme, and at every update's refresh).
theme_name_ok() { [[ $1 =~ ^[A-Za-z0-9_-]{1,40}$ ]]; }

# The built-in themes' names before 0.72.4, when every theme's name got
# its -light or -dark: a saved choice, a script of yours or an agent may
# still say them, and a Vikix update refreshes the saved theme before the
# migration renames it. An old name stands for the new one only while no
# theme file of yours has it.
theme_old_name() {   # theme_old_name NAME — the theme NAME is now called
  case $1 in
    void)        echo vikix-dark ;;
    paper)       echo vikix-light ;;
    contrast)    echo contrast-dark ;;
    gruvbox)     echo gruvbox-dark ;;
    nord)        echo nord-dark ;;
    tokyo-night) echo tokyo-night-dark ;;
    *)           echo "$1" ;;
  esac
}

theme_canonical() {   # theme_canonical NAME — NAME, or what an old name is now
  local new; new=$(theme_old_name "$1")
  if [ "$new" != "$1" ] && [ ! -f "$USER_THEMES/$1.theme" ]; then echo "$new"; else echo "$1"; fi
}

theme_file() {   # theme_file NAME — the file that defines NAME (yours first)
  local f
  theme_name_ok "$1" || return 1
  for f in "$USER_THEMES/$1.theme" "$VIKIX_DIR/themes/$1.theme"; do
    [ -f "$f" ] && { echo "$f"; return 0; }
  done
  return 1
}

# theme_names — every theme there is, in order: Vikix's own two first, then
# by name, a -light before its -dark.
theme_names() {
  local f
  local n
  for f in "$VIKIX_DIR"/themes/*.theme "$USER_THEMES"/*.theme; do
    [ -f "$f" ] || continue
    n=$(basename "$f" .theme)
    theme_name_ok "$n" && echo "$n"
  done | sort -u | awk '{ own = ($0 ~ /^vikix-/) ? 0 : 1
                         shade = ($0 ~ /-light$/) ? 0 : ($0 ~ /-dark$/) ? 1 : 2
                         base = $0; sub(/-(light|dark)$/, "", base)
                         print own "\t" base "\t" shade "\t" $0 }' | sort -t $'\t' -k1,1n -k2,2 -k3,3n | cut -f4
}

# theme_read FILE — sets c_KEY for each colour. The file is read, never run.
theme_read() {
  local key value k missing=()
  for k in $THEME_KEYS $THEME_OPTIONAL; do unset "c_$k"; done
  while IFS='=' read -r key value; do
    key=${key//[[:space:]]/}
    [ -n "$key" ] || continue
    read -r value _ <<<"$value"             # the first word; the rest is a comment
    [[ " $THEME_KEYS $THEME_OPTIONAL " == *[[:space:]]"$key"[[:space:]]* ]] || continue
    [[ $value =~ ^#[0-9A-Fa-f]{6}$ ]] || { warn "$1: $key=$value is not a #rrggbb colour"; continue; }
    printf -v "c_$key" '%s' "$value"
  done < "$1"
  for k in $THEME_KEYS; do
    local var="c_$k"
    [ -n "${!var:-}" ] || missing+=("$k")
  done
  [ "${#missing[@]}" -eq 0 ] || { warn "$1 has no colour for: ${missing[*]}"; return 1; }
  : "${c_sel:=$c_color0}"
  : "${c_agent_asks:=$c_color3}"
  : "${c_agent_released:=$c_color2}"
  : "${c_agent_pushed:=$c_color6}"
}

# theme_write NAME — every program's theme file, from theme NAME.
# shellcheck disable=SC2154  # the c_* colours are set by theme_read, with printf -v
theme_write() {
  local file
  theme_name_ok "$1" || die "a theme's name is letters, digits, - and _ only"
  file=$(theme_file "$1") || die "no theme called '$1' (vikix theme lists them)"
  theme_read "$file" || die "theme '$1' is incomplete; nothing was changed"
  [ "$DRY_RUN" = 1 ] && { printf '   would write the %s theme into %s\n' "$1" "$THEME_OUT"; return 0; }
  mkdir -p "$THEME_OUT" "$(dirname "$DUNST_DROPIN")"
  local head="Written by \`vikix theme\` from $file; changes here are overwritten."

  cat > "$THEME_OUT/alacritty.toml" <<EOF
# $head
[colors.primary]
background = "$c_bg"
foreground = "$c_fg"

[colors.selection]
background = "$c_sel"
text = "CellForeground"

[colors.normal]
black = "$c_color0"
red = "$c_color1"
green = "$c_color2"
yellow = "$c_color3"
blue = "$c_color4"
magenta = "$c_color5"
cyan = "$c_color6"
white = "$c_color7"

[colors.bright]
black = "$c_color8"
red = "$c_color9"
green = "$c_color10"
yellow = "$c_color11"
blue = "$c_color12"
magenta = "$c_color13"
cyan = "$c_color14"
white = "$c_color15"
EOF

  local i kitty="# $head
background $c_bg
foreground $c_fg
selection_background $c_sel
selection_foreground none
cursor $c_fg
active_border_color $c_accent
inactive_border_color $c_dim"
  for i in $(seq 0 15); do
    local var="c_color$i"
    kitty+=$'\n'"color$i ${!var}"
  done
  printf '%s\n' "$kitty" > "$THEME_OUT/kitty.conf"

  cat > "$THEME_OUT/rofi.rasi" <<EOF
/* $head */
* {
    bg: $c_bg; fg: $c_fg; subtle: $c_subtle; dim: $c_dim; sel: $c_sel;
    accent: $c_accent; alert: $c_alert;
    background-color: transparent;
    text-color: @fg;
}
window {
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    padding: 12px;
    width: 40%;
}
inputbar { children: [ prompt, entry ]; spacing: 8px; padding: 0 0 8px 0; }
prompt { text-color: @accent; }
entry { placeholder: "Type to search"; placeholder-color: @subtle; }
listview { lines: 10; scrollbar: false; }
element { padding: 4px 8px; }
element selected.normal, element selected.active { background-color: @sel; text-color: @fg; }
element-text, element-icon { background-color: inherit; text-color: inherit; }
EOF

  cat > "$DUNST_DROPIN" <<EOF
# $head
# A drop-in: dunst reads it after ~/.config/dunst/dunstrc, so these colours
# win over the ones there. To keep your own, add a drop-in named after this
# one (e.g. 90-mine.conf): the last in name order wins.
[global]
    frame_color = "$c_accent"
[urgency_low]
    background = "$c_bg"
    foreground = "$c_subtle"
    highlight = "$c_subtle"
[urgency_normal]
    background = "$c_bg"
    foreground = "$c_fg"
    highlight = "$c_accent"
[urgency_critical]
    background = "$c_bg"
    foreground = "$c_fg"
    frame_color = "$c_alert"
    highlight = "$c_alert"
EOF

  printf '%s\n' "${c_bg#\#}" > "$THEME_OUT/lock"     # i3lock -c takes rrggbb
  # Every colour as KEY=#rrggbb, for the editors: Neovim and Emacs read it
  # for a theme they have no colour scheme of their own for.
  {
    printf '# %s\n' "$head"
    for k in $THEME_KEYS $THEME_OPTIONAL; do local var="c_$k"; printf '%s=%s\n' "$k" "${!var}"; done
  } > "$THEME_OUT/palette"
  printf '%s\n' "$1" > "$THEME_OUT/current"
  theme_toolkits "$head"
  theme_hype "$1"
}

# theme_dark — whether the theme just read is dark: its background's
# relative luminance (WCAG) under a half.
# shellcheck disable=SC2154  # c_bg is set by theme_read, with printf -v
theme_dark() {
  local hex=${c_bg#\#}
  awk -v r=$((16#${hex:0:2})) -v g=$((16#${hex:2:2})) -v b=$((16#${hex:4:2})) \
    'function lin(c) { c /= 255; return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ^ 2.4 }
     BEGIN { exit (0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b) < 0.5) ? 0 : 1 }'
}

# theme_toolkits HEAD — GTK and Qt programs (Firefox, PCManFM, LibreOffice,
# zenity, Qt's): dark or light with the theme, in its colours where they
# take them. GTK 3 follows its theme's name (Adwaita or Adwaita-dark) from
# XSETTINGS, which xsettingsd (started by vikix-session) serves from
# xsettingsd.conf; GTK 4 and libadwaita follow the colour scheme the portal
# serves from gsettings, and take the theme's colours from gtk4.css, which
# ~/.config/gtk-4.0/gtk.css imports; Qt 6 takes a palette, qt6ct-colors.conf,
# through qt6ct. GTK 3's Adwaita has no colours to set from outside.
# shellcheck disable=SC2154  # the c_* colours are set by theme_read, with printf -v
theme_toolkits() {
  local mode=light gtk=Adwaita
  theme_dark && { mode=dark; gtk=Adwaita-dark; }
  printf '%s\n' "$mode" > "$THEME_OUT/mode"
  printf '# %s\nNet/ThemeName "%s"\nNet/IconThemeName "Adwaita"\n' "$1" "$gtk" > "$THEME_OUT/xsettingsd.conf"
  # libadwaita 1.6 on reads the variables, older and plain GTK 4 the names.
  local card="$c_sel" view="$c_bg" side="$c_bg"
  cat > "$THEME_OUT/gtk4.css" <<EOF
/* $1 */
@define-color accent_bg_color $c_accent;
@define-color accent_color $c_accent;
@define-color window_bg_color $c_bg;
@define-color window_fg_color $c_fg;
@define-color view_bg_color $view;
@define-color view_fg_color $c_fg;
@define-color headerbar_bg_color $c_bg;
@define-color headerbar_fg_color $c_fg;
@define-color sidebar_bg_color $side;
@define-color popover_bg_color $c_bg;
@define-color dialog_bg_color $c_bg;
@define-color card_bg_color $card;
:root {
  --accent-bg-color: $c_accent;
  --accent-color: $c_accent;
  --window-bg-color: $c_bg;
  --window-fg-color: $c_fg;
  --view-bg-color: $view;
  --view-fg-color: $c_fg;
  --headerbar-bg-color: $c_bg;
  --headerbar-fg-color: $c_fg;
  --sidebar-bg-color: $side;
  --popover-bg-color: $c_bg;
  --dialog-bg-color: $c_bg;
  --card-bg-color: $card;
}
EOF
  # Qt's palette, in QPalette's order: WindowText Button Light Midlight Dark
  # Mid Text BrightText ButtonText Base Window Shadow Highlight
  # HighlightedText Link LinkVisited AlternateBase NoRole ToolTipBase
  # ToolTipText PlaceholderText Accent; #aarrggbb.
  local roles=(fg sel bg sel dim dim fg fg fg bg bg black accent bg accent color5 sel black
               sel fg subtle accent) r active=() disabled=()
  for r in "${roles[@]}"; do
    local var="c_$r" v
    v=${!var:-#000000}; [ "$r" = black ] && v='#000000'
    active+=("#ff${v#\#}")
    [ "$r" = fg ] && v=$c_subtle     # disabled: the text quieter
    disabled+=("#ff${v#\#}")
  done
  local IFS=,
  local a="${active[*]}" d="${disabled[*]}"
  unset IFS
  printf '# %s\n[ColorScheme]\nactive_colors=%s\ndisabled_colors=%s\ninactive_colors=%s\n' \
    "$1" "$a" "$d" "$a" > "$THEME_OUT/qt6ct-colors.conf"
}

# theme_toolkits_apply — running GTK programs change now: xsettingsd reads
# its file again (GTK 3), and the colour scheme the portal tells GTK 4 about
# changes. Qt programs take the palette when they next start.
theme_toolkits_apply() {
  local mode gtk
  mode=$(cat "$THEME_OUT/mode" 2>/dev/null) || return 0
  gtk=Adwaita; [ "$mode" = dark ] && gtk=Adwaita-dark
  pkill -HUP -x xsettingsd 2>/dev/null || true
  if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface color-scheme "$([ "$mode" = dark ] && echo prefer-dark || echo default)" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface gtk-theme "$gtk" 2>/dev/null || true
  fi
}

# theme_omarchy — the colours theme_read set, in Omarchy's colors.toml form.
# shellcheck disable=SC2154  # the c_* colours are set by theme_read, with printf -v
theme_omarchy() {
  local i var
  printf '# %s\n' "$1"
  printf 'background = "%s"\nforeground = "%s"\naccent = "%s"\ncursor = "%s"\n' "$c_bg" "$c_fg" "$c_accent" "$c_fg"
  printf 'selection = "%s"\nselection_background = "%s"\nselection_foreground = "%s"\n' "$c_sel" "$c_sel" "$c_fg"
  printf 'lighter_background = "%s"\nactive_border_color = "%s"\nred = "%s"\n' "$c_color0" "$c_accent" "$c_color1"
  for i in $(seq 0 15); do var="c_color$i"; printf 'color%s = "%s"\n' "$i" "${!var}"; done
}

# Hype (vikix hype setup) is made for Omarchy: its window takes the
# desktop's colours from Omarchy's current theme, and it offers Omarchy's
# themes for the slides. Where it's built, the current theme goes where
# its window looks (it notices the change), and every theme where the hype
# command points it (OMARCHY_PATH).
theme_hype() {
  [ -x "$HOME/.local/opt/hype/build/hype" ] || return 0
  local current="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme"
  local themes="${XDG_DATA_HOME:-$HOME/.local/share}/vikix/omarchy/themes" n f
  mkdir -p "$current"
  theme_omarchy "Written by \`vikix theme\` ($1), for Hype; changes here are overwritten." > "$current/colors.toml"
  rm -rf "$themes"
  for n in $(theme_names); do
    f=$(theme_file "$n") || continue
    # Each in a subshell: theme_read sets the colours, and the current
    # theme's must stay as they are.
    ( theme_read "$f" 2>/dev/null || exit 0
      mkdir -p "$themes/$n"
      theme_omarchy "Written by \`vikix theme\` from $f, for Hype." > "$themes/$n/colors.toml" )
  done
}

# The editors that are running change too: Emacs through its server, each
# Neovim through its own (every nvim listens on a socket in the runtime
# folder). Each gets 3 seconds, and one that doesn't answer is left as it
# is: it follows at its next start.
theme_editors() {
  local sock
  if command -v emacsclient >/dev/null 2>&1; then
    timeout 3 emacsclient -a false -e "(when (fboundp 'vikix-theme-apply) (vikix-theme-apply))" >/dev/null 2>&1 || true
  fi
  command -v nvim >/dev/null 2>&1 || return 0
  for sock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim.*; do
    [ -S "$sock" ] || continue
    timeout 3 nvim --server "$sock" --remote-expr \
      'luaeval("pcall(function() require(\"vikix.theme\").apply() end)")' >/dev/null 2>&1 || true
  done
}

# Nyxt, when it's running with Vikix's part of its config
# (config/nyxt/vikix.lisp), which lets its socket take Lisp: the socket is
# in the runtime folder, so only yours. Without that part, or not answering
# in 3 seconds, it's left as it is, and reads the colours at its next start.
theme_nyxt() {
  command -v nyxt >/dev/null 2>&1 || return 0
  pgrep -u "$(id -u)" -x nyxt >/dev/null 2>&1 || return 0
  timeout 3 nyxt --remote --quit --eval \
    '(let ((f (and (find-package :nyxt-user) (find-symbol "VIKIX-THEME-APPLY" :nyxt-user)))) (when (and f (fboundp f)) (funcall f)))' \
    </dev/null >/dev/null 2>&1 || true
}

theme_current() {
  local n; n=$(cat "$THEME_OUT/current" 2>/dev/null) || n=vikix-dark
  theme_name_ok "$n" && theme_canonical "$n" || echo vikix-dark
}

# vikix theme            the current theme, and the ones there are
# vikix theme NAME       switch to NAME, everywhere, now
# vikix theme --refresh  write the current theme's files again (40-config
#                        does this, so a Vikix update reaches them)
cmd_theme() {
  local name=${1:-}
  case $name in
    import)    shift; theme_import "$@"; return ;;
    -h|--help) theme_help; return 0 ;;
  esac
  if [ -z "$name" ]; then
    say "theme: $(theme_current)"
    say "themes: $(theme_names | tr '\n' ' ')"
    say "switch with: vikix theme NAME (or Super+m, Theme); your own go in $USER_THEMES"
    return 0
  fi
  local refresh=0
  [ "$name" = --refresh ] && { refresh=1; name=$(theme_current); }
  theme_name_ok "$name" || die "a theme's name is letters, digits, - and _ only"
  if [ "$(theme_canonical "$name")" != "$name" ]; then
    say "$name is called $(theme_canonical "$name") now"
    name=$(theme_canonical "$name")
  fi
  theme_write "$name"
  [ "$DRY_RUN" = 1 ] && return 0
  # The programs that are running pick the new colours up now. Alacritty
  # notices by itself that the file it imports has changed; rofi and the
  # lock screen read theirs each time they start.
  if [ -n "${DISPLAY:-}" ]; then
    command -v dunstctl >/dev/null 2>&1 && dunstctl reload >/dev/null 2>&1
    python3 "$VIKIX_DIR/bin/vikix-eval" "(vikix-apply-theme :$name)" >/dev/null 2>&1 ||
      warn "StumpWM didn't repaint (is it running?); it will use $name from its next start"
    # kitty reads its config again on SIGUSR1: with kitty.conf including
    # ours, open kitty windows change too.
    pkill -USR1 -x kitty 2>/dev/null || true
    theme_editors
    theme_nyxt
    theme_toolkits_apply
    # The theme's own wallpaper, unless you chose one (vikix-wallpaper).
    # Not on --refresh: that is `vikix update` rewriting the same theme,
    # and must not replace a picture set some other way.
    if [ "$refresh" = 0 ]; then
      "$VIKIX_DIR/bin/vikix-wallpaper" || warn "the wallpaper didn't change"
    fi
  fi
  say "theme: $name"
}

theme_help() {
  cat <<HELP
vikix theme                  the current theme, and the ones there are
vikix theme NAME             switch to NAME, everywhere, now
vikix theme import SOURCE [NAME] [--force] [--no-switch]
                             an Omarchy theme, as a theme of yours, then switch to it.
                             SOURCE is an https git URL, OWNER/REPO on GitHub, or a
                             folder with a git repository. NAME is the repository's
                             name without omarchy- and -theme, unless you give one.
                             --force replaces a theme of yours with that name (the
                             old files are kept as .vikix-bak); --no-switch only imports.
vikix theme --refresh        write the current theme's files again

Your own themes are in $USER_THEMES.
HELP
}

# --- Importing an Omarchy theme ------------------------------------------------
# Omarchy's themes (omarchy.org, and the community's at themes.omarchy.org)
# are git repositories: colors.toml, flat key = "#rrggbb" lines, and the
# wallpapers in backgrounds/. `vikix theme import` turns one into a Vikix
# theme. The repository is someone else's, so nothing in it is ever run or
# sourced: colors.toml is read line by line as text, only colour values
# are kept, and one picture is copied, after its first bytes show it is one.

THEME_IMPORT_TOML_MAX=65536                      # a real colors.toml is 1-3 KB
THEME_IMPORT_PICTURE_MAX=$((50 * 1024 * 1024))   # a 4K wallpaper is 2-20 MB
THEME_IMPORT_TMP=''
# The names colors.toml may use. Omarchy's own (the semantic ones), its
# older short ones (bg, fg, ...) and the ANSI color0..color15 that themes
# from before the semantic names have; any other key is left alone.
OMARCHY_KEYS="background foreground accent muted selection selection_background
  dark_background darker_background lighter_background dark_foreground
  light_foreground bright_foreground red green yellow blue magenta purple cyan
  bright_red bright_green bright_yellow bright_blue bright_magenta bright_purple
  bright_cyan black white bright_black bright_white bg fg dark_bg darker_bg
  lighter_bg dark_fg light_fg bright_fg $(printf 'color%d ' $(seq 0 15))"

# omarchy_hex VALUE — VALUE as #rrggbb in lower case: #rgb is widened and
# the alpha of #rrggbbaa dropped. Anything else fails.
omarchy_hex() {
  local h=${1#\#}
  [[ $1 == \#* && $h =~ ^[0-9A-Fa-f]+$ ]] || return 1
  case ${#h} in
    3) h="${h:0:1}${h:0:1}${h:1:1}${h:1:1}${h:2:1}${h:2:1}" ;;
    6) ;;
    8) h=${h:0:6} ;;
    *) return 1 ;;
  esac
  printf '#%s\n' "${h,,}"
}

# omarchy_mix A B PERCENT — colour A, PERCENT of the way to colour B. It is
# how Omarchy makes the bright colours a theme leaves out (20% to white).
omarchy_mix() {
  local a=${1#\#} b=${2#\#} p=$3 out='#' i x y
  for i in 0 2 4; do
    x=$((16#${a:i:2})) y=$((16#${b:i:2}))
    printf -v out '%s%02x' "$out" $(( (x * (100 - p) + y * p + 50) / 100 ))
  done
  printf '%s\n' "$out"
}

# omarchy_read FILE — the colours in FILE into om[KEY], and src[KEY]=KEY
# (the caller declares both). Only a line that is exactly  key = "#hex"
# (a comment after it allowed) counts, and only before the first [table],
# whose keys wouldn't be the palette in TOML. The first of a key wins.
omarchy_read() {
  local line key hex
  local re="^[[:space:]]*([A-Za-z0-9_]+)[[:space:]]*=[[:space:]]*[\"'](#[0-9A-Fa-f]+)[\"'][[:space:]]*(#.*)?$"
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    [[ $line =~ ^[[:space:]]*\[ ]] && break
    [[ $line =~ ^[[:space:]]*([A-Za-z0-9_]+)[[:space:]]*= ]] || continue
    key=${BASH_REMATCH[1]}
    [[ " ${OMARCHY_KEYS//$'\n'/ } " == *" $key "* ]] || continue
    [ -z "${om[$key]:-}" ] || continue
    if ! [[ $line =~ $re ]] || ! hex=$(omarchy_hex "${BASH_REMATCH[2]}"); then
      warn "colors.toml: $key isn't a colour (#rgb, #rrggbb or #rrggbbaa); left out"
      continue
    fi
    om[$key]=$hex
    src[$key]=$key
  done < "$1"
}

# om_alias KEY FROM... — when the theme has no KEY, the first FROM it has.
om_alias() {
  local k=$1 f
  shift
  [ -z "${om[$k]:-}" ] || return 0
  for f; do
    [ -n "${om[$f]:-}" ] || continue
    om[$k]=${om[$f]}
    src[$k]=${src[$f]}
    return 0
  done
  return 1
}

# om_derive KEY A B PERCENT — when the theme has no KEY, mix it from A and B.
om_derive() {
  [ -z "${om[$1]:-}" ] || return 0
  om[$1]=$(omarchy_mix "${om[$2]}" "${om[$3]}" "$4")
  src[$1]="made from ${src[$2]}, $4% towards ${src[$3]}"
}

# omarchy_resolve — every Omarchy name Vikix needs, filled in the way
# Omarchy fills them (bin/omarchy-theme-color), so the colours are those
# the theme shows there. Fails without a background or a foreground.
omarchy_resolve() {
  local hue missing=()
  om_alias background bg color0 || true
  om_alias foreground fg color7 || true
  [ -n "${om[background]:-}" ] && [ -n "${om[foreground]:-}" ] || return 1
  om[pure_white]='#ffffff'; src[pure_white]=white
  om_alias dark_foreground dark_fg || true
  om_alias lighter_background lighter_bg || true
  om_alias bright_foreground bright_fg color15 foreground
  om_alias red color1 || true
  om_alias green color2 || true
  om_alias yellow color3 || true
  om_alias blue color4 || true
  om_alias magenta purple color5 || true
  om_alias cyan color6 || true
  om_alias bright_red color9 || true
  om_alias bright_green color10 || true
  om_alias bright_yellow color11 || true
  om_alias bright_blue color12 || true
  om_alias bright_magenta bright_purple color13 || true
  om_alias bright_cyan color14 || true
  # Omarchy's palette always has the six; Vikix's must, so a theme that
  # lacks one gets its foreground there rather than a colour from nowhere.
  for hue in red green yellow blue magenta cyan; do
    om_alias "$hue" foreground || true
    [ "${src[$hue]}" = "${src[foreground]}" ] && [ "$hue" != foreground ] && missing+=("$hue")
    om_derive "bright_$hue" "$hue" pure_white 20
  done
  [ "${#missing[@]}" -eq 0 ] || warn "colors.toml has no ${missing[*]}; the foreground stands in"
  om_alias accent blue
  om_alias muted color8 dark_foreground || om_derive muted foreground background 60
  # Quieter text must stay readable: color8 is often too faint for it.
  om_alias dark_foreground || om_derive dark_foreground foreground background 25
  om_alias selection_background selection lighter_background color8 || om_derive selection_background background foreground 15
  if [ "${om[selection_background]}" = "${om[background]}" ]; then
    src[selection_background]=''
    om[selection_background]=''
    om_derive selection_background background foreground 15
  fi
}

# omarchy_picture REPO — the first picture in REPO/backgrounds, by name,
# that is a plain file under the size limit and really is a JPEG, PNG or
# WebP (feh shows all three). Sets pic and pic_type; fails when none is.
omarchy_picture() {
  local dir=$1/backgrounds f magic shown
  pic='' pic_type=''
  [ -d "$dir" ] && [ ! -L "$dir" ] || return 1
  while IFS= read -r -d '' f; do
    shown=$(basename "$f"); shown=${shown//[^[:alnum:]._ -]/?}
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    if [ "$(stat -c %s -- "$f")" -gt "$THEME_IMPORT_PICTURE_MAX" ]; then
      warn "backgrounds/$shown is over 50 MB; skipped"; continue
    fi
    magic=$(head -c 12 -- "$f" | od -An -tx1 | tr -d ' \n')
    case $magic in
      ffd8ff*)                  pic_type=jpg ;;
      89504e470d0a1a0a*)        pic_type=png ;;
      52494646????????57454250) pic_type=webp ;;
      *) warn "backgrounds/$shown isn't a JPEG, PNG or WebP inside; skipped"; continue ;;
    esac
    pic=$f
    return 0
  done < <(find "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' \
             -o -iname '*.png' -o -iname '*.webp' \) -print0 | LC_ALL=C sort -z)
  return 1
}

# vikix theme import SOURCE [NAME] [--force] [--no-switch]
theme_import() {
  local source='' name='' force=0 switch=1 url proto
  while [ $# -gt 0 ]; do
    case $1 in
      --force)     force=1 ;;
      --no-switch) switch=0 ;;
      -h|--help)   theme_help; return 0 ;;
      -*)          die "unknown option: $1 (vikix theme --help)" ;;
      *) if [ -z "$source" ]; then source=$1
         elif [ -z "$name" ]; then name=$1
         else die "too many arguments (vikix theme --help)"; fi ;;
    esac
    shift
  done
  [ -n "$source" ] || die "which theme? vikix theme import URL|OWNER/REPO [NAME] (vikix theme --help)"

  # Only https (and a folder here): git's other ways in include ext::,
  # which runs a command, and plain http, which anyone on the way can change.
  if [[ $source == /* || $source == ./* || $source == ../* ]] || [ -d "$source" ]; then
    [ -d "$source" ] || die "no folder $source"
    url="file://$(cd "$source" && pwd)" proto=file
  elif [[ $source =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
    url="https://github.com/$source" proto=https
  elif [[ $source =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~-]+)+/?$ ]]; then
    url=${source%/} proto=https
  else
    die "not a theme's address: $source (an https:// git URL, OWNER/REPO on GitHub, or a folder)"
  fi

  # The name, from the repository's unless given: omarchy-ash-theme is ash.
  # Lower case, since StumpWM's menu switches by the lower-case name.
  if [ -z "$name" ]; then
    name=${url##*/}; name=${name%.git}; name=${name#omarchy-}; name=${name%-theme}; name=${name,,}
    theme_name_ok "$name" || die "no theme name comes out of $source; give one: vikix theme import $source NAME"
  fi
  theme_name_ok "$name" || die "a theme's name is letters, digits, - and _ only (up to 40)"
  case $name in
    -*|import) die "'$name' would read as part of the command; give the theme another name" ;;
  esac
  { [ -f "$VIKIX_DIR/themes/$name.theme" ] || [ "$(theme_old_name "$name")" != "$name" ]; } &&
    die "$name is one of Vikix's own themes; give yours another name: vikix theme import $source NAME"
  local dest="$USER_THEMES/$name.theme" f existing=()
  for f in "$dest" "$USER_THEMES/$name".{jpg,jpeg,png,webp}; do
    { [ -e "$f" ] || [ -L "$f" ]; } && existing+=("$f")
  done
  [ "${#existing[@]}" -eq 0 ] || [ "$force" = 1 ] ||
    die "you already have a theme called $name (${existing[*]}); --force replaces it, or give another NAME"

  command -v git >/dev/null || die "importing a theme needs git"
  THEME_IMPORT_TMP=$(mktemp -d "${TMPDIR:-/tmp}/vikix-theme.XXXXXX")
  trap 'rm -rf -- "$THEME_IMPORT_TMP"' EXIT
  local tmp=$THEME_IMPORT_TMP
  say "fetching $url"
  # One commit, no submodules, no tags. No hooks run (none come with a
  # clone, and hooksPath keeps your own template's away), LFS files stay
  # pointers, git never asks for a password, and symlinks come out as
  # small text files, so nothing checked out points outside the folder.
  if ! GIT_TERMINAL_PROMPT=0 GIT_LFS_SKIP_SMUDGE=1 GIT_ASKPASS='' SSH_ASKPASS='' \
      timeout 300 git -c protocol.allow=never -c "protocol.$proto.allow=always" \
        -c core.askPass= -c core.hooksPath=/dev/null -c core.symlinks=false \
        clone --quiet --depth 1 --no-tags --no-recurse-submodules -- "$url" "$tmp/repo" 2> "$tmp/git.log"; then
    # git's own words, minus anything the server sent to move the cursor.
    tr -cd '[:print:]\n' < "$tmp/git.log" | tail -n 3 >&2
    die "couldn't fetch $url (is the address right, and are you online?)"
  fi
  local commit
  commit=$(git -C "$tmp/repo" rev-parse --short=12 HEAD 2>/dev/null) || commit=unknown
  [[ $commit =~ ^[0-9a-f]+$ ]] || commit=unknown

  local toml="$tmp/repo/colors.toml"
  [ -e "$toml" ] || die "$source has no colors.toml, so Vikix can't read its colours (older Omarchy themes have only alacritty.toml)"
  [ -f "$toml" ] || die "colors.toml in $source isn't a file"
  [ "$(stat -c %s -- "$toml")" -le "$THEME_IMPORT_TOML_MAX" ] || die "colors.toml in $source is over 64 KB: not a palette"
  local -A om=() src=()
  omarchy_read "$toml"
  omarchy_resolve || die "colors.toml in $source has no background or foreground colour (#rrggbb)"

  # Vikix's names from Omarchy's. The terminal's 16 are those Omarchy's
  # alacritty.toml gets: black is the background, bright black the muted
  # colour, white the foreground (black and white keys win, where a theme
  # has them).
  om_alias black_ black background; om_alias white_ white foreground
  om_alias bright_black_ bright_black muted; om_alias bright_white_ bright_white bright_foreground
  local shown=${source//[^[:print:]]/?}
  [ "$proto" = https ] && shown=$url
  {
    printf '# %s — imported by `vikix theme import` from an Omarchy theme.\n' "$name"
    printf '#\n# From %s, commit %s, on %s.\n' "$shown" "$commit" "$(date +%F)"
    echo "# Omarchy (omarchy.org) themes are made by their authors; this is theirs,"
    echo "# in Vikix's names. Beside each colour, the colors.toml name it came from."
    echo "# Change it as you like; importing again with --force replaces it."
    echo
    echo "# The desktop"
    local pair k from
    for pair in bg:background fg:foreground subtle:dark_foreground dim:muted \
                accent:accent alert:red sel:selection_background; do
      k=${pair%%:*} from=${pair#*:}
      printf '%-18s # %s\n' "$k=${om[$from]}" "${src[$from]}"
    done
    echo
    echo "# The terminal's 16 colours: black red green yellow blue magenta cyan white,"
    echo "# then the same eight, bright."
    local i=0
    for from in black_ red green yellow blue magenta cyan white_ bright_black_ bright_red \
                bright_green bright_yellow bright_blue bright_magenta bright_cyan bright_white_; do
      printf '%-18s # %s\n' "color$i=${om[$from]}" "${src[$from]}"
      i=$((i + 1))
    done
  } > "$tmp/theme"
  # The same check as a switch: a file theme_read won't take isn't kept.
  theme_read "$tmp/theme" || die "the imported colours don't make a whole theme; nothing was changed"

  local pic='' pic_type=''
  omarchy_picture "$tmp/repo" || warn "no picture in backgrounds/; the wallpaper will be plain, in the theme's background"

  run mkdir -p "$USER_THEMES"
  local stamp; stamp=$(timestamp)
  for f in "${existing[@]}"; do
    run mv -- "$f" "$f.vikix-bak.$stamp"
  done
  run cp -- "$tmp/theme" "$dest"
  [ -z "$pic" ] || run cp -- "$pic" "$USER_THEMES/$name.$pic_type"
  say "imported $name: $dest${pic:+, with its wallpaper}"

  if [ "$switch" = 0 ]; then
    say "switch to it with: vikix theme $name"
  elif [ "$DRY_RUN" = 1 ]; then
    printf '   would switch to %s\n' "$name"
  else
    cmd_theme "$name"
  fi
}

case ${1:-} in
  names) theme_names; exit 0 ;;   # for vikix's completion (vikix __complete)
  help)  theme_help; exit 0 ;;
esac
cmd_theme "$@"
