#!/usr/bin/env bash
# vikix — the everyday command.
#
#   vikix update        pull Vikix, update Void, add new packages and their
#                         services, refresh config links, pull the editor
#                         configs, run new migrations, reload StumpWM, and
#                         upgrade your pipx, uv and cargo programs
#   vikix update core|system|tools   one part: Vikix only (seconds), Void's
#                         packages only, or the editors, languages and tools
#   vikix update check  what a core update ends with, by itself: the StumpWM
#                         image starts, Vikix's links point into ~/vikix,
#                         and what vikix doctor finds
#   vikix try [DESK]    the desktop runs a desk's work before it is released:
#                         ~/vikix is put at the desk's last commit and the core
#                         update's steps run; DESK is a desk's folder, topic or
#                         branch, none the desk this shell is in (vikix try help)
#   vikix try off|status   back to main now; what the desktop runs
#   vikix update --back   the system as it was before the last update: Vikix's
#                         commit and links, the packages that changed, the
#                         StumpWM binary (vikix rollback: what is kept)
#   vikix rollback [keep|restore [ID]|forget]   the records vikix update keeps
#                         before it starts, and a restore by hand (vikix rollback --help)
#   vikix migrate       run only the migrations not yet applied
#   vikix rebuild-wm    rebuild the StumpWM executable at the Quicklisp dist Vikix pins; the one
#                       before stays as stumpwm.prev, and a new image that won't start is thrown away
#   vikix docs find WORDS  every document on the machine, searched: Vikix's
#                         guides, your projects and notes, man pages, manuals
#                         (Super+F2; vikix docs help for the rest)
#   vikix docs get      download the offline programming docs into ~/dev
#                         (a few GB, slow; update and the installer skip them)
#   vikix doctor [--fix]  check the pieces are all there; --fix mends the
#                         plain faults (vikix doctor help)
#   vikix screens [extend|mirror|external|laptop|pick]
#                         the screens: a plugged one lights up by itself;
#                         this lays them out otherwise (Super+Ctrl+p)
#   vikix wifi [list|scan]   Wi-Fi: pick a network from a list scanned first
#   vikix network [status]  Network Office: nearby devices, ports and connections
#   vikix nodes [--last]  your other machines as nodes of this Vikix: each
#                         asked over SSH, online or not, what runs there
#   vikix node add|remove|status|shell|run NAME ...   a node: a Void machine
#                         reached by key; a shell or a command there
#                         (vikix node help)
#   vikix tray [on|off|status]  a tray at the bar's end: network and
#                         Bluetooth icons (nm-applet, blueman-applet); alone
#                         it switches, as Super+m's Tray does
#   vikix memory [left|clean]  what uses the memory, biggest first, and the
#                         programs left over (hidden screens, tests nobody
#                         ended); clean ends those; a warning comes by itself
#                         when memory runs low (vikix memory help)
#   vikix rescue [free|undo|lock]  when the desktop is stuck: how it is and
#                         what it is doing; free = out of a loop (rules
#                         paused, focus on clicks, a fresh event loop); works
#                         from a text console too (vikix rescue help)
#   vikix resume [now|save|ask|always|never]  your windows back after a
#                         restart: what is saved, bring them back now, and
#                         whether a login asks first (vikix resume help)
#   vikix used [never|all|forget]  what gets used: the keys you press most,
#                         the menu entries and commands, and the keys you
#                         never have; names and counts only, kept on this
#                         machine (vikix used help)
#   vikix times [measure|soak]  how long logging in and a reload take; measure
#                         = on a hidden screen: start, reload, a key, an
#                         Emacs frame, StumpWM answering, against limits;
#                         soak = an hour of it worked hard (vikix times help)
#   vikix features      what you can add (languages, editors, LibreOffice,
#                         printing, Windows, local AI ...), and what you have
#   vikix add NAME...   add features, or a bundle (essentials, developer,
#                         everything); every update keeps them
#   vikix remove NAME...  stop keeping them, and uninstall what only they
#                         needed (it shows the list and asks first)
#   vikix pkg add|drop|list   single programs: search and install, or
#                         uninstall (and keep out); vikix pkg help
#   vikix welcome [add]  the first steps (it opens by itself at the first
#                         login): add software, keys, theme, keyboard, guide
#   vikix theme [NAME]  the colour theme, everywhere: the current one and
#                         the list, or switch to NAME
#   vikix theme import URL|OWNER/REPO [NAME]   an Omarchy theme as one of
#                         yours, then switch to it (vikix theme --help)
#   vikix version|-v|--version   the version you have (the checkout's VERSION)
#
#   vikix layout save NAME | NAME [--no-start] | list | rm NAME
#                       this workspace's layout (its splits or its strip, and
#                       which window is where) saved, put back (the windows it
#                       had that aren't open started, unless --no-start),
#                       listed, removed
#   vikix rules [off|on|forget N] [why [CLASS]] [test|apply [N]] [verbs|now|proposed]
#                       the desktop's rules: the list, one off or on, why a
#                       window is where it is, what they'd do with the windows
#                       open now, and doing it; forget takes one out of your
#                       rules.lisp (vikix rules help)
#   vikix door [run N|drop N|check FORM|allowed]
#                       the Lisp an agent sent that the door held for you:
#                       run one as you, drop it, see what passes (vikix door help)
#   vikix why [N]       why did that happen? the last things the desktop did
#                       (a key and its command, a rule and its window, the
#                       menu, an agent) and where each is written (Super+?)
#   vikix what [KIND] [NAME]
#                       what is this? the bar's field under the pointer or the
#                       window in front, or a thing by name (a field, a key,
#                       a process, a service, a package, a command, a file):
#                       what it is doing now, what such a thing is, and where
#                       it is explained: your own chapters first (Super+Alt+?)
#   vikix viri [on|off]  this workspace as a strip that scrolls sideways
#                       (Super+h/l along it), or tiled again; no word switches
#   vikix gestures [on|off]  three fingers swept on the touchpad move the
#                         focus, as Super+h/j/k/l do; alone: how it is
#   vikix eval FORM     run Lisp in the running StumpWM, print the result
#   vikix debug         one file saying what's going on, secrets taken out, to
#                         attach to an issue
#   vikix diagnose      that report, handed to your AI agent: what's wrong?
#   vikix dictate setup|models|file|status|uninstall
#                         speak, and it types what you said (Super+F9), on this laptop
#   vikix voice setup|say|quiet|new|voices|status|uninstall
#                         talk to the AI (Super+F10) or the agent (Super+F11),
#                         and it answers aloud (Piper, on this laptop)
#   vikix notes setup|uninstall
#                         ask your notes from any terminal: note index ~/Notes,
#                         then note ask "..." (vikix-notes; on this laptop)
#   vikix project [list|show|path|log|open|build|check|new] [NAME]
#                         your projects, each a folder with a log.md (in ~/src):
#                         where each is and what's next; log NAME "what was
#                         done" adds today's entry; new NAME makes one
#                         (vikix project help)
#   vikix today [yesterday|DATE]
#                         what was done today across your projects (log
#                         entries and commits), and what's next
#   vikix back            where you were: how long away, the project and its
#                         next step, Emacs's unsaved files, your last commands
#                         there, the last note; shown by itself when you come
#                         back after ten minutes away
#   vikix day [yesterday|DATE] [--week] [--for NAME]
#                         the day as the desktop saw it, kept as a diary in
#                         ~/journal: how long each project had the screen,
#                         its entries and commits, files moved, agents'
#                         sessions; day log offers the missing log entries
#                         (vikix day help)
#   vikix learn [c]       a course in the terminal: edit, save, it's checked
#                         (vikix learn c list, hint, go NN, reset NN)
#   vikix hype setup|status|uninstall
#                         Hype: Markdown slides with a visual editor, in your
#                         theme's colours (vikix add hype)
#   vikix publish [NAME] [epub|pdf|check|links]
#                         a book from Markdown: an EPUB checked for e-ink
#                         readers, and a PDF (vikix add publish)
#   vikix wallpapers setup|update|status|uninstall
#                         Vid's wallpapers, in the Super+m picker (vikix add wallpapers)
#   vikix obsidian [convert FOLDER...|--all] [report FOLDER]
#                         an Obsidian vault into Org notes, a folder at a
#                         time, links kept (~/Dropbox/notes/vault)
#   vikix records search|list|get|export|forget|stats
#                         what plugins found and kept (flights, meetings,
#                         plan use ...), searchable (vikix records help)
#   vikix grok new|list|show|prompt|claim|result|fail|accept|cancel|status|instructions
#                         local briefs and reviewed results for Grok Bot
#   vikix plugin list|add|remove|off|on|safe|status
#                         small additions from the vikix-plugins repo: bar
#                         words, Super+m entries, keys (vikix plugin help)
#   vikix bitwarden setup|pick|lock|sync|status|uninstall
#                         your Bitwarden vault: Super+Alt+v types a
#                         password into any window (vikix add bitwarden)
#   vikix lisp-apps setup|status|uninstall
#                         Nyxt, Lem and McCLIM's Listener: programs in Common
#                         Lisp (vikix add lisp-apps)
#   vikix esploro setup|status|doctor|uninstall
#                         Esploro, a file explorer in Common Lisp (vikix add
#                         esploro; Super+e)
#   vikix music setup|doctor|check|tone|play|repl|uninstall
#                         a first musical sketchpad: Lisp patterns and a quiet
#                         SuperCollider tone (vikix add music)
#   vikix cuis setup|rebuild|run|desktop|status|doctor|uninstall
#                         Cuis Smalltalk: a live image built from Vikix's
#                         packages, with a door for vikix eval --cuis (vikix
#                         add cuis)
#   vikix mcp register|unregister|tools|status
#                         the desktop as an MCP server, for Claude Code and other agents
#   vikix agent         the AI agent, after a snapshot of your files (alias: a):
#                         Claude Code, or --use opencode|codex|gemini|antigravity|aider,
#                         --local on this laptop, --default NAME, --list;
#                         --exec [NAME] for editors (stdout is the agent's), --which
#   vikix agents [--json]
#                       the agents at work here: each one's folder, branch
#                       and uncommitted files, its workspace, how long it
#                       has run, and whether it works or waits for you
#   vikix agents desk [PROJECT [TOPIC]]
#                       start an agent at a desk of its own: a workspace to
#                       itself and a git worktree of the project on a branch
#                       of that name; resume takes a desk up again, close
#                       takes it down, handoff is its record (the task, the
#                       status, what is left), tell, pause, test and dismiss
#                       are for a worker: vikix agents help is the map
#   vikix snapshot [MESSAGE]   record your files as they are now
#   vikix changes [ID]  what changed since the last snapshot (or in snapshot ID)
#   vikix history       the snapshots, newest first
#   vikix undo [ID]     put your files back as they were one snapshot ago (or at ID)
#   vikix versions PATH   every version of a file or folder, from the backups
#                         and the snapshots, newest first (vikix versions --help)
#   vikix restore PATH ID [--beside|--replace]   bring one back beside the
#                         file as NAME (DATE).ext, or in its place through the Trash
#
#   vikix backup [now]  back up your home folder with restic (vikix backup help:
#                         setup, the drive plugged in; status, list, restore,
#                         check, card, doctor, off)
#   vikix firmware [update]   firmware updates from LVFS (BIOS, Thunderbolt, ...):
#                         what's waiting, or install it (on AC power)
#   vikix fingerprint [on|off|enrol]   a finger for sudo and the lock screen,
#                         where fprintd supports the reader
#   vikix firewall [on|off|allow PORT|close PORT]   the firewall (ufw): nothing
#                         comes in but SSH and the ports you allow
#   vikix ledger [today|DATE|PROGRAM|on|off|status]   what left the laptop,
#                         by program and destination (vikix ledger --help)
#   vikix webapp add|open|list|remove    a website as a program of its own
#                         (presets: fastmail, gmail, outlook, outlook-live, superhuman)
#   vikix ai setup|models|chat|list|remove|status|stop|uninstall
#                         AI models that run on this laptop (Ollama)
#   vikix ai llm          the llm command, with those models and your keys
#   vikix ai use [local|claude|codex|cloud]  the model for Super+i, AI on the selected text
#   vikix ai log [N] [WORD]  the last questions and answers (Super+i, Super+F10, llm)
#   vikix ai key set|list|remove|check   API keys (ANTHROPIC_API_KEY ...)
#                         kept safely, out of your dotfiles and their history
#   vikix windows [setup|create ISO|stop|status|network|remove]   Windows in a VM:
#                         set it up once, install it by itself, then open its
#                         desktop in a window (vikix windows help)
#   vikix windows app NAME [FILE] | apps [setup|add NAME|remove NAME|restore|forget]
#                         one Windows program in a window of its own, and
#                         the programs Windows has
#   vikix vm [list|start|open|pause|resume|save|stop|off|status NAME]
#                         every virtual machine libvirt has, yours and the
#                         system's, in a menu: its state, start, pause, save,
#                         shut down, open its screen (Super+m, Apps)
#   vikix steam [setup|status|uninstall]   Steam, with the 32-bit libraries and
#                         the Vulkan driver your graphics card needs; Windows
#                         games too, through Proton (vikix steam help)
#
# Each command has a man page with the whole of it: man vikix-NAME (man
# vikix is this list; man -k vikix lists the pages).
#
# vk is the same command, shorter. A command can be given by the start of its
# name when only one begins so (vk upd), and so can the word after it (vk
# docs f runit); a command's start that fits several says which, unless the
# shortest of them starts all the others (vk vers is version, not
# versions). Tab completes them.

set -euo pipefail

# ~/.local/bin/vikix is a symlink; follow it back to the checkout.
VIKIX_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
export VIKIX_DIR
# shellcheck source=../lib/common.sh
. "$VIKIX_DIR/lib/common.sh"
# shellcheck source=../lib/features.sh
. "$VIKIX_DIR/lib/features.sh"

cmd_migrate() {
  run mkdir -p "$VIKIX_STATE/migrations"
  local m id applied=0
  # Migrations are named <unix-time>.sh, so a plain sort is time order.
  for m in "$VIKIX_DIR"/migrations/*.sh; do
    [ -e "$m" ] || continue
    id=$(basename "$m" .sh)
    [ -e "$VIKIX_STATE/migrations/$id" ] && continue
    say "migration $id"
    if [ "$DRY_RUN" = 1 ]; then
      printf '   would run: %s\n' "$m"
    else
      bash "$m" || die "migration $id failed; nothing after it was run"
      touch "$VIKIX_STATE/migrations/$id"
    fi
    applied=$((applied + 1))
  done
  say "$applied new migration(s)"
}

# Changes made in the checkout itself (an edit by hand or by another
# program) stop the pull: git won't overwrite them. Vikix's files are
# replaced by every update anyway, so they're set aside, not deleted: in a
# patch file to read (it can't clash with anything, unlike putting them
# back), and in a git stash, named after the update and its files.
# Editors' leftovers (#file#, file~) are in .gitignore, so they don't count.
set_aside_local_changes() {
  local dir=$1 changes unmerged name files patch hash when
  # A stash put back earlier that clashed with Vikix's files leaves them
  # half merged, with <<<<<<< marks in them: the desktop may not even
  # start like that. That needs a person, not another stash.
  unmerged=$(git -C "$dir" ls-files -u 2>/dev/null | awk '{ print $4 }' | sort -u) || unmerged=''
  if [ -n "$unmerged" ]; then
    warn "Vikix's own files have changes put back into them that clash (<<<<<<< marks):"
    printf '     %s\n' $unmerged
    echo "   The desktop may not start like that. Keep what was there in a file, and put"
    echo "   Vikix's files back as released, then update again:"
    echo "     git -C $dir diff > ~/vikix-clash-$(date +%Y%m%d-%H%M).patch"
    echo "     git -C $dir reset --hard"
    echo "     vikix update"
    exit 1
  fi
  changes=$(git -C "$dir" status --porcelain 2>/dev/null) || return 0
  [ -n "$changes" ] || return 0
  when=$(date +%Y%m%d-%H%M%S)
  files=$(awk '{ print $2 }' <<<"$changes" | head -3 | paste -sd' ')
  name="vikix update $(date '+%Y-%m-%d %H:%M'): $files"
  patch="$VIKIX_STATE/checkout-changes/$when.patch"
  warn "the Vikix checkout, $dir, has changes of its own, which would stop the update:"
  awk -v d="$dir" '{ what = ($1 == "??") ? "new" : "changed"; printf "     %-8s %s/%s\n", what, d, $2 }' <<<"$changes" | head -10
  if [ "$DRY_RUN" = 1 ]; then
    echo "   would set them aside in $patch (and a git stash), then update"
    return 0
  fi
  # The patch first, from the files themselves (git stash show on the new
  # stash sometimes printed a summary instead, and the patch came out empty).
  mkdir -p "$(dirname "$patch")"
  {
    git -C "$dir" diff HEAD
    local f
    while IFS= read -r f; do
      git -C "$dir" diff --no-index -- /dev/null "$f" || true    # 1 means "they differ"
    done < <(git -C "$dir" ls-files --others --exclude-standard)
  } > "$patch" 2>/dev/null
  [ -s "$patch" ] || die "couldn't write the changes to $patch; nothing was changed. See: git -C $dir status"
  git -C "$dir" -c user.name=Vikix -c user.email=vikix@localhost \
    stash push --include-untracked --quiet --message "$name" ||
    die "couldn't set them aside (git stash failed, above); nothing was changed. See: git -C $dir status"
  hash=$(git -C "$dir" rev-parse --short refs/stash)
  echo "   Set aside, not deleted (Vikix's files are replaced by every update anyway):"
  echo "     read them:  less $patch"
  echo "     the same, in git: git -C $dir stash show -p --include-untracked $hash"
  echo "   A change of your own belongs in your own files (~/.stumpwm.d/user.lisp and the"
  echo "   like): see ~/vikix/docs/customize.md, or ask the agent (Super+a) to move it there."
  VIKIX_SET_ASIDE=$patch
  export VIKIX_SET_ASIDE
}

# The pull failed: commits made in the checkout, which Vikix can't update
# over, or (most often) the network. Say which, and what to do.
pull_failed() {
  local dir=$1 ahead
  ahead=$(git -C "$dir" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
  if [ "${ahead:-0}" -gt 0 ]; then
    warn "the Vikix checkout, $dir, has $ahead commit(s) of its own, and Vikix can't update over them."
    echo "   Keep them as patch files, then put the checkout back as released, and update:"
    echo "     git -C $dir format-patch '@{u}' -o ~/vikix-commits-$(date +%Y%m%d-%H%M)"
    echo "     git -C $dir reset --hard '@{u}'"
    echo "     vikix update"
    echo "   (Changing Vikix itself, for good: ~/vikix/docs/customize.md, Changing Vikix itself.)"
  else
    warn "couldn't pull Vikix (the network? GitHub?); nothing was changed. Try again: vikix update"
  fi
  exit 1
}

# pull_channel DIR: the Vikix checkout brought to its channel (vikix_channel in
# lib/common.sh): main as a plain pull; good as a fast-forward to the good tag,
# with main's untested commits counted so the wait is seen, not wondered about.
pull_channel() {
  local dir=$1 channel tag ahead
  channel=$(vikix_channel)
  if [ "$channel" = main ]; then
    say "pulling Vikix (channel main: every commit as it lands)"
    git_pull "$dir" || pull_failed "$dir"
    return 0
  fi
  say "pulling Vikix (channel good: the last commit whose tests passed on GitHub)"
  tag=$(git_fetch_good "$dir") || pull_failed "$dir"
  if [ "$tag" = no-good ]; then
    warn "GitHub has no good tag yet (its tests haven't passed on main since the tag was added): taking main this once"
    git_pull "$dir" || pull_failed "$dir"
    return 0
  fi
  run git -C "$dir" merge -q --ff-only good || pull_failed "$dir"
  ahead=$(git -C "$dir" rev-list --count 'good..@{u}' 2>/dev/null || echo 0)
  if [ "${ahead:-0}" -gt 0 ]; then
    say "main is $ahead commit(s) past good: GitHub's tests haven't passed on them yet (or failed); they come when they do. To take every commit as it lands: echo main > ~/.config/vikix/channel"
  fi
}

# Programs you installed yourself with pipx, uv or cargo, brought up to date.
# uv's llm and Piper are left alone: they're Vikix's, pinned, and brought
# to their pins by vikix ai llm and vikix voice. Go has no way to upgrade
# everything it installed: `go install NAME@latest` again, one at a time.
upgrade_user_tools() {
  local name
  if command -v pipx >/dev/null 2>&1; then
    say "your pipx programs"
    run pipx upgrade-all || warn "pipx couldn't upgrade everything (above)"
  fi
  if command -v uv >/dev/null 2>&1; then
    say "your uv tools"
    while read -r name; do
      case $name in ''|-*|llm|piper-tts) continue ;; esac
      run uv tool upgrade "$name" || warn "uv couldn't upgrade $name (above)"
    done < <(uv tool list 2>/dev/null | awk '{ print $1 }')
  fi
  if command -v cargo >/dev/null 2>&1; then
    if cargo install-update --version >/dev/null 2>&1; then
      say "your cargo programs"
      run cargo install-update -a || warn "cargo couldn't upgrade everything (above)"
    elif compgen -G "$HOME/.cargo/bin/*" >/dev/null; then
      say "cargo programs aren't upgraded without cargo-update: cargo install cargo-update, once"
    fi
  fi
}

update_help() {
  cat <<'EOF'
vikix update          everything: core, then system, then tools
vikix update core     Vikix only: pull it, install packages new to its lists
                        (nothing else of Void's), services, config links,
                        migrations, reload StumpWM. Seconds, not minutes.
vikix update core --from DIR
                      the same, pulling from the Vikix repository in DIR (its
                        main) instead of GitHub: for trying your own commits
                        before you push them; only ever a fast-forward
                      Which commits: ~/.config/vikix/channel says good (the
                        default: the last commit of main whose tests passed on
                        GitHub, the tag CI moves) or main (every commit as it
                        lands, for the machine you develop Vikix on)
vikix update system   Void's packages only (xbps-install -Su)
vikix update tools    the editors' plugins and servers, the languages built
                        from source, ~/dev, llm, and your own pipx, uv and
                        cargo programs
vikix update --back   the system as it was before the last update: Vikix at
                        its commit with its links, the packages that changed
                        reinstalled from the record, the StumpWM binary back
                        (vikix rollback shows what is kept)
vikix update check    what a core update ends with, by itself: the StumpWM
                        image starts (asked, without a screen), Vikix's links
                        point into the checkout, and what vikix doctor finds
EOF
}

# --- vikix try: a desk's work on the desktop before it is released -------------

try_help() {
  cat <<'EOF'
vikix try [DESK]      the desktop runs a desk's work before it is released:
                        ~/vikix is put at the desk's last commit (its branch,
                        not main), and the core update's steps run: packages
                        new to the lists, services, config links, migrations,
                        StumpWM reloaded. DESK is a desk's folder, its topic or
                        its branch (vikix agents desks lists them); none: the
                        desk this shell is in. Files uncommitted at the desk
                        aren't taken: commit first. One desk at a time: the
                        next vikix try replaces it, and vikix update core
                        (gup) puts ~/vikix back on main first
vikix try off         back to main now, with the core update's steps
vikix try status      what the desktop runs: main, or which desk since when
EOF
}
try_file() { printf '%s/try' "$VIKIX_STATE"; }
try_status() {
  local f folder commit branch since
  f=$(try_file)
  if [ -f "$f" ]; then
    { read -r folder; read -r commit; read -r branch; read -r since; } < "$f"
    echo "the desktop runs $folder ($branch at ${commit:0:7}, since $since; vikix try), not main: vikix update core (gup) puts it back on main"
  else
    echo "the desktop runs main: Vikix $(cat "$VIKIX_DIR/VERSION")"
  fi
}
# Back on main after a try (nothing to do otherwise). An update calls it
# before its pull: a detached checkout can't pull, and a try is never kept
# over an update, so what the desktop runs is always main or a named desk.
try_back() {
  local f
  f=$(try_file)
  if [ -f "$f" ]; then
    say "back from the try of $(head -n 1 "$f"): $VIKIX_DIR on main again"
  elif ! git -C "$VIKIX_DIR" symbolic-ref -q HEAD >/dev/null 2>&1; then
    say "$VIKIX_DIR was on no branch: on main again"
  else
    return 0
  fi
  run git -C "$VIKIX_DIR" checkout -q main || die "$VIKIX_DIR couldn't go back to main (git checkout main failed, above)"
  [ "$DRY_RUN" = 1 ] || rm -f "$f"
}
# try_desk WORD: the desk's folder, from a folder, a topic or a branch;
# none: the repository this shell is in, which must not be the project's own folder.
try_desk() {
  local word=$1 top own hits
  if [ -z "$word" ]; then
    top=$(git rev-parse --show-toplevel 2>/dev/null) ||
      die "this folder isn't a repository: name the desk (vikix try DESK; vikix agents desks lists them), or run it from one"
    own=$(git -C "$top" worktree list --porcelain | awk '/^worktree /{print substr($0, 10); exit}')
    [ "$(readlink -f "$top")" != "$(readlink -f "$own")" ] ||
      die "$top is the project's own folder, not a desk: vikix try DESK (vikix agents desks lists them)"
    printf '%s\n' "$top"
    return 0
  fi
  if [ -d "$word" ]; then
    top=$(git -C "$word" rev-parse --show-toplevel 2>/dev/null) || die "$word isn't a repository"
    printf '%s\n' "$top"
    return 0
  fi
  hits=$(python3 "$VIKIX_DIR/bin/vikix-agents" desks 2>/dev/null |
    awk -F'\t' -v w="$word" '{ n = split($1, p, "/"); last = p[n] }
      $2 == w || last == w || substr(last, length(last) - length(w)) == "-" w { print $1 }')
  [ -n "$hits" ] || die "no desk called $word: vikix agents desks lists them (a folder, a topic or a branch)"
  [ "$(wc -l <<<"$hits")" = 1 ] || die "$word is several desks, say which: $(paste -sd' ' <<<"$hits")"
  printf '%s\n' "$hits"
}
cmd_try() {
  local a word='' off='' desk changes commit branch f
  while [ "$#" -gt 0 ]; do
    a=$1; shift
    case $a in
      -h|--help|help) try_help; return 0 ;;
      status) try_status; return 0 ;;
      off) off=1 ;;
      -*) die "vikix try [DESK|off|status] (vikix try help)" ;;
      *) [ -z "$word" ] || die "one desk at a time: vikix try DESK"; word=$a ;;
    esac
  done
  f=$(try_file)
  if [ -n "$off" ]; then
    [ -z "$word" ] || die "vikix try off takes no desk"
    if [ ! -f "$f" ] && git -C "$VIKIX_DIR" symbolic-ref -q HEAD >/dev/null 2>&1; then
      say "the desktop runs main already (Vikix $(cat "$VIKIX_DIR/VERSION")); nothing to do"
      return 0
    fi
    set_aside_local_changes "$VIKIX_DIR"
    try_back
    exec "$VIKIX_DIR/bin/vikix" update --pulled core
  fi
  desk=$(try_desk "$word")
  git -C "$desk" cat-file -e HEAD:bin/vikix 2>/dev/null ||
    die "$desk isn't a Vikix repository (no bin/vikix at its last commit)"
  changes=$(git -C "$desk" status --porcelain 2>/dev/null) || changes=''
  [ -z "$changes" ] ||
    die "$(wc -l <<<"$changes") file(s) uncommitted at $desk aren't taken: commit them there first, then vikix try again"
  commit=$(git -C "$desk" rev-parse HEAD)
  branch=$(git -C "$desk" rev-parse --abbrev-ref HEAD)
  [ ! -f "$f" ] || say "replacing the try of $(head -n 1 "$f")"
  set_aside_local_changes "$VIKIX_DIR"
  say "the desktop takes $desk: $branch at ${commit:0:7}, not main (vikix try off, or vikix update core, puts main back)"
  # From the desk's folder, a repository of its own as far as git is concerned.
  run git -C "$VIKIX_DIR" fetch -q "$desk" HEAD || die "couldn't fetch $desk's commit into $VIKIX_DIR"
  run git -C "$VIKIX_DIR" checkout -q --detach FETCH_HEAD || die "$VIKIX_DIR couldn't take ${commit:0:7} (git checkout failed, above)"
  if [ "$DRY_RUN" = 1 ]; then
    printf '   would note the try in %s\n' "$f"
  else
    mkdir -p "$(dirname "$f")"
    printf '%s\n%s\n%s\n%s\n' "$desk" "$commit" "$branch" "$(date '+%Y-%m-%d %H:%M')" > "$f"
  fi
  # The steps, from the copy of this script the desk's commit brought.
  exec "$VIKIX_DIR/bin/vikix" update --pulled core
}

cmd_update() {
  local a pulled='' part=all from=''
  while [ "$#" -gt 0 ]; do
    a=$1; shift
    case $a in
      --pulled) pulled=1 ;;
      --back) exec "$VIKIX_DIR/bin/vikix-rollback" restore "$@" ;;
      --from) from=${1:-}; [ "$#" -gt 0 ] && shift; [ -n "$from" ] || die "--from needs a folder: vikix update core --from ~/src/vikix" ;;
      --from=*) from=${a#--from=} ;;
      ''|all) ;;
      core|system|tools|check) part=$a ;;
      -h|--help|help) update_help; return 0 ;;
      *) die "vikix update [core|system|tools|check] [--from DIR] (vikix update help)" ;;
    esac
  done
  # The check a core update ends with, and vikix update check by itself:
  # that the StumpWM image starts (asked without a screen, as 30-lisp asks a
  # new one; the next login would find out otherwise), that Vikix's links
  # point into this checkout, and what the doctor finds. The first two are
  # the update's own doing, so they fail it; the doctor's findings can be
  # older than the update, so they are said, counted, and left to it.
  # DESIGN-dependable.md 1 and 5; Desktop 1.0's gate A.
  update_check() {
    local image="$HOME/.local/bin/stumpwm" bad=0 links=0 l out found n
    if [ "$DRY_RUN" = 1 ]; then
      printf '   would check: %s\n' "the StumpWM image starts, the links point into $VIKIX_DIR, vikix doctor"
      return 0
    fi
    if [ ! -x "$image" ]; then
      warn "no StumpWM image at $image (vikix rebuild-wm builds it)"; bad=1
    elif [ ! -f "$VIKIX_STATE/stumpwm-built" ]; then
      # An image from before 0.72.134 doesn't know the question and would
      # try to start a desktop; it is left alone, and the next one knows.
      say "the StumpWM image is from before Vikix could ask it whether it starts: vikix rebuild-wm, once, and every update after that asks"
    elif out=$(env -u DISPLAY VIKIX_WM_CHECK=1 timeout --kill-after=5s 60s "$image" 2>&1) && grep -q 'stumpwm image ok' <<<"$out"; then
      say "the StumpWM image starts"
    else
      warn "the StumpWM image at $image doesn't start: vikix rebuild-wm makes a new one$([ -x "$image.prev" ] && echo '; the one before is kept as stumpwm.prev, and the session starts it when this one dies at login')"; bad=1
    fi
    for l in "$HOME/.stumpwm.d/init.lisp" "$HOME/.local/bin/vikix" "$HOME/.xinitrc"; do
      case $(readlink -f -- "$l" 2>/dev/null) in
        "$VIKIX_DIR"/*) ;;
        *) warn "$l isn't Vikix's link into $VIKIX_DIR (40-config makes it: vikix update core)"; links=1 ;;
      esac
    done
    [ "$links" = 1 ] && bad=1 || say "Vikix's links point into $VIKIX_DIR"
    # VIKIX_DOCTOR: a stand-in for the tests, which have no desktop to ask.
    local -a doctor=("$VIKIX_DIR/bin/vikix" doctor)
    [ -n "${VIKIX_DOCTOR:-}" ] && doctor=("$VIKIX_DOCTOR")
    if out=$(timeout --kill-after=5s 120s "${doctor[@]}" 2>&1); then
      say "the doctor finds all good"
    else
      found=$(printf '%s\n' "$out" | sed 's/\x1b\[[0-9;]*m//g' | sed -n 's/^!! //p' | grep -vx 'see above' || true)
      n=$(printf '%s\n' "$found" | grep -c . || true)
      warn "the doctor finds $n thing(s) to see to (vikix doctor):"
      printf '%s\n' "$found" | sed 's/^/     /'
    fi
    [ "$bad" = 0 ]
  }
  if [ "$part" = check ]; then
    update_check
    return
  fi
  if [ -n "$from" ]; then
    [ "$part" = core ] || die "--from goes with core: vikix update core --from $from"
    git -C "$from" rev-parse --verify -q main >/dev/null 2>&1 ||
      die "$from isn't a Vikix repository with a main branch"
    from=$(cd "$from" && pwd)
  fi
  local what="update"; [ "$part" = all ] || what="update $part"
  # gup from a folder that is gone since (a desk its release removed, with
  # your shell still standing in it): every stage's bash would start with
  # "shell-init: getcwd" noise and git refuse to work, though nothing of an
  # update needs the folder it was started from. So go home, once, and say.
  if ! pwd -P >/dev/null 2>&1; then
    cd "$HOME" 2>/dev/null || cd /
    say "the folder this was started from is gone: running from $PWD"
  fi
  drop_keys
  # Everything it prints also goes to a log, like the installer's. Set up
  # once: the run restarted after the pull (below) inherits it.
  if [ -z "${VIKIX_UPDATE_LOG:-}" ]; then
    VIKIX_UPDATE_LOG="$VIKIX_STATE/logs/update-$(date +%Y%m%d-%H%M%S).log"
    export VIKIX_UPDATE_LOG
    mkdir -p "$(dirname "$VIKIX_UPDATE_LOG")"
    exec > >(tee -a "$VIKIX_UPDATE_LOG") 2>&1
    say "Vikix $(cat "$VIKIX_DIR/VERSION"): $what; log: $VIKIX_UPDATE_LOG"
  fi
  sudo_keepalive
  # Only core pulls: system and tools work from the checkout as it is.
  if [ "$part" = all ] || [ "$part" = core ]; then
    if [ -z "$pulled" ]; then
      set_aside_local_changes "$VIKIX_DIR"
      try_back
      # The system as it is, before anything changes: vikix update --back.
      bash "$VIKIX_DIR/bin/vikix-rollback" keep || warn "no record of the system as it is (vikix rollback); carrying on"
      if [ -n "$from" ]; then
        # Your own repository's main, without GitHub: commits you haven't
        # pushed yet. Only a fast-forward, so ~/vikix stays a step of the
        # same history GitHub will have once you push, and the next plain
        # update carries on from there.
        say "pulling Vikix from $from (main), not GitHub"
        run git -C "$VIKIX_DIR" pull --ff-only -q "$from" main ||
          die "$VIKIX_DIR can't fast-forward to $from's main (was main rewritten?); a plain vikix update core pulls from GitHub"
      else
        pull_channel "$VIKIX_DIR"
      fi
      # The pull may have replaced this very script, but bash goes on running
      # the copy it already opened: the steps below would be the OLD version's,
      # and a stage new in this version would be skipped. So start again from
      # the new copy. (Same process, so sudo_keepalive carries on.)
      exec "$VIKIX_DIR/bin/vikix" update --pulled "$part"
    fi
  fi
  if [ "$part" = all ] || [ "$part" = system ]; then
    say "updating Void"
    # xbps refuses every other install until xbps itself is current.
    run sudo xbps-install -Syu xbps
    # The packages about to change, as they are, into the record (vikix
    # update --back puts them back from there). A system-only update has
    # no record of its own yet: one is made first.
    if [ "$part" = system ]; then
      bash "$VIKIX_DIR/bin/vikix-rollback" keep || warn "no record of the system as it is (vikix rollback); carrying on"
    fi
    bash "$VIKIX_DIR/bin/vikix-rollback" keep packages || warn "the packages about to change weren't kept (vikix rollback); carrying on"
    run sudo xbps-install -Su
  fi
  # One failed stage (a network hiccup in 45-editors, say) must not keep
  # the rest, or the migrations, from running: carry on, and report at
  # the end, as part two of the install does. Core's 10-packages installs
  # only what's new to the lists (it updates nothing else of Void's), so a
  # release that needs a new program still works after a core update.
  # Features you have but never chose (installed by hand) become choices,
  # so 10-packages keeps their packages and vikix remove knows them.
  if [ "$part" = all ] || [ "$part" = core ]; then
    local found=()
    mapfile -t found < <(installed_features 2>/dev/null)
    if [ "${#found[@]}" -gt 0 ]; then
      say "already installed, now kept as your features: ${found[*]}"
      record_features "${found[@]}"
    fi
  fi
  local stage stages=() failed=()
  case $part in
    all)   stages=(10-packages 20-services 40-config 45-editors 65-languages 67-dev) ;;
    core)  stages=(10-packages 20-services 40-config) ;;
    tools) stages=(45-editors 65-languages 67-dev) ;;
  esac
  for stage in "${stages[@]}"; do
    say "stage $stage"
    bash "$VIKIX_DIR/install/$stage.sh" || { warn "stage $stage failed; carrying on"; failed+=("$stage"); }
  done
  if [ "$part" = all ] || [ "$part" = core ]; then
    cmd_migrate
    # The wallpapers (vikix add wallpapers) are a clone of their own, beside
    # the checkout: new pictures come with Vikix's own pull. A failed pull
    # only warns; the pictures already here stay.
    if is_chosen wallpapers; then
      bash "$VIKIX_DIR/bin/vikix-wallpapers" update || true
    fi
    # Plugins (vikix plugin add) live at a pinned commit too: a release that
    # moves the pin fetches it here. Nothing to do without plugins.
    bash "$VIKIX_DIR/bin/vikix-plugin" sync >/dev/null || failed+=("plugins")
    # Esploro (vikix add esploro) is built from a pinned commit: a release
    # that moves the pin builds the new one here; otherwise nothing to do.
    if is_chosen esploro; then
      bash "$VIKIX_DIR/bin/vikix-esploro" setup || failed+=("esploro")
    fi
    # Cuis (vikix add cuis): a release that moves the pin fetches it, one
    # that changes Vikix's packages builds the image again; else nothing.
    if is_chosen cuis; then
      bash "$VIKIX_DIR/bin/vikix-cuis" setup || failed+=("cuis")
    fi
  fi
  if [ "$part" = all ] || [ "$part" = tools ]; then
    # llm (vikix ai llm) is installed with uv, outside the stages: bring it
    # to the pinned version when it's here and isn't.
    if [ "$DRY_RUN" = 1 ]; then
      printf '   would run: %s\n' "vikix ai llm --refresh  # llm to its pinned version, if installed"
    else
      bash "$VIKIX_DIR/bin/vikix-local-ai" llm --refresh || warn "couldn't update llm; vikix ai llm tries again"
    fi
    upgrade_user_tools
  fi
  # So the bar stops showing the updates that were just installed.
  [ "$DRY_RUN" = 1 ] || "$VIKIX_DIR/bin/vikix-updates" >/dev/null 2>&1 || true
  # StumpWM keeps its config in memory, so the new files on disk (keys, the
  # bar, the menu) change nothing until it loads them again. Reload it now;
  # if it can't be reached, the next login loads them.
  if [ "$part" = all ] || [ "$part" = core ]; then
    if [ "$DRY_RUN" = 1 ]; then
      printf '   would run: %s\n' "vikix eval '(vikix-reload)'  # reload StumpWM, saying the version it then runs"
    elif python3 "$VIKIX_DIR/bin/vikix-eval" '(vikix-reload)' >/dev/null 2>&1; then
      say "StumpWM reloaded: the new keys, bar and menu are in use"
    else
      warn "couldn't reach StumpWM to reload it; the new keys, bar and menu start at the next login (or Super+m, Reload config)"
    fi
  fi
  # Said again at the end, where it's seen: the warning was 400 lines up.
  if [ -n "${VIKIX_SET_ASIDE:-}" ]; then
    warn "changes made in the checkout were set aside before this update: less $VIKIX_SET_ASIDE"
  fi
  # After vikix try: what runs is a desk's work, not a release.
  if [ "$part" = core ] && [ -f "$(try_file)" ]; then
    warn "$(try_status)"
  fi
  # The docs catalogue (vikix docs, Super+F2) reads again what changed: the
  # man pages and manuals of the packages this update brought, the guides.
  [ "$DRY_RUN" = 1 ] || python3 "$VIKIX_DIR/bin/vikix-docs" index --quiet >/dev/null 2>&1 || true
  # Before the update is called a success: the image, the links, the doctor.
  local checked=1
  if [ "$part" = all ] || [ "$part" = core ]; then
    say "checking the update"
    update_check || checked=0
  fi
  if [ "${#failed[@]}" -gt 0 ]; then
    warn "these stages failed: ${failed[*]}. Fix them, then: vikix $what (log: $VIKIX_UPDATE_LOG)"
    echo "   Not sure how? vikix diagnose asks your AI agent; vikix debug writes a report to attach to an issue."
    return 1
  fi
  if [ "$checked" = 0 ]; then
    warn "Vikix $(cat "$VIKIX_DIR/VERSION") is installed, but the check found a problem (above). vikix update --back puts the system back as it was; log: $VIKIX_UPDATE_LOG"
    return 1
  fi
  case $part in
    all)    say "Vikix $(cat "$VIKIX_DIR/VERSION") is up to date; log: $VIKIX_UPDATE_LOG" ;;
    core)   say "Vikix $(cat "$VIKIX_DIR/VERSION") is up to date (Void's packages and the tools weren't touched: vikix update system, vikix update tools); log: $VIKIX_UPDATE_LOG" ;;
    system) say "Void's packages are up to date; log: $VIKIX_UPDATE_LOG" ;;
    tools)  say "the tools are up to date; log: $VIKIX_UPDATE_LOG" ;;
  esac
}

# vikix layout: saved layouts (layouts.lisp), files in ~/.config/vikix/layouts.
cmd_layout() {
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/vikix/layouts" what=${1:-list} name=${2:-}
  name_ok() { [[ $1 =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]{0,39}$ ]] || die "vikix layout: a name is letters, digits, - _ and ."; }
  ask() {   # the Lisp's answer, its own words when it fails
    local out
    local ok=0
    out=$(python3 "$VIKIX_DIR/bin/vikix-eval" "$1" 2>&1) || ok=$?
    # The Lisp's own words when it said no (vikix eval fails then too).
    case $out in *"error:"*) die "vikix layout: $(sed -n 's/.*error: //p' <<<"$out" | head -1)" ;; esac
    [ "$ok" = 0 ] || die "vikix layout: StumpWM didn't answer (vikix doctor)"
    printf '%s\n' "$out" | grep -v '^=> ' || true
  }
  case $what in
    list)  [ -d "$dir" ] && find "$dir" -maxdepth 1 -name '*.lisp' -printf '%f\n' | sed 's/\.lisp$//' | sort ;;
    save)  name_ok "$name"
           ask "(progn (vikix-layout-save \"$name\") (format t \"saved ~a~%\" \"$name\"))" ;;
    rm)    name_ok "$name"; [ -f "$dir/$name.lisp" ] || die "vikix layout: no layout $name"
           rm -f "$dir/$name.lisp"; say "removed layout $name" ;;
    *)     name_ok "$what"
           local start=t
           [ "$name" = --no-start ] && start=nil
           ask "(multiple-value-bind (missing started) (vikix-layout-restore \"$what\" (current-group) :start $start) (format t \"~a~%\" (vikix-layout-said \"$what\" missing started)))" ;;
  esac
}

# --- Snapshots of your files -----------------------------------------------
# Your files (config/yours.list names them) are kept in a git repository
# of their own, $VIKIX_STATE/yours.git, whose work tree is your home
# folder. Nothing is added to ~ itself: no .git folder appears anywhere.
# Every change an AI agent (or you) makes to them can then be seen with
# `vikix changes` and taken back with `vikix undo`.

YOURS_GIT="$VIKIX_STATE/yours.git"

# From ~ itself: git reads the current folder even with both given, so from
# a folder that is gone (vikix update after a release removed the desk you
# stood in) it failed: "Unable to read current working directory".
yours_git() { git -C "$HOME" --git-dir="$YOURS_GIT" --work-tree="$HOME" "$@"; }

yours_init() {
  [ -d "$YOURS_GIT" ] && return 0
  say "starting the history of your files in $YOURS_GIT"
  run mkdir -p "$VIKIX_STATE"
  run git init -q --bare "$YOURS_GIT"
  # Commits here are Vikix's bookkeeping, so they don't need (or change)
  # your own git name.
  run yours_git config user.name "Vikix"
  run yours_git config user.email "vikix@localhost"
  # `git status` in this repo would otherwise list every file in ~.
  run yours_git config status.showUntrackedFiles no
  yours_exclude
}

# What the history never keeps, whatever yours.list says: Vikix's own links,
# things that change by themselves, and your API keys (vikix ai key). Written
# at every snapshot, so a machine whose history began before a line was
# added gets it too.
yours_exclude() {
  [ "$DRY_RUN" = 1 ] && return 0
  cat > "$YOURS_GIT/info/exclude" <<'EXCLUDE'
/.stumpwm.d/init.lisp
/.stumpwm.d/vikix
/.stumpwm.d/modules/
/.stumpwm.d/*.log*
/.stumpwm.d/history
/.config/vikix/secrets/
/music/*
!/music/*/
/music/*/*
!/music/*/patterns.lisp
/cuis/*.image
/cuis/*.changes
/cuis/*.sources
/cuis/Logs/
/cuis/UserChanges/
/cuis/.build/
*.vikix-bak.*
*.fasl
*~
EXCLUDE
}

# Stage every file of yours as it is now: changed, new and deleted ones.
yours_stage() {
  local p
  yours_exclude
  while IFS= read -r p; do
    # A line naming the keys' folder, or a file in it, is skipped outright
    # (git would refuse an excluded path named on its own).
    case /${p%/}/ in /.config/vikix/secrets/*) warn "yours.list names $p; API keys are never kept in the history"; continue ;; esac
    # A git clone (a Neovim config of your own) keeps its own history, and
    # git can't take it in: it would record a pointer, or fail the snapshot.
    [ -e "$HOME/$p/.git" ] && continue
    if [ -e "$HOME/$p" ]; then yours_git add -A -- "$HOME/$p"; fi
  done < <(read_list "$VIKIX_DIR/config/yours.list")
  yours_git add -u    # files that were recorded and are now gone
}

has_snapshot() { yours_git rev-parse -q --verify HEAD >/dev/null 2>&1; }

cmd_snapshot() {
  local message=${1:-snapshot}
  yours_init
  if [ "$DRY_RUN" = 1 ]; then
    printf '   would record your files: %s\n' "$message"; return 0
  fi
  yours_stage
  if has_snapshot && yours_git diff --cached --quiet; then
    say "your files haven't changed since snapshot $(yours_git rev-parse --short HEAD)"
    return 0
  fi
  yours_git commit -q -m "$message"
  say "snapshot $(yours_git rev-parse --short HEAD): $message"
}

cmd_changes() {
  has_snapshot || die "no snapshots yet (vikix snapshot makes one)"
  if [ -n "${1:-}" ]; then
    yours_git show --stat --patch "$1"
    return
  fi
  yours_stage
  if yours_git diff --cached --quiet; then
    say "nothing has changed since snapshot $(yours_git rev-parse --short HEAD)"
  else
    yours_git diff --cached --stat
    yours_git diff --cached
  fi
}

cmd_history() {
  has_snapshot || die "no snapshots yet (vikix snapshot makes one)"
  yours_git log --date=format:'%Y-%m-%d %H:%M' --format='%h  %ad  %s'
}

# The help for the four commands of the history, from the top of this file.
history_help() {
  sed -n 's/^#   \(vikix \(snapshot\|changes\|history\|undo\) .*\)/\1/p' "$0"
  echo "An agent's start (Super+a, vikix agent, an editor's) takes a snapshot too: vikix history lists them all."
}

cmd_undo() {
  local target=${1:-} f
  has_snapshot || die "no snapshots yet, so nothing to undo"
  [ "$DRY_RUN" = 1 ] && { printf '   would put your files back to %s\n' "${target:-the previous snapshot}"; return 0; }
  # The target is checked before the snapshot below, so a mistyped one
  # leaves no "before undo" in the history.
  if [ -z "$target" ]; then
    yours_git rev-parse -q --verify HEAD~1 >/dev/null ||
      die "there is only one snapshot, so there is nothing before it to go back to"
    target=HEAD~1
  fi
  yours_git rev-parse -q --verify "$target^{commit}" >/dev/null ||
    die "no snapshot called $target (vikix history lists them)"
  local label changed
  label="$(yours_git rev-parse --short "$target") ($(yours_git log -1 --format=%s "$target"))"
  # In a terminal, say what it will change, and ask: the snapshot one back
  # may be an agent's start, not the one you had in mind.
  yours_stage
  changed=$(yours_git diff --cached --name-only "$target" || true)
  if [ -t 0 ] && [ -t 1 ]; then
    if [ -z "$changed" ]; then
      say "your files are already as they were at snapshot $label"; return 0
    fi
    say "back to snapshot $label, from $(yours_git log -1 --date=format:'%Y-%m-%d %H:%M' --format=%ad "$target"). It changes:"
    sed 's/^/     ~\//' <<<"$changed"
    local answer
    read -r -p "Put these back? [y/N] " answer
    case $answer in y|Y|yes) ;; *) say "nothing changed (vikix history lists the snapshots; vikix undo ID goes to one)"; return 0 ;; esac
  fi
  # Record the files as they are first, so the undo can itself be undone.
  cmd_snapshot "before undo"
  # Files that were added after the target snapshot are removed; they
  # stay in the history, so `vikix undo` again brings them back.
  while IFS= read -r -d '' f; do
    rm -f -- "${HOME:?}/$f"
  done < <(yours_git diff --name-only --diff-filter=A -z "$target" HEAD)
  yours_git checkout "$target" -- ':/'
  yours_stage
  yours_git commit -q --allow-empty -m "undo: back to $label"
  say "your files are as they were at snapshot $label"
  say "to take this back too: vikix undo"
  say "StumpWM keeps the old settings until it reloads: Super+m, then Reload config"
}

# --- The agent --------------------------------------------------------------
# bin/vikix-agent: Claude Code or another agent, after a snapshot.

# Everything runs inside main, and main is the last thing in the file.
# Bash reads a script as it goes, and `vikix update` pulls a new copy
# of this very file while it runs. Parsed whole before it starts, main
# can't be changed under our feet; the final `exit` keeps bash from
# reading whatever the pull put after it.
# --- Less typing: vk, prefixes, completion --------------------------------------
# `vk` is a second name for this command (40-config links it). A command can
# be given by the start of its name when only one begins so (vk upd is vikix
# update), and so can a subcommand of the scripts it hands over to (vk doc f
# runit is vikix docs find runit); the lists come from this file's own
# dispatch and from each script's header, so they can't drift. Tab
# completion (vikix.bash) asks `vikix __complete` for the same lists.

vikix_commands() {   # every command main knows, one a line
  awk '/^main\(\) \{/ {on = 1; next} on && /^\}/ {exit}
       on && match($0, /^    [a-z][a-z|-]*\)/) {
         s = substr($0, 5, RLENGTH - 5); n = split(s, w, "|"); for (i = 1; i <= n; i++) print w[i] }' \
    "$VIKIX_DIR/bin/vikix" | grep -vx -e help -e __complete -e '-.*' | sort -u
}

vikix_script_of() {   # the bin/ script a command hands over to, if any
  awk -v c="$1" '/^main\(\) \{/ {on = 1; next} on && /^\}/ {exit}
       on && match($0, /^    [a-z][a-z|-]*\)/) {
         s = substr($0, 5, RLENGTH - 5); n = split(s, w, "|")
         for (i = 1; i <= n; i++) if (w[i] == c) { if (match($0, /bin\/vikix-[a-z-]+/)) print substr($0, RSTART, RLENGTH); exit } }' \
    "$VIKIX_DIR/bin/vikix"
}

vikix_subcommands() {   # the words a command takes next, from the headers' usage lines
  local cmd=$1 script f
  script=$(vikix_script_of "$cmd")
  for f in "$VIKIX_DIR/bin/vikix" ${script:+"$VIKIX_DIR/$script"}; do
    head -n 80 "$f"
  # A usage line, not prose: vikix CMD a few spaces in, at most.
  done | grep -oE "^#? {1,4}vikix $cmd [^ ]+" | awk '{print $NF}' | tr -d '[]' | tr '|' '\n' |
    grep -E '^[a-z][a-z0-9-]*$' | sort -u
}

vikix_resolve() {   # vikix_resolve [--nested] WORD CANDIDATES...: the one WORD names, or why not
  # --nested: version and versions both fit "vers"; the shorter is meant,
  # when it starts every other hit, since the longer can still be typed
  # whole. For a command's name only: a word after it that fits several
  # may be a name of the user's, and is left alone (vikix_expand).
  local nested=0 word c hits=()
  [ "$1" = --nested ] && { nested=1; shift; }
  word=$1
  shift
  for c in "$@"; do [ "$c" = "$word" ] && { echo "$word"; return 0; }; done
  for c in "$@"; do [[ $c == "$word"* ]] && hits+=("$c"); done
  if [ "${#hits[@]}" -eq 1 ]; then echo "${hits[0]}"; return 0; fi
  if [ "${#hits[@]}" -gt 1 ]; then
    if [ "$nested" = 1 ]; then
      local shortest=${hits[0]} all=1
      for c in "${hits[@]}"; do [ "${#c}" -lt "${#shortest}" ] && shortest=$c; done
      for c in "${hits[@]}"; do [[ $c == "$shortest"* ]] || all=0; done
      [ "$all" = 1 ] && { echo "$shortest"; return 0; }
    fi
    echo "${hits[*]}"; return 2
  fi
  return 1
}

vikix_complete() {   # vikix __complete INDEX WORDS-BEFORE...: what may come at INDEX
  local index=$1 cmd sub
  shift
  if [ "$index" -le 1 ]; then vikix_commands; return; fi
  local all words
  mapfile -t all < <(vikix_commands)
  cmd=$(vikix_resolve --nested "$1" "${all[@]}") || return 0
  sub=${2:-}
  mapfile -t words < <(vikix_subcommands "$cmd")
  [ -n "$sub" ] && [ "$index" -ge 3 ] && sub=$(vikix_resolve "$sub" "${words[@]}") || true
  case $cmd:$index in
    theme:2)            vikix_subcommands theme; "$VIKIX_DIR/bin/vikix-theme" names ;;
    add:2|remove:2)     awk -F'|' '!/^[[:space:]]*#/ && NF > 1 {gsub(/ /, "", $1); print $1}' "$VIKIX_DIR/features.list" ;;
    plugin:3|plugins:3) [ "$sub" = add ] || [ "$sub" = remove ] || [ "$sub" = off ] || [ "$sub" = on ] || [ "$sub" = pin ] &&
                          { for d in "${XDG_DATA_HOME:-$HOME/.local/share}"/vikix/plugins/*/manifest; do
                              [ -e "$d" ] && basename "$(dirname "$d")"; done
                            for d in "${XDG_DATA_HOME:-$HOME/.local/share}"/vikix/plugins-from/*/; do
                              [ -d "$d" ] && basename "$d"; done; } ;;
    project:3|projects:3) ls "$HOME/src" 2>/dev/null ;;
    *:2)                vikix_subcommands "$cmd" ;;
  esac
}

vikix_expand() {   # the arguments, a command's and a subcommand's names made whole
  local word whole cmd all words
  [ "$#" -gt 0 ] || return 0
  case $1 in -*|__complete) printf '%s\0' "$@"; return ;; esac
  mapfile -t all < <(vikix_commands)
  if whole=$(vikix_resolve --nested "$1" "${all[@]}"); then
    cmd=$whole
  elif [ $? = 2 ]; then
    echo "vikix: \"$1\" could be: $whole" >&2; exit 2
  else
    cmd=$1                                  # unknown: main says so
  fi
  shift
  printf '%s\0' "$cmd"
  # The next word, when it starts exactly one of the command's own words. A
  # word that starts none, or several, is left as it is: it may be a name
  # (a theme, a feature, a message).
  if [ "$#" -gt 0 ] && [[ $1 != -* ]]; then
    word=$1
    mapfile -t words < <(vikix_subcommands "$cmd")
    if whole=$(vikix_resolve "$word" "${words[@]}"); then word=$whole; fi
    shift
    printf '%s\0' "$word"
  fi
  [ "$#" -gt 0 ] && printf '%s\0' "$@"
  return 0
}

main() {
  case ${1:-help} in
    __complete)  shift; vikix_complete "$@" ;;
    update)      shift; cmd_update "$@" ;;
    try)         shift; cmd_try "$@" ;;
    rollback)    shift; exec "$VIKIX_DIR/bin/vikix-rollback" "$@" ;;
    migrate)     cmd_migrate ;;
    rebuild-wm)  VIKIX_REBUILD_WM=1 bash "$VIKIX_DIR/install/30-lisp.sh" ;;
    docs)        shift; exec python3 "$VIKIX_DIR/bin/vikix-docs" "$@" ;;
    doctor)      shift; exec "$VIKIX_DIR/bin/vikix-doctor" "$@" ;;
    features)    exec "$VIKIX_DIR/bin/vikix-features" list ;;
    add|remove)  exec "$VIKIX_DIR/bin/vikix-features" "$@" ;;
    welcome)     shift; exec "$VIKIX_DIR/bin/vikix-welcome" "$@" ;;
    pkg)         shift; exec "$VIKIX_DIR/bin/vikix-pkg" "$@" ;;
    version|-v|--version) cat "$VIKIX_DIR/VERSION" ;;
    eval)        shift; exec python3 "$VIKIX_DIR/bin/vikix-eval" "$@" ;;
    layout)      shift; cmd_layout "$@" ;;
    rules)       shift; exec "$VIKIX_DIR/bin/vikix-rules" "$@" ;;
    why)         shift; exec "$VIKIX_DIR/bin/vikix-why" "$@" ;;
    door)        shift; exec "$VIKIX_DIR/bin/vikix-door" "$@" ;;
    what)        shift; exec python3 "$VIKIX_DIR/bin/vikix-what" "$@" ;;
    viri)        shift
                 case ${1:-} in ''|on|off) ;; *) die "vikix viri: on, off, or nothing to switch" ;; esac
                 python3 "$VIKIX_DIR/bin/vikix-eval" "(run-commands \"vikix-viri ${1:-}\")" >/dev/null ||
                   die "vikix viri: StumpWM didn't answer (vikix doctor)" ;;
    agent)       shift; exec "$VIKIX_DIR/bin/vikix-agent" "$@" ;;
    agents)      shift; exec python3 "$VIKIX_DIR/bin/vikix-agents" "$@" ;;
    grok)        shift; exec python3 "$VIKIX_DIR/bin/vikix-grok" "$@" ;;
    debug|diagnose) exec "$VIKIX_DIR/bin/vikix-debug" "$@" ;;
    dictate)     shift; exec "$VIKIX_DIR/bin/vikix-dictate" "$@" ;;
    lisp-apps)   shift; exec "$VIKIX_DIR/bin/vikix-lisp-apps" "$@" ;;
    esploro)     shift; exec "$VIKIX_DIR/bin/vikix-esploro" "$@" ;;
    music)       shift; exec "$VIKIX_DIR/bin/vikix-music" "$@" ;;
    cuis)        shift; exec "$VIKIX_DIR/bin/vikix-cuis" "$@" ;;
    plugin|plugins) shift; exec "$VIKIX_DIR/bin/vikix-plugin" "$@" ;;
    records)     shift; exec "$VIKIX_DIR/bin/vikix-records" "$@" ;;
    screens)     shift; exec "$VIKIX_DIR/bin/vikix-screens" "$@" ;;
    wifi)        shift; exec "$VIKIX_DIR/bin/vikix-wifi" "$@" ;;
    network)     shift; exec "$VIKIX_DIR/bin/vikix-network" "$@" ;;
    nodes)       shift; exec "$VIKIX_DIR/bin/vikix-node" list "$@" ;;
    node)        shift; exec "$VIKIX_DIR/bin/vikix-node" "$@" ;;
    memory)      shift; exec "$VIKIX_DIR/bin/vikix-memory" "$@" ;;
    times)       shift; exec "$VIKIX_DIR/bin/vikix-times" "$@" ;;
    used)        shift; exec "$VIKIX_DIR/bin/vikix-used" "$@" ;;
    rescue)      shift; exec "$VIKIX_DIR/bin/vikix-rescue" "$@" ;;
    resume)      shift; exec "$VIKIX_DIR/bin/vikix-resume" "$@" ;;
    tray)        shift
                 # Alone it switches, like Super+m's Tray: vikix-tray in modeline.lisp
                 # is the toggle, vikix-tray-on and -off the two ends.
                 case ${1:-} in
                   '') python3 "$VIKIX_DIR/bin/vikix-eval" "(run-commands \"vikix-tray\")" >/dev/null ||
                         die "vikix tray: StumpWM didn't answer (vikix doctor)" ;;
                   on|off) python3 "$VIKIX_DIR/bin/vikix-eval" "(run-commands \"vikix-tray-$1\")" >/dev/null ||
                         die "vikix tray $1: StumpWM didn't answer (vikix doctor)" ;;
                   status) echo "the tray in the bar, for the network and Bluetooth applets' icons"
                      echo "  (the applets it starts: applets = in ~/.config/vikix/tray)"
                      grep -qx on "${XDG_CONFIG_HOME:-$HOME/.config}/vikix/tray" 2>/dev/null && echo "now: on" || echo "now: off" ;;
                   *) die "vikix tray: on, off, status, or nothing to switch" ;;
                 esac ;;
    obsidian)    shift; exec "$VIKIX_DIR/bin/vikix-obsidian" "$@" ;;
    bitwarden)   shift; exec "$VIKIX_DIR/bin/vikix-bitwarden" "$@" ;;
    voice)       shift; exec "$VIKIX_DIR/bin/vikix-voice" "$@" ;;
    notes)       shift; exec "$VIKIX_DIR/bin/vikix-notes" "$@" ;;
    project|projects) shift; exec "$VIKIX_DIR/bin/vikix-project" "$@" ;;
    today)       shift; exec "$VIKIX_DIR/bin/vikix-project" today "$@" ;;
    day)         shift; exec "$VIKIX_DIR/bin/vikix-day" "$@" ;;
    back)        shift; exec "$VIKIX_DIR/bin/vikix-back" "$@" ;;
    gestures)    shift; exec "$VIKIX_DIR/bin/vikix-gestures" "$@" ;;
    mcp)         shift; exec "$VIKIX_DIR/bin/vikix-mcp" "$@" ;;
    snapshot|changes|history|undo)
      case ${2:-} in -h|--help) history_help; exit 0 ;; esac
      case $1 in
        snapshot) case ${2:-} in -*) die "a snapshot's message can't start with - (vikix snapshot --help)" ;; esac
                  cmd_snapshot "${2:-snapshot}" ;;
        changes)  cmd_changes "${2:-}" ;;
        history)  cmd_history ;;
        undo)     cmd_undo "${2:-}" ;;
      esac ;;
    theme)       shift; exec "$VIKIX_DIR/bin/vikix-theme" "$@" ;;
    backup)      shift; exec "$VIKIX_DIR/bin/vikix-backup" "$@" ;;
    versions)    shift; exec "$VIKIX_DIR/bin/vikix-versions" "$@" ;;
    restore)     shift; exec "$VIKIX_DIR/bin/vikix-versions" restore "$@" ;;
    firmware)    shift; exec "$VIKIX_DIR/bin/vikix-firmware" "$@" ;;
    windows)     shift; exec "$VIKIX_DIR/bin/vikix-windows" "$@" ;;
    vm|vms)      shift; exec "$VIKIX_DIR/bin/vikix-vm" "$@" ;;
    steam)       shift; exec "$VIKIX_DIR/bin/vikix-steam" "$@" ;;
    ai)          shift; exec "$VIKIX_DIR/bin/vikix-ai" "$@" ;;
    webapp|webapps) shift; exec "$VIKIX_DIR/bin/vikix-webapp" "$@" ;;
    fingerprint) shift; exec "$VIKIX_DIR/bin/vikix-fingerprint" "$@" ;;
    hype)        shift; exec "$VIKIX_DIR/bin/vikix-hype" "$@" ;;
    publish)     shift; exec "$VIKIX_DIR/bin/vikix-publish" "$@" ;;
    learn)       shift; exec "$VIKIX_DIR/bin/vikix-learn" "$@" ;;
    wallpapers)  shift; exec "$VIKIX_DIR/bin/vikix-wallpapers" "$@" ;;
    firewall)    shift; exec "$VIKIX_DIR/bin/vikix-firewall" "$@" ;;
    ledger)      shift; exec "$VIKIX_DIR/bin/vikix-ledger" "$@" ;;
    help|-h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)           die "unknown command: $1 (try: vikix help)" ;;
  esac
}
mapfile -d '' -t vikix_args < <(vikix_expand "$@") || exit 2
[ "$#" -gt 0 ] && [ "${#vikix_args[@]}" -eq 0 ] && exit 2   # an ambiguous start, said above
main "${vikix_args[@]}"
exit
