#!/usr/bin/env bash
# vikix — the everyday command.
#
#   vikix update        pull Vikix, update Void, add new packages and their
#                         services, refresh config links, pull the editor
#                         configs, run new migrations, reload StumpWM
#   vikix migrate       run only the migrations not yet applied
#   vikix rebuild-wm    rebuild the StumpWM executable (after a Quicklisp update)
#   vikix docs          download the offline programming docs into ~/dev
#                         (a few GB, slow; update and the installer skip them)
#   vikix doctor        check the pieces are all there
#   vikix features      what you can add (languages, editors, LibreOffice,
#                         printing, Windows, local AI ...), and what you have
#   vikix add NAME...   add features, or a bundle (essentials, developer,
#                         everything); every update keeps them
#   vikix remove NAME...  stop keeping them, and uninstall what only they
#                         needed (it shows the list and asks first)
#   vikix pkg add|drop|list   single programs: search and install, or
#                         uninstall (and keep out); vikix pkg help
#   vikix welcome [add] the first steps (it opens by itself at the first
#                         login): add software, keys, theme, keyboard, guide
#   vikix theme [NAME]  the colour theme, everywhere: the current one and
#                         the list, or switch to NAME
#   vikix version
#
#   vikix eval FORM     run Lisp in the running StumpWM, print the result
#   vikix debug         one file saying what's going on, secrets taken out, to
#                         attach to an issue
#   vikix diagnose      that report, handed to your AI agent: what's wrong?
#   vikix dictate setup|models|file|status|uninstall
#                         speak, and it types what you said (Super+F9), on this laptop
#   vikix voice setup|say|quiet|new|voices|status|uninstall
#                         talk to the AI (Super+F10) or the agent (Super+F11),
#                         and it answers aloud (Piper, on this laptop)
#   vikix notes setup|uninstall
#                         ask your notes from any terminal: note index ~/Notes,
#                         then note ask "..." (vikix-notes; on this laptop)
#   vikix mcp register|unregister|tools
#                         the desktop as an MCP server, for Claude Code and other agents
#   vikix agent         the AI agent, after a snapshot of your files (alias: a):
#                         Claude Code, or --use opencode|codex|gemini|aider,
#                         --local on this laptop, --default NAME, --list;
#                         --exec [NAME] for editors (stdout is the agent's), --which
#   vikix snapshot [MESSAGE]   record your files as they are now
#   vikix changes [ID]  what changed since the last snapshot (or in snapshot ID)
#   vikix history       the snapshots, newest first
#   vikix undo [ID]     put your files back as they were one snapshot ago (or at ID)
#
#   vikix backup [now]  back up your home folder with restic (vikix backup help:
#                         setup, status, list, restore, check, off)
#   vikix firmware [update]   firmware updates from LVFS (BIOS, Thunderbolt, ...):
#                         what's waiting, or install it (on AC power)
#   vikix fingerprint [on|off|enrol]   a finger for sudo and the lock screen,
#                         where fprintd supports the reader
#   vikix webapp add|open|list|remove    a website as a program of its own
#                         (presets: fastmail, gmail, outlook, outlook-live, superhuman)
#   vikix ai setup|models|chat|list|remove|status|stop|uninstall
#                         AI models that run on this laptop (Ollama)
#   vikix ai llm          the llm command, with those models and your keys
#   vikix ai use [local|claude] the model for Super+i, AI on the selected text
#   vikix ai key set|list|remove|check   API keys (ANTHROPIC_API_KEY ...)
#                         kept safely, out of your dotfiles and their history
#   vikix windows [setup|create ISO|stop|status|network|remove]   Windows in a VM:
#                         set it up once, install it by itself, then open its
#                         desktop in a window (vikix windows help)

set -euo pipefail

# ~/.local/bin/vikix is a symlink; follow it back to the checkout.
VIKIX_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
export VIKIX_DIR
# shellcheck source=../lib/common.sh
. "$VIKIX_DIR/lib/common.sh"
# shellcheck source=../lib/features.sh
. "$VIKIX_DIR/lib/features.sh"

cmd_migrate() {
  run mkdir -p "$VIKIX_STATE/migrations"
  local m id applied=0
  # Migrations are named <unix-time>.sh, so a plain sort is time order.
  for m in "$VIKIX_DIR"/migrations/*.sh; do
    [ -e "$m" ] || continue
    id=$(basename "$m" .sh)
    [ -e "$VIKIX_STATE/migrations/$id" ] && continue
    say "migration $id"
    if [ "$DRY_RUN" = 1 ]; then
      printf '   would run: %s\n' "$m"
    else
      bash "$m" || die "migration $id failed; nothing after it was run"
      touch "$VIKIX_STATE/migrations/$id"
    fi
    applied=$((applied + 1))
  done
  say "$applied new migration(s)"
}

# Changes made in the checkout itself (an edit by hand or by another
# program) stop the pull: git won't overwrite them. Vikix's files are
# replaced by every update anyway, so they're set aside, not deleted: in a
# patch file to read (it can't clash with anything, unlike putting them
# back), and in a git stash, named after the update and its files.
# Editors' leftovers (#file#, file~) are in .gitignore, so they don't count.
set_aside_local_changes() {
  local dir=$1 changes unmerged name files patch hash when
  # A stash put back earlier that clashed with Vikix's files leaves them
  # half merged, with <<<<<<< marks in them: the desktop may not even
  # start like that. That needs a person, not another stash.
  unmerged=$(git -C "$dir" ls-files -u 2>/dev/null | awk '{ print $4 }' | sort -u) || unmerged=''
  if [ -n "$unmerged" ]; then
    warn "Vikix's own files have changes put back into them that clash (<<<<<<< marks):"
    printf '     %s\n' $unmerged
    echo "   The desktop may not start like that. Keep what was there in a file, and put"
    echo "   Vikix's files back as released, then update again:"
    echo "     git -C $dir diff > ~/vikix-clash-$(date +%Y%m%d-%H%M).patch"
    echo "     git -C $dir reset --hard"
    echo "     vikix update"
    exit 1
  fi
  changes=$(git -C "$dir" status --porcelain 2>/dev/null) || return 0
  [ -n "$changes" ] || return 0
  when=$(date +%Y%m%d-%H%M%S)
  files=$(awk '{ print $2 }' <<<"$changes" | head -3 | paste -sd' ')
  name="vikix update $(date '+%Y-%m-%d %H:%M'): $files"
  patch="$VIKIX_STATE/checkout-changes/$when.patch"
  warn "the Vikix checkout, $dir, has changes of its own, which would stop the update:"
  awk -v d="$dir" '{ what = ($1 == "??") ? "new" : "changed"; printf "     %-8s %s/%s\n", what, d, $2 }' <<<"$changes" | head -10
  if [ "$DRY_RUN" = 1 ]; then
    echo "   would set them aside in $patch (and a git stash), then update"
    return 0
  fi
  # The patch first, from the files themselves (git stash show on the new
  # stash sometimes printed a summary instead, and the patch came out empty).
  mkdir -p "$(dirname "$patch")"
  {
    git -C "$dir" diff HEAD
    local f
    while IFS= read -r f; do
      git -C "$dir" diff --no-index -- /dev/null "$f" || true    # 1 means "they differ"
    done < <(git -C "$dir" ls-files --others --exclude-standard)
  } > "$patch" 2>/dev/null
  [ -s "$patch" ] || die "couldn't write the changes to $patch; nothing was changed. See: git -C $dir status"
  git -C "$dir" -c user.name=Vikix -c user.email=vikix@localhost \
    stash push --include-untracked --quiet --message "$name" ||
    die "couldn't set them aside (git stash failed, above); nothing was changed. See: git -C $dir status"
  hash=$(git -C "$dir" rev-parse --short refs/stash)
  echo "   Set aside, not deleted (Vikix's files are replaced by every update anyway):"
  echo "     read them:  less $patch"
  echo "     the same, in git: git -C $dir stash show -p --include-untracked $hash"
  echo "   A change of your own belongs in your own files (~/.stumpwm.d/user.lisp and the"
  echo "   like): see ~/vikix/docs/customize.md, or ask the agent (Super+a) to move it there."
  VIKIX_SET_ASIDE=$patch
  export VIKIX_SET_ASIDE
}

# The pull failed: commits made in the checkout, which Vikix can't update
# over, or (most often) the network. Say which, and what to do.
pull_failed() {
  local dir=$1 ahead
  ahead=$(git -C "$dir" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
  if [ "${ahead:-0}" -gt 0 ]; then
    warn "the Vikix checkout, $dir, has $ahead commit(s) of its own, and Vikix can't update over them."
    echo "   Keep them as patch files, then put the checkout back as released, and update:"
    echo "     git -C $dir format-patch '@{u}' -o ~/vikix-commits-$(date +%Y%m%d-%H%M)"
    echo "     git -C $dir reset --hard '@{u}'"
    echo "     vikix update"
    echo "   (Changing Vikix itself, for good: ~/vikix/docs/customize.md, Changing Vikix itself.)"
  else
    warn "couldn't pull Vikix (the network? GitHub?); nothing was changed. Try again: vikix update"
  fi
  exit 1
}

cmd_update() {
  drop_keys
  # Everything it prints also goes to a log, like the installer's. Set up
  # once: the run restarted after the pull (below) inherits it.
  if [ -z "${VIKIX_UPDATE_LOG:-}" ]; then
    VIKIX_UPDATE_LOG="$VIKIX_STATE/logs/update-$(date +%Y%m%d-%H%M%S).log"
    export VIKIX_UPDATE_LOG
    mkdir -p "$(dirname "$VIKIX_UPDATE_LOG")"
    exec > >(tee -a "$VIKIX_UPDATE_LOG") 2>&1
    say "Vikix $(cat "$VIKIX_DIR/VERSION"): update; log: $VIKIX_UPDATE_LOG"
  fi
  sudo_keepalive
  if [ "${1:-}" != --pulled ]; then
    set_aside_local_changes "$VIKIX_DIR"
    say "pulling Vikix"
    git_pull "$VIKIX_DIR" || pull_failed "$VIKIX_DIR"
    # The pull may have replaced this very script, but bash goes on running
    # the copy it already opened: the steps below would be the OLD version's,
    # and a stage new in this version would be skipped. So start again from
    # the new copy. (Same process, so sudo_keepalive carries on.)
    exec "$VIKIX_DIR/bin/vikix" update --pulled
  fi
  say "updating Void"
  # xbps refuses every other install until xbps itself is current.
  run sudo xbps-install -Syu xbps
  run sudo xbps-install -Su
  # One failed stage (a network hiccup in 45-editors, say) must not keep
  # the rest, or the migrations, from running: carry on, and report at
  # the end, as part two of the install does.
  local stage failed=()
  for stage in 10-packages 20-services 40-config 45-editors 65-languages 67-dev; do
    say "stage $stage"
    bash "$VIKIX_DIR/install/$stage.sh" || { warn "stage $stage failed; carrying on"; failed+=("$stage"); }
  done
  cmd_migrate
  # llm (vikix ai llm) is installed with uv, outside the stages: bring it
  # to the pinned version when it's here and isn't.
  if [ "$DRY_RUN" = 1 ]; then
    printf '   would run: %s\n' "vikix ai llm --refresh  # llm to its pinned version, if installed"
  else
    bash "$VIKIX_DIR/bin/vikix-local-ai" llm --refresh || warn "couldn't update llm; vikix ai llm tries again"
  fi
  # So the bar stops showing the updates that were just installed.
  [ "$DRY_RUN" = 1 ] || "$VIKIX_DIR/bin/vikix-updates" >/dev/null 2>&1 || true
  # StumpWM keeps its config in memory, so the new files on disk (keys, the
  # bar, the menu) change nothing until it loads them again. Reload it now;
  # if it can't be reached, the next login loads them.
  if [ "$DRY_RUN" = 1 ]; then
    printf '   would run: %s\n' "vikix eval '(loadrc)'  # reload StumpWM"
  elif python3 "$VIKIX_DIR/bin/vikix-eval" '(loadrc)' >/dev/null 2>&1; then
    say "StumpWM reloaded: the new keys, bar and menu are in use"
  else
    warn "couldn't reach StumpWM to reload it; the new keys, bar and menu start at the next login (or Super+m, Reload config)"
  fi
  # Said again at the end, where it's seen: the warning was 400 lines up.
  if [ -n "${VIKIX_SET_ASIDE:-}" ]; then
    warn "changes made in the checkout were set aside before this update: less $VIKIX_SET_ASIDE"
  fi
  if [ "${#failed[@]}" -gt 0 ]; then
    warn "these stages failed: ${failed[*]}. Fix them, then: vikix update (log: $VIKIX_UPDATE_LOG)"
    echo "   Not sure how? vikix diagnose asks your AI agent; vikix debug writes a report to attach to an issue."
    return 1
  fi
  say "Vikix $(cat "$VIKIX_DIR/VERSION") is up to date; log: $VIKIX_UPDATE_LOG"
}

cmd_doctor() {
  local ok=1 c sv
  # pam_elogind creates this at login; pipewire and dbus-run-session need it.
  if [ -n "${XDG_RUNTIME_DIR:-}" ]; then say "XDG_RUNTIME_DIR is set"
  else warn "XDG_RUNTIME_DIR is not set (pam_elogind isn't creating sessions)"; ok=0; fi
  # The editors only when chosen (vikix add emacs); the rest is the base.
  local progs=(sbcl stumpwm alacritty rofi picom dunst pipewire i3lock firefox nmtui clipmenu maim restic) dirs=()
  is_chosen emacs  && { progs+=(emacs); dirs+=("$HOME/.emacs.d"); }
  is_chosen neovim && progs+=(nvim)
  for c in "${progs[@]}"; do
    if command -v "$c" >/dev/null 2>&1 || [ -x "$HOME/.local/bin/$c" ]; then
      say "found $c"
    else
      warn "missing $c"; ok=0
    fi
  done
  while IFS= read -r sv; do
    if [ -e "/var/service/$sv" ]; then say "service $sv enabled"
    else warn "service $sv not enabled"; ok=0; fi
  done < <(read_list "$VIKIX_DIR/services.list")
  if [ -e /var/service/NetworkManager ]; then say "service NetworkManager enabled"
  else warn "service NetworkManager not enabled"; ok=0; fi
  for d in "${dirs[@]}"; do
    if [ -d "$d/.git" ]; then say "$d is a git clone"
    else warn "$d is not a git clone (45-editors did not set it up)"; ok=0; fi
  done
  # Emacs: Vikix's AI setup, in the running Emacs too.
  if is_chosen emacs; then
    local el="${XDG_DATA_HOME:-$HOME/.local/share}/vikix/emacs/vikix-ai.el" live
    if [ ! -f "$el" ]; then
      warn "$el, Vikix's AI setup for Emacs, is missing (vikix update links it)"; ok=0
    else
      live=$(emacs_ai)
      case $live in
        '')  say "Emacs's AI setup is there (the next Emacs loads it)" ;;
        old) warn "the running Emacs doesn't have Vikix's AI setup (C-c g, C-c a): emacs-restart when your chats are done" ;;
        "$(sha256sum < "$el" | cut -d' ' -f1)") say "Emacs has Vikix's AI setup loaded" ;;
        *)   warn "the running Emacs has an older AI setup: vikix update reloads it, or emacs-restart" ;;
      esac
    fi
  fi
  # Neovim: Vikix's starter with Vikix's part, or a config of your own.
  if is_chosen neovim; then
    local nv="$HOME/.config/nvim" layer="${XDG_DATA_HOME:-$HOME/.local/share}/vikix/nvim"
    if grep -qsF 'require, "vikix"' "$nv/init.lua"; then
      local saved="$VIKIX_STATE/nvim-lock.json" whose="versions of your own (:Lazy update)"
      if [ -f "$saved" ]; then
        python3 "$VIKIX_DIR/lib/nvim-lock.py" untouched "$saved" "$nv/lazy-lock.json" 2>/dev/null && whose="the versions Vikix tested"
      elif [ -f "$VIKIX_STATE/nvim-lock" ] && [ -f "$nv/lazy-lock.json" ]; then
        # 0.55.0's two checksums, until the next update replaces them.
        local sums; sums=$(cat "$VIKIX_STATE/nvim-lock")
        [ "${sums#* }" = "$(sha256sum < "$nv/lazy-lock.json" | cut -d' ' -f1)" ] && whose="the versions Vikix tested"
      fi
      if [ ! -f "$layer/lua/vikix/init.lua" ]; then
        warn "$layer, Vikix's part of Neovim, is missing (vikix update links it)"; ok=0
      elif [ ! -d "${XDG_DATA_HOME:-$HOME/.local/share}/nvim/lazy/lazy.nvim" ]; then
        warn "Neovim's plugins aren't installed (vikix update installs them)"; ok=0
      else say "Neovim is Vikix's, with your part in $nv; its plugins are at $whose"; fi
      local old
      for old in "$nv".vikix-bak.*; do
        if [ -d "$old" ]; then say "your Neovim config from before is kept in $old"; fi
      done
    elif [ -d "$nv/.git" ]; then say "$nv is a git clone (a Neovim config of your own)"
    elif [ -e "$nv/init.lua" ] || [ -e "$nv/init.vim" ]; then say "$nv is a Neovim config of your own"
    else warn "$nv has no Neovim config (vikix update puts Vikix's starter there)"; ok=0; fi
  fi
  if [ ! -L "$HOME/.stumpwm.d/init.lisp" ]; then
    warn "$HOME/.stumpwm.d/init.lisp is not Vikix's"; ok=0
  fi
  # The AI side. Claude Code itself is optional: Super+a offers to install it.
  if [ -d "$YOURS_GIT" ]; then say "your files have a snapshot history"
  else warn "no snapshot history of your files yet (40-config starts it)"; ok=0; fi
  # Without it, anything that reaches 127.0.0.1:4004 (the Windows VM, too)
  # runs code in StumpWM as you.
  if [ -s "$HOME/.slime-secret" ] && [ "$(stat -c %a "$HOME/.slime-secret")" = 600 ]; then
    say "Swank asks for a password (~/.slime-secret)"
  else
    warn "Swank lets anyone on 127.0.0.1 in: no ~/.slime-secret, or others can read it (vikix update makes it)"; ok=0
  fi
  # Local AI, if it's set up: running?
  bash "$VIKIX_DIR/bin/vikix-local-ai" check || ok=0
  # The Windows VM, if there is one, on its private network.
  bash "$VIKIX_DIR/bin/vikix-windows" check || ok=0
  # API keys belong in ~/.config/vikix/secrets (vikix ai key), not in your
  # files, where the snapshot history keeps them for ever.
  bash "$VIKIX_DIR/bin/vikix-ai" key check || ok=0
  if [ -L "$HOME/.claude/skills/vikix" ]; then say "the Vikix skill is linked for Claude Code"
  else warn "the Vikix skill isn't in ~/.claude/skills (40-config links it)"; ok=0; fi
  if command -v claude >/dev/null 2>&1 || [ -x "$HOME/.local/bin/claude" ]; then
    say "found claude"
  else
    say "claude is not installed (optional: Super+a or 'vikix agent' offers to install it)"
  fi
  if [ -f "${XDG_DATA_HOME:-$HOME/.local/share}/vikix/AGENTS.md" ]; then say "the Vikix guide for other agents is in ~/.local/share/vikix/AGENTS.md"
  else warn "the Vikix guide for other agents, ~/.local/share/vikix/AGENTS.md, is missing (40-config writes it; vikix agent too)"; ok=0; fi
  if [ -n "${DISPLAY:-}" ]; then
    if pgrep -x udiskie >/dev/null 2>&1; then
      say "udiskie is running: USB drives mount when plugged in"
    else
      warn "udiskie isn't running, so USB drives won't mount by themselves (log in again, or: setsid -f vikix-drives start)"; ok=0
    fi
    if python3 "$VIKIX_DIR/bin/vikix-eval" '(+ 1 1)' >/dev/null 2>&1; then
      say "vikix eval reaches the running StumpWM"
    else
      warn "vikix eval can't reach StumpWM (is it running? reload it: Super+m, Reload config)"; ok=0
    fi
  fi
  if [ "$ok" = 1 ]; then say "all good"
  else
    warn "see above"
    echo "   Stuck? vikix diagnose asks your AI agent; vikix debug writes a report to attach to an issue."
    return 1
  fi
}

# --- Snapshots of your files -----------------------------------------------
# Your files (config/yours.list names them) are kept in a git repository
# of their own, $VIKIX_STATE/yours.git, whose work tree is your home
# folder. Nothing is added to ~ itself: no .git folder appears anywhere.
# Every change an AI agent (or you) makes to them can then be seen with
# `vikix changes` and taken back with `vikix undo`.

YOURS_GIT="$VIKIX_STATE/yours.git"

yours_git() { git --git-dir="$YOURS_GIT" --work-tree="$HOME" "$@"; }

yours_init() {
  [ -d "$YOURS_GIT" ] && return 0
  say "starting the history of your files in $YOURS_GIT"
  run mkdir -p "$VIKIX_STATE"
  run git init -q --bare "$YOURS_GIT"
  # Commits here are Vikix's bookkeeping, so they don't need (or change)
  # your own git name.
  run yours_git config user.name "Vikix"
  run yours_git config user.email "vikix@localhost"
  # `git status` in this repo would otherwise list every file in ~.
  run yours_git config status.showUntrackedFiles no
  yours_exclude
}

# What the history never keeps, whatever yours.list says: Vikix's own links,
# things that change by themselves, and your API keys (vikix ai key). Written
# at every snapshot, so a machine whose history began before a line was
# added gets it too.
yours_exclude() {
  [ "$DRY_RUN" = 1 ] && return 0
  cat > "$YOURS_GIT/info/exclude" <<'EXCLUDE'
/.stumpwm.d/init.lisp
/.stumpwm.d/vikix
/.stumpwm.d/modules/
/.stumpwm.d/*.log*
/.stumpwm.d/history
/.config/vikix/secrets/
*.vikix-bak.*
*.fasl
*~
EXCLUDE
}

# Stage every file of yours as it is now: changed, new and deleted ones.
yours_stage() {
  local p
  yours_exclude
  while IFS= read -r p; do
    # A line naming the keys' folder, or a file in it, is skipped outright
    # (git would refuse an excluded path named on its own).
    case /${p%/}/ in /.config/vikix/secrets/*) warn "yours.list names $p; API keys are never kept in the history"; continue ;; esac
    # A git clone (a Neovim config of your own) keeps its own history, and
    # git can't take it in: it would record a pointer, or fail the snapshot.
    [ -e "$HOME/$p/.git" ] && continue
    if [ -e "$HOME/$p" ]; then yours_git add -A -- "$HOME/$p"; fi
  done < <(read_list "$VIKIX_DIR/config/yours.list")
  yours_git add -u    # files that were recorded and are now gone
}

has_snapshot() { yours_git rev-parse -q --verify HEAD >/dev/null 2>&1; }

cmd_snapshot() {
  local message=${1:-snapshot}
  yours_init
  if [ "$DRY_RUN" = 1 ]; then
    printf '   would record your files: %s\n' "$message"; return 0
  fi
  yours_stage
  if has_snapshot && yours_git diff --cached --quiet; then
    say "your files haven't changed since snapshot $(yours_git rev-parse --short HEAD)"
    return 0
  fi
  yours_git commit -q -m "$message"
  say "snapshot $(yours_git rev-parse --short HEAD): $message"
}

cmd_changes() {
  has_snapshot || die "no snapshots yet (vikix snapshot makes one)"
  if [ -n "${1:-}" ]; then
    yours_git show --stat --patch "$1"
    return
  fi
  yours_stage
  if yours_git diff --cached --quiet; then
    say "nothing has changed since snapshot $(yours_git rev-parse --short HEAD)"
  else
    yours_git diff --cached --stat
    yours_git diff --cached
  fi
}

cmd_history() {
  has_snapshot || die "no snapshots yet (vikix snapshot makes one)"
  yours_git log --date=format:'%Y-%m-%d %H:%M' --format='%h  %ad  %s'
}

# The help for the four commands of the history, from the top of this file.
history_help() {
  sed -n 's/^#   \(vikix \(snapshot\|changes\|history\|undo\) .*\)/\1/p' "$0"
  echo "An agent's start (Super+a, vikix agent, an editor's) takes a snapshot too: vikix history lists them all."
}

cmd_undo() {
  local target=${1:-} f
  has_snapshot || die "no snapshots yet, so nothing to undo"
  [ "$DRY_RUN" = 1 ] && { printf '   would put your files back to %s\n' "${target:-the previous snapshot}"; return 0; }
  # The target is checked before the snapshot below, so a mistyped one
  # leaves no "before undo" in the history.
  if [ -z "$target" ]; then
    yours_git rev-parse -q --verify HEAD~1 >/dev/null ||
      die "there is only one snapshot, so there is nothing before it to go back to"
    target=HEAD~1
  fi
  yours_git rev-parse -q --verify "$target^{commit}" >/dev/null ||
    die "no snapshot called $target (vikix history lists them)"
  local label changed
  label="$(yours_git rev-parse --short "$target") ($(yours_git log -1 --format=%s "$target"))"
  # In a terminal, say what it will change, and ask: the snapshot one back
  # may be an agent's start, not the one you had in mind.
  yours_stage
  changed=$(yours_git diff --cached --name-only "$target" || true)
  if [ -t 0 ] && [ -t 1 ]; then
    if [ -z "$changed" ]; then
      say "your files are already as they were at snapshot $label"; return 0
    fi
    say "back to snapshot $label, from $(yours_git log -1 --date=format:'%Y-%m-%d %H:%M' --format=%ad "$target"). It changes:"
    sed 's/^/     ~\//' <<<"$changed"
    local answer
    read -r -p "Put these back? [y/N] " answer
    case $answer in y|Y|yes) ;; *) say "nothing changed (vikix history lists the snapshots; vikix undo ID goes to one)"; return 0 ;; esac
  fi
  # Record the files as they are first, so the undo can itself be undone.
  cmd_snapshot "before undo"
  # Files that were added after the target snapshot are removed; they
  # stay in the history, so `vikix undo` again brings them back.
  while IFS= read -r -d '' f; do
    rm -f -- "${HOME:?}/$f"
  done < <(yours_git diff --name-only --diff-filter=A -z "$target" HEAD)
  yours_git checkout "$target" -- ':/'
  yours_stage
  yours_git commit -q --allow-empty -m "undo: back to $label"
  say "your files are as they were at snapshot $label"
  say "to take this back too: vikix undo"
  say "StumpWM keeps the old settings until it reloads: Super+m, then Reload config"
}

# --- The agent --------------------------------------------------------------
# bin/vikix-agent: Claude Code or another agent, after a snapshot.

# --- Themes ------------------------------------------------------------------
# A theme is a file of named colours: themes/NAME.theme in Vikix, or your own
# in ~/.config/vikix/themes/. `vikix theme NAME` remembers the choice and
# writes the colours out for each program into ~/.config/vikix/theme/. Your
# config files include those (alacritty.toml imports alacritty.toml; rofi's
# config.rasi names rofi.rasi; kitty.conf can include kitty.conf), and dunst
# reads its drop-in by itself. StumpWM reads the saved name when it starts,
# so the theme survives a restart.

THEME_OUT="${XDG_CONFIG_HOME:-$HOME/.config}/vikix/theme"
USER_THEMES="${XDG_CONFIG_HOME:-$HOME/.config}/vikix/themes"
DUNST_DROPIN="${XDG_CONFIG_HOME:-$HOME/.config}/dunst/dunstrc.d/10-vikix-theme.conf"
THEME_KEYS="bg fg subtle dim accent alert color0 color1 color2 color3 color4 color5
            color6 color7 color8 color9 color10 color11 color12 color13 color14 color15"
# Keys a theme may leave out, with what stands in: themes made before
# 0.23.0 have no sel, and keep working.
THEME_OPTIONAL="sel"

# A theme's name is its file's name, and it goes to StumpWM as a Lisp
# keyword: letters, digits, - and _ only, or a file named to be Lisp would
# run as you (at vikix theme, and at every update's refresh).
theme_name_ok() { [[ $1 =~ ^[A-Za-z0-9_-]{1,40}$ ]]; }

theme_file() {   # theme_file NAME — the file that defines NAME (yours first)
  local f
  theme_name_ok "$1" || return 1
  for f in "$USER_THEMES/$1.theme" "$VIKIX_DIR/themes/$1.theme"; do
    [ -f "$f" ] && { echo "$f"; return 0; }
  done
  return 1
}

theme_names() {
  local f
  local n
  for f in "$VIKIX_DIR"/themes/*.theme "$USER_THEMES"/*.theme; do
    [ -f "$f" ] || continue
    n=$(basename "$f" .theme)
    theme_name_ok "$n" && echo "$n"
  done | sort -u
}

# theme_read FILE — sets c_KEY for each colour. The file is read, never run.
theme_read() {
  local key value k missing=()
  for k in $THEME_KEYS $THEME_OPTIONAL; do unset "c_$k"; done
  while IFS='=' read -r key value; do
    key=${key//[[:space:]]/}
    [ -n "$key" ] || continue
    read -r value _ <<<"$value"             # the first word; the rest is a comment
    [[ " $THEME_KEYS $THEME_OPTIONAL " == *[[:space:]]"$key"[[:space:]]* ]] || continue
    [[ $value =~ ^#[0-9A-Fa-f]{6}$ ]] || { warn "$1: $key=$value is not a #rrggbb colour"; continue; }
    printf -v "c_$key" '%s' "$value"
  done < "$1"
  for k in $THEME_KEYS; do
    local var="c_$k"
    [ -n "${!var:-}" ] || missing+=("$k")
  done
  [ "${#missing[@]}" -eq 0 ] || { warn "$1 has no colour for: ${missing[*]}"; return 1; }
  : "${c_sel:=$c_color0}"
}

# theme_write NAME — every program's theme file, from theme NAME.
# shellcheck disable=SC2154  # the c_* colours are set by theme_read, with printf -v
theme_write() {
  local file
  theme_name_ok "$1" || die "a theme's name is letters, digits, - and _ only"
  file=$(theme_file "$1") || die "no theme called '$1' (vikix theme lists them)"
  theme_read "$file" || die "theme '$1' is incomplete; nothing was changed"
  [ "$DRY_RUN" = 1 ] && { printf '   would write the %s theme into %s\n' "$1" "$THEME_OUT"; return 0; }
  mkdir -p "$THEME_OUT" "$(dirname "$DUNST_DROPIN")"
  local head="Written by \`vikix theme\` from $file; changes here are overwritten."

  cat > "$THEME_OUT/alacritty.toml" <<EOF
# $head
[colors.primary]
background = "$c_bg"
foreground = "$c_fg"

[colors.selection]
background = "$c_sel"
text = "CellForeground"

[colors.normal]
black = "$c_color0"
red = "$c_color1"
green = "$c_color2"
yellow = "$c_color3"
blue = "$c_color4"
magenta = "$c_color5"
cyan = "$c_color6"
white = "$c_color7"

[colors.bright]
black = "$c_color8"
red = "$c_color9"
green = "$c_color10"
yellow = "$c_color11"
blue = "$c_color12"
magenta = "$c_color13"
cyan = "$c_color14"
white = "$c_color15"
EOF

  local i kitty="# $head
background $c_bg
foreground $c_fg
selection_background $c_sel
selection_foreground none
cursor $c_fg
active_border_color $c_accent
inactive_border_color $c_dim"
  for i in $(seq 0 15); do
    local var="c_color$i"
    kitty+=$'\n'"color$i ${!var}"
  done
  printf '%s\n' "$kitty" > "$THEME_OUT/kitty.conf"

  cat > "$THEME_OUT/rofi.rasi" <<EOF
/* $head */
* {
    bg: $c_bg; fg: $c_fg; subtle: $c_subtle; dim: $c_dim; sel: $c_sel;
    accent: $c_accent; alert: $c_alert;
    background-color: transparent;
    text-color: @fg;
}
window {
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    padding: 12px;
    width: 40%;
}
inputbar { children: [ prompt, entry ]; spacing: 8px; padding: 0 0 8px 0; }
prompt { text-color: @accent; }
entry { placeholder: "Type to search"; placeholder-color: @subtle; }
listview { lines: 10; scrollbar: false; }
element { padding: 4px 8px; }
element selected.normal, element selected.active { background-color: @sel; text-color: @fg; }
element-text, element-icon { background-color: inherit; text-color: inherit; }
EOF

  cat > "$DUNST_DROPIN" <<EOF
# $head
# A drop-in: dunst reads it after ~/.config/dunst/dunstrc, so these colours
# win over the ones there. To keep your own, add a drop-in named after this
# one (e.g. 90-mine.conf): the last in name order wins.
[global]
    frame_color = "$c_accent"
[urgency_low]
    background = "$c_bg"
    foreground = "$c_subtle"
    highlight = "$c_subtle"
[urgency_normal]
    background = "$c_bg"
    foreground = "$c_fg"
    highlight = "$c_accent"
[urgency_critical]
    background = "$c_bg"
    foreground = "$c_fg"
    frame_color = "$c_alert"
    highlight = "$c_alert"
EOF

  printf '%s\n' "${c_bg#\#}" > "$THEME_OUT/lock"     # i3lock -c takes rrggbb
  printf '%s\n' "$1" > "$THEME_OUT/current"
}

theme_current() {
  local n; n=$(cat "$THEME_OUT/current" 2>/dev/null) || n=void
  theme_name_ok "$n" && echo "$n" || echo void
}

# vikix theme            the current theme, and the ones there are
# vikix theme NAME       switch to NAME, everywhere, now
# vikix theme --refresh  write the current theme's files again (40-config
#                        does this, so a Vikix update reaches them)
cmd_theme() {
  local name=${1:-}
  if [ -z "$name" ]; then
    say "theme: $(theme_current)"
    say "themes: $(theme_names | tr '\n' ' ')"
    say "switch with: vikix theme NAME (or Super+m, Theme); your own go in $USER_THEMES"
    return 0
  fi
  local refresh=0
  [ "$name" = --refresh ] && { refresh=1; name=$(theme_current); }
  theme_write "$name"
  [ "$DRY_RUN" = 1 ] && return 0
  # The programs that are running pick the new colours up now. Alacritty
  # notices by itself that the file it imports has changed; rofi and the
  # lock screen read theirs each time they start.
  if [ -n "${DISPLAY:-}" ]; then
    command -v dunstctl >/dev/null 2>&1 && dunstctl reload >/dev/null 2>&1
    python3 "$VIKIX_DIR/bin/vikix-eval" "(vikix-apply-theme :$name)" >/dev/null 2>&1 ||
      warn "StumpWM didn't repaint (is it running?); it will use $name from its next start"
    # kitty reads its config again on SIGUSR1: with kitty.conf including
    # ours, open kitty windows change too.
    pkill -USR1 -x kitty 2>/dev/null || true
    # The theme's own wallpaper, unless you chose one (vikix-wallpaper).
    # Not on --refresh: that is `vikix update` rewriting the same theme,
    # and must not replace a picture set some other way.
    if [ "$refresh" = 0 ]; then
      "$VIKIX_DIR/bin/vikix-wallpaper" || warn "the wallpaper didn't change"
    fi
  fi
  say "theme: $name"
}

# Everything runs inside main, and main is the last thing in the file.
# Bash reads a script as it goes, and `vikix update` pulls a new copy
# of this very file while it runs. Parsed whole before it starts, main
# can't be changed under our feet; the final `exit` keeps bash from
# reading whatever the pull put after it.
main() {
  case ${1:-help} in
    update)      cmd_update "${2:-}" ;;
    migrate)     cmd_migrate ;;
    rebuild-wm)  VIKIX_REBUILD_WM=1 bash "$VIKIX_DIR/install/30-lisp.sh" ;;
    docs)        VIKIX_DOCS=1 bash "$VIKIX_DIR/install/67-dev.sh" ;;
    doctor)      cmd_doctor ;;
    features)    exec "$VIKIX_DIR/bin/vikix-features" list ;;
    add|remove)  exec "$VIKIX_DIR/bin/vikix-features" "$@" ;;
    welcome)     shift; exec "$VIKIX_DIR/bin/vikix-welcome" "$@" ;;
    pkg)         shift; exec "$VIKIX_DIR/bin/vikix-pkg" "$@" ;;
    version)     cat "$VIKIX_DIR/VERSION" ;;
    eval)        shift; exec python3 "$VIKIX_DIR/bin/vikix-eval" "$@" ;;
    agent)       shift; exec "$VIKIX_DIR/bin/vikix-agent" "$@" ;;
    debug|diagnose) exec "$VIKIX_DIR/bin/vikix-debug" "$@" ;;
    dictate)     shift; exec "$VIKIX_DIR/bin/vikix-dictate" "$@" ;;
    voice)       shift; exec "$VIKIX_DIR/bin/vikix-voice" "$@" ;;
    notes)       shift; exec "$VIKIX_DIR/bin/vikix-notes" "$@" ;;
    mcp)         shift; exec "$VIKIX_DIR/bin/vikix-mcp" "$@" ;;
    snapshot|changes|history|undo)
      case ${2:-} in -h|--help) history_help; exit 0 ;; esac
      case $1 in
        snapshot) case ${2:-} in -*) die "a snapshot's message can't start with - (vikix snapshot --help)" ;; esac
                  cmd_snapshot "${2:-snapshot}" ;;
        changes)  cmd_changes "${2:-}" ;;
        history)  cmd_history ;;
        undo)     cmd_undo "${2:-}" ;;
      esac ;;
    theme)       cmd_theme "${2:-}" ;;
    backup)      shift; exec "$VIKIX_DIR/bin/vikix-backup" "$@" ;;
    firmware)    shift; exec "$VIKIX_DIR/bin/vikix-firmware" "$@" ;;
    windows)     shift; exec "$VIKIX_DIR/bin/vikix-windows" "$@" ;;
    ai)          shift; exec "$VIKIX_DIR/bin/vikix-ai" "$@" ;;
    webapp|webapps) shift; exec "$VIKIX_DIR/bin/vikix-webapp" "$@" ;;
    fingerprint) shift; exec "$VIKIX_DIR/bin/vikix-fingerprint" "$@" ;;
    help|-h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)           die "unknown command: $1 (try: vikix help)" ;;
  esac
}
main "$@"
exit
