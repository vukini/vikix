#!/usr/bin/env bash
# vikix-backup — your home folder, backed up with restic (`vikix backup`).
#
#   vikix backup setup [PLACE]  once: where backups go. With no PLACE, the
#                                USB drive plugged in (it asks when there are
#                                several); or a drive's folder
#                                (/run/media/you/DRIVE), or any restic place
#                                (sftp:host:/path, b2:bucket:path, ...)
#   vikix backup card [--print] [--kept] [FILE]
#                              the password as a card to print and put in a
#                                drawer (a one-page PDF when typst is here,
#                                else text); --kept says it is put away
#   vikix backup [now]         back up now: all of ~, minus what
#                                ~/.config/vikix/backup-exclude leaves out
#   vikix backup status        where, when the last one was, what is left out
#   vikix backup list          the backups, newest last
#   vikix backup restore PATH [ID]   bring back PATH (a file or folder) from
#                                the latest backup, or backup ID, into
#                                ~/Restored/<time>/; nothing is overwritten
#   vikix backup check         make sure the backups can be read back
#   vikix backup doctor        the lines vikix doctor shows: where, when, the
#                                drive, the last check, the card
#                                (vikix versions PATH lists a file's versions
#                                from the backups and the snapshots together,
#                                and vikix restore PATH ID brings one back
#                                beside it: vikix versions --help)
#   vikix backup off           stop the reminder; the backups stay where they are
#
# Every backup is encrypted with the password in ~/.config/vikix/backup-password,
# made at setup and readable only by you. Keep a copy somewhere else: without
# it, a lost laptop means backups nobody can read. Old backups thin out
# after each run: one a day for a week, one a week for a month, one a month
# for a year. The bar says "backup 9d" once the last backup is older than
# DAYS (7) in ~/.config/vikix/backup; nothing runs by itself. A click on
# that note is a menu: back up now, status, the card, check; or set up.

set -euo pipefail
VIKIX_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../lib/common.sh
. "$VIKIX_DIR/lib/common.sh"

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/vikix"
settings="$config_dir/backup"
password="$config_dir/backup-password"
exclude="$config_dir/backup-exclude"
state="${XDG_STATE_HOME:-$HOME/.local/state}/vikix"
# "LAST DAYS" for the bar: the time of the last backup (0 for none yet),
# and after how many days it starts reminding.
bar_file="$state/backup"

setting() { sed -n "s/^$1=//p" "$settings" 2>/dev/null | tail -1; }
days() { local d; d=$(setting DAYS); case $d in ''|*[!0-9]*) echo 7 ;; *) echo "$d" ;; esac; }

need_restic() {
  command -v restic >/dev/null 2>&1 || die "restic isn't installed (vikix update adds it)"
}

need_setup() {
  [ -f "$settings" ] && [ -n "$(setting REPO)" ] ||
    die "backups aren't set up yet: vikix backup setup PLACE (a USB drive's folder, usually)"
  [ -r "$password" ] || die "the backup password is missing ($password); restore your copy of it there"
}

# restic, with this machine's repository and password.
r() { restic -r "$(setting REPO)" --password-file "$password" "$@"; }

# A place on this machine (a USB drive) rather than a remote one: no
# "scheme:" in front.
is_local() { case $1 in /*) return 0 ;; *) return 1 ;; esac; }

notify() { [ -n "${notify:-}" ] && command -v notify-send >/dev/null 2>&1 && notify-send "$@" || true; }

write_bar() { mkdir -p "$state"; echo "$1 $(days)" > "$bar_file"; }

cmd_setup() {
  local place=${1:-} repo drives=() n i
  need_restic
  if [ -z "$place" ]; then
    # No place named: the USB drive plugged in (vikix-drives knows them).
    mapfile -t drives < <("$VIKIX_DIR/bin/vikix-drives" list 2>/dev/null)
    case ${#drives[@]} in
      0) die "no USB drive is plugged in: plug one in (it mounts by itself) and run vikix backup setup again; or name a place: vikix backup setup PLACE (a folder, sftp:host:/path, b2:bucket:path ...)" ;;
      1) place=${drives[0]}; say "the drive plugged in: $place" ;;
      *) if [ -t 0 ]; then
           echo "Several drives are plugged in. Which one for the backups?"
           for i in "${!drives[@]}"; do printf '  %d. %s\n' "$((i + 1))" "${drives[$i]}"; done
           read -r -p "  [1-${#drives[@]}] " n
           [[ $n =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le "${#drives[@]}" ] || die "not a number from the list; run vikix backup setup again"
           place=${drives[$((n - 1))]}
         else
           die "several drives are plugged in; name one: vikix backup setup PLACE, one of: ${drives[*]}"
         fi ;;
    esac
  fi
  if is_local "$place"; then
    [ -d "$place" ] || die "$place isn't there; plug in the drive (it mounts by itself) and try again"
    place=$(cd "$place" && pwd)
    # A restic repository already, or a drive to make one on.
    if [ -f "$place/config" ] && [ -d "$place/data" ]; then repo=$place
    else repo="$place/vikix-backup"; fi
  else
    repo=$place
  fi

  mkdir -p "$config_dir"
  local new_password=
  if [ ! -s "$password" ]; then
    (umask 077; head -c 32 /dev/urandom | base64 | tr -d '/+=\n' | cut -c1-32 > "$password")
    new_password=1
  fi
  chmod 600 "$password"

  if restic -r "$repo" --password-file "$password" cat config >/dev/null 2>&1; then
    say "using the backups already at $repo"
  elif is_local "$repo" && [ -f "$repo/config" ]; then
    die "$repo holds backups made with another password; put that password in $password and run this again"
  else
    say "making a new backup store at $repo"
    restic -r "$repo" --password-file "$password" init >/dev/null
  fi

  { echo "# Where vikix backup puts your backups, and after how many days"
    echo "# without one the bar starts reminding you. Written by vikix backup setup."
    echo "REPO=$repo"
    echo "DAYS=$(days)"
    [ "$(setting CARD)" = kept ] && echo "CARD=kept"; } > "$settings.new"
  mv "$settings.new" "$settings"
  [ -f "$exclude" ] || cp "$VIKIX_DIR/config/backup/exclude" "$exclude"
  [ -f "$bar_file" ] || write_bar 0

  say "backups go to $repo"
  if [ -n "$new_password" ]; then
    echo
    echo "  The password for your backups is:"
    echo
    echo "      $(cat "$password")"
    echo
    echo "  Keep it away from this laptop: it is also in $password,"
    echo "  but if the laptop is lost, that copy goes with it. As a card to print"
    echo "  and put in a drawer:  vikix backup card --print  (vikix backup card shows it);"
    echo "  once it is put away:  vikix backup card --kept"
    echo
  fi
  say "back up now with: vikix backup"
}

# The password card: what to print and put in a drawer. REPO is where the
# backups go, for someone reading the card on another machine.
card_text() {
  local repo=$1
  cat <<EOF
VIKIX BACKUP: THE PASSWORD

Made on $(date '+%A %-d %B %Y') for $(id -un) on $(hostname 2>/dev/null || cat /etc/hostname 2>/dev/null || echo "this laptop").

The password:

    $(cat "$password")

Backups go to: $repo

Everything in the backups is encrypted with this password. Without it
they can't be read, by anyone, so keep this card away from the laptop:
the copy on it, ~/.config/vikix/backup-password, is lost with it.

To read the backups on another machine: put the password, alone, in
~/.config/vikix/backup-password there, then
    vikix backup setup PLACE
(or, without Vikix: restic -r PLACE snapshots, and restic asks for it).
EOF
}

# vikix backup card [--print] [--kept] [FILE]: the card as a one-page PDF
# (typst, when the publish feature brought it) or plain text, at FILE or
# in the session's runtime folder (gone at logout); shown too. --print
# sends it to the printer; --kept notes that the card is put away, which
# vikix doctor asks about until then.
cmd_card() {
  local print='' kept='' file='' a text out
  for a in "$@"; do
    case $a in
      --print) print=1 ;;
      --kept) kept=1 ;;
      -h|--help) echo "usage: vikix backup card [--print] [--kept] [FILE]"; return 0 ;;
      -*) die "vikix backup card: unknown option $a (--print, --kept, or a FILE to write)" ;;
      *) file=$a ;;
    esac
  done
  if [ -n "$kept" ]; then
    [ -f "$settings" ] || die "backups aren't set up yet: vikix backup setup first"
    set_setting CARD kept
    say "noted: the password card is kept away from the laptop (vikix doctor stops asking)"
    return 0
  fi
  [ -s "$password" ] || die "there is no backup password yet: vikix backup setup first"
  text=$(card_text "$(setting REPO)")
  out=${file:-${XDG_RUNTIME_DIR:-/tmp}/vikix-backup-card}
  if command -v typst >/dev/null 2>&1 && [ -z "${VIKIX_BACKUP_CARD_TEXT:-}" ] && card_pdf "$text" "${out%.pdf}.pdf"; then
    out=${out%.pdf}.pdf
  else
    out=${out%.txt}.txt
    (umask 077; printf '%s\n' "$text" > "$out")
  fi
  chmod 600 "$out" 2>/dev/null || true
  printf '%s\n\n' "$text"
  say "the card is at $out"
  if [ -n "$print" ]; then
    lpstat -d 2>/dev/null | grep -q ': ' ||
      die "no printer is set up yet (vikix add printing, then the printer in its settings); print $out from another machine, or copy the password by hand"
    lp -s "$out" || die "the printer didn't take it; the card is at $out"
    say "sent to the printer: put the card in a drawer, then vikix backup card --kept"
  fi
}

# card_pdf TEXT FILE: TEXT as a one-page PDF through typst; fails quietly.
card_pdf() {
  local text=$1 out=$2 src body
  src=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/vikix-card-XXXX.typ") || return 1
  # Typst's markup is kept out: the text goes in as raw blocks, line by line.
  body=$(printf '%s\n' "$text" | sed -e 's/`/'"'"'/g')
  { echo '#set page(paper: "a5", margin: 1.6cm)'
    echo '#set text(size: 11pt)'
    echo '#show raw.where(block: true): set text(size: 11pt)'
    echo '```'
    printf '%s\n' "$body"
    echo '```'; } > "$src"
  (umask 077; typst compile "$src" "$out" >/dev/null 2>&1); local rc=$?
  rm -f "$src"
  return $rc
}

# set_setting KEY VALUE: one line of the settings file, kept or added.
set_setting() {
  if grep -q "^$1=" "$settings" 2>/dev/null; then
    sed -i "s|^$1=.*|$1=$2|" "$settings"
  else
    echo "$1=$2" >> "$settings"
  fi
}

# The bar's "backup" note was clicked: a small menu in rofi.
cmd_menu() {
  local term=${VIKIX_TERMINAL:-${TERMINAL:-alacritty}} lines pick
  if [ -f "$settings" ] && [ -n "$(setting REPO)" ]; then
    lines=$'Back up now\nWhere and when: status\nThe password card\nThe backups, read back: check'
  else
    lines=$'Set up backups (plug in a USB drive first)'
  fi
  pick=$(printf '%s\n' "$lines" | rofi -dmenu -i -p backup -no-custom 2>/dev/null) || return 0
  case $pick in
    "Back up now") notify=1; cmd_now ;;
    "Where and when"*) exec "$term" -e sh -c 'vikix backup status; echo; echo "Press Enter to close."; read x' ;;
    "The password card") exec "$term" -e sh -c 'vikix backup card; echo "To print it: vikix backup card --print. Put away: vikix backup card --kept"; echo; echo "Press Enter to close."; read x' ;;
    "The backups, read back"*) exec "$term" -e sh -c 'vikix backup check; echo; echo "Press Enter to close."; read x' ;;
    "Set up backups"*) exec "$term" -e sh -c 'vikix backup setup; echo; echo "Press Enter to close."; read x' ;;
  esac
}

# vikix backup doctor: the lines vikix doctor shows. Not set up is a
# choice, said; the rest counted (exit 1 when something wants doing).
cmd_doctor() {
  local ok=1 repo last age checked
  if [ ! -f "$settings" ] || [ -z "$(setting REPO)" ]; then
    say "backups aren't set up: plug in a USB drive and run vikix backup setup"
    return 0
  fi
  repo=$(setting REPO)
  if [ -r "$password" ] && [ -s "$password" ]; then say "backups go to $repo, encrypted with the password in $password"
  else warn "the backup password is missing ($password): put your copy of it there"; ok=0; fi
  if is_local "$repo"; then
    if [ -d "$repo" ]; then say "the backup drive is plugged in"
    else say "the backup drive isn't plugged in (the backup runs when it is, if one is due)"; fi
  fi
  last=$(cut -d' ' -f1 "$bar_file" 2>/dev/null || echo 0)
  if [ "${last:-0}" -gt 0 ] 2>/dev/null; then
    age=$(( ($(date +%s) - last) / 86400 ))
    if [ "$age" -ge "$(days)" ]; then warn "the last backup was $age days ago, past the reminder's $(days) (vikix backup)"; ok=0
    elif [ "$age" = 0 ]; then say "the last backup was today"
    else say "the last backup was $age days ago"; fi
  else
    warn "no backup yet (vikix backup, with the drive plugged in)"; ok=0
  fi
  checked=$(cat "$state/backup-check" 2>/dev/null || echo 0)
  if [ "${checked:-0}" -gt 0 ] 2>/dev/null; then
    age=$(( ($(date +%s) - checked) / 86400 ))
    say "the backups were read back and checked $([ "$age" = 0 ] && echo today || echo "$age days ago")"
  else
    warn "the backups were never read back (vikix backup check makes sure they can be)"; ok=0
  fi
  if [ "$(setting CARD)" = kept ]; then say "the password card is kept away from the laptop"
  else warn "the password card isn't put away yet: vikix backup card --print, a drawer, then vikix backup card --kept"; ok=0; fi
  [ "$ok" = 1 ]
}

cmd_now() {
  need_restic
  need_setup
  local repo; repo=$(setting REPO)
  if is_local "$repo" && [ ! -d "$repo" ]; then
    notify -u normal "Backup" "The backup drive isn't plugged in."
    die "the backup drive isn't there ($repo); plug it in (it mounts by itself) and try again"
  fi
  mkdir -p "$state/logs"
  # One at a time: a second run waits for nothing, it just stops.
  exec 9>"$state/backup.lock"
  flock -n 9 || die "a backup is already running"

  [ -f "$exclude" ] || cp "$VIKIX_DIR/config/backup/exclude" "$exclude"
  local log started
  log="$state/logs/backup-$(timestamp).log"
  started=$(date +%s)
  say "backing up $HOME to $repo (the log: $log)"
  notify -u low "Backup" "Started. You can keep working."
  # --one-file-system: not into drives mounted under ~. --exclude-caches:
  # not into folders marked as caches (CACHEDIR.TAG, e.g. Rust's target/).
  if ! r backup "$HOME" --exclude-file "$exclude" --exclude-caches --one-file-system \
         --tag vikix 2>&1 | tee "$log"; then
    notify -u critical "Backup failed" "See $log"
    die "the backup failed; the log is $log"
  fi
  say "thinning out old backups"
  r forget --tag vikix --keep-daily 7 --keep-weekly 4 --keep-monthly 12 --prune >>"$log" 2>&1 ||
    warn "couldn't thin out old backups (the new one is fine); see $log"
  write_bar "$(date +%s)"
  local secs=$(( $(date +%s) - started )) took
  if [ "$secs" -lt 60 ]; then took="$secs s"; else took="$(( (secs + 30) / 60 )) min"; fi
  notify -u low "Backup done" "Took $took."
  say "done in $took"
}

cmd_status() {
  if [ ! -f "$settings" ]; then
    echo "backups: not set up (vikix backup setup PLACE)"
    return 0
  fi
  local last age
  echo "backups go to: $(setting REPO)"
  last=$(cut -d' ' -f1 "$bar_file" 2>/dev/null || echo 0)
  if [ "${last:-0}" -gt 0 ] 2>/dev/null; then
    age=$(( ($(date +%s) - last) / 86400 ))
    echo "last backup:   $(date -d "@$last" '+%a %d %b %Y, %H:%M') ($age days ago)"
  else
    echo "last backup:   none yet (vikix backup)"
  fi
  echo "reminder:      after $(days) days (DAYS= in $settings)"
  echo "left out:      what $exclude names"
  [ -r "$password" ] || echo "!! the password file is missing: $password"
}

cmd_list() { need_restic; need_setup; r snapshots; }
cmd_check() { need_restic; need_setup; r check && { mkdir -p "$state"; date +%s > "$state/backup-check"; }; }

cmd_restore() {
  local path=${1:-} id=${2:-latest} target
  [ -n "$path" ] || die "what to bring back? vikix backup restore PATH [ID]  (vikix backup list shows the IDs)"
  need_restic
  need_setup
  path=$(realpath -m "$path")
  # A folder of its own each time, even for two restores in one second.
  mkdir -p "$HOME/Restored"
  target=$(mktemp -d "$HOME/Restored/$(timestamp)-XXXX")
  say "bringing back $path from backup $id"
  r restore "$id" --target "$target" --include "$path" || true
  if [ ! -e "$target$path" ]; then
    rm -rf "$target"
    die "$path isn't in backup $id (vikix backup list shows them)"
  fi
  say "it's in $target$path"
}

cmd_off() {
  rm -f "$settings" "$bar_file"
  say "no more reminders. The backups stay at their place, and the password in $password"
}

case ${1:-now} in
  setup)   shift; cmd_setup "$@" ;;
  now)     shift || true; [ "${1:-}" = --notify ] && notify=1; cmd_now ;;
  --notify) notify=1; cmd_now ;;
  status)  cmd_status ;;
  list)    cmd_list ;;
  restore) shift; cmd_restore "$@" ;;
  check)   cmd_check ;;
  card)    shift; cmd_card "$@" ;;
  menu)    cmd_menu ;;
  doctor)  cmd_doctor ;;
  off)     cmd_off ;;
  help|-h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)       die "unknown: vikix backup $1 (try: vikix backup help)" ;;
esac
