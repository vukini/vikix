# apps.list — everyday programs.
firefox
pcmanfm         # file manager
udisks2         # lets the file manager mount USB sticks
gvfs            # ...and show them in its sidebar
udiskie         # mounts a USB drive when it's plugged in (vikix-drives)
gvfs-mtp        # Android phones in the file manager
ntfs-3g         # read and write Windows drives
mpv             # video and audio
nsxiv           # images
zathura         # PDFs (keyboard-driven)...
zathura-pdf-mupdf  # ...with the MuPDF engine
spacefm         # a second file manager: tabs, split panes, its own bookmarks (s-E)
foliate         # EPUB (and MOBI, FB2, comics) reader, with a library
