# apps.list — everyday programs.
firefox
pcmanfm         # file manager
udisks2         # lets the file manager mount USB sticks
gvfs            # ...and show them in its sidebar
ntfs-3g         # read and write Windows drives
mpv             # video and audio
nsxiv           # images
zathura         # PDFs (keyboard-driven)...
zathura-pdf-mupdf  # ...with the MuPDF engine
spacefm         # a second file manager: tabs, split panes, its own bookmarks (s-E)
foliate         # EPUB (and MOBI, FB2, comics) reader, with a library
# LibreOffice: the parts, not the libreoffice meta package, which adds Base,
# a PostgreSQL driver and seven more interface languages.
libreoffice-writer   # documents (.odt, .docx)
libreoffice-calc     # spreadsheets (.ods, .xlsx)
libreoffice-impress  # presentations (.odp, .pptx)
libreoffice-draw     # drawings, and editing PDFs
libreoffice-math     # formulas
libreoffice-fonts
libreoffice-i18n-en-US
zeal            # offline docs for every language, searchable (docsets from 67-dev)
