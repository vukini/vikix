# base.list — the plumbing a desktop session needs.
dbus            # message bus most desktop programs talk over
elogind         # login sessions and seats, without systemd
polkit          # lets desktop tools ask for permission
git
curl
unzip
bash-completion
openssh         # ssh/scp in and out
chrony          # keeps the clock right (Void does not by default)
rsync
zip
7zip
wget
man-pages       # the manual...
mdocml          # ...and the man command that reads it
xdg-utils       # xdg-open: "open this file with the right program"
xdg-user-dirs   # ~/Documents, ~/Downloads ...
polkit-gnome    # the password box when a program asks for admin rights
texinfo         # info, and makeinfo, which makes the guides in docs/ an Info manual
earlyoom        # the last resort when memory runs out: ends one program, not the whole desktop (vikix memory)
python3         # vikix eval (the door into the running StumpWM) is written in Python
