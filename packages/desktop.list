# desktop.list — X11 and the programs around the window manager.
xorg-minimal    # X server, xinit/startx, libinput
xorg-fonts
mesa-dri        # graphics drivers (Intel/AMD)
xsetroot        # root window cursor
xrdb            # loads ~/.Xresources
xset            # idle timeout for the screen lock
setxkbmap       # keyboard layout
xrandr          # screens
arandr          # screens, with a GUI
picom           # compositor: no tearing
dunst           # notifications
xsettingsd      # tells GTK programs the theme (dark or light), live
gnome-themes-extra  # Adwaita-dark for GTK 3 programs
qt6ct           # Qt 6 programs in the theme's colours
libnotify       # notify-send
rofi            # launcher
rofi-emoji      # emoji picker (Super+.)
rofi-calc       # calculator (Super+=); brings qalculate
noto-fonts-emoji  # colour emoji, for the picker and everywhere else
alacritty       # terminal
noto-fonts-ttf  # everything else
xss-lock        # locks the screen on suspend/idle
gammastep       # night light: a warmer screen in the evening (vikix-nightlight)
i3lock          # the lock screen
maim            # screenshots
slop            # choosing an area to record (maim uses it too)
ffmpeg6         # screen recording (vikix-record)
xclip           # clipboard from the command line
tesseract-ocr   # the text in a screenshot (Super+Ctrl+Print, Text from an area)
tesseract-ocr-eng   # ...its English (other languages: tesseract-ocr-deu, -fra, ...)
xcolor          # the colour under the pointer (Super+Ctrl+Print, Pick a colour)
clipmenu        # clipboard history (Super+c); clipmenud records it
xdotool
feh             # wallpaper
nerd-fonts-symbols-ttf  # icon glyphs only; the full Nerd Fonts set is nerd-fonts-ttf
