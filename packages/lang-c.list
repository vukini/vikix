# lang-c.list — C (the base-devel toolchain, gdb and valgrind are in dev.list)
tcc             # Tiny C Compiler: `tcc -run hello.c` runs a file like a script
clang           # a second compiler, with better diagnostics; also builds PicoLisp
rr              # record a run, then step through it backwards in gdb
cmake
meson
ninja
shellcheck      # for the shell scripts around the C
shfmt
