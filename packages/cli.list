# cli.list — command-line tools (aliases in config/bash/vikix.bash).
htop            # what is running
ripgrep         # rg: search file contents, fast
fd              # find files by name, fast
fzf             # fuzzy finder: Ctrl+R history, Ctrl+T files
bat             # cat with colour and line numbers
eza             # ls with colour and git status
tmux
tree
jq              # read and reshape JSON
zoxide          # z: cd by a remembered part of a folder's name
yazi            # y: file manager in the terminal
lazygit         # lg: git in a terminal UI
github-cli      # gh: GitHub from the terminal (pull requests, issues, Actions)
restic          # vikix backup: your home folder, encrypted, to a USB drive or elsewhere
atuin           # Ctrl+R: search all your shell history
bash-preexec    # lets atuin see each command as it runs
