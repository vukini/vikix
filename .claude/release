#!/usr/bin/env bash
# .claude/release — finish a change: its branch onto main, the version, the tag.
# (Vid's dev machine; for the sessions that work on Vikix side by side.)
#
#   .claude/release TOPIC "what it brings, in a line"
#       TOPIC's branch is put on top of main (rebased, when main has moved
#       on), the tests its changes reach are run, main is fast-forwarded to
#       it, VERSION goes up by one and is committed as
#       "Vikix X.Y.Z: what it brings", tagged vX.Y.Z; then TOPIC's worktree
#       and branch are removed. Nothing is pushed: Vid runs gup.
#
#   --tests changed|quick|full|none
#                 which tests run first (changed: tests/run.sh --changed main,
#                 the default; none: you ran them on this very commit). A
#                 run is skipped, and said so, when the desk's record (the
#                 office's, lib/handoff.py) has a passing check as wide on
#                 the very commit being merged, with a clean tree: the
#                 worker's or the tester's run speaks for it (one commit
#                 was tested four times in a day, 2026-10-11)
#   --plain       only put the branch on main: no version, no tag (a change
#                 to TODO.md or the guides alone)
#   --middle      the middle number goes up and the last starts again
#                 (0.71.266 → 0.72.0): only when Vid asks for it
#   --keep        leave the worktree and the branch
#   --co-author "Name <mail>"
#                 a Co-Authored-By line on the release commit
#
#   .claude/release --queue
#       the releases under way, the one whose turn it is first: each one's
#       topic, its step (step 4 of 7: testing, waiting for its turn) and
#       since when, and its summary. Nothing is changed.
#
# One release at a time: a second waits for the first (a lock in the
# repository), so two sessions can't take the same number, and main can't
# move between a session's last look and its merge. Each step runs only if
# the one before it worked; one that fails stops everything and says where
# things stand. An empty release, tagged over a merge that had been
# refused, happened twice by hand (0.71.142, 0.71.147).
#
# It never rewrites main, never pushes, never touches another topic.

set -uo pipefail
# In braces, so the whole of it is read before any of it runs: it removes
# the worktree it may have been started from, this file with it.
{
say() { printf ':: %s\n' "$*"; }
die() { printf 'xx %s\n' "$*" >&2; exit 1; }

tests=changed plain='' keep='' coauthor='' topic='' summary='' queue='' middle=''
while [ $# -gt 0 ]; do
  case $1 in
    --tests) [ $# -ge 2 ] || die "--tests needs changed, quick, full or none"; tests=$2; shift 2 ;;
    --tests=*) tests=${1#--tests=}; shift ;;
    --plain) plain=1; shift ;;
    --middle) middle=1; shift ;;
    --keep) keep=1; shift ;;
    --queue) queue=1; shift ;;
    --co-author) [ $# -ge 2 ] || die "--co-author needs a name and an address"; coauthor=$2; shift 2 ;;
    -h|--help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
    -*) die "no option $1 (see --help)" ;;
    *) if [ -z "$topic" ]; then topic=$1; elif [ -z "$summary" ]; then summary=$1; else die "too many words: the summary in quotes"; fi; shift ;;
  esac
done
case $tests in changed|quick|full|none) ;; *) die "--tests is changed, quick, full or none" ;; esac

# Each release keeps a note of itself while it runs, in the repository
# beside the lock: what --queue reads, and what the Office shows as its
# Releases box (release_queue in lib/office.py reads the same lines; change
# one, change both). Eight lines: the topic; its step in words (checking,
# testing (quick), waiting for its turn, ...); when the release began
# (epoch seconds); "no version" for --plain, else nothing; the summary;
# when this step began; the step's number of the seven (0 while waiting
# for its turn: see steps below); the worktree the tests run in (so the
# Office finds the run's plan, tests/run.sh's, and says how long is left).
# A note whose process has ended is nobody's, and is cleared away here.
notes_dir() { printf '%s/vikix-release-queue' "$(cd "$(dirname "$0")/.." && cd "$(git rev-parse --git-common-dir)" && pwd)"; }
steps=7   # checking, looking at origin, onto main, testing, merging, version and tag, closing the desk
show_queue() {
  local dir f pid topic state since summary kind step rows
  dir=$(notes_dir) || die "this isn't a git repository"
  rows=$(for f in "$dir"/*; do
    [ -f "$f" ] || continue
    pid=${f##*/}
    kill -0 "$pid" 2>/dev/null || { rm -f "$f"; continue; }
    step=''
    { IFS= read -r topic; IFS= read -r state; IFS= read -r since; IFS= read -r kind; IFS= read -r summary; IFS= read -r _; IFS= read -r step; } < "$f" || true
    case $step in [1-9]|[1-9][0-9]) state="step $step of $steps: $state" ;; esac
    # The one whose turn it is sorts first, then the waiting by when they came.
    case $state in waiting*) printf '1 %s' "$since" ;; *) printf '0 %s' "$since" ;; esac
    printf '\t%s\t%s\t%s\t%s\n' "$topic" "$state" "$(date -d "@$since" +%H:%M 2>/dev/null || echo '?')" "$summary${kind:+ ($kind)}"
  done | sort | while IFS=$'\t' read -r _ topic state since summary; do
    printf '  %-12s %-34s since %s   %s\n' "$topic" "$state" "$since" "$summary" | cut -c1-"${COLUMNS:-160}"
  done)
  if [ -n "$rows" ]; then
    printf 'Releases under way, the one whose turn it is first:\n%s\n' "$rows"
  else
    echo "No release is under way."
  fi
}
if [ -n "$queue" ]; then
  [ -z "$topic" ] || die "--queue takes nothing more"
  show_queue
  exit 0
fi

[ -n "$topic" ] || die "which topic? .claude/release TOPIC \"what it brings\""
[ -n "$plain" ] || [ -n "$summary" ] || die "what does it bring? .claude/release $topic \"...\" (it becomes the release's line)"
case $summary in *$'\n'*) die "the summary is one line" ;; esac

here=$(cd "$(dirname "$0")/.." && pwd) || die "where am I?"
common=$(cd "$here" && cd "$(git rev-parse --git-common-dir)" && pwd) || die "$here isn't a git repository"
# The first worktree listed is the main checkout: where main is merged.
main=$(git -C "$here" worktree list --porcelain | awk '/^worktree /{print substr($0, 10); exit}')
[ -n "$main" ] && [ -d "$main" ] || die "the main checkout wasn't found"
wt=$(git -C "$main" worktree list --porcelain | awk -v b="refs/heads/$topic" '/^worktree /{w=substr($0, 10)} $1=="branch" && $2==b {print w; exit}')
git -C "$main" rev-parse --verify -q "refs/heads/$topic" >/dev/null || die "there is no branch $topic"
[ -n "$wt" ] || die "the branch $topic has no worktree (git worktree add ~/src/vikix-$topic $topic)"
[ "$wt" != "$main" ] || die "$topic is checked out in the main folder: that one is for merging only"

# This release's note, for --queue and the Office: gone when this ends,
# however it ends. Each step is numbered as it comes, skipped or not, so
# "step 4 of 7" is the same step in every release.
note_file="$common/vikix-release-queue/$$"
came=$(date +%s)
note() {   # note STEP STATE: what this release is doing now (STEP 0 to 7)
  mkdir -p "$common/vikix-release-queue" 2>/dev/null || return 0
  printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n' "$topic" "$2" "$came" "${plain:+no version}" "$summary" "$(date +%s)" "$1" "$wt" > "$note_file.tmp" 2>/dev/null &&
    mv -f "$note_file.tmp" "$note_file" 2>/dev/null || true
}
trap 'rm -f "$note_file" "$note_file.tmp"' EXIT

# One at a time.
exec 9>"$common/vikix-release.lock" || die "the lock can't be made"
if ! flock -n 9; then
  note 0 "waiting for its turn"
  say "another session is releasing: waiting for it (.claude/release --queue shows the queue)"
  flock -w 3600 9 || die "waited an hour for the other release; nothing done"
fi
note 1 "checking"

[ "$(git -C "$main" symbolic-ref -q --short HEAD)" = main ] || die "the main folder ($main) isn't on main"
[ -z "$(git -C "$main" status --porcelain)" ] || die "the main folder ($main) has changes of its own: it is for merging only. Nothing done"
[ -z "$(git -C "$wt" status --porcelain)" ] || die "$wt has changes not committed (commit them by name, or take them out). Nothing done"
[ ! -d "$common/worktrees/$(basename "$wt")/rebase-merge" ] || die "$wt is in the middle of a rebase. Nothing done"
[ "$(git -C "$main" rev-list --count "main..$topic")" -gt 0 ] || die "$topic has nothing main hasn't. Nothing done"

# A release made elsewhere (a cloud session pushing straight to GitHub) and
# not pulled here would take the same number again, and gup would be refused:
# GitHub's main is looked at first, over HTTPS (no key needed), when the
# repository has an origin. Unreachable: said, and the release goes on.
origin=$(git -C "$main" remote get-url origin 2>/dev/null || true)
if [ -n "$origin" ]; then
  note 2 "looking at origin"
  case $origin in git@github.com:*) origin="https://github.com/${origin#git@github.com:}" ;; esac
  if timeout 30 git -C "$main" fetch -q --no-tags "$origin" main >/dev/null 2>&1; then
    behind=$(git -C "$main" rev-list --count main..FETCH_HEAD 2>/dev/null || echo 0)
    [ "$behind" = 0 ] ||
      die "origin's main has $behind commit(s) this main hasn't (a release from elsewhere?). Vid: gpl, then release again. Nothing done"
  else
    say "origin couldn't be reached: releasing without looking at it"
  fi
fi

# On top of main as it is now.
if [ "$(git -C "$main" rev-list --count "$topic..main")" -gt 0 ]; then
  note 3 "onto main"
  say "main has moved on: putting $topic on top of it"
  if ! git -C "$wt" rebase -q main >/dev/null 2>&1; then
    files=$(git -C "$wt" diff --name-only --diff-filter=U | tr '\n' ' ')
    git -C "$wt" rebase --abort >/dev/null 2>&1
    die "$topic and main changed the same lines (${files:-?}). Nothing done: in $wt run git rebase main, settle them, and release again"
  fi
fi

# The record's own check first: a passing run of the runner, as wide as this
# one, on this very commit (the rebase above changed it when main had moved,
# so nothing stale can vouch), with nothing uncommitted. --tests none stays as typed.
# The topic's copy of lib/handoff.py, which is at least main's (main's has no
# fresh-check until this lands); the closing below uses main's, the worktree gone by then.
if [ "$tests" != none ] && [ -f "$wt/lib/handoff.py" ]; then
  if vouched=$(python3 "$wt/lib/handoff.py" fresh-check "$common" "$wt" "$(git -C "$wt" rev-parse HEAD)" "$tests" 2>/dev/null); then
    say "tests: not run: the desk's record has $vouched"
    tests=none
  fi
fi

case $tests in
  none) [ -n "${vouched:-}" ] || say "tests: not run (you said none)" ;;
  *)
    case $tests in changed) args=(--changed main) ;; quick) args=(--quick) ;; full) args=() ;; esac
    note 4 "testing ($tests)"
    say "tests (${tests}), in $wt ..."
    log=$(mktemp)
    # 9>&-: the tests don't inherit the lock's descriptor, or a program a test
    # leaves behind (an Xvfb, 2026-10-08) holds the queue for everyone after.
    if ! (cd "$wt" && tests/run.sh "${args[@]}" 9>&-) >"$log" 2>&1; then
      grep -E '^FAIL|^FAILED' "$log" | head -20 >&2
      kept="$common/vikix-release-tests.log"; cp "$log" "$kept"; rm -f "$log"
      die "the tests failed (all they said: $kept). Nothing merged"
    fi
    tail -1 "$log" | cut -c1-300
    rm -f "$log" ;;
esac

# From here main changes. Each step only after the one before.
note 5 "merging"
git -C "$main" merge -q --ff-only "$topic" >/dev/null 2>&1 ||
  die "main wouldn't fast-forward to $topic. Nothing merged"
merged=$(git -C "$main" rev-parse --short HEAD)
say "main is at $merged ($topic)"

if [ -z "$plain" ]; then
  note 6 "version and tag"
  old=$(cat "$main/VERSION" 2>/dev/null)
  [[ $old =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] ||
    die "VERSION says '$old', not a number like 0.71.189. $topic is merged ($merged); the version and tag are not made"
  if [ -n "$middle" ]; then new="${BASH_REMATCH[1]}.$((BASH_REMATCH[2] + 1)).0"
  else new="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.$((BASH_REMATCH[3] + 1))"; fi
  git -C "$main" rev-parse -q --verify "refs/tags/v$new" >/dev/null &&
    die "the tag v$new is there already. $topic is merged ($merged); the version and tag are not made"
  printf '%s\n' "$new" > "$main/VERSION" ||
    die "VERSION can't be written. $topic is merged ($merged); the version and tag are not made"
  message=("-m" "Vikix $new: $summary")
  [ -z "$coauthor" ] || message+=("-m" "Co-Authored-By: $coauthor")
  if ! { git -C "$main" add VERSION && git -C "$main" commit -q "${message[@]}"; } >/dev/null 2>&1; then
    git -C "$main" checkout -q -- VERSION 2>/dev/null
    die "the release commit failed. $topic is merged ($merged); the version and tag are not made"
  fi
  git -C "$main" tag "v$new" || die "the tag v$new failed. Vikix $new is committed; tag it: git -C $main tag v$new"
fi

if [ -z "$keep" ]; then
  note 7 "closing the desk"
  git -C "$main" worktree remove "$wt" >/dev/null 2>&1 || say "the worktree $wt wasn't removed (something in it git doesn't know?)"
  git -C "$main" branch -q -d "$topic" >/dev/null 2>&1 || say "the branch $topic wasn't removed"
  # The desk's record (the office's, ~/.local/state/vikix/office/desks/) is
  # marked closed, as vikix agents close marks it, so the Office files the
  # desk under Closed (for a day, then its Archive) and not among the ones
  # waiting to be picked up. A desk that never had a record gets none. A
  # handoff with no status gets "finished" and this release's line first:
  # the work is on main, whatever the agent left unsaid.
  if [ -f "$main/lib/handoff.py" ]; then
    python3 "$main/lib/handoff.py" closed "$common" "$wt" release "$summary" >/dev/null 2>&1
    case $? in 0|1) ;; *) say "the desk's record wasn't marked closed (vikix agents handoff list)" ;; esac
  fi
  # The desk's tasks (lib/tasks.py): the event released, with the version,
  # and each open one completed, since its work is on main now.
  if [ -f "$main/lib/tasks.py" ]; then
    python3 "$main/lib/tasks.py" released "$common" "$wt" "${new:-}" >/dev/null 2>&1
    case $? in 0|1) ;; *) say "the desk's tasks weren't marked released (vikix agents tasks)" ;; esac
  fi
fi

if [ -z "$plain" ]; then
  say "Vikix $new is released on main: $summary"
else
  say "$topic is on main, with no new version"
fi
# A release may unblock a dependent task. The event tick obeys auto=off.
if [ -f "$main/lib/scheduler.py" ]; then
  python3 - "$main" <<'PYTHON'
import sys
sys.path.insert(0, sys.argv[1] + '/lib')
import scheduler
scheduler.wake(sys.argv[1] + '/bin/vikix-agents')
PYTHON
fi
say "not pushed. Vid: gup"
exit 0
}
