# services.list — runit services install/20-services.sh switches on.
# NetworkManager is switched on separately, by install/25-network.sh,
# because the old network services have to be stopped at the right moment.
dbus
# elogind is deliberately NOT here: dbus starts it on demand. Enabling its
# runit service as well races with that and loops forever printing
# "elogind is already running" on the console.
# acpid is deliberately NOT here either (from 0.71.31): its handler.sh
# suspends on the lid itself (zzz) while elogind does too, and two
# suspends at once collide (blank screen on opening it, sleeping twice),
# and the first skips the lock screen. elogind handles the lid and the
# power button, StumpWM the brightness keys.
tlp
chronyd         # from chrony
bluetoothd      # from bluez
cupsd           # printing, from cups
avahi-daemon    # finds printers (and other devices) on the network
ipp-usb         # driverless USB printers
ufw             # puts the firewall's rules back at boot; does nothing while it's off
