[Desktop Entry]
# Vikix's: the same name as Void's /usr/share/applications/lazarus.desktop,
# so this one is used instead. It starts the docked IDE (vikix-lazarus).
Name=Lazarus
Comment=Lazarus IDE for Free Pascal
Exec=vikix-lazarus %f
Terminal=false
Type=Application
Icon=lazarus
Categories=IDE;Development;
StartupWMClass=Lazarus
MimeType=text/x-pascal;text/lazarus-project-source;text/lazarus-project-information;text/lazarus-form;text/lazarus-resource;text/lazarus-package;text/lazarus-package-link;text/lazarus-code-inlay;
Keywords=editor;Pascal;IDE;FreePascal;fpc;Design;Designer;
