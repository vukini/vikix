# ~/.config/dunst/dunstrc — yours; Vikix copied it once.
# Colours come from Vikix's theme, in dunstrc.d/10-vikix-theme.conf, which
# dunst reads after this file. To use your own, see the note in that file.
[global]
    font = Iosevka 11
    origin = top-right
    offset = (12, 36)
    width = 360
    frame_width = 2
    corner_radius = 0

[urgency_low]
    timeout = 5

[urgency_normal]
    timeout = 8

[urgency_critical]
    timeout = 0
