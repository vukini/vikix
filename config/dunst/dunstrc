# ~/.config/dunst/dunstrc — yours; Vikix copied it once.
# Colours match Vikix's "void" theme.
[global]
    font = Iosevka 11
    origin = top-right
    offset = (12, 36)
    width = 360
    frame_width = 2
    frame_color = "#89b4fa"
    corner_radius = 0

[urgency_low]
    background = "#1e1e2e"
    foreground = "#a6adc8"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 8

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#f38ba8"
    timeout = 0
